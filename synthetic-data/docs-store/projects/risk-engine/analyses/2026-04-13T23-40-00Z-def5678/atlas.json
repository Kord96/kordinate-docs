{
  "project": "Risk Engine",
  "purpose": "Scores transactions and fraud signals before settlement.",
  "domain_model": {
    "primary": "RiskDecision",
    "entities": ["Transaction", "RiskDecision", "Signal"],
    "relationships": ["Transaction yields signals", "Signals drive decision"]
  },
  "groups": [
    { "id": "ingest", "label": "Ingest", "description": "Receives transactions" },
    { "id": "scoring", "label": "Scoring", "description": "Evaluates rules and models" }
  ],
  "components": [
    {
      "id": "ingest-api",
      "name": "Ingest API",
      "type": "api",
      "group": "ingest",
      "description": "Accepts transaction payloads.",
      "depends_on": ["risk-engine"]
    },
    {
      "id": "risk-engine",
      "name": "Risk Engine",
      "type": "service",
      "group": "scoring",
      "description": "Combines rules and model signals to produce a decision.",
      "depends_on": ["risk-store"]
    }
  ],
  "external_dependencies": [
    {
      "id": "risk-store",
      "name": "Risk Store",
      "type": "store",
      "description": "Persists decisions and model features."
    }
  ],
  "flows": [
    {
      "id": "score-transaction",
      "title": "Score Transaction",
      "steps": [
        { "component": "ingest-api", "to": "risk-engine" },
        { "component": "risk-engine", "to": "risk-store" }
      ]
    }
  ],
  "failure_modes": [],
  "concepts": {},
  "debt": {}
}
