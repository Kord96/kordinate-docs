---
/**
 * Client-side JavaScript for journey pages.
 * Handles: scroll tracking, journey switching, Cytoscape graphs,
 * drawer interactions, focus mode, keyboard nav, bold-ref clicks.
 *
 * Depends on DOM IDs from: JourneyNav, LandingSection, OverviewSection,
 * StorySection, Drawer, FocusOverlay, JourneyData.
 */
---

<script is:inline>
  const journeyNav = document.getElementById('journey-nav');
  const jbDots = document.getElementById('jb-dots');
  const jnPicker = document.getElementById('jn-picker');
  const landing = document.getElementById('s0');
  const fabMenu = document.getElementById('fab-menu');
  const fabJourneyGroup = document.getElementById('fab-journey-group');
  const fabJourneys = document.getElementById('fab-journeys');
  let cur = 0;
  let currentJourneyId = journeyNav?.dataset.defaultJourney || jnPicker?.querySelector('.jn-pick-active')?.dataset.journey || 'system-overview';

  function getVisibleSections() {
    return [landing, ...document.querySelectorAll(`.journey-section[data-journey="${currentJourneyId}"]`)];
  }

  // Show/hide nav based on scroll position
  const landingObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      journeyNav.classList.toggle('visible', !e.isIntersecting);
    });
  }, { threshold: 0.3 });
  landingObs.observe(landing);

  function toggleJourneyPicker(anchorEl) {
    if (!jnPicker || !anchorEl) return;
    const rect = anchorEl.getBoundingClientRect();
    jnPicker.style.bottom = (window.innerHeight - rect.top + 6) + 'px';
    jnPicker.style.left = Math.max(16, rect.left - Math.max(0, jnPicker.offsetWidth - rect.width)) + 'px';
    jnPicker.classList.toggle('open');
  }

  // Journey picker toggle — position next to the section action buttons
  document.addEventListener('click', () => jnPicker?.classList.remove('open'));
  document.querySelectorAll('.journey-switch-btn').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleJourneyPicker(btn);
    });
  });
  jnPicker?.querySelectorAll('.jn-pick').forEach(pick => {
    pick.addEventListener('click', (e) => {
      e.stopPropagation();
      jnPicker.classList.remove('open');
      switchJourney(pick.dataset.journey);
      jnPicker.querySelectorAll('.jn-pick').forEach(p => p.classList.toggle('jn-pick-active', p === pick));
    });
  });

  // Track current story and update dots
  function rebuildDots() {
    const secs = getVisibleSections();
    const storyCount = secs.length - 1;
    jbDots.innerHTML = '';
    for (let i = 1; i <= storyCount; i++) {
      const dot = document.createElement('a');
      dot.className = 'jb-dot';
      dot.dataset.index = i;
      const sec = secs[i];
      const titleEl = sec?.querySelector('.story-title');
      const fullTitle = titleEl ? titleEl.textContent : 'Story ' + i;
      dot.title = fullTitle;
      dot.textContent = fullTitle.includes(':') ? fullTitle.split(':')[0].trim() : fullTitle;
      dot.addEventListener('click', () => {
        secs[i]?.scrollIntoView({ behavior: 'smooth' });
      });
      jbDots.appendChild(dot);
    }
  }

  function setupObserver() {
    const secs = getVisibleSections();
    rebuildDots();

    const obs = new IntersectionObserver(entries => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          cur = secs.indexOf(e.target);
          jbDots.querySelectorAll('.jb-dot').forEach((d, i) => {
            d.classList.toggle('jb-dot-active', i + 1 === cur);
            if (i + 1 < cur) d.classList.add('jb-dot-visited');
          });
        }
      });
    }, { threshold: 0.5 });
    secs.forEach(s => { if (s) obs.observe(s); });
    return obs;
  }

  let currentObs = setupObserver();

  // Keyboard navigation
  document.addEventListener('keydown', e => {
    const secs = getVisibleSections();
    if (e.key === 'ArrowDown' || e.key === 'j') { e.preventDefault(); secs[Math.min(cur+1, secs.length-1)]?.scrollIntoView({ behavior: 'smooth' }); }
    if (e.key === 'ArrowUp' || e.key === 'k') { e.preventDefault(); secs[Math.max(cur-1, 0)]?.scrollIntoView({ behavior: 'smooth' }); }
    if ((e.metaKey || e.ctrlKey) && e.key === 'k') { e.preventDefault(); updateFabMenu(); fabMenu?.classList.toggle('open'); }
    if (e.key === 'Escape' && drawer.classList.contains('open')) { closeDrawer(); }
  });

  // ─── Cytoscape graphs ───
  const typeColors = {
    worker: { bg: '#2a2a4a', border: '#818cf8', text: '#c7c7ff' },
    service: { bg: '#1e2a4a', border: '#60a5fa', text: '#93c5fd' },
    api: { bg: '#1a2e2a', border: '#4ade80', text: '#86efac' },
    store: { bg: '#2e2a1a', border: '#fbbf24', text: '#fde68a' },
    cli: { bg: '#222', border: '#94a3b8', text: '#cbd5e1' },
    scheduler: { bg: '#2a1e3a', border: '#c084fc', text: '#d8b4fe' },
    external: { bg: '#2e1a1a', border: '#f87171', text: '#fca5a5' },
    broker: { bg: '#2e221a', border: '#fb923c', text: '#fdba74' },
  };

  // ─── Drawer ───
  const drawer = document.getElementById('drawer');
  const fab = document.getElementById('fab');
  const drawerClose = document.getElementById('drawer-close');
  const drawerTabs = document.querySelectorAll('.drawer-tab');
  const panelDetail = document.getElementById('panel-detail');
  const panelTerminal = document.getElementById('panel-terminal');

  function getCurrentSectionElement() {
    const sections = getVisibleSections().filter(Boolean);
    return sections[cur] || sections[0] || landing;
  }

  function getCurrentStorySupport() {
    const section = getCurrentSectionElement();
    const encoded = section?.dataset?.storySupport;
    if (!encoded) return null;
    try {
      return JSON.parse(decodeURIComponent(encoded));
    } catch {
      return null;
    }
  }

  function escapeHtml(value) {
    return String(value ?? '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');
  }

  function renderInlineMarkup(value) {
    return escapeHtml(value).replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>');
  }

  function openDrawer(tab) {
    drawer?.classList.add('open');
    document.body.classList.add('drawer-open');
    fab?.classList.add('hidden');
    drawerTabs.forEach(t => t.classList.toggle('active', t.dataset.panel === tab));
    panelDetail?.classList.toggle('active', tab === 'detail');
    panelTerminal?.classList.toggle('active', tab === 'terminal');
    if (tab === 'terminal') document.getElementById('term-field')?.focus();
  }

  function closeDrawer() {
    drawer?.classList.remove('open');
    document.body.classList.remove('drawer-open');
    fab?.classList.remove('hidden');
  }

  function closeFabMenu() {
    fabMenu?.classList.remove('open');
  }

  function updateFabMenu() {
    if (!fabMenu) return;
    const picks = Array.from(jnPicker?.querySelectorAll('.jn-pick') || []);
    const hasJourneys = picks.length > 1;
    if (fabJourneyGroup && fabJourneys) {
      fabJourneyGroup.toggleAttribute('hidden', !hasJourneys);
      fabJourneys.innerHTML = '';
      if (hasJourneys) {
        picks.forEach((pick) => {
          const option = document.createElement('button');
          option.type = 'button';
          option.className = 'fab-journey-option' + (pick.classList.contains('jn-pick-active') ? ' fab-journey-option-active' : '');
          option.dataset.journey = pick.dataset.journey || '';
          option.textContent = pick.textContent?.trim() || (pick.dataset.journey || '');
          option.addEventListener('click', (event) => {
            event.stopPropagation();
            const jid = option.dataset.journey;
            if (!jid) return;
            switchJourney(jid);
            jnPicker?.querySelectorAll('.jn-pick').forEach((p) => p.classList.toggle('jn-pick-active', p.dataset.journey === jid));
            closeFabMenu();
          });
          fabJourneys.appendChild(option);
        });
      }
    }
  }

  function showStorySupportDetail(support) {
    if (!support) return;
    let html = '<div class="detail-header">';
    html += '<div class="detail-name">' + escapeHtml(support.title || 'Story support') + '</div>';
    html += '<div class="detail-type"><span class="detail-type-badge">story support</span></div>';
    html += '</div>';
    if (support.teaches) html += '<div class="detail-desc">' + renderInlineMarkup(support.teaches) + '</div>';
    if (support.anchor) {
      html += '<div class="detail-section"><div class="detail-label">Start Here</div>';
      html += '<div class="detail-subsection"><div class="detail-subtitle">' + escapeHtml((support.anchor.file || '') + ':' + (support.anchor.line || '')) + '</div>';
      if (support.anchor.description) html += '<div class="detail-note">' + escapeHtml(support.anchor.description) + '</div>';
      html += '</div></div>';
    }
    const observations = support.observations || [];
    if (observations.length) {
      html += '<div class="detail-section"><div class="detail-label">Evidence-backed Findings</div><ul class="detail-list">';
      html += observations.map((obs) =>
        '<li><div class="detail-prose">' + renderInlineMarkup(obs.finding || '') + '</div>'
        + ((obs.evidence?.file || obs.confidence) ? '<div class="detail-note">' + escapeHtml([obs.evidence?.file ? `${obs.evidence.file}${obs.evidence.lines?.length ? ':' + obs.evidence.lines[0] : ''}` : '', obs.confidence ? `confidence: ${obs.confidence}` : ''].filter(Boolean).join(' • ')) + '</div>' : '')
        + (obs.recommendation ? '<div class="detail-rec">→ ' + escapeHtml(obs.recommendation) + '</div>' : '')
        + '</li>'
      ).join('');
      html += '</ul></div>';
    }
    const rationale = support.rationale || [];
    if (rationale.length) {
      html += '<div class="detail-section"><div class="detail-label">Decisions & Trade-offs</div><ul class="detail-list">';
      html += rationale.map((entry) =>
        '<li><div class="detail-prose"><strong>' + escapeHtml(entry.decision || '') + '</strong></div>'
        + (entry.context ? '<div class="detail-note">' + escapeHtml(entry.context) + '</div>' : '')
        + (entry.trade_offs ? '<div class="detail-rec">↔ ' + escapeHtml(entry.trade_offs) + '</div>' : '')
        + '</li>'
      ).join('');
      html += '</ul></div>';
    }
    panelDetail.innerHTML = html;
    openDrawer('detail');
  }

  function showStructureDetail(structSupport) {
    if (!structSupport) return;
    const nodes = Array.isArray(structSupport.nodes) ? structSupport.nodes : [];
    const edges = Array.isArray(structSupport.edges) ? structSupport.edges : [];
    let html = '<div class="detail-header">';
    html += '<div class="detail-name">' + escapeHtml(structSupport.title || 'Structure view') + '</div>';
    html += '<div class="detail-type"><span class="detail-type-badge">graph</span>';
    if (structSupport.storyTitle) html += '<span>' + escapeHtml(structSupport.storyTitle) + '</span>';
    html += '</div></div>';
    if (structSupport.summary) html += '<div class="detail-desc">' + renderInlineMarkup(structSupport.summary) + '</div>';
    if (structSupport.teaches) {
      html += '<div class="detail-section"><div class="detail-label">Focus</div><div class="detail-prose">' + renderInlineMarkup(structSupport.teaches) + '</div></div>';
    }
    if (nodes.length) {
      html += '<div class="detail-section"><div class="detail-label">Nodes In View</div><div class="detail-links">';
      html += nodes.map((node) => '<a class="detail-link detail-dep" data-node="' + escapeHtml(node.id) + '">' + escapeHtml(node.name || labelFor(node.id)) + '</a>').join('');
      html += '</div></div>';
    }
    if (edges.length) {
      html += '<div class="detail-section"><div class="detail-label">Key Relationships</div><ul class="detail-list">';
      html += edges.map((edge) => {
        const relation = edge.label || 'relates to';
        return '<li><div class="detail-prose"><strong>' + escapeHtml(labelFor(edge.from)) + '</strong> — ' + escapeHtml(relation) + ' → <strong>' + escapeHtml(labelFor(edge.to)) + '</strong></div></li>';
      }).join('');
      html += '</ul></div>';
    }
    panelDetail.innerHTML = html;
    panelDetail.querySelectorAll('.detail-dep').forEach(link => {
      link.addEventListener('click', () => {
        const nodeId = link.dataset.node;
        const comp = allCompData[nodeId];
        if (comp) showNodeDetail(comp, allRefs);
      });
    });
    openDrawer('detail');
  }

  function showSymbolDetail(symbolData) {
    if (!symbolData) return;
    let html = '<div class="detail-header">';
    html += '<div class="detail-name">' + escapeHtml(symbolData.name || 'Symbol') + '</div>';
    html += '<div class="detail-type"><span class="detail-type-badge">symbol</span>';
    if (symbolData.kind) html += '<span>' + escapeHtml(symbolData.kind) + '</span>';
    html += '</div></div>';
    html += '<div class="detail-desc">Grounded mechanism reference from <code>' + escapeHtml(symbolData.file || 'unknown file') + '</code>.</div>';
    html += '<div class="detail-section"><div class="detail-label">Grounding</div>';
    if (symbolData.file) html += '<div class="detail-subsection"><div class="detail-subtitle">File</div><code style="font-size:.72rem;color:var(--accent);display:block;padding:.1rem 0;">' + escapeHtml(symbolData.file) + '</code></div>';
    if (symbolData.language || symbolData.exported !== undefined) {
      html += '<div class="detail-subsection"><div class="detail-subtitle">Traits</div><div class="detail-links">';
      if (symbolData.language) html += '<span class="detail-type-badge">' + escapeHtml(symbolData.language) + '</span>';
      if (symbolData.kind) html += '<span class="detail-type-badge">' + escapeHtml(symbolData.kind) + '</span>';
      if (symbolData.exported) html += '<span class="detail-type-badge">exported</span>';
      html += '</div></div>';
    }
    if ((symbolData.reasons || []).length) {
      html += '<div class="detail-subsection"><div class="detail-subtitle">Why This Is Grounded</div><div class="detail-links">';
      html += symbolData.reasons.map((item) => '<span class="detail-type-badge">' + escapeHtml(item) + '</span>').join('');
      html += '</div></div>';
    }
    html += '</div>';
    panelDetail.innerHTML = html;
    openDrawer('detail');
  }

  function showFlowDetail(flowSupport) {
    if (!flowSupport) return;
    const steps = Array.isArray(flowSupport.steps) ? flowSupport.steps : [];
    let html = '<div class="detail-header">';
    html += '<div class="detail-name">' + escapeHtml(flowSupport.title || 'Flow') + '</div>';
    html += '<div class="detail-type"><span class="detail-type-badge">flow</span>';
    if (flowSupport.storyTitle) html += '<span>' + escapeHtml(flowSupport.storyTitle) + '</span>';
    html += '</div></div>';
    if (flowSupport.summary) html += '<div class="detail-desc">' + renderInlineMarkup(flowSupport.summary) + '</div>';
    if (flowSupport.trigger || flowSupport.outcome || flowSupport.severity) {
      html += '<div class="detail-section"><div class="detail-label">Flow Framing</div>';
      if (flowSupport.trigger) html += '<div class="detail-subsection"><div class="detail-subtitle">Trigger</div><div class="detail-prose">' + escapeHtml(flowSupport.trigger) + '</div></div>';
      if (flowSupport.outcome) html += '<div class="detail-subsection"><div class="detail-subtitle">Outcome</div><div class="detail-prose">' + escapeHtml(flowSupport.outcome) + '</div></div>';
      if (flowSupport.severity) html += '<div class="detail-subsection"><div class="detail-subtitle">Severity</div><div class="detail-links"><span class="detail-type-badge">' + escapeHtml(flowSupport.severity) + '</span></div></div>';
      html += '</div>';
    }
    if (steps.length) {
      html += '<div class="detail-section"><div class="detail-label">Stages</div><ol class="detail-list detail-list-compact">';
      html += steps.map((step) => {
        const fromName = labelFor(step.node || step.component || '');
        const toName = step.to ? labelFor(step.to) : '';
        const action = step.action || step.effect || '';
        const effect = step.effect && step.effect !== step.action ? step.effect : '';
        const meta = [
          step.actor ? `actor:${step.actor}` : '',
          step.technology || '',
          step.data || '',
          step.transform || '',
          step.condition || '',
          step.gate || '',
          step.topic || '',
          step.delivery || '',
          step.from_state || '',
          step.to_state || '',
          step.resource || '',
          step.operation || '',
        ].filter(Boolean);
        return '<li>'
          + '<div class="detail-prose"><strong>' + escapeHtml(fromName) + '</strong>'
          + (action ? ' — ' + escapeHtml(action) : '')
          + (toName ? ' → <strong>' + escapeHtml(toName) + '</strong>' : '')
          + '</div>'
          + (effect ? '<div class="detail-note">' + escapeHtml(effect) + '</div>' : '')
          + (meta.length ? '<div class="detail-inline-meta">' + meta.map((item) => '<span class="detail-inline-chip">' + escapeHtml(item) + '</span>').join('') + '</div>' : '')
          + '</li>';
      }).join('');
      html += '</ol></div>';
    }
    if ((flowSupport.detection || []).length) {
      html += '<div class="detail-section"><div class="detail-label">Detection</div><ul class="detail-list">';
      html += flowSupport.detection.map((item) => '<li>' + escapeHtml(item) + '</li>').join('');
      html += '</ul></div>';
    }
    if ((flowSupport.recovery || []).length) {
      html += '<div class="detail-section"><div class="detail-label">Recovery</div><ul class="detail-list">';
      html += flowSupport.recovery.map((item) => '<li>' + escapeHtml(item) + '</li>').join('');
      html += '</ul></div>';
    }
    panelDetail.innerHTML = html;
    openDrawer('detail');
  }

  fab?.addEventListener('click', (event) => {
    event.stopPropagation();
    updateFabMenu();
    fabMenu?.classList.toggle('open');
  });
  drawerClose?.addEventListener('click', closeDrawer);
  drawerTabs.forEach(t => t.addEventListener('click', () => openDrawer(t.dataset.panel)));
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (target.closest('#fab')) {
      return;
    }
    if (target.closest('#fab-menu')) return;
    const storySupportTrigger = target.closest('[data-story-support-open]');
    if (storySupportTrigger) {
      const support = getCurrentStorySupport();
      if (support) {
        showStorySupportDetail(support);
      }
      return;
    }
    const flowSupportTrigger = target.closest('[data-flow-support-open]');
    if (flowSupportTrigger) {
      const flowRoot = flowSupportTrigger.closest('[data-flow-support]');
      const encoded = flowRoot?.dataset?.flowSupport;
      if (encoded) {
        try {
          showFlowDetail(JSON.parse(decodeURIComponent(encoded)));
        } catch {}
      }
      return;
    }
    const structSupportTrigger = target.closest('[data-struct-support-open]');
    if (structSupportTrigger) {
      const structRoot = structSupportTrigger.closest('[data-struct-support]');
      const encoded = structRoot?.dataset?.structSupport;
      if (encoded) {
        try {
          showStructureDetail(JSON.parse(decodeURIComponent(encoded)));
        } catch {}
      }
      return;
    }
    if (target.closest('#drawer-close')) {
      closeDrawer();
      return;
    }
    const tabButton = target.closest('.drawer-tab');
    if (tabButton instanceof HTMLElement && tabButton.dataset.panel) {
      openDrawer(tabButton.dataset.panel);
      return;
    }
    if (!drawer?.classList.contains('open')) return;
    if (target.closest('#drawer')) return;
    if (target.closest('.ref, .struct-graph, .detail-link, .detail-dep, .flow, .obs')) return;
    closeDrawer();
  });
  document.addEventListener('click', () => closeFabMenu());

  function formatId(id) { return id.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase()); }
  function labelFor(id) { return (atlasDetailData.labelsById || {})[id] || allCompData[id]?.name || formatId(id); }

  const projectData = JSON.parse(document.getElementById('project-data')?.textContent || '{}');
  const atlasDetailData = JSON.parse(document.getElementById('atlas-detail-data')?.textContent || '{}');
  const projectApiBasePath = projectData.apiBasePath || '';
  let graphLayoutsPromise = null;
  let graphLayoutsCache = null;
  const saveLayoutTimers = new Map();

  function normalizeGraphId(id) {
    return String(id || '').replace(/^focus-/, '');
  }

  async function loadGraphLayouts() {
    if (!projectApiBasePath) return {};
    if (!graphLayoutsPromise) {
      graphLayoutsPromise = fetch(`${projectApiBasePath}/ui/graph-layouts`)
        .then((response) => response.ok ? response.json() : { graph_layouts: {} })
        .then((payload) => {
          graphLayoutsCache = payload?.graph_layouts || {};
          return graphLayoutsCache;
        })
        .catch(() => {
          graphLayoutsCache = {};
          return graphLayoutsCache;
        });
    }
    return graphLayoutsPromise;
  }

  function captureGraphPositions(cy) {
    return Object.fromEntries(
      cy.nodes().map((node) => {
        const position = node.position();
        return [node.id(), { x: Number(position.x.toFixed(2)), y: Number(position.y.toFixed(2)) }];
      }),
    );
  }

  function applySavedPositions(cy, saved) {
    if (!saved || !saved.positions) return false;
    let applied = 0;
    cy.nodes().forEach((node) => {
      const position = saved.positions[node.id()];
      if (!position || typeof position.x !== 'number' || typeof position.y !== 'number') return;
      node.position(position);
      applied += 1;
    });
    return applied > 0;
  }

  function collectCollapsedNodeIds(cy) {
    return cy.nodes('.collapsed-parent').map((node) => node.id());
  }

  function scheduleGraphLayoutSave(graphId, layout) {
    if (!projectApiBasePath || !graphId) return;
    const normalizedId = normalizeGraphId(graphId);
    if (saveLayoutTimers.has(normalizedId)) clearTimeout(saveLayoutTimers.get(normalizedId));
    saveLayoutTimers.set(normalizedId, setTimeout(async () => {
      saveLayoutTimers.delete(normalizedId);
      graphLayoutsCache = graphLayoutsCache || {};
      graphLayoutsCache[normalizedId] = { ...(graphLayoutsCache[normalizedId] || {}), ...layout };
      try {
        await fetch(`${projectApiBasePath}/ui/graph-layouts`, {
          method: 'PUT',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ graph_id: normalizedId, layout }),
        });
      } catch {}
    }, 320));
  }

  function buildChildMap(nodes) {
    const map = new Map();
    nodes.forEach((node) => {
      if (!node?.id) return;
      if (!map.has(node.id)) map.set(node.id, new Set());
      (node.children || []).forEach((childId) => {
        if (!map.has(node.id)) map.set(node.id, new Set());
        map.get(node.id).add(childId);
      });
      if (node.parent) {
        if (!map.has(node.parent)) map.set(node.parent, new Set());
        map.get(node.parent).add(node.id);
      }
    });
    return map;
  }

  function descendantIds(childMap, nodeId, seen = new Set()) {
    const children = childMap.get(nodeId);
    if (!children) return [];
    const result = [];
    children.forEach((childId) => {
      if (seen.has(childId)) return;
      seen.add(childId);
      result.push(childId);
      result.push(...descendantIds(childMap, childId, seen));
    });
    return result;
  }

  function setCollapseState(cy, childMap, nodeId, collapsed) {
    const node = cy.getElementById(nodeId);
    if (!node || !node.length) return;
    const descendants = descendantIds(childMap, nodeId);
    descendants.forEach((childId) => {
      const child = cy.getElementById(childId);
      if (child && child.length) child.toggleClass('hidden-by-collapse', collapsed);
    });
    cy.edges().forEach((edge) => {
      const src = edge.data('source');
      const tgt = edge.data('target');
      const hidden = descendants.includes(src) || descendants.includes(tgt);
      if (hidden) edge.toggleClass('hidden-by-collapse', collapsed);
    });
    node.toggleClass('collapsed-parent', collapsed);
    const baseLabel = node.data('baseLabel') || node.data('label');
    node.data('label', collapsed ? `${baseLabel} [${descendants.length}]` : baseLabel);
  }

  function showNodeDetail(data, refs) {
    const storyList = (refs[data.id] || []).map(s =>
      '<a class="detail-link" href="#' + currentJourneyId + '-s1" data-story="' + s + '">' + formatId(s) + '</a>'
    ).join(' ');
    const depList = (data.depends_on || []).map(d =>
      '<a class="detail-link detail-dep" data-node="' + d + '">' + formatId(d) + '</a>'
    ).join(' ');
    const patterns = (data.patterns || []).map(p =>
      '<span class="detail-type-badge">' + p + '</span>'
    ).join(' ');
    const modules = (data.modules || []).slice(0, 3).map(m =>
      '<code style="font-size:.7rem;color:var(--accent);display:block;padding:.1rem 0;">' + m + '</code>'
    ).join('');
    const children = (data.children || []).map(id =>
      '<a class="detail-link detail-dep" data-node="' + id + '">' + formatId(id) + '</a>'
    ).join(' ');
    const readers = (data.readers || []).map((id) =>
      '<a class="detail-link detail-dep" data-node="' + id + '">' + formatId(id) + '</a>'
    ).join(' ');
    const writers = (data.writers || []).map((id) =>
      '<a class="detail-link detail-dep" data-node="' + id + '">' + formatId(id) + '</a>'
    ).join(' ');
    const storesIn = (data.stores_in || []).map((item) =>
      '<code style="font-size:.7rem;color:var(--accent);display:block;padding:.1rem 0;">' + item + '</code>'
    ).join('');
    const health = data.health || {};
    const healthCriteria = (health.criteria || []).map((item) => '<li>' + item + '</li>').join('');
    const scenarioIds = [...new Set([
      ...(health.triggers_failure_scenarios || []),
      ...(health.participates_in_failure_scenarios || []),
      ...((atlasDetailData.failureScenariosByTarget || {})[data.id] || []).map((item) => item.id),
    ])];
    const scenarioList = scenarioIds.map((scenarioId) => {
      const scenario = (atlasDetailData.failureScenarioById || {})[scenarioId] || {};
      const title = scenario.name || scenarioId;
      const summary = scenario.summary || scenario.degraded_mode || '';
      return '<li><button class="detail-scenario-link" data-scenario="' + scenarioId + '"><strong>' + title + '</strong></button>' + (summary ? '<div class="detail-note">' + summary + '</div>' : '') + '</li>';
    }).join('');
    const monitoringList = (((atlasDetailData.monitoringByTarget || {})[data.id]) || []).map((item) =>
      '<li><strong>' + (item.name || item.id) + '</strong>' + (item.summary ? '<div class="detail-note">' + item.summary + '</div>' : '') + '</li>'
    ).join('');
    const gapList = (((atlasDetailData.gapsByTarget || {})[data.id]) || []).map((item) =>
      '<li><strong>' + (item.title || item.id) + '</strong>'
      + (item.kind ? '<span class="detail-type-badge" style="margin-left:.35rem;">' + item.kind + '</span>' : '')
      + (item.summary ? '<div class="detail-note">' + item.summary + '</div>' : '')
      + (item.recommendation ? '<div class="detail-rec">→ ' + item.recommendation + '</div>' : '')
      + '</li>'
    ).join('');
    const summaryText = data.summary || data.purpose || data.description || '';
    const purposeText = data.purpose && data.purpose !== summaryText ? data.purpose : '';
    const usedByList = (data.components || []).map((id) =>
      '<a class="detail-link detail-dep" data-node="' + id + '">' + formatId(id) + '</a>'
    ).join(' ');

    let html = '<div class="detail-header">';
    html += '<div class="detail-name">' + (data.name || formatId(data.id)) + '</div>';
    var typeColorMap = { worker: '#6366f1', service: '#3b82f6', api: '#22c55e', store: '#f59e0b', cli: '#64748b', scheduler: '#a855f7', external: '#ef4444', broker: '#f97316', state: '#14b8a6' };
    var tc = typeColorMap[data.type] || '#71717a';
    html += '<div class="detail-type"><span style="color:' + tc + ';border:1px solid ' + tc + '33;background:' + tc + '15;padding:.15rem .5rem;border-radius:4px">' + (data.type || 'component') + '</span>' + (patterns ? ' ' + patterns : '') + '</div>';
    html += '</div>';

    if (summaryText) html += '<div class="detail-desc">' + summaryText + '</div>';
    if (purposeText) html += '<div class="detail-section"><div class="detail-label">Why It Matters</div><div class="detail-prose">' + purposeText + '</div></div>';
    if (children || depList || usedByList) {
      html += '<div class="detail-section"><div class="detail-label">Structure</div>';
      if (children) html += '<div class="detail-subsection"><div class="detail-subtitle">Subcomponents</div><div class="detail-links">' + children + '</div></div>';
      if (depList) html += '<div class="detail-subsection"><div class="detail-subtitle">Dependencies</div><div class="detail-links">' + depList + '</div></div>';
      if (usedByList) html += '<div class="detail-subsection"><div class="detail-subtitle">Used By</div><div class="detail-links">' + usedByList + '</div></div>';
      html += '</div>';
    }
    if (readers || writers || storesIn || data.durability || data.consistency) {
      html += '<div class="detail-section"><div class="detail-label">State</div>';
      if (readers) html += '<div class="detail-subsection"><div class="detail-subtitle">Readers</div><div class="detail-links">' + readers + '</div></div>';
      if (writers) html += '<div class="detail-subsection"><div class="detail-subtitle">Writers</div><div class="detail-links">' + writers + '</div></div>';
      if (storesIn) html += '<div class="detail-subsection"><div class="detail-subtitle">Stored In</div>' + storesIn + '</div>';
      if (data.durability || data.consistency) {
        html += '<div class="detail-subsection"><div class="detail-subtitle">Behavior</div><div class="detail-links">';
        if (data.durability) html += '<span class="detail-type-badge">' + data.durability + '</span>';
        if (data.consistency) html += '<span class="detail-type-badge">' + data.consistency + '</span>';
        html += '</div></div>';
      }
      html += '</div>';
    }
    if (healthCriteria) html += '<div class="detail-section"><div class="detail-label">Health</div><div class="detail-subsection"><div class="detail-subtitle">Healthy When</div><ul class="detail-list">' + healthCriteria + '</ul></div></div>';
    if (scenarioList) html += '<div class="detail-section"><div class="detail-label">Risks</div><div class="detail-subsection"><div class="detail-subtitle">Failure Scenarios</div><ul class="detail-list">' + scenarioList + '</ul></div></div>';
    if (monitoringList) html += '<div class="detail-section"><div class="detail-label">Monitoring</div><ul class="detail-list">' + monitoringList + '</ul></div>';
    if (gapList) html += '<div class="detail-section"><div class="detail-label">Gaps</div><ul class="detail-list">' + gapList + '</ul></div>';
    if (storyList || modules) {
      html += '<div class="detail-section"><div class="detail-label">References</div>';
      if (storyList) html += '<div class="detail-subsection"><div class="detail-subtitle">Appears In Stories</div><div class="detail-links">' + storyList + '</div></div>';
      if (modules) html += '<div class="detail-subsection"><div class="detail-subtitle">Files</div>' + modules + '</div>';
      html += '</div>';
    }

    panelDetail.innerHTML = html;

    panelDetail.querySelectorAll('.detail-dep').forEach(link => {
      link.addEventListener('click', () => {
        const nodeId = link.dataset.node;
        const comp = allCompData[nodeId];
        if (comp) showNodeDetail(comp, allRefs);
      });
    });
    panelDetail.querySelectorAll('.detail-scenario-link').forEach((link) => {
      link.addEventListener('click', () => {
        const scenarioId = link.dataset.scenario;
        if (scenarioId) showFailureScenarioDetail(scenarioId, data.id);
      });
    });

    openDrawer('detail');
  }

  function showFailureScenarioDetail(scenarioId, originNodeId = '') {
    const scenario = (atlasDetailData.failureScenarioById || {})[scenarioId];
    if (!scenario) return;
    const startsAt = (scenario.starts_at || []).map((id) => '<span class="detail-link">' + labelFor(id) + '</span>').join(' ');
    const involves = (scenario.involves || []).map((id) => '<span class="detail-link">' + labelFor(id) + '</span>').join(' ');
    const chain = (scenario.chain || []).map((step, index) =>
      '<li><div class="detail-chain-step"><span class="detail-chain-index">' + (index + 1) + '</span><div><div class="detail-chain-line"><strong>' + labelFor(step.from) + '</strong> → <strong>' + labelFor(step.to) + '</strong></div>'
      + (step.effect ? '<div class="detail-note">' + step.effect + '</div>' : '')
      + '</div></div></li>'
    ).join('');
    const impacts = (scenario.user_visible_impact || []).map((item) => '<li>' + item + '</li>').join('');
    const mitigations = (scenario.mitigations || []).map((item) => '<li>' + item + '</li>').join('');
    const gaps = (scenario.gaps || []).map((item) => '<li>' + item + '</li>').join('');
    const signals = (scenario.signals || []).map((item) => '<span class="detail-type-badge">' + item + '</span>').join('');
    const grounded = (scenario.grounded_in || []).map((item) => '<code style="font-size:.7rem;color:var(--accent);display:block;padding:.1rem 0;">' + item + '</code>').join('');

    let html = '<div class="detail-header">';
    if (originNodeId) html += '<button class="detail-back-link" data-node="' + originNodeId + '">← Back to component</button>';
    html += '<div class="detail-name">' + (scenario.name || scenario.id) + '</div>';
    html += '<div class="detail-type"><span class="detail-type-badge">' + (scenario.scope || 'failure scenario') + '</span></div>';
    html += '</div>';
    if (scenario.degraded_mode) html += '<div class="detail-desc">' + scenario.degraded_mode + '</div>';
    if (startsAt || involves) {
      html += '<div class="detail-section"><div class="detail-label">Scope</div>';
      if (startsAt) html += '<div class="detail-subsection"><div class="detail-subtitle">Starts At</div><div class="detail-links">' + startsAt + '</div></div>';
      if (involves) html += '<div class="detail-subsection"><div class="detail-subtitle">Involves</div><div class="detail-links">' + involves + '</div></div>';
      html += '</div>';
    }
    if (chain) html += '<div class="detail-section"><div class="detail-label">Cascade Chain</div><ol class="detail-list detail-chain-list">' + chain + '</ol></div>';
    if (signals) html += '<div class="detail-section"><div class="detail-label">Signals</div><div class="detail-links">' + signals + '</div></div>';
    if (impacts) html += '<div class="detail-section"><div class="detail-label">User / Operator Impact</div><ul class="detail-list">' + impacts + '</ul></div>';
    if (mitigations) html += '<div class="detail-section"><div class="detail-label">Mitigations</div><ul class="detail-list">' + mitigations + '</ul></div>';
    if (gaps) html += '<div class="detail-section"><div class="detail-label">Gaps</div><ul class="detail-list">' + gaps + '</ul></div>';
    if (grounded) html += '<div class="detail-section"><div class="detail-label">Grounded In</div>' + grounded + '</div>';

    panelDetail.innerHTML = html;
    panelDetail.querySelectorAll('.detail-back-link').forEach((btn) => {
      btn.addEventListener('click', () => {
        const nodeId = btn.dataset.node;
        const comp = allCompData[nodeId];
        if (comp) showNodeDetail(comp, allRefs);
      });
    });
    openDrawer('detail');
  }

  // Tooltip element for graph hover
  const graphTooltip = document.createElement('div');
  graphTooltip.className = 'graph-tooltip';
  graphTooltip.style.cssText = 'position:fixed;z-index:9999;pointer-events:none;opacity:0;transition:opacity 0.15s;max-width:260px;padding:8px 12px;border-radius:8px;background:rgba(12,12,14,0.95);border:1px solid rgba(129,140,248,0.3);color:#e4e4e7;font:12px/1.5 Inter,sans-serif;backdrop-filter:blur(8px);box-shadow:0 4px 20px rgba(0,0,0,0.5);';
  document.body.appendChild(graphTooltip);

  async function initGraph(container) {
    const data = JSON.parse(container.dataset.graph);
    const refs = JSON.parse(container.dataset.refs || '{}');
    const childMap = buildChildMap(data.nodes || []);
    const expandedGroups = {};

    function buildElements() {
      const collapsedNodes = new Set(
        Object.entries(expandedGroups)
          .filter(([, expanded]) => expanded === false)
          .map(([nodeId]) => nodeId)
      );
      const hiddenNodes = new Set();
      collapsedNodes.forEach((nodeId) => {
        descendantIds(childMap, nodeId).forEach((descendantId) => hiddenNodes.add(descendantId));
      });

      const visibleNodeIds = new Set();
      const elements = [];

      data.nodes.forEach((n) => {
        if (hiddenNodes.has(n.id)) return;
        const collapsed = collapsedNodes.has(n.id);
        const descendantCount = collapsed ? descendantIds(childMap, n.id).length : 0;
        const parentId = !collapsed && n.parent && !hiddenNodes.has(n.parent) && !collapsedNodes.has(n.parent)
          ? n.parent
          : undefined;
        visibleNodeIds.add(n.id);
        elements.push({
          group: 'nodes',
          data: {
            id: n.id,
            label: collapsed ? `${n.name} [${descendantCount}]` : n.name,
            baseLabel: n.name,
            nodeType: n.type,
            childCount: (n.children || []).length,
            parent: parentId,
            collapsed,
            ...n
          }
        });
      });

      data.edges.forEach((e) => {
        if (!visibleNodeIds.has(e.from) || !visibleNodeIds.has(e.to)) return;
        elements.push({ group: 'edges', data: { source: e.from, target: e.to, label: e.label || '', edgeKind: 'explicit' } });
      });

      return elements;
    }

    container._cy = null;
    const isLight = document.documentElement.dataset.theme === 'light';
    const graphTheme = isLight ? {
      edge: 'rgba(63,63,70,0.42)',
      edgeText: 'rgba(39,39,42,0.72)',
      edgeTextBg: 'rgba(255,255,255,0.96)',
      edgeHi: 'rgba(79,70,229,0.72)',
      edgeHover: 'rgba(79,70,229,0.86)',
      parentBg: '#eef2ff',
      parentBorder: 'rgba(79,70,229,0.45)',
      parentText: '#3730a3',
      tooltipTitle: '#4338ca',
      tooltipMeta: '#3f3f46',
    } : {
      edge: 'rgba(255,255,255,0.15)',
      edgeText: 'rgba(255,255,255,0.5)',
      edgeTextBg: '#1c1c22',
      edgeHi: 'rgba(129,140,248,0.6)',
      edgeHover: 'rgba(129,140,248,0.7)',
      parentBg: '#232336',
      parentBorder: 'rgba(196,181,253,0.55)',
      parentText: '#ddd6fe',
      tooltipTitle: '#c4b5fd',
      tooltipMeta: '#a1a1aa',
    };
    const cy = cytoscape({
      container: container,
      elements: buildElements(),
      minZoom: 0.5, maxZoom: 2.5, wheelSensitivity: 0.3,
      style: [
        { selector: 'node', style: {
          'label': 'data(label)', 'text-valign': 'center', 'text-halign': 'center',
          'font-size': '11px', 'font-family': 'Inter, sans-serif', 'font-weight': '500',
          'color': '#fff', 'text-wrap': 'wrap', 'text-max-width': '120px',
          'width': 'label', 'height': 'label', 'padding': '14px 18px',
          'shape': 'roundrectangle', 'border-width': 1.5, 'border-opacity': 0.8,
          'transition-property': 'opacity, border-width, overlay-opacity',
          'transition-duration': '0.2s',
        }},
        { selector: 'node:parent', style: {
          'shape': 'roundrectangle',
          'background-opacity': 0.14,
          'background-color': graphTheme.parentBg,
          'border-style': 'dashed',
          'border-width': 1.4,
          'border-color': graphTheme.parentBorder,
          'padding': '18px',
          'text-valign': 'top',
          'text-halign': 'center',
          'font-size': '12px',
          'font-weight': '600',
          'color': graphTheme.parentText,
          'text-margin-y': '-8px',
        }},
        { selector: 'node.collapsed-parent', style: {
          'background-opacity': 0.92,
          'background-color': graphTheme.parentBg,
          'border-width': 2,
          'border-style': 'dashed',
          'border-color': graphTheme.parentBorder,
          'compound-sizing-wrt-labels': 'include',
          'min-width': 180,
          'min-height': 56,
          'padding': 18,
          'text-valign': 'center',
          'text-halign': 'center',
          'text-margin-y': 0,
          'color': graphTheme.parentText,
        }},
        { selector: 'edge', style: {
          'width': 1.5, 'line-color': graphTheme.edge,
          'target-arrow-color': graphTheme.edge, 'target-arrow-shape': 'triangle',
          'curve-style': 'bezier', 'arrow-scale': 0.8,
          'label': 'data(label)', 'font-size': '9px', 'font-family': 'Inter, sans-serif',
          'font-weight': '400', 'color': graphTheme.edgeText,
          'text-rotation': 'autorotate',
          'text-background-color': graphTheme.edgeTextBg, 'text-background-opacity': 0.92,
          'text-background-padding': '3px', 'text-background-shape': 'roundrectangle',
          'text-margin-y': -8,
          'transition-property': 'opacity, width, line-color, target-arrow-color',
          'transition-duration': '0.2s',
        }},
        { selector: 'node.selected', style: { 'border-width': 2.5, 'border-opacity': 1, 'overlay-color': '#818cf8', 'overlay-padding': 8, 'overlay-opacity': 0.12 }},
        { selector: 'edge.highlighted', style: { 'width': 2.5, 'line-color': graphTheme.edgeHi, 'target-arrow-color': graphTheme.edgeHi, 'color': graphTheme.edgeText }},
        { selector: 'node.dimmed', style: { 'opacity': 0.25 }},
        { selector: 'edge.dimmed', style: { 'opacity': 0.12 }},
        { selector: 'node.hovered', style: { 'border-width': 2.5, 'border-opacity': 1, 'overlay-color': '#818cf8', 'overlay-padding': 10, 'overlay-opacity': 0.15 }},
        { selector: 'edge.hover-connected', style: { 'width': 3, 'line-color': graphTheme.edgeHover, 'target-arrow-color': graphTheme.edgeHover, 'color': graphTheme.edgeText, 'z-index': 10 }},
      ],
    });

    function applyNodeColors() {
      cy.nodes().forEach(n => {
        const tc = typeColors[n.data('nodeType')] || typeColors.worker;
        n.style({ 'background-color': tc.bg, 'border-color': tc.border, 'color': tc.text });
      });
    }

    function runGraphLayout() {
      const visibleCount = cy.nodes().length;
      const layoutName = visibleCount <= 3 ? 'grid' : visibleCount <= 8 ? 'dagre' : 'cose-bilkent';
      try {
        cy.layout({
          name: layoutName,
          ...(layoutName === 'dagre' ? { rankDir: 'TB', nodeSep: 60, rankSep: 100, edgeSep: 20, spacingFactor: 1.05 } :
              layoutName === 'cose-bilkent' ? { idealEdgeLength: 140, nodeRepulsion: 7000 } :
              { rows: 1, padding: 30 })
        }).run();
      } catch { cy.layout({ name: 'grid', padding: 30 }).run(); }
    }

    function rebuildGraph(preserveViewport = true) {
      const zoom = cy.zoom();
      const pan = { ...cy.pan() };
      const previousPositions = {};
      cy.nodes().forEach((node) => {
        previousPositions[node.id()] = { ...node.position() };
      });
      cy.elements().remove();
      cy.add(buildElements());
      applyNodeColors();
      let appliedPositions = 0;
      let missingPositions = 0;
      cy.nodes().forEach((node) => {
        const previous = previousPositions[node.id()];
        if (previous && typeof previous.x === 'number' && typeof previous.y === 'number') {
          node.position(previous);
          appliedPositions += 1;
        } else {
          missingPositions += 1;
        }
      });
      if (missingPositions > 0 || appliedPositions === 0) {
        runGraphLayout();
      }
      if (preserveViewport) {
        cy.zoom(zoom);
        cy.pan(pan);
      } else {
        cy.fit(undefined, 30);
      }
    }

    applyNodeColors();
    const nodeCount = data.nodes.length;
    const graphId = normalizeGraphId(container.id);
    const savedLayouts = await loadGraphLayouts();
    const savedLayout = savedLayouts[graphId];
    (savedLayout?.collapsed_nodes || []).forEach((nodeId) => {
      expandedGroups[nodeId] = false;
    });
    if (Object.keys(expandedGroups).length) {
      rebuildGraph(false);
    }
    cy.nodes().forEach(n => {
      const tc = typeColors[n.data('nodeType')] || typeColors.worker;
      n.style({ 'background-color': tc.bg, 'border-color': tc.border, 'color': tc.text });
    });
    if (!applySavedPositions(cy, savedLayout)) {
      runGraphLayout();
    }
    cy.fit(undefined, 30);

    cy.on('mouseover', 'node', function(evt) {
      const n = evt.target;
      const connected = n.connectedEdges();
      const neighbors = n.neighborhood().nodes();
      cy.nodes().addClass('dimmed');
      cy.edges().addClass('dimmed');
      n.removeClass('dimmed').addClass('hovered');
      neighbors.removeClass('dimmed');
      connected.removeClass('dimmed').addClass('hover-connected');
      const childCount = Number(n.data('childCount') || 0);
      const desc = n.data('description') || n.data('role') || n.data('nodeType') || '';
      if (desc) {
        graphTooltip.innerHTML = '<strong style="color:' + graphTheme.tooltipTitle + '">' + n.data('label') + '</strong>'
          + (childCount ? '<br><span style="color:' + graphTheme.tooltipMeta + '">contains ' + childCount + ' subcomponent' + (childCount === 1 ? '' : 's') + '</span>' : '')
          + '<br>' + desc;
        graphTooltip.style.opacity = '1';
      }
    });

    cy.on('mousemove', 'node', function(evt) {
      const pos = evt.originalEvent;
      if (pos) {
        graphTooltip.style.left = (pos.clientX + 14) + 'px';
        graphTooltip.style.top = (pos.clientY + 14) + 'px';
      }
    });

    cy.on('mouseout', 'node', function() {
      cy.nodes().removeClass('dimmed hovered');
      cy.edges().removeClass('dimmed hover-connected');
      graphTooltip.style.opacity = '0';
    });

    cy.on('tap', 'node', function(evt) {
      const n = evt.target;
      const d = n.data();
      if (Number(d.childCount || 0) > 0) {
        expandedGroups[d.id] = Boolean(d.collapsed);
        rebuildGraph(true);
        cy.nodes().removeClass('selected');
        cy.edges().removeClass('highlighted');
        scheduleGraphLayoutSave(graphId, {
          positions: captureGraphPositions(cy),
          collapsed_nodes: Object.entries(expandedGroups).filter(([, expanded]) => expanded === false).map(([nodeId]) => nodeId),
        });
        return;
      }
      cy.nodes().removeClass('selected');
      cy.edges().removeClass('highlighted');
      n.addClass('selected');
      n.connectedEdges().addClass('highlighted');
      showNodeDetail(d, refs);
    });

    cy.on('tap', function(evt) {
      if (evt.target === cy) {
        cy.nodes().removeClass('selected');
        cy.edges().removeClass('highlighted');
        closeDrawer();
      }
    });

    cy.on('dragfree', 'node', function() {
      scheduleGraphLayoutSave(graphId, {
        positions: captureGraphPositions(cy),
        collapsed_nodes: Object.entries(expandedGroups).filter(([, expanded]) => expanded === false).map(([nodeId]) => nodeId),
      });
    });

    container._cy = cy;
  }

  // Lazy-load Cytoscape when graph sections enter viewport
  let cyLoaded = false;
  const graphObserver = new IntersectionObserver(entries => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const el = entry.target;
      graphObserver.unobserve(el);

      function init() {
        if (typeof cytoscape === 'undefined') { setTimeout(init, 150); return; }
        initGraph(el);
      }

      if (!cyLoaded) {
        cyLoaded = true;
        const libs = [
          'https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js',
          'https://unpkg.com/dagre@0.8.5/dist/dagre.min.js',
          'https://unpkg.com/cytoscape-dagre@2.5.0/cytoscape-dagre.js',
        ];
        let loaded = 0;
        libs.forEach(src => {
          const s = document.createElement('script');
          s.src = src;
          s.onload = () => { loaded++; if (loaded === libs.length) init(); };
          document.head.appendChild(s);
        });
      } else {
        init();
      }
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.struct-graph').forEach(g => graphObserver.observe(g));

  setTimeout(() => {
    if (typeof cytoscape === 'undefined') return;
    document.querySelectorAll('.struct-graph').forEach(g => {
      if (g._cy) return;
      const rect = g.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) initGraph(g);
    });
  }, 2000);

  document.addEventListener('scrollend', () => {
    if (typeof cytoscape === 'undefined') return;
    document.querySelectorAll('.struct-graph').forEach(g => {
      if (g._cy) return;
      const rect = g.getBoundingClientRect();
      if (rect.top < window.innerHeight && rect.bottom > 0) initGraph(g);
    });
  }, { passive: true });

  // ─── Focus mode ───
  const focusOverlay = document.getElementById('focus-overlay');
  const focusContent = document.getElementById('focus-content');
  const focusClose = document.getElementById('focus-close');
  const focusPrev = document.getElementById('focus-prev');
  const focusNext = document.getElementById('focus-next');
  const focusPos = document.getElementById('focus-pos');
  let focusIndex = 0;
  let focusSections = [];

  function getFocusSections() {
    return [
      document.getElementById('chapter0'),
      ...document.querySelectorAll(`.journey-section[data-journey="${currentJourneyId}"]`)
    ].filter(Boolean);
  }

  function openFocus(sectionId) {
    focusSections = getFocusSections();
    const section = document.getElementById(sectionId);
    focusIndex = focusSections.indexOf(section);
    if (focusIndex < 0) focusIndex = 0;
    renderFocus();
    focusOverlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    refreshFocusGraphs();
  }

  function refreshFocusGraphs() {
    const attemptResize = () => {
      focusContent.querySelectorAll('.struct-graph').forEach(g => {
        if (!g._cy) return;
        g._cy.resize();
        g._cy.center();
        g._cy.fit(undefined, 20);
      });
    };

    requestAnimationFrame(() => {
      requestAnimationFrame(attemptResize);
    });
    setTimeout(attemptResize, 120);
    setTimeout(attemptResize, 320);
  }

  function renderFocus() {
    const section = focusSections[focusIndex];
    if (!section) return;
    const inner = section.querySelector('.snap-inner');
    focusContent.innerHTML = inner.innerHTML;
    focusContent.querySelectorAll('.focus-btn').forEach(b => b.remove());
    focusContent.querySelectorAll('.struct-graph').forEach(g => {
      g.innerHTML = '';
      delete g._cy;
      g.removeAttribute('style');
      g.id = 'focus-' + g.id;
      setTimeout(() => {
        if (typeof cytoscape !== 'undefined') {
          initGraph(g);
          refreshFocusGraphs();
        }
      }, 100);
    });
    focusPos.textContent = (focusIndex + 1) + ' / ' + focusSections.length;
    focusPrev.disabled = focusIndex === 0;
    focusNext.disabled = focusIndex === focusSections.length - 1;
    focusOverlay.scrollTop = 0;
  }

  document.querySelectorAll('.focus-btn').forEach(btn => {
    btn.addEventListener('click', () => openFocus(btn.dataset.focus));
  });
  fabMenu?.querySelectorAll('[data-fab-action]').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.stopPropagation();
      const action = btn.dataset.fabAction;
      if (action === 'ask') {
        closeFabMenu();
        openDrawer('terminal');
        return;
      }
      if (action === 'focus') {
        closeFabMenu();
        openFocus(getCurrentSectionElement()?.id || 'chapter0');
        return;
      }
    });
  });

  focusPrev.addEventListener('click', () => { if (focusIndex > 0) { focusIndex--; renderFocus(); } });
  focusNext.addEventListener('click', () => { if (focusIndex < focusSections.length - 1) { focusIndex++; renderFocus(); } });

  focusClose.addEventListener('click', () => {
    focusOverlay.classList.remove('open');
    document.body.style.overflow = '';
    focusContent.innerHTML = '';
  });

  document.addEventListener('keydown', e => {
    if (!focusOverlay.classList.contains('open')) return;
    if (e.key === 'Escape') focusClose.click();
    if (e.key === 'ArrowLeft' || e.key === 'h') focusPrev.click();
    if (e.key === 'ArrowRight' || e.key === 'l') focusNext.click();
  });

  window.addEventListener('resize', () => {
    if (!focusOverlay.classList.contains('open')) return;
    refreshFocusGraphs();
  });

  // ─── Journey switching ───
  function switchJourney(jid) {
    currentJourneyId = jid;
    document.querySelectorAll('.journey-section').forEach(s => {
      s.classList.toggle('hidden', s.dataset.journey !== currentJourneyId);
    });
    document.querySelectorAll('[data-journey-overview]').forEach(o => {
      o.classList.toggle('hidden', o.dataset.journeyOverview !== currentJourneyId);
    });

    const overviewGraph = document.getElementById('atlas-overview');
    if (overviewGraph && overviewGraph._cy) {
      const cy = overviewGraph._cy;
      const relevantNodes = new Set();
      document.querySelectorAll(`.journey-section[data-journey="${currentJourneyId}"] .ref`).forEach(r => {
        relevantNodes.add(r.dataset.id);
      });
      document.querySelectorAll(`.journey-section[data-journey="${currentJourneyId}"] .struct-graph`).forEach(g => {
        try { const data = JSON.parse(g.dataset.graph); data.nodes.forEach(n => relevantNodes.add(n.id)); } catch {}
      });
      if (relevantNodes.size > 0) {
        cy.nodes().forEach(n => { n.style('opacity', relevantNodes.has(n.data('id')) ? 1 : 0.2); });
        cy.edges().forEach(e => {
          const srcRelevant = relevantNodes.has(e.data('source'));
          const tgtRelevant = relevantNodes.has(e.data('target'));
          e.style('opacity', srcRelevant && tgtRelevant ? 1 : 0.1);
        });
      } else {
        cy.elements().style('opacity', 1);
      }
    }

    const startBtn = document.getElementById('start-btn');
    if (startBtn) startBtn.href = '#' + currentJourneyId + '-s1';

    const activeJourneyLabel = jnPicker?.querySelector('.jn-pick-active')?.textContent?.trim();
    document.querySelectorAll('.journey-switch-btn').forEach((btn) => {
      const activePick = jnPicker?.querySelector(`.jn-pick[data-journey="${currentJourneyId}"]`);
      btn.textContent = activePick?.textContent?.trim() || activeJourneyLabel || btn.textContent || '';
    });
    document.querySelectorAll('.landing-journey-btn').forEach((btn) => {
      btn.classList.toggle('primary', btn.dataset.journey === currentJourneyId);
    });

    currentObs = setupObserver();
    document.getElementById('chapter0')?.scrollIntoView({ behavior: 'smooth' });

    document.querySelectorAll(`.journey-section[data-journey="${currentJourneyId}"] .struct-graph`).forEach(g => {
      if (!g._cy) graphObserver.observe(g);
    });
  }

  document.querySelectorAll('.landing-journey-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const jid = btn.dataset.journey;
      if (jid !== currentJourneyId) {
        e.preventDefault();
        switchJourney(jid);
        document.getElementById('chapter0')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  // ─── Bold ref clicks → open node detail in drawer ───
  const allCompData = JSON.parse(document.getElementById('comp-data')?.textContent || '{}');
  const allRefs = JSON.parse(document.getElementById('refs-data')?.textContent || '{}');
  const allSymbolData = JSON.parse(document.getElementById('symbol-data')?.textContent || '{}');

  document.addEventListener('click', e => {
    const ref = e.target.closest('.ref');
    if (!ref) return;
    const refKind = ref.dataset.kind || 'atlas';
    if (refKind === 'symbol') {
      const symbolName = ref.dataset.symbol;
      const symbol = allSymbolData[symbolName];
      if (symbol) showSymbolDetail(symbol);
      return;
    }
    const nodeId = ref.dataset.id;
    const comp = allCompData[nodeId];
    if (comp) showNodeDetail(comp, allRefs);
  });

  document.addEventListener('click', e => {
    const link = e.target.closest('.flow-node-link');
    if (!link) return;
    const nodeId = link.dataset.node;
    const comp = allCompData[nodeId];
    if (comp) showNodeDetail(comp, allRefs);
  });
</script>
