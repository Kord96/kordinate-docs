---
/**
 * Focus overlay — fullscreen story view with prev/next navigation.
 */
---

<div class="focus-overlay" id="focus-overlay">
  <div class="focus-header">
    <div class="focus-nav">
      <button class="focus-nav-btn" id="focus-prev" title="Previous story">← Prev</button>
      <span class="focus-pos" id="focus-pos"></span>
      <button class="focus-nav-btn" id="focus-next" title="Next story">Next →</button>
    </div>
    <button class="focus-close" id="focus-close">✕ Close</button>
  </div>
  <div class="focus-content" id="focus-content"></div>
</div>
