---
/**
 * Chapter 0 — Overview with atlas graph and journey overviews.
 */
interface Props {
  atlas: any;
  journeys: any[];
  defaultJourney: any;
  storyByNode: Record<string, string[]>;
  parseSummary: (text: string) => string;
}

const { atlas, journeys, defaultJourney, storyByNode, parseSummary } = Astro.props;
const components = atlas.components || [];
const componentIds = new Set(components.map((c: any) => c.id));
const flowEdges = (atlas.flows || []).flatMap((flow: any) => {
  const steps = flow.steps || [];
  const derived: { from: string; to: string; label: string }[] = [];
  for (let i = 0; i < steps.length - 1; i += 1) {
    const from = String(steps[i]?.component || '').trim();
    const to = String(steps[i + 1]?.component || '').trim();
    if (!from || !to || from === to) continue;
    if (!componentIds.has(from) || !componentIds.has(to)) continue;
    derived.push({ from, to, label: flow.name || flow.id || 'flow' });
  }
  return derived;
});
const dependencyEdges = components.flatMap((c: any) =>
  (c.depends_on || [])
    .filter((d: string) => componentIds.has(d))
    .map((d: string) => ({ from: c.id, to: d, label: 'depends on' }))
);
const overviewEdges = Array.from(
  new Map(
    [...dependencyEdges, ...flowEdges].map((edge) => [
      `${edge.from}->${edge.to}`,
      edge,
    ])
  ).values()
);
---

<section class="snap" id="chapter0">
  <div class="snap-inner ch0">
    <div class="ch0-header">
      <div class="story-num">Overview</div>
      <h2 class="story-title">How it works</h2>
    </div>

    <div class="struct">
      <div class="struct-graph" id="atlas-overview" data-graph={JSON.stringify({
        nodes: components.map((c: any) => ({
          id: c.id, name: c.name, type: c.type,
          description: c.description, summary: c.summary || '', depends_on: c.depends_on || [], patterns: c.patterns || [], children: c.children || [], parent: c.parent || ''
        })),
        edges: overviewEdges
      })} data-refs={JSON.stringify(storyByNode)}></div>
      <div class="struct-hint">click a node to explore</div>
    </div>

    <div class="ch0-text" id="ch0-overview">
      {journeys.map((j: any) => (
        <div class={`ch0-journey-overview ${j.id === defaultJourney.id ? '' : 'hidden'}`} data-journey-overview={j.id}>
          <div class="ch0-journey-title">{j.title}</div>
          {j.overview && j.overview.split(/\.\s+/).filter(Boolean).map((sentence: string, i: number) => (
            <div class="ch0-point">
              <span class="ch0-dot">{i + 1}</span>
              <span set:html={parseSummary(`${sentence.trim()}${sentence.trim().endsWith('.') ? '' : '.'}`)} />
            </div>
          ))}
        </div>
      ))}
    </div>

    <div class="next">
      <a href={`#${defaultJourney.id}-s1`}>Begin the journey →</a>
    </div>
  </div>
</section>
