---
/**
 * Story section — teaching-first journey section with one primary explainer,
 * concise thesis/summary, and supporting detail moved into the drawer.
 */
interface Props {
  story: any;
  index: number;
  total: number;
  journeyId: string;
  isDefault: boolean;
  allJourneyTitles?: Record<string, string>;
  bridge?: any;
  compMap: Record<string, any>;
  storyByNode: Record<string, string[]>;
  parseSummary: (text: string) => string;
}

const { story, index, total, journeyId, isDefault, allJourneyTitles = {}, bridge, compMap, storyByNode, parseSummary } = Astro.props;
const anchor = story.anchor;
const html = parseSummary(story.summary || '');
const teachesHtml = parseSummary(story.teaches || '');
const keyTakeaways = (story.observations || []).slice(0, 3);
const inferredPrimaryMode = story.primary_mode
  || ((story.flows || []).length ? 'flow'
    : (story.structures || []).length ? 'structure'
    : (story.rationale || []).length ? 'decision'
    : 'structure');
const supportPayload = encodeURIComponent(JSON.stringify({
  id: story.id,
  title: story.title,
  primaryMode: inferredPrimaryMode,
  teaches: story.teaches || '',
  anchor: story.anchor || null,
  observations: story.observations || [],
  rationale: story.rationale || [],
}));
---

<section class={`snap journey-section ${isDefault ? '' : 'hidden'}`} id={`${journeyId}-s${index+1}`} data-journey={journeyId} data-story-support={supportPayload}>
  <div class="snap-inner">
    {bridge && <div class="bridge">{bridge.text}</div>}

    <div class="story-num">Story {index+1} of {total}</div>
    <h2 class="story-title">
      <button class="story-title-button" type="button" data-story-support-open>
        {story.title}
      </button>
    </h2>
    {story.teaches && <div class="story-thesis" set:html={teachesHtml} />}

    <div class="summary" set:html={html} />

    {keyTakeaways.length > 0 && (
      <div class="story-takeaways">
        <div class="story-block-label">Key Takeaways</div>
        <div class="takeaway-grid">
          {keyTakeaways.map((obs: any) => (
            <div class={`takeaway ${obs.recommendation ? 'takeaway-gap' : ''}`}>
              <div class="takeaway-text" set:html={parseSummary(obs.finding || '')} />
            </div>
          ))}
        </div>
      </div>
    )}

    {(story.structures || []).map((st: any, si: number) => {
      const graphId = `graph-${index}-${si}`;
      const structureNodes = (st.nodes || []).map((n: any) => typeof n === 'string' ? { id: n } : n);
      const explicitIds = structureNodes.map((n: any) => n.id);
      const edgeIds = (st.edges || []).flatMap((e: any) => [e.from, e.to].filter(Boolean));
      const missingIds = edgeIds.filter((id: string) => !explicitIds.includes(id));
      const allNodeIds = [...new Set([...explicitIds, ...missingIds])];
      const structureNodeMap = Object.fromEntries(structureNodes.map((n: any) => [n.id, n]));
      const childToParent = Object.fromEntries(
        structureNodes.flatMap((n: any) =>
          ((n.children || []) as string[])
            .filter((childId: string) => explicitIds.includes(childId))
            .map((childId: string) => [childId, n.id])
        )
      );
      const graphData = JSON.stringify({
        nodes: allNodeIds.map((nid: string) => {
          const c = compMap[nid];
          const stNode = structureNodeMap[nid] || {};
          return {
            id: nid,
            name: c?.name || nid,
            type: c?.type || 'worker',
            description: c?.description || '',
            summary: c?.summary || '',
            depends_on: c?.depends_on || [],
            patterns: c?.patterns || [],
            children: stNode.children || [],
            observation_ids: stNode.observation_ids || [],
            parent: childToParent[nid] || '',
          };
        }),
        edges: (st.edges || []).map((e: any) => ({ from: e.from, to: e.to, label: e.label || '' }))
      });
      const storyRefs = JSON.stringify(storyByNode);
      const structureSupportPayload = encodeURIComponent(JSON.stringify({
        id: st.id || `${story.id}-structure-${si + 1}`,
        storyId: story.id,
        storyTitle: story.title,
        title: st.title || `Structure View ${si + 1}`,
        summary: st.summary || story.summary || '',
        teaches: story.teaches || '',
        nodes: allNodeIds.map((nid: string) => ({
          id: nid,
          name: compMap[nid]?.name || nid,
          type: compMap[nid]?.type || 'worker',
        })),
        edges: (st.edges || []).map((e: any) => ({ from: e.from, to: e.to, label: e.label || '' })),
      }));
      return (
        <div class="struct" data-struct-support={structureSupportPayload}>
          <div class="struct-graph" id={graphId} data-graph={graphData} data-refs={storyRefs}></div>
          <div class="struct-hint">
            <button class="struct-hint-button" type="button" data-struct-support-open>
              About this graph
            </button>
            <span class="struct-hint-sep">•</span>
            <span>click a node to explore</span>
          </div>
        </div>
      );
    })}

    {(story.flows || []).map((fl: any, fi: number) => {
      const steps = fl.steps || [];
      const finalStep = steps.length ? steps[steps.length - 1] : null;
      const flowOutcome = finalStep ? (finalStep.effect || finalStep.action || '') : '';
      const flowTrigger = fl.trigger || '';
      const flowSupportPayload = encodeURIComponent(JSON.stringify({
        id: fl.id || `${story.id}-flow-${fi + 1}`,
        storyId: story.id,
        storyTitle: story.title,
        title: fl.title || `Flow ${fi + 1}`,
        summary: fl.summary || '',
        trigger: flowTrigger,
        outcome: flowOutcome,
        severity: fl.severity || '',
        detection: fl.detection || [],
        recovery: fl.recovery || [],
        steps,
      }));
      return (
        <div class="flow" data-flow-support={flowSupportPayload}>
          {!(fi === 0 && (inferredPrimaryMode === 'flow' || inferredPrimaryMode === 'failure' || inferredPrimaryMode === 'state')) && (
            <div class="story-block-label">Supporting Flow</div>
          )}
          {fl.title && (
            <div class="flow-head">
              <button class="flow-head-button" type="button" data-flow-support-open>
                {fl.title}
              </button>
            </div>
          )}
          <div class="flow-frame">
            {flowTrigger && (
              <div class="flow-frame-card">
                <div class="flow-meta-label">Trigger</div>
                <div class="flow-frame-text">{flowTrigger}</div>
              </div>
            )}
            {flowOutcome && (
              <div class="flow-frame-card">
                <div class="flow-meta-label">Outcome</div>
                <div class="flow-frame-text">{flowOutcome}</div>
              </div>
            )}
          </div>
          <div class="flow-steps-label">Flow Stages</div>
          <div class="flow-steps">
            {steps.map((step: any, si: number) => (
              <div class={`flow-step ${step.to && step.to !== step.node ? 'flow-step-crossing' : ''}`}>
                <div class="flow-stage-rail" aria-hidden="true">
                  <span class="flow-n">{si+1}</span>
                  {si < steps.length - 1 && <span class="flow-stage-line"></span>}
                </div>
                <div class="flow-step-body">
                  <div class="flow-route">
                    <span class="flow-segment flow-segment-source">
                      <span class="flow-segment-label">From</span>
                      <button class="flow-segment-name flow-node-link" type="button" data-node={step.node}>
                        {compMap[step.node]?.name || step.node}
                      </button>
                    </span>
                    {step.action && (
                      <span class="flow-segment flow-segment-action">
                        <span class="flow-segment-label">Action</span>
                        <span class="flow-segment-name">{step.action}</span>
                      </span>
                    )}
                    {step.to && (
                      <span class={`flow-segment flow-segment-target ${step.to !== step.node ? 'flow-segment-target-crossing' : ''}`}>
                        <span class="flow-segment-label">To</span>
                        <button class="flow-segment-name flow-node-link" type="button" data-node={step.to}>
                          {compMap[step.to]?.name || step.to}
                        </button>
                      </span>
                    )}
                    {step.effect && (
                      <span class="flow-segment flow-segment-outcome">
                        <span class="flow-segment-label">Outcome</span>
                        <span class="flow-segment-name">{step.effect}</span>
                      </span>
                    )}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      );
    })}

    <div class="next">
      {index < total - 1
        ? <a href={`#${journeyId}-s${index+2}`}>Next →</a>
        : <a href="#s0">↑ Start</a>
      }
    </div>
  </div>
</section>
