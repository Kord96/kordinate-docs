---
/**
 * Bottom drawer — detail panel + terminal panel.
 * Includes the floating terminal button (FAB).
 */
interface Props {
  projectLabel: string;
}

const { projectLabel } = Astro.props;
---

<button class="fab" id="fab" title="Open story actions (⌘K)"><svg width="20" height="18" viewBox="0 0 20 18" fill="none"><rect x="0.5" y="0.5" width="19" height="17" rx="3" stroke="currentColor" stroke-width="1.2"/><path d="M4 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M4 5l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
<div class="fab-menu" id="fab-menu" aria-label="Story actions">
  <button class="fab-menu-item" type="button" data-fab-action="focus">Focus</button>
  <button class="fab-menu-item" type="button" data-fab-action="journey">Switch Narrative</button>
  <button class="fab-menu-item" type="button" data-fab-action="evidence">Evidence</button>
  <button class="fab-menu-item" type="button" data-fab-action="decisions">Decisions</button>
  <button class="fab-menu-item" type="button" data-fab-action="terminal">Terminal</button>
</div>

<div id="drawer">
  <div class="drawer-tabs">
    <button class="drawer-tab active" data-panel="detail">Detail</button>
    <button class="drawer-tab" data-panel="terminal">Terminal</button>
    <button class="drawer-close" id="drawer-close">✕</button>
  </div>
  <div class="drawer-body">
    <div class="drawer-panel active" id="panel-detail">
      <div style="color: var(--text-4); font-size: .8rem; font-style: italic;">Click a component name or graph node to see details.</div>
    </div>
    <div class="drawer-panel" id="panel-terminal">
      <div class="term-input-row">
        <span class="term-prompt">›_</span>
        <input class="term-field" id="term-field" placeholder={`Ask about ${projectLabel}...`} />
      </div>
      <div class="term-output" id="term-output">Powered by Claude Code — ask about architecture, components, flows, or decisions.</div>
    </div>
  </div>
</div>
