---
/**
 * Bottom drawer — detail panel + ask panel.
 * Includes the floating story actions button (FAB).
 */
interface Props {
  projectLabel: string;
}

const { projectLabel } = Astro.props;
---

<button class="fab" id="fab" title="Open story actions (⌘K)" aria-label="Open story actions">
  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
    <rect x="3" y="3" width="5" height="5" rx="1.3" fill="currentColor"/>
    <rect x="12" y="3" width="5" height="5" rx="1.3" fill="currentColor"/>
    <rect x="3" y="12" width="5" height="5" rx="1.3" fill="currentColor"/>
    <rect x="12" y="12" width="5" height="5" rx="1.3" fill="currentColor"/>
  </svg>
</button>
<div class="fab-menu" id="fab-menu" aria-label="Story actions">
  <button class="fab-menu-item" type="button" data-fab-action="focus">
    <span class="fab-menu-icon" aria-hidden="true">⛶</span>
    <span>Focus</span>
  </button>
  <div class="fab-menu-group" id="fab-journey-group" hidden>
    <div class="fab-menu-group-label">Narratives</div>
    <div class="fab-menu-journeys" id="fab-journeys"></div>
  </div>
  <button class="fab-menu-item" type="button" data-fab-action="ask">
    <span class="fab-menu-icon" aria-hidden="true">⌘</span>
    <span>Ask</span>
  </button>
</div>

<div id="drawer">
  <div class="drawer-tabs">
    <button class="drawer-tab active" data-panel="detail">Detail</button>
    <button class="drawer-tab" data-panel="terminal">Ask</button>
    <button class="drawer-close" id="drawer-close">✕</button>
  </div>
  <div class="drawer-body">
    <div class="drawer-panel active" id="panel-detail">
      <div style="color: var(--text-4); font-size: .8rem; font-style: italic;">Click a component, graph node, or story title to inspect details.</div>
    </div>
    <div class="drawer-panel" id="panel-terminal">
      <div class="term-input-row">
        <span class="term-prompt">›_</span>
        <input class="term-field" id="term-field" placeholder={`Ask about ${projectLabel}...`} />
      </div>
      <div class="term-output" id="term-output">Powered by Claude Code — ask about architecture, components, flows, or decisions.</div>
    </div>
  </div>
</div>
