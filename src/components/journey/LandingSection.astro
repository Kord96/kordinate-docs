---
/**
 * Landing section — hero with project name, purpose, and stats.
 */
interface Props {
  project: string;
  purpose: string;
  journeys: any[];
  defaultJourney: any;
  totalStories: number;
  domainModel?: any;
}

const { project, purpose, journeys, defaultJourney, totalStories, domainModel } = Astro.props;
const dm = domainModel || {};
const [owner, repo] = String(project || '').split('/');
const landingTitle = owner && repo ? repo : project;
---

<section class="snap" id="s0">
  <div class="snap-inner landing">
    <h1>{landingTitle}</h1>
    <p class="landing-sub">{purpose}</p>
    {dm.primary && (
      <div class="landing-badge">
        ◆ {dm.primary} · {dm.entities?.length || 0} entities · {dm.relationships?.length || 0} relationships
      </div>
    )}
    <a class="landing-cta" href="#chapter0">Open narrative overview →</a>
    <div class="landing-stats">
      <span>{Astro.props.componentCount || '?'} components</span>
      <span>{Astro.props.flowCount || '?'} flows</span>
      <span>{totalStories} stories</span>
      <span>~{Math.ceil(totalStories * 1.5)} min</span>
    </div>
  </div>
</section>
