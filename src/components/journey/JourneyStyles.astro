---
/**
 * All CSS for journey pages — scroll-snap, nav, stories, graphs, drawer, focus mode.
 * Import this component to get all journey styles.
 */
---

  <style is:global slot="head">
    html { scroll-snap-type: y mandatory; scroll-behavior: smooth; }

    /* ─── Journey bar (below header, sticky) ─── */
    /* ─── Bottom pill nav ─── */
    .journey-nav {
      position: fixed; bottom: 1.25rem; left: 50%; transform: translateX(-50%);
      z-index: 1200; display: flex; align-items: center; gap: 2px;
      background: rgba(9,9,11,0.92); backdrop-filter: blur(16px) saturate(180%);
      border: 1px solid var(--border-hover); border-radius: 99px; padding: 3px;
      max-width: 90vw; overflow: visible; scrollbar-width: none;
      opacity: 0; transform: translateX(-50%) translateY(20px);
      transition: opacity .3s, transform .3s;
    }
    .journey-nav.visible { opacity: 1; transform: translateX(-50%) translateY(0); }
    .journey-nav.page-menu-open { opacity: 1; transform: translateX(-50%) translateY(0); }
    .journey-nav::-webkit-scrollbar { display: none; }
    body.drawer-open .journey-nav {
      z-index: 100 !important;
      opacity: .08;
      pointer-events: none;
    }
    .jn-page-menu {
      flex-shrink: 0;
      position: relative;
      z-index: 260;
    }
    .jn-page-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .35rem;
      border-radius: 99px;
      background: var(--accent-dim);
      border: 1px solid var(--accent-border);
      color: var(--accent);
      min-height: 2rem;
      min-width: 4.75rem;
      padding: .45rem .8rem;
      font-size: .65rem;
      font-weight: 700;
      line-height: 1;
      white-space: nowrap;
      cursor: pointer;
      transition: background .18s, border-color .18s, color .18s;
    }
    .jn-page-button:hover {
      background: rgba(129,140,248,.14);
    }
    .jn-page-caret {
      font-size: .5rem;
      opacity: .7;
    }
    .jn-page-popover {
      position: absolute;
      left: 0;
      bottom: calc(100% + .5rem);
      min-width: 9rem;
      z-index: 280;
      display: none;
      flex-direction: column;
      gap: 2px;
      padding: .3rem;
      border-radius: 14px;
      background: rgba(9,9,11,.96);
      border: 1px solid var(--border-hover);
      box-shadow: 0 12px 28px rgba(0,0,0,.28);
      backdrop-filter: blur(16px) saturate(180%);
    }
    .jn-page-menu.open .jn-page-popover {
      display: flex;
    }
    .jn-page-option {
      text-decoration: none;
      color: var(--accent);
      font-size: .65rem;
      font-weight: 600;
      line-height: 1;
      padding: .55rem .7rem;
      border-radius: 10px;
      white-space: nowrap;
      transition: background .18s, color .18s;
    }
    .jn-page-option:hover {
      background: rgba(129,140,248,.12);
      color: var(--text);
    }
    .jn-page-option-active {
      background: rgba(129,140,248,.14);
      color: var(--text);
    }
    .jn-journey {
      padding: .3rem .6rem; border-radius: 99px;
      font-size: .65rem; font-weight: 500; color: var(--text-4);
      cursor: pointer; transition: all .2s; white-space: nowrap;
      position: relative; line-height: 1;
    }
    .jn-journey:hover { color: var(--text-2); background: rgba(39,39,42,0.6); }
    .jn-journey::after { content: ' ▾'; font-size: .45rem; opacity: .5; vertical-align: middle; }
    .jn-picker {
      position: fixed; z-index: 210;
      background: var(--bg); border: 1px solid var(--border-hover);
      border-radius: 8px; padding: 4px; min-width: 200px;
      display: none; flex-direction: column; gap: 1px;
      box-shadow: 0 -4px 20px rgba(0,0,0,0.4);
    }
    .jn-picker.open { display: flex; }
    .jn-pick {
      padding: .35rem .6rem; border-radius: 6px;
      font-size: .65rem; color: var(--text-3); cursor: pointer;
      transition: all .15s; white-space: nowrap;
    }
    .jn-pick:hover { color: var(--text); background: var(--border); }
    .jn-pick-active { color: var(--accent); }
    #jb-dots {
      display: inline-flex; align-items: center; gap: 2px;
      min-width: 0;
      overflow-x: auto;
      overflow-y: visible;
      scrollbar-width: none;
    }
    #jb-dots::-webkit-scrollbar { display: none; }
    .jb-dot {
      padding: .3rem .6rem; border-radius: 99px;
      font-size: .65rem; font-weight: 500; color: var(--text-4);
      cursor: pointer; transition: all .2s; text-decoration: none;
      white-space: nowrap; line-height: 1;
    }
    .jb-dot:hover { color: var(--text-2); background: rgba(39,39,42,0.6); }
    .jb-dot-active { color: var(--text); background: var(--border-hover); }
    .jb-dot-visited { color: var(--text-3); }

    /* ─── Sections ─── */
    .snap { min-height: 100vh; scroll-snap-align: start; scroll-snap-stop: always; position: relative; }
    .snap-inner {
      max-width: 680px; margin: 0 auto; padding: 90px 1.5rem 120px;
      min-height: 100vh; display: flex; flex-direction: column; justify-content: center;
    }

    /* ─── Landing ─── */
    .landing { text-align: center; }
    .landing h1 {
      font-size: 3.5rem; font-weight: 800; letter-spacing: -.04em;
      background: linear-gradient(135deg, #fff 20%, var(--accent) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      margin-bottom: .75rem;
    }
    [data-theme='light'] .landing h1 {
      background: linear-gradient(135deg, #111827 10%, #3730a3 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .landing-sub { font-size: 1.05rem; color: var(--text-2); line-height: 1.65; max-width: 520px; margin: 0 auto 1.5rem; }
    .landing-badge {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .3rem .8rem; border-radius: 99px; font-size: .75rem;
      background: var(--accent-dim); border: 1px solid var(--accent-border); color: var(--accent);
      margin-bottom: 2.5rem;
    }
    .landing-cta {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .7rem 1.8rem; border-radius: 8px; font-size: .9rem; font-weight: 500;
      background: var(--accent); color: #fff; border: none; cursor: pointer;
      transition: all .2s; text-decoration: none;
    }
    .landing-cta:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(129,140,248,.2); }
    /* ─── Chapter 0 ─── */
    .ch0 { justify-content: flex-start; padding-top: 80px; }
    .ch0-header { margin-bottom: 1rem; }
    .ch0-text { margin-top: 1rem; }
    .ch0-journey-overview.hidden { display: none; }
    .ch0-journey-title { font-size: .8rem; font-weight: 600; color: var(--accent); margin-bottom: .5rem; }
    .ch0-point {
      display: flex; gap: .6rem; align-items: flex-start;
      padding: .4rem 0; font-size: .85rem; color: var(--text-2); line-height: 1.6;
    }
    .ch0-dot {
      width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
      background: var(--accent-dim); color: var(--accent);
      font-size: .65rem; font-weight: 600;
      display: flex; align-items: center; justify-content: center; margin-top: .15rem;
    }
    .ch0-decisions {
      margin-top: 1rem; padding: .75rem 1rem;
      background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius);
    }
    .ch0-decisions-label {
      font-size: .6rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: .1em; color: var(--text-4); margin-bottom: .4rem;
    }
    .ch0-decision {
      font-size: .8rem; color: var(--text-3); line-height: 1.5;
      padding: .2rem 0;
    }

    .landing-overview {
      font-size: .9rem; color: var(--text-2); line-height: 1.65;
      max-width: 560px; margin: 0 auto 1rem; text-align: left;
    }
    .landing-how {
      font-size: .85rem; color: var(--text-3); line-height: 1.6;
      max-width: 560px; margin: 0 auto 2rem; text-align: left;
      padding: .75rem 1rem; background: var(--bg-raised);
      border: 1px solid var(--border); border-radius: var(--radius);
    }
    .landing-journeys {
      display: flex; gap: .6rem; justify-content: center; flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }
    .landing-journey-btn {
      padding: .6rem 1.4rem; border-radius: 8px; font-size: .85rem; font-weight: 500;
      text-decoration: none; transition: all .2s; cursor: pointer;
      border: 1px solid var(--border); color: var(--text-3);
    }
    .landing-journey-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-dim); }
    .landing-journey-btn.primary {
      background: var(--accent); color: #fff; border-color: var(--accent);
    }
    .landing-journey-btn.primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(129,140,248,.2); }
    .landing-stats {
      margin-top: 1.5rem; display: flex; gap: 1.5rem; justify-content: center;
      font-size: .75rem; color: var(--text-4);
    }
    .landing-switch {
      margin-top: 1.5rem;
    }
    .landing-switch-link {
      font-size: .75rem; color: var(--text-4); text-decoration: none;
      padding: .3rem .8rem; border: 1px solid var(--border); border-radius: 6px;
      transition: all .2s;
    }
    .landing-switch-link:hover {
      color: var(--text-2); border-color: var(--border-hover);
    }

    /* ─── Bridge ─── */
    .bridge {
      text-align: center; max-width: 440px; margin: 0 auto 2.5rem;
      font-size: .9rem; color: var(--text-3); font-style: italic; line-height: 1.6;
      padding: 1rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    }

    /* ─── Story chrome ─── */
    .story-num { font-size: .65rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .4rem; }
    .story-title { font-size: 1.6rem; font-weight: 700; letter-spacing: -.025em; margin-bottom: .4rem; line-height: 1.2; }
    .story-title-button {
      appearance: none; border: none; background: none; padding: 0; margin: 0;
      font: inherit; color: inherit; letter-spacing: inherit; line-height: inherit;
      text-align: left; cursor: pointer;
      transition: color .18s ease, opacity .18s ease;
    }
    .story-title-button:hover { color: var(--accent); }
    .story-title-button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 4px;
      border-radius: 6px;
    }
    .story-thesis { font-size: .88rem; line-height: 1.65; color: var(--text-1); margin-bottom: .85rem; max-width: 46rem; }
    .story-thesis strong { color: var(--text); }
    .story-block-label {
      font-size: .62rem; font-weight: 700; color: var(--text-4); text-transform: uppercase;
      letter-spacing: .1em; margin-bottom: .55rem;
    }
    .story-group { display: inline-block; font-size: .65rem; color: var(--text-4); padding: .15rem .5rem; border: 1px solid var(--border); border-radius: 4px; margin-bottom: 1.25rem; }

    /* ─── Summary ─── */
    .summary { font-size: .9rem; line-height: 1.75; color: var(--text-2); margin-bottom: 1.25rem; }
    .story-takeaways { margin-bottom: 1.1rem; }
    .takeaway-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: .65rem; }
    .takeaway { padding: .75rem .85rem; border: 1px solid var(--border); border-radius: var(--radius); background: var(--bg-card); }
    .takeaway-gap { border-left: 2px solid var(--warn); background: var(--warn-dim); }
    .takeaway-text { color: var(--text); line-height: 1.55; font-size: .82rem; }

    /* ─── Structure ─── */
    .struct { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 1rem; overflow: hidden; }
    .struct > .story-block-label,
    .flow > .story-block-label { padding: .8rem .9rem 0; margin-bottom: .4rem; }
    .struct-head {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding: .75rem .85rem .35rem;
    }
    .struct-head-button {
      appearance: none;
      border: none;
      background: transparent;
      padding: 0;
      margin: 0;
      color: var(--text);
      font: inherit;
      font-size: .82rem;
      font-weight: 700;
      letter-spacing: .01em;
      cursor: pointer;
      text-align: left;
      line-height: 1.35;
      transition: color .18s ease;
    }
    .struct-head-button:hover { color: var(--accent); }
    .struct-head-button:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 3px;
      border-radius: 6px;
    }
    .struct-graph { width: 100%; height: 280px; cursor: grab; }
    .struct-legend {
      display: flex; flex-wrap: wrap; gap: .4rem; padding: .3rem .6rem;
      border-top: 1px solid var(--border); font-size: .6rem; color: var(--text-4);
    }
    .legend-item { display: flex; align-items: center; gap: .25rem; }
    .legend-dot { width: 8px; height: 8px; border-radius: 2px; }
    .struct-graph:active { cursor: grabbing; }
    .flow-summary { color: var(--text-2); font-size: .82rem; line-height: 1.6; margin: 0 0 .75rem; }

    /* ─── Floating terminal button ─── */
    .fab {
      position: fixed; bottom: 1.25rem; right: 1.25rem; z-index: 720;
      width: 44px; height: 44px; border-radius: 12px; border: none;
      background: rgba(129,140,248,.16); color: var(--accent);
      font-size: 1rem; font-weight: 700; cursor: pointer;
      box-shadow: 0 0 16px rgba(129,140,248,.18), 0 4px 12px rgba(0,0,0,.3);
      transition: all .2s; display: flex; align-items: center; justify-content: center;
      font-family: var(--mono);
    }
    .fab:hover { transform: scale(1.05); box-shadow: 0 0 24px rgba(129,140,248,.24), 0 6px 16px rgba(0,0,0,.4); }
    .fab.hidden { display: none; }
    .fab-menu {
      position: fixed; right: 1.25rem; bottom: calc(1.25rem + 52px); z-index: 1210;
      display: none; flex-direction: column; gap: .3rem; min-width: 11rem;
      padding: .45rem; border-radius: 14px; background: var(--bg);
      border: 1px solid var(--border-hover); box-shadow: 0 10px 28px rgba(0,0,0,.28);
      backdrop-filter: blur(16px) saturate(180%);
    }
    .fab-menu.open { display: flex; }
    .fab-menu-item {
      display: inline-flex; align-items: center; justify-content: flex-start; width: 100%;
      min-height: 2.1rem; padding: .5rem .65rem; border: 1px solid transparent;
      border-radius: 10px; background: transparent; color: var(--text-2);
      font-size: .74rem; font-weight: 600; cursor: pointer;
      transition: background .18s, border-color .18s, color .18s;
    }
    .fab-menu-icon {
      width: 1rem; margin-right: .55rem; display: inline-flex; align-items: center; justify-content: center;
      color: var(--accent); font-size: .82rem; line-height: 1;
    }
    .fab-menu-item:hover { background: var(--bg-raised); border-color: var(--border); color: var(--text); }
    .fab-menu-item[hidden] { display: none !important; }
    .fab-menu-group {
      display: flex; flex-direction: column; gap: .35rem;
      padding: .15rem 0 .1rem;
      margin: .1rem 0 .2rem;
      border-top: 1px solid var(--border);
      border-bottom: 1px solid var(--border);
    }
    .fab-menu-group[hidden] { display: none !important; }
    .fab-menu-group-label {
      font-size: .58rem; font-weight: 700; letter-spacing: .11em; text-transform: uppercase;
      color: var(--text-4); padding: .15rem .2rem 0;
    }
    .fab-menu-journeys {
      display: flex; flex-wrap: wrap; gap: .35rem;
      padding: 0 .1rem .2rem;
    }
    .fab-journey-option {
      display: inline-flex; align-items: center; justify-content: center;
      min-height: 1.9rem; padding: .4rem .65rem;
      border-radius: 999px; border: 1px solid var(--border);
      background: var(--bg-raised); color: var(--text-2);
      font-size: .68rem; font-weight: 600; cursor: pointer;
      transition: background .18s, border-color .18s, color .18s, transform .18s;
    }
    .fab-journey-option:hover {
      background: var(--accent-dim); border-color: var(--accent-border); color: var(--text);
      transform: translateY(-1px);
    }
    .fab-journey-option-active {
      background: var(--accent-dim); border-color: var(--accent-border); color: var(--accent);
    }

    /* ─── Bottom Drawer ─── */
    #drawer {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 1000;
      background: var(--bg); border-top: 1px solid var(--border);
      transform: translateY(100%); transition: transform .3s ease;
      height: 280px; display: flex; flex-direction: column;
    }
    #drawer.open { transform: translateY(0); }
    .drawer-tabs {
      display: flex; border-bottom: 1px solid var(--border); padding: 0 1rem;
      align-items: center;
    }
    .drawer-tab {
      padding: .5rem .75rem; font-size: .7rem; font-weight: 500;
      color: var(--text-4); cursor: pointer; border: none; background: none;
      border-bottom: 2px solid transparent; transition: all .2s;
    }
    .drawer-tab:hover { color: var(--text-2); }
    .drawer-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
    .drawer-close {
      margin-left: auto; padding: .3rem .5rem; font-size: .65rem;
      color: var(--text-4); cursor: pointer; border: none; background: none;
      border-radius: 4px;
    }
    .drawer-close:hover { color: var(--text-2); background: var(--bg-raised); }
    .drawer-body { flex: 1; overflow-y: auto; padding: 1rem 1.25rem; }
    .drawer-panel { display: none; }
    .drawer-panel.active { display: block; }

    /* ─── Detail panel ─── */
    .detail-header { margin-bottom: .6rem; }
    .detail-name { font-weight: 700; font-size: 1.05rem; margin-bottom: .25rem; letter-spacing: -.01em; }
    .detail-type {
      font-size: .65rem; color: var(--text-4); text-transform: uppercase;
      letter-spacing: .08em;
      display: flex; gap: .4rem; flex-wrap: wrap; align-items: center;
    }
    .detail-type-badge {
      padding: .15rem .5rem; border-radius: 4px;
      background: var(--accent-dim); color: var(--accent); font-size: .6rem;
    }
    .detail-desc {
      font-size: .85rem; color: var(--text-2); line-height: 1.6; margin-bottom: .75rem;
      padding-bottom: .75rem; border-bottom: 1px solid var(--border);
    }
    .detail-section { margin-bottom: .6rem; }
    .detail-label { font-size: .6rem; font-weight: 600; color: var(--text-4); text-transform: uppercase; letter-spacing: .1em; margin-bottom: .3rem; }
    .detail-links { display: flex; flex-wrap: wrap; gap: .3rem; }
    .detail-link {
      font-size: .72rem; color: var(--accent); cursor: pointer;
      padding: .15rem .5rem; border-radius: 5px; background: var(--accent-dim);
      border: 1px solid transparent; transition: all .15s;
    }
    .detail-link:hover { background: rgba(129,140,248,.15); border-color: var(--accent-border); }
    .detail-list-compact li + li { margin-top: .55rem; }
    .detail-inline-meta { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .35rem; }
    .detail-inline-chip {
      display: inline-flex; align-items: center; min-height: 1.35rem;
      padding: .15rem .45rem; border-radius: 999px; border: 1px solid var(--border);
      background: var(--bg-raised); color: var(--text-3); font-size: .64rem; line-height: 1.2;
    }

    /* ─── Terminal panel ─── */
    .term-input-row { display: flex; align-items: center; gap: .5rem; margin-bottom: .75rem; }
    .term-prompt { color: #fb923c; font-family: var(--mono); font-size: .8rem; font-weight: 600; }
    .term-field {
      flex: 1; background: none; border: none; color: var(--text);
      font-family: var(--font); font-size: .85rem; outline: none;
    }
    .term-field::placeholder { color: var(--text-4); }
    .term-output {
      font-size: .8rem; color: var(--text-3); line-height: 1.6;
      font-style: italic;
    }

    /* ─── Flow ─── */
    .flow { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; margin-bottom: 1rem; }
    .flow-head { font-size: .98rem; font-weight: 700; color: var(--text); margin-bottom: .75rem; letter-spacing: -.01em; }
    .flow-head-button {
      appearance: none; border: 0; background: none; padding: 0;
      color: inherit; font: inherit; letter-spacing: inherit;
      cursor: pointer; text-align: left;
      transition: color .15s ease;
    }
    .flow-head-button:hover { color: var(--accent); }
    .flow-frame {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: .6rem;
      margin-bottom: .95rem;
    }
    .flow-frame-card {
      display: flex; flex-direction: column; gap: .25rem;
      padding: .75rem .85rem; border: 1px solid var(--border);
      border-radius: 14px; background: var(--bg-raised);
    }
    .flow-frame-card-primary {
      background: linear-gradient(180deg, color-mix(in srgb, var(--accent-dim) 55%, var(--bg-raised)), var(--bg-raised));
      border-color: var(--accent-border);
    }
    .flow-frame-text { font-size: .82rem; color: var(--text-2); line-height: 1.55; }
    .flow-steps-label {
      font-size: .58rem; font-weight: 700; color: var(--text-4); text-transform: uppercase;
      letter-spacing: .11em; margin-bottom: .55rem;
    }
    .flow-meta-label { font-size: .58rem; font-weight: 700; color: var(--text-4); text-transform: uppercase; letter-spacing: .1em; }
    .flow-steps {
      display: flex; flex-direction: column; gap: .2rem;
      position: relative;
    }
    .flow-step {
      display: grid; grid-template-columns: 30px minmax(0, 1fr); gap: .75rem;
      padding: .3rem 0 .45rem; font-size: .8rem;
      position: relative;
    }
    .flow-step-crossing .flow-step-body { border-color: var(--accent-border); }
    .flow-stage-rail {
      display: flex; flex-direction: column; align-items: center;
      min-height: 100%; padding-top: .1rem;
    }
