---
/**
 * Bottom pill nav — journey selector dropdown + story dot pills.
 */
interface Props {
  journeys: any[];
  defaultJourney: any;
  stories: any[];
  pageLinks?: { label: string; href: string }[];
  activePage?: string;
}

const { defaultJourney, stories, pageLinks = [], activePage = '' } = Astro.props;
const activePageLink = pageLinks.find((link) => link.label.toLowerCase() === activePage) || pageLinks[0] || null;
---

<div class="jn-picker" id="jn-picker">
  {Astro.props.journeys?.map((j: any) => {
    const label = j.title?.includes(':') ? j.title.split(':')[0].trim() : j.title;
    return <div class={`jn-pick ${j.id === defaultJourney.id ? 'jn-pick-active' : ''}`} data-journey={j.id}>{label}</div>;
  })}
</div>
<nav class="journey-nav" id="journey-nav" data-default-journey={defaultJourney.id}>
  {activePageLink && (
    <div class="jn-page-menu">
      <label class="jn-page-select-wrap">
        <span class="sr-only">Page</span>
        <select class="jn-page-select" onchange="window.location.href=this.value">
          {pageLinks.map((link) => (
            <option value={link.href} selected={activePage === link.label.toLowerCase()}>
              {link.label}
            </option>
          ))}
        </select>
      </label>
    </div>
  )}
  <span id="jb-dots">
    {stories.map((s: any, i: number) => {
      const label = s.title?.includes(':') ? s.title.split(':')[0].trim() : (s.title || `Story ${i+1}`);
      return (
        <a class={`jb-dot ${i === 0 ? 'jb-dot-active' : ''}`} data-index={i + 1} title={s.title}>
          {label}
        </a>
      );
    })}
  </span>
</nav>
