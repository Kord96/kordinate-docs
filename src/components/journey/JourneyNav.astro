---
/**
 * Bottom pill nav — journey selector dropdown + story dot pills.
 */
interface Props {
  journeys: any[];
  defaultJourney: any;
  stories: any[];
  pageLinks?: { label: string; href: string }[];
  activePage?: string;
}

const { defaultJourney, stories, pageLinks = [], activePage = '' } = Astro.props;
const activePageLink = pageLinks.find((link) => link.label.toLowerCase() === activePage) || pageLinks[0] || null;
---

<div class="jn-picker" id="jn-picker">
  {Astro.props.journeys?.map((j: any) => {
    const label = j.title?.includes(':') ? j.title.split(':')[0].trim() : j.title;
    return <div class={`jn-pick ${j.id === defaultJourney.id ? 'jn-pick-active' : ''}`} data-journey={j.id}>{label}</div>;
  })}
</div>
<nav class="journey-nav" id="journey-nav" data-default-journey={defaultJourney.id}>
  {activePageLink && (
    <div class="jn-page-menu">
      <button class="jn-page-button" type="button" aria-haspopup="true" aria-expanded="false">
        <span>{activePageLink.label}</span>
        <span class="jn-page-caret">▾</span>
      </button>
      <div class="jn-page-popover" role="menu">
        {pageLinks.map((link) => (
          <a
            href={link.href}
            class={`jn-page-option ${activePage === link.label.toLowerCase() ? 'jn-page-option-active' : ''}`}
            role="menuitem"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  )}
  <span id="jb-dots">
    {stories.map((s: any, i: number) => {
      const label = s.title?.includes(':') ? s.title.split(':')[0].trim() : (s.title || `Story ${i+1}`);
      return (
        <a class={`jb-dot ${i === 0 ? 'jb-dot-active' : ''}`} data-index={i + 1} title={s.title}>
          {label}
        </a>
      );
    })}
  </span>
</nav>

<script is:inline>
(function() {
  const nav = document.getElementById('journey-nav');
  if (!nav) return;
  const menu = nav.querySelector('.jn-page-menu');
  const button = nav.querySelector('.jn-page-button');
  const popover = nav.querySelector('.jn-page-popover');
  if (!menu || !button || !popover) return;

  function closeMenu() {
    menu.classList.remove('open');
    button.setAttribute('aria-expanded', 'false');
    nav.classList.remove('page-menu-open');
  }

  button.addEventListener('click', (event) => {
    event.stopPropagation();
    const nextOpen = !menu.classList.contains('open');
    if (!nextOpen) {
      closeMenu();
      return;
    }
    menu.classList.add('open');
    button.setAttribute('aria-expanded', 'true');
    nav.classList.add('page-menu-open');
  });

  document.addEventListener('click', (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest('.jn-page-menu')) return;
    closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
})();
</script>
