---
/**
 * Hidden JSON data blobs consumed by JourneyScript.
 */
interface Props {
  atlas: any;
  storyByNode: Record<string, string[]>;
  projectApiPath: string;
}

const { atlas, storyByNode, projectApiPath } = Astro.props;

function uniqueStrings(values: any[]) {
  return [...new Set((values || []).filter((value: any) => typeof value === 'string' && value.length > 0))];
}

const failureScenarioById = Object.fromEntries(
  (atlas.failure_scenarios || []).filter((item: any) => item?.id).map((item: any) => [item.id, item]),
);
const labelsById = Object.fromEntries([
  ...(atlas.components || []).filter((item: any) => item?.id).map((item: any) => [item.id, item.name || item.id]),
  ...(atlas.external_dependencies || []).filter((item: any) => item?.id).map((item: any) => [item.id, item.name || item.id]),
  ...(atlas.flows || []).filter((item: any) => item?.id).map((item: any) => [item.id, item.name || item.id]),
  ...(atlas.state || []).filter((item: any) => item?.id).map((item: any) => [item.id, item.name || item.id]),
]);
const failureScenariosByTarget = (atlas.failure_scenarios || []).reduce((acc: Record<string, any[]>, item: any) => {
  const targets = uniqueStrings([...(item?.starts_at || []), ...(item?.involves || [])]);
  for (const target of targets) {
    acc[target] ||= [];
    acc[target].push({
      id: item.id,
      name: item.name || item.id,
      summary: item.summary || item.degraded_mode || '',
      severity: item.severity || '',
    });
  }
  return acc;
}, {});

const monitoringByTarget = (atlas.monitoring || []).reduce((acc: Record<string, any[]>, item: any) => {
  const targets = uniqueStrings([...(item?.targets || []), ...(item?.covers || []), ...(item?.affects || [])]);
  for (const target of targets) {
    acc[target] ||= [];
    acc[target].push({
      id: item.id,
      name: item.name || item.id,
      summary: item.summary || item.description || '',
    });
  }
  return acc;
}, {});

const gapsByTarget = (atlas.gaps || []).reduce((acc: Record<string, any[]>, item: any) => {
  const targets = uniqueStrings(item?.affects || []);
  for (const target of targets) {
    acc[target] ||= [];
    acc[target].push({
      id: item.id,
      title: item.title || item.name || item.id,
      kind: item.kind || '',
      summary: item.summary || item.description || '',
      recommendation: item.recommendation || '',
    });
  }
  return acc;
}, {});
---

<script id="comp-data" type="application/json" set:html={JSON.stringify(
  Object.fromEntries([
    ...(atlas.components || []).map((c: any) => [c.id, { id: c.id, name: c.name, type: c.type, description: c.description, summary: c.summary || '', purpose: c.purpose || '', depends_on: c.depends_on || [], patterns: c.patterns || [], modules: c.modules || [], children: c.children || [], health: c.health || {} }]),
    ...(atlas.external_dependencies || []).map((e: any) => [e.id, { id: e.id, name: e.name || e.id, type: 'external', description: e.description || '', summary: e.summary || '', depends_on: [], patterns: [], modules: [], children: [], health: e.health || {}, purpose: e.purpose || '', technology: e.technology || '', components: e.components || [] }]),
  ])
)} />
<script id="refs-data" type="application/json" set:html={JSON.stringify(storyByNode)} />
<script id="project-data" type="application/json" set:html={JSON.stringify({ apiBasePath: `/api${projectApiPath}` })} />
<script id="atlas-detail-data" type="application/json" set:html={JSON.stringify({
  failureScenarioById,
  failureScenariosByTarget,
  monitoringByTarget,
  gapsByTarget,
  labelsById,
})} />
