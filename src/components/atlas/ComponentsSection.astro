---
interface Props { components: any[]; embedded?: boolean; }
const { components, embedded = false } = Astro.props;

const roots = components.filter((component: any) => !component.parent);
const childrenByParent = new Map<string, any[]>();
for (const component of components) {
  if (!component.parent) continue;
  if (!childrenByParent.has(component.parent)) childrenByParent.set(component.parent, []);
  childrenByParent.get(component.parent)?.push(component);
}

function linkedComponents(ids: string[] = []) {
  return ids
    .map((id) => components.find((component: any) => component.id === id))
    .filter(Boolean);
}

function groundedRefs(component: any) {
  const values = component?.grounded_in || component?.modules || [];
  return Array.isArray(values) ? values.slice(0, 6) : [];
}

function list(values: any): string[] {
  return Array.isArray(values) ? values.filter(Boolean) : [];
}
---

<div class={embedded ? '' : 'section'} id={embedded ? undefined : 'components-section'}>
  {!embedded && (
    <>
      <h2 class="section-title">Components</h2>
      <p class="section-sub">{components.length} components arranged by top-level architecture slice</p>
    </>
  )}

  {roots.map((root: any) => {
    const children = childrenByParent.get(root.id) || [];
    const dependencies = linkedComponents(root.depends_on || []);
    const health = root.health || {};
    const criteria = list(health.criteria);
    const triggerScenarios = list(health.triggers_failure_scenarios);
    const participatingScenarios = list(health.participates_in_failure_scenarios);
    const references = groundedRefs(root);

    return (
      <section class="component-root" id={`card-${root.id}`}>
        <div class="group-header">
          <div class="group-name-row">
            <div class="group-name-block">
              <div class="group-name">{root.name}</div>
              <div class="group-kicker">
                Top-level component
                {children.length > 0 ? ` · ${children.length} subcomponent${children.length === 1 ? '' : 's'}` : ' · standalone'}
              </div>
            </div>
            <div class="group-pill">{root.type}</div>
          </div>
          <div class="group-desc">{root.description}</div>
          {root.summary && <div class="signal-text" style="margin-top:.45rem;">{root.summary}</div>}
        </div>

        <div class="root-summary-grid">
          {root.abstraction && root.abstraction.length > 0 && (
            <div class="summary-block">
              <div class="summary-label">Role</div>
              <div class="summary-list">
                {root.abstraction.map((item: string) => <span class="summary-pill">{item}</span>)}
              </div>
            </div>
          )}

          {dependencies.length > 0 && (
            <div class="summary-block">
              <div class="summary-label">Depends On</div>
              <div class="summary-list">
                {dependencies.map((component: any) => (
                  <a href={`#card-${component.id}`} class="summary-link">{component.name}</a>
                ))}
              </div>
            </div>
          )}

          {root.patterns && root.patterns.length > 0 && (
            <div class="summary-block">
              <div class="summary-label">Patterns</div>
              <div class="summary-list">
                {root.patterns.map((pattern: string) => <span class="card-tag">{pattern}</span>)}
              </div>
            </div>
          )}

          {criteria.length > 0 && (
            <div class="summary-block">
              <div class="summary-label">Healthy When</div>
              <ul class="summary-bullets">
                {criteria.map((criterion: string) => <li>{criterion}</li>)}
              </ul>
            </div>
          )}

          {triggerScenarios.length > 0 && (
            <div class="summary-block">
              <div class="summary-label">Can Trigger</div>
              <div class="summary-list">
                {triggerScenarios.map((scenarioId: string) => <a href={`#failure-${scenarioId}`} class="summary-link">{scenarioId}</a>)}
              </div>
            </div>
          )}

          {participatingScenarios.length > 0 && (
            <div class="summary-block">
              <div class="summary-label">Participates In</div>
              <div class="summary-list">
                {participatingScenarios.map((scenarioId: string) => <a href={`#failure-${scenarioId}`} class="summary-link">{scenarioId}</a>)}
              </div>
            </div>
          )}

          {references.length > 0 && (
            <div class="summary-block">
              <div class="summary-label">Grounded In</div>
              <div class="summary-code-list">
                {references.map((ref: string) => <code class="summary-code">{ref}</code>)}
              </div>
            </div>
          )}
        </div>

        {children.length > 0 ? (
          <div class="component-children">
            <div class="children-title">Subcomponents ({children.length})</div>
            <div class="card-grid">
              {children.map((child: any) => {
                const childDependencies = linkedComponents(child.depends_on || []);
                const childHealth = child.health || {};
                const childCriteria = list(childHealth.criteria);
                const childTriggerScenarios = list(childHealth.triggers_failure_scenarios);
                const childParticipatingScenarios = list(childHealth.participates_in_failure_scenarios);
                const childRefs = groundedRefs(child);
                return (
                  <article class="card component-card" id={`card-${child.id}`} data-component-id={child.id}>
                    <div class="card-name-row">
                      <div class="card-name">{child.name}</div>
                      <div class="card-type">{child.type}</div>
                    </div>
                    <div class="card-desc">{child.description}</div>
                    {child.summary && <div class="signal-text">{child.summary}</div>}

                    {child.abstraction && child.abstraction.length > 0 && (
                      <div class="meta-block">
                        <div class="meta-label">Role</div>
                        <div class="card-meta">
                          {child.abstraction.map((item: string) => <span class="card-tag">{item}</span>)}
                        </div>
                      </div>
                    )}

                    {child.patterns && child.patterns.length > 0 && (
                      <div class="meta-block">
                        <div class="meta-label">Patterns</div>
                        <div class="card-meta">
                          {child.patterns.map((pattern: string) => <span class="card-tag">{pattern}</span>)}
                        </div>
                      </div>
                    )}

                    {childDependencies.length > 0 && (
                      <div class="meta-block">
                        <div class="meta-label">Depends On</div>
                        <div class="summary-list">
                          {childDependencies.map((component: any) => (
                            <a href={`#card-${component.id}`} class="summary-link">{component.name}</a>
                          ))}
                        </div>
                      </div>
                    )}

                    {childCriteria.length > 0 && (
                      <div class="meta-block">
                        <div class="meta-label">Healthy When</div>
                        <ul class="summary-bullets">
                          {childCriteria.map((criterion: string) => <li>{criterion}</li>)}
                        </ul>
                      </div>
                    )}

                    {childTriggerScenarios.length > 0 && (
                      <div class="meta-block">
                        <div class="meta-label">Can Trigger</div>
                        <div class="summary-list">
                          {childTriggerScenarios.map((scenarioId: string) => <a href={`#failure-${scenarioId}`} class="summary-link">{scenarioId}</a>)}
                        </div>
                      </div>
                    )}

                    {childParticipatingScenarios.length > 0 && (
                      <div class="meta-block">
                        <div class="meta-label">Participates In</div>
                        <div class="summary-list">
                          {childParticipatingScenarios.map((scenarioId: string) => <a href={`#failure-${scenarioId}`} class="summary-link">{scenarioId}</a>)}
                        </div>
                      </div>
                    )}

                    {child.modules && child.modules.length > 0 && (
                      <div class="meta-block">
                        <div class="meta-label">Modules</div>
                        <div class="summary-code-list">
                          {child.modules.slice(0, 4).map((module: string) => <code class="summary-code">{module}</code>)}
                        </div>
                      </div>
                    )}

                    {childRefs.length > 0 && (
                      <div class="meta-block">
                        <div class="meta-label">Grounded In</div>
                        <div class="summary-code-list">
                          {childRefs.map((ref: string) => <code class="summary-code">{ref}</code>)}
                        </div>
                      </div>
                    )}
                  </article>
                );
              })}
            </div>
          </div>
        ) : (
          <div class="component-children">
            <div class="children-title">This top-level component has no subcomponents.</div>
          </div>
        )}
      </section>
    );
  })}
</div>
