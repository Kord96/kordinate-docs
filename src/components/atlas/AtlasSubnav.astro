---
interface Props {
  links: { label: string; href: string; active?: boolean }[];
}

const { links } = Astro.props;
---

<nav class="atlas-subnav" aria-label="Atlas views">
  {links.map((link) => (
    <a href={link.href} class:list={['atlas-subnav-link', link.active && 'atlas-subnav-link-active']}>
      {link.label}
    </a>
  ))}
</nav>
