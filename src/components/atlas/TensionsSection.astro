---
interface Props { tensions: any[]; components?: any[]; }
const { tensions, components = [] } = Astro.props;

const componentNames = new Map<string, string>(
  components.filter((component: any) => component?.id).map((component: any) => [component.id, component.name || component.id]),
);
---

<div class="section" id="sec-tensions">
  <h2 class="section-title">Architecture Tensions</h2>
  <p class="section-sub">{tensions.length} grounded trade-offs and contradictions surfaced by the atlas</p>

  <div class="signal-list">
    {tensions.map((tension: any) => (
      <article class="summary-block">
        <div class="signal-title">{tension.title || tension.id}</div>
        {tension.summary && <div class="signal-text">{tension.summary}</div>}
        {tension.trade_off && (
          <div class="meta-block">
            <div class="meta-label">Trade-off</div>
            <div class="signal-text">{tension.trade_off}</div>
          </div>
        )}
        {tension.components && tension.components.length > 0 && (
          <div class="meta-block">
            <div class="meta-label">Touches</div>
            <div class="summary-list">
              {tension.components.map((componentId: string) => <a href={`#card-${componentId}`} class="summary-link">{componentNames.get(componentId) || componentId}</a>)}
            </div>
          </div>
        )}
        {tension.evidence && tension.evidence.length > 0 && (
          <div class="meta-block">
            <div class="meta-label">Evidence</div>
            <div class="summary-code-list">
              {tension.evidence.map((ref: string) => <code class="summary-code">{ref}</code>)}
            </div>
          </div>
        )}
      </article>
    ))}
  </div>
</div>
