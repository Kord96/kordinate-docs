---
interface Props { concepts: any; debt: any; severity: (s: string) => string; components?: any[]; flows?: any[]; }
const { concepts, debt, severity, components = [], flows = [] } = Astro.props;

const patterns = concepts.detected_patterns || [];
const antiPatterns = concepts.detected_anti_patterns || [];
const gaps = concepts.gaps || [];
const recommendations = debt?.recommendations || [];

const componentNames = new Map<string, string>(
  components.filter((component: any) => component?.id).map((component: any) => [component.id, component.name || component.id]),
);
const flowNames = new Map<string, string>(
  flows.filter((flow: any) => flow?.id).map((flow: any) => [flow.id, flow.name || flow.id]),
);

function gradeColor(grade: string): string {
  return grade === 'A' ? '#22c55e' : grade === 'B' ? '#f59e0b' : '#ef4444';
}
---

<div class="section" id="sec-patterns">
  <h2 class="section-title">Patterns & Architecture</h2>
  <p class="section-sub">{patterns.length} patterns identified, {antiPatterns.length} anti-patterns detected, {gaps.length} gaps</p>

  {/* Debt Grade Summary */}
  {debt?.grade && (
    <div style="margin-bottom: 1.5rem; padding: 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); display: flex; align-items: center; gap: 1rem;">
      <div style={`background: ${gradeColor(debt.grade)}; color: white; font-size: 1.5rem; font-weight: 800; width: 56px; height: 56px; border-radius: 8px; display: flex; align-items: center; justify-content: center;`}>
        {debt.grade}
      </div>
      <div>
        <div style="font-weight: 600; font-size: .9rem;">Architecture Health Score: {debt.score}</div>
        <div style="font-size: .8rem; color: var(--text-3); margin-top: .2rem;">{debt.interpretation || ''}</div>
      </div>
    </div>
  )}

  {/* Positive Patterns */}
  {patterns.length > 0 && (
    <div style="margin-bottom: 2rem;">
      <div style="font-size: .7rem; font-weight: 600; color: #22c55e; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .75rem; display: flex; align-items: center; gap: .4rem;">
        <span style="font-size: .9rem;">✓</span> Good Patterns
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: .75rem;">
        {patterns.map((p: any) => (
          <div style="background: var(--bg-card); border: 1px solid var(--border); border-left: 2px solid #22c55e; border-radius: var(--radius); padding: .75rem 1rem; transition: border-color .2s;">
            <div style="display: flex; align-items: center; gap: .4rem; margin-bottom: .3rem;">
              <span style="font-weight: 600; font-size: .85rem;">{p.id}</span>
              <span style="font-size: .6rem; text-transform: uppercase; background: #22c55e15; color: #22c55e; padding: .1rem .3rem; border-radius: 3px; font-weight: 500;">{p.category}</span>
              {p.confidence && <span style="font-size: .6rem; color: var(--text-4);">{p.confidence}</span>}
            </div>
            {p.summary && <div style="font-size: .78rem; color: var(--text-2); line-height: 1.45; margin-bottom: .35rem;">{p.summary}</div>}
            {p.why_it_matters && <div style="font-size: .74rem; color: var(--text-3); line-height: 1.45; margin-bottom: .35rem;">{p.why_it_matters}</div>}
            {p.components && p.components.length > 0 && (
              <div style="font-size: .7rem; color: var(--accent); margin-bottom: .3rem; display: flex; gap: .3rem; flex-wrap: wrap;">
                {p.components.slice(0, 4).map((componentId: string) => (
                  <a href={`#card-${componentId}`} class="dep-comp-link" style="padding: .15rem .45rem;">
                    {componentNames.get(componentId) || componentId}
                  </a>
                ))}
                {p.components.length > 4 && <span style="font-size: .68rem; color: var(--text-4);">+{p.components.length - 4} more</span>}
              </div>
            )}
            {p.flows && p.flows.length > 0 && (
              <div style="font-size: .7rem; color: var(--accent); margin-bottom: .3rem; display: flex; gap: .3rem; flex-wrap: wrap;">
                {p.flows.slice(0, 3).map((flowId: string) => (
                  <a href={`#flow-${flowId}`} class="dep-comp-link" style="padding: .15rem .45rem;">
                    {flowNames.get(flowId) || flowId}
                  </a>
                ))}
              </div>
            )}
            {p.evidence?.note && <div style="font-size: .75rem; color: var(--text-3); line-height: 1.4;">{p.evidence.note}</div>}
          </div>
        ))}
      </div>
    </div>
  )}

  {/* Anti-Patterns */}
  {antiPatterns.length > 0 && (
    <div style="margin-bottom: 2rem;">
      <div style="font-size: .7rem; font-weight: 600; color: #ef4444; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .75rem; display: flex; align-items: center; gap: .4rem;">
        <span style="font-size: .9rem;">⚠</span> Anti-Patterns
      </div>
      <div style="display: flex; flex-direction: column; gap: .6rem;">
        {antiPatterns.map((ap: any) => (
          <div style="background: #ef444415; border: 1px solid #ef444433; border-left: 3px solid #ef4444; border-radius: var(--radius); padding: .75rem 1rem;">
            <div style="display: flex; align-items: center; gap: .4rem; margin-bottom: .3rem;">
              <span style="font-weight: 600; font-size: .85rem;">{ap.id}</span>
              <span style="font-size: .6rem; text-transform: uppercase; background: #ef444430; color: #ef4444; padding: .1rem .3rem; border-radius: 3px; font-weight: 600;">{ap.category}</span>
              {ap.confidence && <span style="font-size: .6rem; color: var(--text-4);">{ap.confidence}</span>}
            </div>
            {ap.components && ap.components.length > 0 && (
              <div style="font-size: .75rem; color: var(--text-2); margin-bottom: .3rem; font-weight: 500; display: flex; gap: .3rem; flex-wrap: wrap;">
                {ap.components.map((componentId: string) => (
                  <a href={`#card-${componentId}`} class="dep-comp-link" style="padding: .15rem .45rem;">
                    {componentNames.get(componentId) || componentId}
                  </a>
                ))}
              </div>
            )}
            {ap.evidence?.note && <div style="font-size: .75rem; color: var(--text-2); line-height: 1.4; margin-bottom: .3rem;">{ap.evidence.note}</div>}
            {ap.evidence?.files && ap.evidence.files.length > 0 && (
              <div style="font-size: .7rem; color: var(--accent); font-family: var(--mono);">
                {ap.evidence.files.slice(0, 2).join(' · ')}{ap.evidence.files.length > 2 ? ` +${ap.evidence.files.length - 2} more` : ''}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )}

  {/* Gaps & Recommendations */}
  {(gaps.length > 0 || recommendations.length > 0) && (
    <div>
      <div style="font-size: .7rem; font-weight: 600; color: #f59e0b; text-transform: uppercase; letter-spacing: .08em; margin-bottom: .75rem; display: flex; align-items: center; gap: .4rem;">
        <span style="font-size: .9rem;">◆</span> Gaps & Recommendations
      </div>
      <div style="display: flex; flex-direction: column; gap: .5rem;">
        {gaps.map((g: any) => (
          <div style="background: var(--bg-card); border: 1px solid var(--border); border-left: 2px solid #f59e0b; border-radius: var(--radius); padding: .75rem 1rem;">
            <div style="font-weight: 600; font-size: .85rem; margin-bottom: .3rem;">{g.id}</div>
            {g.summary && <div style="font-size: .78rem; color: var(--text-2); line-height: 1.45; margin-bottom: .35rem;">{g.summary}</div>}
            {g.relevance && <div style="font-size: .78rem; color: var(--text-3); line-height: 1.5; margin-bottom: .4rem;">{g.relevance}</div>}
            {g.components && g.components.length > 0 && (
              <div style="display: flex; gap: .3rem; flex-wrap: wrap; margin-bottom: .4rem;">
                {g.components.map((componentId: string) => (
                  <a href={`#card-${componentId}`} class="dep-comp-link" style="padding: .15rem .45rem;">
                    {componentNames.get(componentId) || componentId}
                  </a>
                ))}
              </div>
            )}
            {g.recommendation && (
              <div style="font-size: .75rem; color: var(--accent); padding: .4rem .6rem; background: var(--accent-dim); border-radius: 4px; border-left: 2px solid var(--accent);">
                <div style="font-weight: 500; margin-bottom: .2rem;">Recommendation:</div>
                {g.recommendation}
              </div>
            )}
          </div>
        ))}
        {recommendations.map((r: any) => (
          <div style="background: var(--bg-card); border: 1px solid var(--border); border-left: 2px solid #f59e0b; border-radius: var(--radius); padding: .75rem 1rem;">
            <div style="font-weight: 600; font-size: .85rem; margin-bottom: .3rem;">{r.title}</div>
            {r.description && <div style="font-size: .78rem; color: var(--text-3); line-height: 1.5; margin-bottom: .4rem;">{r.description}</div>}
            {r.files && r.files.length > 0 && (
              <div style="font-size: .7rem; color: var(--accent); font-family: var(--mono); margin-top: .3rem;">
                {r.files.slice(0, 2).join(' · ')}{r.files.length > 2 ? ` +${r.files.length - 2}` : ''}
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  )}
</div>
