---
interface Props { gaps?: any[]; components?: any[]; flows?: any[]; extDeps?: any[]; failures?: any[]; }
const { gaps = [], components = [], flows = [], extDeps = [], failures = [] } = Astro.props;

const labels = new Map<string, string>();
for (const component of components) if (component?.id) labels.set(component.id, component.name || component.id);
for (const flow of flows) if (flow?.id) labels.set(flow.id, flow.name || flow.id);
for (const dep of extDeps) if (dep?.id) labels.set(dep.id, dep.name || dep.id);
for (const failure of failures) if (failure?.id) labels.set(failure.id, failure.name || failure.id);

function list(values: any): string[] {
  return Array.isArray(values) ? values.filter(Boolean) : [];
}

function affected(entry: any): string[] {
  return list(entry.affects || []).concat(list(entry.targets || []));
}

function hrefFor(id: string) {
  if ((flows || []).some((flow: any) => flow?.id === id)) return `#flow-${id}`;
  if ((extDeps || []).some((dep: any) => dep?.id === id)) return `#external-${id}`;
  if ((failures || []).some((failure: any) => failure?.id === id)) return `#failure-${id}`;
  return `#card-${id}`;
}
---

{gaps.length > 0 && (
  <div class="section" id="sec-gaps">
    <h2 class="section-title">Gaps</h2>
    <p class="section-sub">{gaps.length} cross-cutting gaps spanning monitoring, resilience, concepts, and architectural weaknesses</p>

    <div class="section-stack">
      {gaps.map((gap: any) => {
        const affectedRefs = affected(gap);
        const refsList = list(gap.grounded_in);
        return (
          <article class="summary-block gap-card" id={`gap-${gap.id}`}>
            <div class="card-name-row">
              <div class="card-name">{gap.title || gap.name || gap.id}</div>
              {gap.kind && <div class="card-type">{gap.kind}</div>}
            </div>
            {gap.summary && <div class="signal-text">{gap.summary}</div>}

            <div class="detail-grid" style="margin-top:.8rem;">
              {affectedRefs.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Affects</div>
                  <div class="summary-list">
                    {affectedRefs.map((id: string) => <a href={hrefFor(id)} class="summary-link">{labels.get(id) || id}</a>)}
                  </div>
                </div>
              )}

              {gap.recommendation && (
                <div class="summary-block">
                  <div class="summary-label">Recommendation</div>
                  <div class="signal-text">{gap.recommendation}</div>
                </div>
              )}

              {refsList.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Grounded In</div>
                  <div class="summary-code-list">
                    {refsList.map((ref: string) => <code class="summary-code">{ref}</code>)}
                  </div>
                </div>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </div>
)}
