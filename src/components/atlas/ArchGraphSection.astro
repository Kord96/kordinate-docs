---
/**
 * Cytoscape component dependency view with expand/collapse roots,
 * hover tooltips, click for details, fullscreen.
 */
interface Props { components: any[]; extDeps: any[]; patterns?: any[]; embedded?: boolean; }
const { components, extDeps, patterns = [], embedded = false } = Astro.props;

const rootComponents = components.filter((component: any) => !component.parent);
const groupedRoots = rootComponents.filter((component: any) => Array.isArray(component.children) && component.children.length > 0);
const standaloneRoots = rootComponents.filter((component: any) => !Array.isArray(component.children) || component.children.length === 0);
---

<div class={embedded ? 'component-subsection' : 'section'} id={embedded ? undefined : 'sec-graph'}>
  {embedded ? (
    <>
      <h3 class="children-title" style="margin-bottom:.4rem;">Component Dependency View</h3>
      <p class="section-sub" style="margin-bottom:.8rem;">How top-level components, subcomponents, and external systems depend on each other at runtime.</p>
    </>
  ) : (
    <>
      <h2 class="section-title">Component Dependency View</h2>
      <p class="section-sub">How top-level components, subcomponents, and external systems depend on each other at runtime.</p>
    </>
  )}
  <div class="graph-controls">
    <button class="graph-btn" id="btn-expand-all">Expand All</button>
    <button class="graph-btn" id="btn-collapse-all">Collapse All</button>
    <button class="graph-btn" id="btn-fit">Fit View</button>
    <button class="graph-btn graph-btn-accent" id="btn-fullscreen">⛶ Fullscreen</button>
  </div>
  <div class="graph-wrap" id="graph-wrap">
    <div id="cy-container"></div>
    <div id="cy-tooltip">
      <div class="tt-name"></div>
      <div class="tt-type"></div>
      <div class="tt-desc"></div>
    </div>
    <div id="detail-panel" class="detail-panel">
      <button class="detail-close" id="detail-close">✕</button>
      <h3 class="detail-name"></h3>
      <span class="detail-type"></span>
      <p class="detail-desc"></p>
      <div class="detail-deps"></div>
      <div class="detail-patterns"></div>
      <div class="detail-files"></div>
    </div>
  </div>
  <div class="graph-counter" id="graph-counter"></div>
</div>

<style>
  .graph-wrap {
    position: relative;
  }
  #cy-container {
    width: 100%;
    height: 520px;
    border-radius: 12px;
    border: 1px solid var(--border, rgba(255,255,255,0.08));
    background: rgba(9,9,11,0.6);
    transition: all 0.3s ease;
  }
  .graph-wrap.fullscreen {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    z-index: 9999;
    background: #09090b;
    padding: 1rem;
  }
  .graph-wrap.fullscreen #cy-container {
    height: calc(100vh - 5rem);
    border-radius: 8px;
  }
  .graph-wrap.fullscreen .graph-controls {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 10000;
  }
  .graph-controls {
    display: flex; gap: 0.4rem; margin-bottom: 0.75rem;
  }
  .graph-btn {
    font-size: 0.65rem; padding: 0.25rem 0.6rem; border-radius: 4px;
    border: 1px solid var(--border, rgba(255,255,255,0.1)); background: transparent;
    color: var(--text-3, #888); cursor: pointer; transition: all 0.2s;
  }
  .graph-btn:hover { color: #fff; border-color: rgba(255,255,255,0.25); }
  .graph-btn-accent { color: #818cf8; border-color: rgba(129,140,248,0.3); }
  .graph-btn-accent:hover { background: rgba(129,140,248,0.1); }

  .detail-panel {
    display: none;
    position: absolute;
    top: 1rem; right: 1rem;
    width: 320px; max-height: calc(100% - 2rem);
    overflow-y: auto;
    background: rgba(18,18,24,0.95);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(129,140,248,0.2);
    border-radius: 10px;
    padding: 1.2rem;
    z-index: 100;
    box-shadow: 0 8px 32px rgba(0,0,0,0.4);
  }
  .detail-panel.visible { display: block; }
  .detail-close {
    position: absolute; top: 0.6rem; right: 0.8rem;
    background: none; border: none; color: #888; cursor: pointer;
    font-size: 1rem; padding: 0.2rem;
  }
  .detail-close:hover { color: #fff; }
  .detail-name { font-size: 1rem; font-weight: 700; color: #fff; margin: 0 0 0.3rem; }
  .detail-type {
    display: inline-block; font-size: 0.6rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.05em;
    padding: 0.1rem 0.4rem; border-radius: 3px;
    background: rgba(129,140,248,0.15); color: #818cf8;
    margin-bottom: 0.6rem;
  }
  .detail-desc { font-size: 0.75rem; color: #d4d4d8; line-height: 1.5; margin: 0.5rem 0; }
  .detail-deps, .detail-patterns, .detail-files {
    margin-top: 0.6rem; font-size: 0.7rem;
  }
  .detail-deps h4, .detail-patterns h4, .detail-files h4 {
    font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.05em;
    color: #a1a1aa; margin: 0 0 0.3rem;
  }
  .detail-deps ul, .detail-patterns ul, .detail-files ul {
    list-style: none; padding: 0; margin: 0;
  }
  .detail-deps li, .detail-patterns li, .detail-files li {
    padding: 0.15rem 0; color: #e4e4e7;
  }

  #cy-tooltip {
    display: none; position: absolute; z-index: 50;
    background: rgba(18,18,24,0.95); border: 1px solid rgba(129,140,248,0.25);
    border-radius: 8px; padding: 0.6rem 0.8rem; pointer-events: none;
    max-width: 260px; backdrop-filter: blur(8px);
  }
  .tt-name { font-weight: 700; font-size: 0.8rem; color: #fff; }
  .tt-type { font-size: 0.6rem; color: #a5b4fc; text-transform: uppercase; letter-spacing: 0.05em; margin-top: 0.15rem; }
  .tt-desc { font-size: 0.7rem; color: #d4d4d8; margin-top: 0.3rem; line-height: 1.4; }

  .graph-counter { font-size: 0.65rem; color: #71717a; margin-top: 0.5rem; text-align: right; }
</style>

<script is:inline define:vars={{ groupedRoots, standaloneRoots, components, extDeps, patterns }}>
(function() {
  function loadScript(src) {
    return new Promise(function(resolve, reject) {
      var s = document.createElement('script');
      s.src = src; s.onload = resolve; s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  var TYPE_COLORS = {
    worker: '#6366f1', service: '#3b82f6', api: '#22c55e', store: '#f59e0b',
    cli: '#64748b', scheduler: '#a855f7', external: '#ef4444'
  };

  var totalNodes = components.length + extDeps.length;
  var expandedGroups = {};
  var componentById = {};
  components.forEach(function(component) { componentById[component.id] = component; });

  function resolveVisibleNode(componentId) {
    var component = componentById[componentId];
    if (!component) return componentId;
    if (component.parent && !expandedGroups[component.parent]) return component.parent;
    return component.id;
  }

  function buildElements() {
    var els = [], vis = new Set();
    groupedRoots.forEach(function(root) {
      var kids = (root.children || []).map(function(id) { return componentById[id]; }).filter(Boolean);
      var expanded = !!expandedGroups[root.id];
      var label = expanded ? root.name : root.name + '  [' + kids.length + ']';
      vis.add(root.id);
      els.push({ group: 'nodes', data: { id: root.id, label: label, nodeType: root.type || 'service', description: root.description || '', summary: root.summary || '', hasChildren: true, collapsed: !expanded, children: root.children || [], health: root.health || {}, modules: root.modules || [], depends_on: root.depends_on || [] }});
      if (expanded) {
        kids.forEach(function(component) {
          vis.add(component.id);
          els.push({ group: 'nodes', data: { id: component.id, label: component.name, nodeType: component.type || 'worker', description: component.description || '', summary: component.summary || '', parent: root.id, hasChildren: false, collapsed: false, children: component.children || [], health: component.health || {}, modules: component.modules || [], depends_on: component.depends_on || [] }});
        });
      }
    });
    standaloneRoots.forEach(function(component) {
      vis.add(component.id);
      els.push({ group: 'nodes', data: { id: component.id, label: component.name, nodeType: component.type || 'worker', description: component.description || '', summary: component.summary || '', hasChildren: false, collapsed: false, children: component.children || [], health: component.health || {}, modules: component.modules || [], depends_on: component.depends_on || [] }});
    });
    extDeps.forEach(function(dep) {
      vis.add(dep.id);
      els.push({ group: 'nodes', data: { id: dep.id, label: dep.name || dep.id, nodeType: 'external', description: dep.purpose || dep.technology || '', summary: dep.summary || '', hasChildren: false, collapsed: false, children: [], health: dep.health || {}, modules: [], depends_on: [] }});
    });

    var edgeSet = {};
    components.forEach(function(component) {
      if (!component.depends_on) return;
      component.depends_on.forEach(function(depId) {
        var src = resolveVisibleNode(component.id);
        var tgt = vis.has(depId) ? depId : resolveVisibleNode(depId);
        if (!vis.has(src) || !vis.has(tgt) || src === tgt) return;
        var edgeKey = src + '->' + tgt;
        if (edgeSet[edgeKey]) return;
        edgeSet[edgeKey] = true;
        var sourceGroup = component.parent;
        var targetComponent = componentById[depId];
        var targetGroup = targetComponent ? targetComponent.parent : null;
        var crossGroup = sourceGroup !== targetGroup;
        els.push({ group: 'edges', data: { id: 'e-' + src + '-' + tgt, source: src, target: tgt, label: 'depends_on', edgeStyle: crossGroup ? 'dashed' : 'solid' }});
      });
    });

    extDeps.forEach(function(dep) {
      if (!dep.components) return;
      var seenTargets = {};
      dep.components.forEach(function(componentId) {
        var tgt = resolveVisibleNode(componentId);
        if (!tgt || !vis.has(tgt) || seenTargets[tgt]) return;
        seenTargets[tgt] = true;
        els.push({ group: 'edges', data: { id: 'e-ext-' + dep.id + '-' + tgt, source: tgt, target: dep.id, label: 'uses', edgeStyle: 'dashed' }});
      });
    });

    return { elements: els, visibleCount: vis.size };
  }

  function updateCounter(count) {
    document.getElementById('graph-counter').textContent = 'Showing ' + count + ' of ' + totalNodes + ' nodes';
  }

  function runLayout(cy, animate) {
    cy.layout({
      name: 'cose-bilkent',
      quality: 'proof',
      nodeDimensionsIncludeLabels: true,
      idealEdgeLength: 160,
      nodeRepulsion: 15000,
      edgeElasticity: 0.4,
      nestingFactor: 0.12,
      gravity: 0.2,
      numIter: 2500,
      tile: true,
      tilingPaddingVertical: 16,
      tilingPaddingHorizontal: 16,
      animate: animate ? 'end' : false,
      animationDuration: animate ? 400 : 0,
      fit: true,
      padding: 60
    }).run();
  }

  function rebuildGraph(cy, animate) {
    var result = buildElements();
    cy.elements().remove();
    cy.add(result.elements);
    updateCounter(result.visibleCount);
    runLayout(cy, animate);
  }

  function showDetail(nodeId, nodeType) {
    var panel = document.getElementById('detail-panel');
    var nameEl = panel.querySelector('.detail-name');
    var typeEl = panel.querySelector('.detail-type');
    var descEl = panel.querySelector('.detail-desc');
    var depsEl = panel.querySelector('.detail-deps');
    var patsEl = panel.querySelector('.detail-patterns');
    var filesEl = panel.querySelector('.detail-files');

    var component = componentById[nodeId];
    var dep = extDeps.find(function(item) { return item.id === nodeId; });
    var root = groupedRoots.find(function(item) { return item.id === nodeId; });
    var item = component || dep || root;
    if (!item) return;

    nameEl.textContent = item.name || item.id;
    typeEl.textContent = nodeType;
    descEl.textContent = item.summary || item.description || item.purpose || '';

    if (component && component.depends_on && component.depends_on.length) {
      depsEl.innerHTML = '<h4>Dependencies</h4><ul>' + component.depends_on.map(function(depId) {
        var target = componentById[depId] || extDeps.find(function(item) { return item.id === depId; });
        return '<li>→ ' + (target ? (target.name || target.id) : depId) + '</li>';
      }).join('') + '</ul>';
    } else if (root) {
      var kids = components.filter(function(item) { return item.parent === nodeId; });
      depsEl.innerHTML = '<h4>Subcomponents (' + kids.length + ')</h4><ul>' + kids.map(function(kid) {
        return '<li>' + kid.name + ' <span style="color:#a1a1aa">(' + (kid.type || 'worker') + ')</span></li>';
      }).join('') + '</ul>';
    } else if (dep && dep.components) {
      depsEl.innerHTML = '<h4>Used by</h4><ul>' + dep.components.map(function(componentId) {
        var comp = componentById[componentId];
        return '<li>' + (comp ? comp.name : componentId) + '</li>';
      }).join('') + '</ul>';
    } else {
      depsEl.innerHTML = '';
    }

    if (component && patterns.length) {
      var componentPatterns = patterns.filter(function(pattern) { return pattern.components && pattern.components.indexOf(nodeId) !== -1; });
      if (componentPatterns.length) {
        patsEl.innerHTML = '<h4>Patterns</h4><ul>' + componentPatterns.map(function(pattern) {
          return '<li>◆ ' + pattern.id + ' <span style="color:#a1a1aa">(' + (pattern.confidence || 'detected') + ')</span></li>';
        }).join('') + '</ul>';
      } else {
        patsEl.innerHTML = '';
      }
    } else {
      patsEl.innerHTML = '';
    }

    if (component && component.modules && component.modules.length) {
      var shown = component.modules.slice(0, 5);
      filesEl.innerHTML = '<h4>Files</h4><ul>' + shown.map(function(file) {
        return '<li style="font-family:var(--sl-font-mono,monospace);font-size:0.65rem;color:#d4d4d8">' + file + '</li>';
      }).join('') + (component.modules.length > 5 ? '<li style="color:#a1a1aa">+' + (component.modules.length - 5) + ' more</li>' : '') + '</ul>';
    } else {
      filesEl.innerHTML = '';
    }

    panel.classList.add('visible');
  }

  function initGraph() {
    var cy = cytoscape({
      container: document.getElementById('cy-container'),
      elements: [],
      minZoom: 0.2,
      maxZoom: 4,
      wheelSensitivity: 0.3,
      style: [
        { selector: 'node[?collapsed]', style: { 'shape': 'roundrectangle', 'width': function(e) { return Math.max(180, 140 + e.data('label').length * 3); }, 'height': 56, 'background-color': 'rgba(129,140,248,0.08)', 'border-width': 2, 'border-style': 'dashed', 'border-color': 'rgba(129,140,248,0.35)', 'label': 'data(label)', 'color': '#d4d4d8', 'font-size': '13px', 'font-weight': '600', 'text-halign': 'center', 'text-valign': 'center', 'text-wrap': 'wrap', 'text-max-width': '220px', 'font-family': 'Inter, sans-serif', 'overlay-opacity': 0 }},
        { selector: 'node[!collapsed][hasChildren]', style: { 'shape': 'roundrectangle', 'background-color': 'rgba(42,42,78,0.5)', 'background-opacity': 1, 'border-width': 1.5, 'border-style': 'dashed', 'border-color': 'rgba(255,255,255,0.08)', 'label': 'data(label)', 'color': '#a1a1aa', 'font-size': '12px', 'font-weight': '600', 'text-halign': 'center', 'text-valign': 'top', 'text-margin-y': -6, 'padding': '28px', 'compound-sizing-wrt-labels': 'include', 'text-wrap': 'wrap', 'text-max-width': '220px', 'font-family': 'Inter, sans-serif' }},
        { selector: 'node[nodeType!="external"][!hasChildren]', style: { 'shape': 'roundrectangle', 'width': function(e) { return Math.max(140, 100 + e.data('label').length * 3.5); }, 'height': 44, 'background-color': function(e) { return TYPE_COLORS[e.data('nodeType')] || '#6366f1'; }, 'border-width': 0, 'label': 'data(label)', 'color': '#fff', 'font-size': '11px', 'font-weight': '500', 'text-halign': 'center', 'text-valign': 'center', 'text-wrap': 'wrap', 'text-max-width': '130px', 'font-family': 'Inter, sans-serif', 'overlay-opacity': 0 }},
        { selector: 'node[nodeType="external"]', style: { 'shape': 'roundrectangle', 'width': function(e) { return Math.max(120, 80 + e.data('label').length * 4); }, 'height': 40, 'background-color': '#ef4444', 'border-width': 0, 'label': 'data(label)', 'color': '#fff', 'font-size': '10px', 'font-weight': '500', 'text-halign': 'center', 'text-valign': 'center', 'font-family': 'Inter, sans-serif', 'overlay-opacity': 0 }},
        { selector: 'edge[edgeStyle="solid"]', style: { 'width': 1.5, 'line-color': 'rgba(129,140,248,0.45)', 'target-arrow-color': 'rgba(129,140,248,0.45)', 'target-arrow-shape': 'triangle', 'arrow-scale': 0.8, 'curve-style': 'bezier', 'label': 'data(label)', 'font-size': '9px', 'font-family': 'Inter, sans-serif', 'color': 'rgba(255,255,255,0.3)', 'text-rotation': 'autorotate', 'text-margin-y': -10, 'text-background-color': '#0d0d12', 'text-background-opacity': 0.85, 'text-background-padding': '3px', 'text-background-shape': 'roundrectangle' }},
        { selector: 'edge[edgeStyle="dashed"]', style: { 'width': 1.5, 'line-style': 'dashed', 'line-dash-pattern': [6, 4], 'line-color': 'rgba(129,140,248,0.3)', 'target-arrow-color': 'rgba(129,140,248,0.3)', 'target-arrow-shape': 'triangle', 'arrow-scale': 0.8, 'curve-style': 'bezier', 'label': 'data(label)', 'font-size': '9px', 'font-family': 'Inter, sans-serif', 'color': 'rgba(255,255,255,0.25)', 'text-rotation': 'autorotate', 'text-margin-y': -10, 'text-background-color': '#0d0d12', 'text-background-opacity': 0.85, 'text-background-padding': '3px', 'text-background-shape': 'roundrectangle' }},
        { selector: 'node.hover-glow', style: { 'overlay-color': '#818cf8', 'overlay-opacity': 0.15, 'overlay-padding': 8 } },
        { selector: 'edge.highlighted', style: { 'line-color': 'rgba(129,140,248,0.7)', 'target-arrow-color': 'rgba(129,140,248,0.7)', 'color': 'rgba(255,255,255,0.7)', 'width': 2.5, 'z-index': 999 }},
        { selector: 'node.dimmed', style: { 'opacity': 0.15 } },
        { selector: 'edge.dimmed', style: { 'opacity': 0.06 } }
      ]
    });
    rebuildGraph(cy, false);

    var tooltip = document.getElementById('cy-tooltip');
    var ttName = tooltip.querySelector('.tt-name');
    var ttType = tooltip.querySelector('.tt-type');
    var ttDesc = tooltip.querySelector('.tt-desc');

    cy.on('mouseover', 'node', function(e) {
      var node = e.target;
      node.addClass('hover-glow');
      cy.elements().addClass('dimmed');
      node.removeClass('dimmed');
      node.connectedEdges().removeClass('dimmed').addClass('highlighted');
      node.neighborhood('node').removeClass('dimmed');
      if (node.isParent()) node.descendants().removeClass('dimmed');
      if (node.isChild()) node.parent().removeClass('dimmed');
      ttName.textContent = node.data('label');
      ttType.textContent = node.data('nodeType');
      ttDesc.textContent = node.data('description') || '';
      tooltip.style.display = 'block';
      var pos = node.renderedPosition();
      var container = document.getElementById('cy-container').getBoundingClientRect();
      tooltip.style.left = Math.min(pos.x + 12, container.width - 270) + 'px';
      tooltip.style.top = Math.min(pos.y + 12, container.height - 80) + 'px';
    });
    cy.on('mouseout', 'node', function() {
      cy.elements().removeClass('dimmed highlighted hover-glow');
      tooltip.style.display = 'none';
    });

    cy.on('tap', 'node', function(e) {
      var node = e.target;
      var id = node.data('id');
      if (node.data('hasChildren')) {
        if (expandedGroups[id]) delete expandedGroups[id]; else expandedGroups[id] = true;
        rebuildGraph(cy, true);
        return;
      }
      showDetail(id, node.data('nodeType'));
    });

    cy.on('tap', function(e) {
      if (e.target === cy) document.getElementById('detail-panel').classList.remove('visible');
    });

    document.getElementById('detail-close').addEventListener('click', function() {
      document.getElementById('detail-panel').classList.remove('visible');
    });

    document.getElementById('btn-expand-all').addEventListener('click', function() {
      groupedRoots.forEach(function(root) { expandedGroups[root.id] = true; });
      rebuildGraph(cy, false);
    });
    document.getElementById('btn-collapse-all').addEventListener('click', function() {
      expandedGroups = {};
      rebuildGraph(cy, true);
    });
    document.getElementById('btn-fit').addEventListener('click', function() { cy.fit(undefined, 60); });

    var wrap = document.getElementById('graph-wrap');
    var fsBtn = document.getElementById('btn-fullscreen');
    fsBtn.addEventListener('click', function() {
      wrap.classList.toggle('fullscreen');
      fsBtn.textContent = wrap.classList.contains('fullscreen') ? '✕ Exit' : '⛶ Fullscreen';
      setTimeout(function() { cy.resize(); cy.fit(undefined, 60); }, 350);
    });
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && wrap.classList.contains('fullscreen')) {
        wrap.classList.remove('fullscreen');
        fsBtn.textContent = '⛶ Fullscreen';
        setTimeout(function() { cy.resize(); cy.fit(undefined, 60); }, 350);
      }
    });
  }

  loadScript('https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js')
    .then(function() { return loadScript('https://unpkg.com/layout-base@2.0.1/layout-base.js'); })
    .then(function() { return loadScript('https://unpkg.com/cose-base@2.2.0/cose-base.js'); })
    .then(function() { return loadScript('https://unpkg.com/cytoscape-cose-bilkent@4.1.0/cytoscape-cose-bilkent.js'); })
    .then(function() {
      if (typeof cytoscapeCoseBilkent !== 'undefined') cytoscape.use(cytoscapeCoseBilkent);
      initGraph();
    });
})();
</script>
