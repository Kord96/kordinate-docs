---
/**
 * All CSS for atlas pages — cards, graph, failures, debt, flows, patterns.
 */
---

<style is:global>
  .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

  .section { margin-bottom: 3rem; }
  .section-title { font-size: 1.2rem; font-weight: 700; margin-bottom: .25rem; letter-spacing: -.02em; }
  .section-sub { font-size: .8rem; color: var(--text-3); margin-bottom: 1.25rem; }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .75rem; }
  .card {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: .75rem 1rem; transition: border-color .2s;
  }
  .card:hover { border-color: var(--border-hover); }
  .card-name { font-weight: 600; font-size: .85rem; margin-bottom: .2rem; }
  .card-type { font-size: .6rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-4); margin-bottom: .35rem; }
  .card-desc { font-size: .78rem; color: var(--text-2); line-height: 1.5; }
  .card-meta { display: flex; gap: .4rem; flex-wrap: wrap; margin-top: .4rem; }
  .card-tag { font-size: .6rem; padding: .1rem .35rem; border-radius: 4px; background: var(--accent-dim); color: var(--accent); }

  .group-header { margin-top: 2rem; margin-bottom: .75rem; padding-bottom: .35rem; border-bottom: 1px solid var(--border); }
  .group-name { font-size: .9rem; font-weight: 600; }
  .group-desc { font-size: .75rem; color: var(--text-3); }

  .failure {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: .75rem 1rem; margin-bottom: .6rem;
  }
  .failure-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: .3rem; }
  .failure-name { font-weight: 600; font-size: .85rem; }
  .failure-sev { font-size: .6rem; font-weight: 600; text-transform: uppercase; padding: .1rem .4rem; border-radius: 99px; color: white; }
  .failure-trigger { font-size: .78rem; color: var(--text-2); margin-bottom: .3rem; }
  .failure-cascade { font-size: .75rem; color: var(--text-3); }

  .debt-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .debt-grade { font-size: 2rem; font-weight: 800; width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
  .debt-score { font-size: .8rem; color: var(--text-3); }
  .violation {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: .6rem .8rem; margin-bottom: .5rem; font-size: .8rem;
  }
  .violation-sev { font-size: .6rem; font-weight: 600; text-transform: uppercase; margin-right: .4rem; }

  .dep { padding: 1rem 0; border-bottom: 1px solid var(--border); }
  .dep:last-child { border-bottom: none; }
  .dep-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: .5rem; gap: 1rem; }
  .dep-name { font-weight: 600; font-size: .95rem; }
  .dep-crit { font-size: .6rem; text-transform: uppercase; letter-spacing: .06em; font-weight: 600; padding: .15rem .4rem; border-radius: 4px; }
  .dep-purpose { font-size: .8rem; color: var(--text-2); margin: .75rem 0 .5rem; line-height: 1.6; }
  .dep-components { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: .5rem; }
  .dep-comp-link { font-size: .75rem; padding: .25rem .6rem; border-radius: 5px; background: var(--accent-dim); color: var(--accent); text-decoration: none; transition: all .2s; border: 1px solid rgba(129,140,248,0.2); font-weight: 500; }
  .dep-comp-link:hover { background: var(--accent); color: white; border-color: var(--accent); box-shadow: 0 2px 8px rgba(129,140,248,0.2); }

  .flow-card {
    background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
    padding: .75rem 1rem; margin-bottom: .6rem;
  }
  .flow-name { font-weight: 600; font-size: .85rem; margin-bottom: .15rem; }
  .flow-type { font-size: .6rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); margin-bottom: .3rem; }
  .flow-desc { font-size: .78rem; color: var(--text-2); line-height: 1.5; }

  .dm-badge { display: inline-flex; padding: .3rem .8rem; border-radius: 99px; font-size: .75rem; background: var(--accent-dim); border: 1px solid var(--accent-border); color: var(--accent); margin-bottom: 1rem; }
  .dm-entities { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .5rem; }
  .dm-entity { font-size: .7rem; padding: .15rem .4rem; border-radius: 4px; background: var(--bg-card); border: 1px solid var(--border); color: var(--text-2); }

  #cy-container { width: 100%; height: 500px; background: #0d0d12; border: 1px solid var(--border); border-radius: var(--radius); position: relative; }
  .graph-controls { display: flex; gap: .4rem; margin-bottom: .5rem; }
  .graph-btn { font-size: .7rem; font-family: var(--font); padding: .3rem .6rem; border: 1px solid var(--border); border-radius: 4px; background: var(--bg-card); color: var(--text-2); cursor: pointer; transition: all .2s; }
  .graph-btn:hover { border-color: var(--border-hover); color: var(--text); }
  .graph-counter { font-size: .7rem; color: var(--text-4); margin-top: .4rem; }
  #cy-tooltip { position: absolute; z-index: 10; pointer-events: none; background: rgba(24,24,27,.95); border: 1px solid var(--border-hover); border-radius: 6px; padding: .5rem .7rem; max-width: 260px; display: none; backdrop-filter: blur(8px); }
  #cy-tooltip .tt-name { font-size: .8rem; font-weight: 600; color: var(--text); margin-bottom: .15rem; }
  #cy-tooltip .tt-type { font-size: .6rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-4); margin-bottom: .25rem; }
  #cy-tooltip .tt-desc { font-size: .72rem; color: var(--text-2); line-height: 1.4; }
  .card-highlight { border-color: var(--accent) !important; box-shadow: 0 0 0 2px var(--accent-dim); transition: border-color .3s, box-shadow .3s; }
</style>
