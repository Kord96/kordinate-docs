---
interface Props { monitoring?: any[]; components?: any[]; flows?: any[]; extDeps?: any[]; failures?: any[]; }
const { monitoring = [], components = [], flows = [], extDeps = [], failures = [] } = Astro.props;

const labels = new Map<string, string>();
for (const component of components) if (component?.id) labels.set(component.id, component.name || component.id);
for (const flow of flows) if (flow?.id) labels.set(flow.id, flow.name || flow.id);
for (const dep of extDeps) if (dep?.id) labels.set(dep.id, dep.name || dep.id);
for (const failure of failures) if (failure?.id) labels.set(failure.id, failure.name || failure.id);

function list(values: any): string[] {
  return Array.isArray(values) ? values.filter(Boolean) : [];
}

function refs(entry: any): string[] {
  return list(entry?.covers || []).concat(list(entry?.targets || []));
}

function hrefFor(id: string) {
  if ((flows || []).some((flow: any) => flow?.id === id)) return `#flow-${id}`;
  if ((extDeps || []).some((dep: any) => dep?.id === id)) return `#external-${id}`;
  if ((failures || []).some((failure: any) => failure?.id === id)) return `#failure-${id}`;
  return `#card-${id}`;
}
---

{monitoring.length > 0 && (
  <div class="section" id="sec-monitoring">
    <h2 class="section-title">Monitoring</h2>
    <p class="section-sub">{monitoring.length} monitors, signals, and outcome indicators tied directly to architecture units and shared failure scenarios</p>

    <div class="section-stack">
      {monitoring.map((entry: any) => {
        const signalList = list(entry.signals);
        const metricList = list(entry.business_metrics);
        const alertList = list(entry.alerts);
        const dashboardList = list(entry.dashboards);
        const coverage = refs(entry);
        const refsList = list(entry.grounded_in);

        return (
          <article class="summary-block monitoring-card" id={`monitor-${entry.id}`}>
            <div class="card-name-row">
              <div class="card-name">{entry.name || entry.id}</div>
              {entry.kind && <div class="card-type">{entry.kind}</div>}
            </div>
            {entry.summary && <div class="signal-text">{entry.summary}</div>}

            <div class="detail-grid" style="margin-top:.8rem;">
              {coverage.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Covers</div>
                  <div class="summary-list">
                    {coverage.map((id: string) => <a href={hrefFor(id)} class="summary-link">{labels.get(id) || id}</a>)}
                  </div>
                </div>
              )}

              {signalList.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Signals</div>
                  <div class="summary-list">
                    {signalList.map((signal: string) => <span class="summary-pill">{signal}</span>)}
                  </div>
                </div>
              )}

              {metricList.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Business Metrics</div>
                  <div class="summary-list">
                    {metricList.map((metric: string) => <span class="summary-pill">{metric}</span>)}
                  </div>
                </div>
              )}

              {refsList.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Grounded In</div>
                  <div class="summary-code-list">
                    {refsList.map((ref: string) => <code class="summary-code">{ref}</code>)}
                  </div>
                </div>
              )}
            </div>

            {(alertList.length > 0 || dashboardList.length > 0) && (
              <div class="detail-grid" style="margin-top:.8rem;">
                {alertList.length > 0 && (
                  <div class="summary-block">
                    <div class="summary-label">Alerts</div>
                    <ul class="summary-bullets">
                      {alertList.map((alert: string) => <li>{alert}</li>)}
                    </ul>
                  </div>
                )}
                {dashboardList.length > 0 && (
                  <div class="summary-block">
                    <div class="summary-label">Dashboards</div>
                    <ul class="summary-bullets">
                      {dashboardList.map((dashboard: string) => <li>{dashboard}</li>)}
                    </ul>
                  </div>
                )}
              </div>
            )}
          </article>
        );
      })}
    </div>
  </div>
)}
