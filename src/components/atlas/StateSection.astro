---
interface Props { stateEntries: any[]; components?: any[]; }
const { stateEntries, components = [] } = Astro.props;

const componentNames = new Map<string, string>(
  components.filter((component: any) => component?.id).map((component: any) => [component.id, component.name || component.id]),
);
---

<div class="section" id="sec-state">
  <h2 class="section-title">State & Storage</h2>
  <p class="section-sub">{stateEntries.length} persistent or ephemeral state surfaces modeled in the atlas</p>

  <div class="card-grid">
    {stateEntries.map((entry: any) => (
      <article class="card component-card" id={`state-${entry.id}`}>
        <div class="card-name-row">
          <div class="card-name">{entry.id}</div>
          <div class="card-type">{entry.concept}</div>
        </div>

        <div class="card-desc">{entry.stores}</div>

        {entry.technology && (
          <div class="meta-block">
            <div class="meta-label">Technology</div>
            <div class="signal-text">{entry.technology}</div>
          </div>
        )}

        <div class="meta-block">
          <div class="meta-label">Role</div>
          <div class="summary-list">
            {entry.purpose && <span class="summary-pill">{entry.purpose}</span>}
            {entry.persistence && <span class="summary-pill">{entry.persistence}</span>}
            {entry.component && <a href={`#card-${entry.component}`} class="summary-link">{componentNames.get(entry.component) || entry.component}</a>}
          </div>
        </div>

        {entry.readers && entry.readers.length > 0 && (
          <div class="meta-block">
            <div class="meta-label">Readers</div>
            <div class="summary-list">
              {entry.readers.map((reader: string) => <a href={`#card-${reader}`} class="summary-link">{componentNames.get(reader) || reader}</a>)}
            </div>
          </div>
        )}

        {entry.writers && entry.writers.length > 0 && (
          <div class="meta-block">
            <div class="meta-label">Writers</div>
            <div class="summary-list">
              {entry.writers.map((writer: string) => <a href={`#card-${writer}`} class="summary-link">{componentNames.get(writer) || writer}</a>)}
            </div>
          </div>
        )}

        {entry.grounded_in && entry.grounded_in.length > 0 && (
          <div class="meta-block">
            <div class="meta-label">Grounded In</div>
            <div class="summary-code-list">
              {entry.grounded_in.map((ref: string) => <code class="summary-code">{ref}</code>)}
            </div>
          </div>
        )}
      </article>
    ))}
  </div>
</div>
