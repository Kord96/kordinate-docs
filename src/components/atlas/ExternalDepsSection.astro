---
interface Props { extDeps: any[]; severity: (s: string) => string; components?: any[]; }
const { extDeps, severity, components = [] } = Astro.props;

const componentNames = new Map<string, string>(
  components.filter((component: any) => component?.id).map((component: any) => [component.id, component.name || component.id]),
);

function list(values: any): string[] {
  return Array.isArray(values) ? values.filter(Boolean) : [];
}
---

<div class="section" id="sec-external">
  <h2 class="section-title">External Dependencies</h2>
  <p class="section-sub">{extDeps.length} external systems with purpose, blast radius, and health context</p>
  <div class="section-stack">
    {extDeps.map((e: any) => {
      const health = e.health || {};
      const criteria = list(health.criteria);
      const triggerScenarios = list(health.triggers_failure_scenarios);
      const participatingScenarios = list(health.participates_in_failure_scenarios);

      return (
        <article class="summary-block dep" id={`external-${e.id}`}>
          <div class="dep-header">
            <span class="dep-name">{e.name || e.id}</span>
            <span class="dep-crit" style={`color: ${severity(e.criticality)}`}>{e.criticality}</span>
          </div>

          <div class="detail-grid">
            <div class="summary-block">
              <div class="summary-label">Type</div>
              <div class="signal-text">{[e.concept, e.technology].filter(Boolean).join(' · ')}</div>
            </div>
            {e.purpose && (
              <div class="summary-block">
                <div class="summary-label">Purpose</div>
                <div class="signal-text">{e.purpose}</div>
              </div>
            )}
            {Array.isArray(e.components) && e.components.length > 0 && (
              <div class="summary-block">
                <div class="summary-label">Used By</div>
                <div class="summary-list">
                  {e.components.map((comp: string) => (
                    <a href={`#card-${comp}`} class="summary-link">{componentNames.get(comp) || comp}</a>
                  ))}
                </div>
              </div>
            )}
          </div>

          {e.summary && (
            <div class="meta-block" style="margin-top:.7rem;">
              <div class="meta-label">Why It Matters</div>
              <div class="signal-text">{e.summary}</div>
            </div>
          )}

          {(criteria.length > 0 || triggerScenarios.length > 0 || participatingScenarios.length > 0) && (
            <div class="detail-grid" style="margin-top:.8rem;">
              {criteria.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Healthy When</div>
                  <ul class="summary-bullets">
                    {criteria.map((criterion: string) => <li>{criterion}</li>)}
                  </ul>
                </div>
              )}
              {triggerScenarios.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Can Trigger</div>
                  <div class="summary-list">
                    {triggerScenarios.map((scenarioId: string) => <a href={`#failure-${scenarioId}`} class="summary-link">{scenarioId}</a>)}
                  </div>
                </div>
              )}
              {participatingScenarios.length > 0 && (
                <div class="summary-block">
                  <div class="summary-label">Participates In</div>
                  <div class="summary-list">
                    {participatingScenarios.map((scenarioId: string) => <a href={`#failure-${scenarioId}`} class="summary-link">{scenarioId}</a>)}
                  </div>
                </div>
              )}
            </div>
          )}
        </article>
      );
    })}
  </div>
</div>
