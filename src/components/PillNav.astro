---
/**
 * Floating content navigator — jump between sections within a page.
 * Fixed at bottom center. Highlights the section currently in view.
 * Uses IntersectionObserver to track scroll position.
 */
interface Props {
  sections: { id: string; label: string }[];
  pageLinks?: { label: string; href: string }[];
  activePage?: string;
}
const { sections, pageLinks = [], activePage = '' } = Astro.props;
const activePageLink = pageLinks.find((link) => link.label.toLowerCase() === activePage) || pageLinks[0] || null;
---

<nav class="pill-nav" aria-label="Section navigation" id="pill-nav">
  {activePageLink && (
    <div class="pill-page-menu" aria-label="Page navigation">
      <label class="pill-page-select-wrap">
        <span class="sr-only">Page</span>
        <select class="pill-page-select" onchange="window.location.href=this.value">
          {pageLinks.map((link) => (
            <option value={link.href} selected={activePage === link.label.toLowerCase()}>
              {link.label}
            </option>
          ))}
        </select>
      </label>
    </div>
  )}
  <div class="pill-strip">
    {sections.map((s, i) => (
      <a class:list={['pill', i === 0 && 'pill-active']} href={`#${s.id}`} data-section={s.id}>
        <span class="pill-label">{s.label}</span>
      </a>
    ))}
  </div>
</nav>

<script is:inline>
(function() {
  const nav = document.getElementById('pill-nav');
  if (!nav) return;
  const pills = nav.querySelectorAll('.pill[data-section]');
  const ids = Array.from(pills).map(p => p.dataset.section);
  const targets = ids.map(id => document.getElementById(id)).filter(Boolean);
  if (!targets.length) return;

  let current = ids[0];

  const obs = new IntersectionObserver(entries => {
    for (const e of entries) {
      if (e.isIntersecting) {
        current = e.target.id;
        pills.forEach(p => {
          p.classList.toggle('pill-active', p.dataset.section === current);
        });
      }
    }
  }, { rootMargin: '-20% 0px -70% 0px' });

  targets.forEach(t => obs.observe(t));

  // Smooth scroll on click
  pills.forEach(p => {
    p.addEventListener('click', e => {
      e.preventDefault();
      const target = document.getElementById(p.dataset.section);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
})();
</script>

<style>
  .pill-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(9,9,11,0.92);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--border-hover);
    border-radius: 99px;
    padding: 3px;
    max-width: 90vw;
    overflow: visible;
    overflow-y: visible;
    scrollbar-width: none;
    box-shadow: 0 10px 28px rgba(0,0,0,0.28);
  }
  .pill-nav::-webkit-scrollbar { display: none; }
  .pill-strip {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-width: 0;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
  }
  .pill-strip::-webkit-scrollbar { display: none; }
  .pill-page-menu {
    flex-shrink: 0;
  }
  .pill-page-select-wrap {
    display: inline-flex;
    align-items: center;
    border-radius: 99px;
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    position: relative;
  }
  .pill-page-select-wrap::after {
    content: '▾';
    position: absolute;
    right: .55rem;
    font-size: .5rem;
    color: currentColor;
    pointer-events: none;
  }
  .pill-page-select {
    appearance: none;
    -webkit-appearance: none;
    border: none;
    background: transparent;
    color: var(--accent);
    font-size: .65rem;
    font-weight: 700;
    line-height: 1;
    padding: .3rem 1.35rem .3rem .65rem;
    border-radius: 99px;
    cursor: pointer;
  }
  .pill {
    padding: .3rem .6rem;
    border-radius: 99px;
    font-size: .65rem;
    font-weight: 500;
    color: var(--text-4);
    text-decoration: none;
    transition: all .2s;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1;
  }
  .pill:hover {
    color: var(--text-2);
    background: rgba(39,39,42,0.6);
  }
  .pill-active {
    color: var(--text);
    background: var(--border-hover);
  }
  [data-theme='light'] .pill-nav {
    background: rgba(255,255,255,0.96);
    border-color: #cbd5e1;
    box-shadow: 0 8px 28px rgba(24,24,27,0.08);
  }
  [data-theme='light'] .pill-page-toggle {
    color: #3730a3;
  }
  [data-theme='light'] .pill {
    color: #71717a;
  }
  [data-theme='light'] .pill-page-select-wrap {
    background: rgba(79,70,229,0.08);
    border-color: rgba(79,70,229,0.18);
    color: #3730a3;
  }
  [data-theme='light'] .pill-page-select {
    color: #3730a3;
  }
  [data-theme='light'] .pill:hover {
    color: #18181b;
    background: rgba(24,24,27,0.05);
  }
  [data-theme='light'] .pill-active {
    color: #18181b;
    background: #e4e4e7;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
