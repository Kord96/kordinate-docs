---
/**
 * Floating content navigator — jump between sections within a page.
 * Fixed at bottom center. Highlights the section currently in view.
 * Uses IntersectionObserver to track scroll position.
 */
interface Props {
  sections: { id: string; label: string }[];
  pageLinks?: { label: string; href: string }[];
  activePage?: string;
}
const { sections, pageLinks = [], activePage = '' } = Astro.props;
const activePageLink = pageLinks.find((link) => link.label.toLowerCase() === activePage) || pageLinks[0] || null;
---

<nav class="pill-nav" aria-label="Section navigation" id="pill-nav">
  {activePageLink && (
    <div class="pill-page-menu" aria-label="Page navigation">
      <button class="pill-page-toggle" type="button" aria-haspopup="true" aria-expanded="false">
        {activePageLink.label}
      </button>
      <div class="pill-page-list">
        {pageLinks.map((link) => (
          <a class:list={['pill-page-item', activePage === link.label.toLowerCase() && 'pill-page-item-active']} href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  )}
  {sections.map((s, i) => (
    <a class:list={['pill', i === 0 && 'pill-active']} href={`#${s.id}`} data-section={s.id}>
      <span class="pill-label">{s.label}</span>
    </a>
  ))}
</nav>

<script is:inline>
(function() {
  const nav = document.getElementById('pill-nav');
  if (!nav) return;
  const pills = nav.querySelectorAll('.pill[data-section]');
  const ids = Array.from(pills).map(p => p.dataset.section);
  const targets = ids.map(id => document.getElementById(id)).filter(Boolean);
  if (!targets.length) return;

  let current = ids[0];

  const obs = new IntersectionObserver(entries => {
    for (const e of entries) {
      if (e.isIntersecting) {
        current = e.target.id;
        pills.forEach(p => {
          p.classList.toggle('pill-active', p.dataset.section === current);
        });
      }
    }
  }, { rootMargin: '-20% 0px -70% 0px' });

  targets.forEach(t => obs.observe(t));

  // Smooth scroll on click
  pills.forEach(p => {
    p.addEventListener('click', e => {
      e.preventDefault();
      const target = document.getElementById(p.dataset.section);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });

  const pageMenu = nav.querySelector('.pill-page-menu');
  const pageToggle = nav.querySelector('.pill-page-toggle');
  if (pageMenu && pageToggle instanceof HTMLButtonElement) {
    pageToggle.addEventListener('click', (event) => {
      event.stopPropagation();
      const open = pageMenu.classList.toggle('open');
      pageToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Element)) return;
      if (pageMenu.contains(event.target)) return;
      pageMenu.classList.remove('open');
      pageToggle.setAttribute('aria-expanded', 'false');
    });
  }
})();
</script>

<style>
  .pill-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(9,9,11,0.92);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--border-hover);
    border-radius: 99px;
    padding: 3px;
    max-width: 90vw;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
    box-shadow: 0 10px 28px rgba(0,0,0,0.28);
  }
  .pill-nav::-webkit-scrollbar { display: none; }
  .pill-page-menu {
    position: relative;
    flex-shrink: 0;
  }
  .pill-page-toggle {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    padding: .3rem .65rem;
    border-radius: 99px;
    font-size: .65rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    line-height: 1;
    appearance: none;
    -webkit-appearance: none;
    transition: all .18s ease;
    position: relative;
    z-index: 1;
  }
  .pill-page-toggle::after {
    content: '▾';
    font-size: .5rem;
    margin-left: .35rem;
    color: currentColor;
  }
  .pill-page-list {
    position: absolute;
    left: 0;
    bottom: calc(100% + .55rem);
    min-width: 8rem;
    padding: .35rem;
    gap: .2rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(9,9,11,.96);
    backdrop-filter: blur(16px) saturate(180%);
    box-shadow: 0 16px 36px rgba(0,0,0,.26);
    z-index: 220;
    display: none;
  }
  .pill-page-menu.open .pill-page-list {
    display: grid;
  }
  .pill-page-item {
    text-decoration: none;
    color: var(--text-3);
    font-size: .74rem;
    font-weight: 600;
    padding: .38rem .55rem;
    border-radius: 8px;
    transition: all .18s ease;
  }
  .pill-page-item:hover {
    color: var(--text-2);
    background: rgba(39,39,42,.7);
  }
  .pill-page-item-active {
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
  }
  .pill {
    padding: .3rem .6rem;
    border-radius: 99px;
    font-size: .65rem;
    font-weight: 500;
    color: var(--text-4);
    text-decoration: none;
    transition: all .2s;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1;
  }
  .pill:hover {
    color: var(--text-2);
    background: rgba(39,39,42,0.6);
  }
  .pill-active {
    color: var(--text);
    background: var(--border-hover);
  }
  [data-theme='light'] .pill-nav {
    background: rgba(255,255,255,0.96);
    border-color: #cbd5e1;
    box-shadow: 0 8px 28px rgba(24,24,27,0.08);
  }
  [data-theme='light'] .pill-page-toggle {
    color: #3730a3;
    background: rgba(79,70,229,0.08);
    border-color: rgba(79,70,229,0.18);
  }
  [data-theme='light'] .pill {
    color: #71717a;
  }
  [data-theme='light'] .pill-page-list {
    background: rgba(255,255,255,.98);
    border-color: #d4d4d8;
    box-shadow: 0 16px 36px rgba(24,24,27,.12);
  }
  [data-theme='light'] .pill-page-item {
    color: #52525b;
  }
  [data-theme='light'] .pill-page-item:hover {
    color: #18181b;
    background: rgba(24,24,27,.05);
  }
  [data-theme='light'] .pill-page-item-active {
    color: #3730a3;
    background: rgba(79,70,229,.08);
    border-color: rgba(79,70,229,.18);
  }
  [data-theme='light'] .pill:hover {
    color: #18181b;
    background: rgba(24,24,27,0.05);
  }
  [data-theme='light'] .pill-active {
    color: #18181b;
    background: #e4e4e7;
  }
</style>
