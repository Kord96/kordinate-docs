---
/**
 * Floating content navigator — jump between sections within a page.
 * Fixed at bottom center. Highlights the section currently in view.
 * Uses IntersectionObserver to track scroll position.
 */
interface Props {
  sections: { id: string; label: string }[];
  pageLinks?: { label: string; href: string }[];
  activePage?: string;
}
import FloatingNavTheme from './FloatingNavTheme.astro';
const { sections, pageLinks = [], activePage = '' } = Astro.props;
const activePageLink = pageLinks.find((link) => link.label.toLowerCase() === activePage) || pageLinks[0] || null;
---

<FloatingNavTheme />
<nav class="pill-nav" aria-label="Section navigation" id="pill-nav">
  {activePageLink && (
    <div class="pill-page-menu" aria-label="Page navigation">
      <button class="pill-page-button" type="button" aria-haspopup="true" aria-expanded="false">
        <span>{activePageLink.label}</span>
        <span class="pill-page-caret">▾</span>
      </button>
      <div class="pill-page-popover" role="menu">
        {pageLinks.map((link) => (
          <a
            href={link.href}
            class:list={['pill-page-option', activePage === link.label.toLowerCase() && 'pill-page-option-active']}
            role="menuitem"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  )}
  <div class="pill-strip">
    {sections.map((s, i) => (
      <a class:list={['pill', i === 0 && 'pill-active']} href={`#${s.id}`} data-section={s.id}>
        <span class="pill-label">{s.label}</span>
      </a>
    ))}
  </div>
</nav>

<script is:inline>
(function() {
  const nav = document.getElementById('pill-nav');
  if (!nav) return;
  const pills = nav.querySelectorAll('.pill[data-section]');
  const ids = Array.from(pills).map(p => p.dataset.section);
  const targets = ids.map(id => document.getElementById(id)).filter(Boolean);

  if (targets.length) {
    let current = ids[0];
    const obs = new IntersectionObserver(entries => {
      for (const e of entries) {
        if (e.isIntersecting) {
          current = e.target.id;
          pills.forEach(p => {
            p.classList.toggle('pill-active', p.dataset.section === current);
          });
        }
      }
    }, { rootMargin: '-20% 0px -70% 0px' });

    targets.forEach(t => obs.observe(t));

    pills.forEach(p => {
      p.addEventListener('click', e => {
        e.preventDefault();
        const target = document.getElementById(p.dataset.section);
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  }

  const pageMenu = nav.querySelector('.pill-page-menu');
  const pageButton = nav.querySelector('.pill-page-button');
  const pagePopover = nav.querySelector('.pill-page-popover');
  if (pageMenu && pageButton && pagePopover) {
    const closePageMenu = () => {
      pageMenu.classList.remove('open');
      pageButton.setAttribute('aria-expanded', 'false');
    };

    pageButton.addEventListener('click', (e) => {
      e.stopPropagation();
      const nextOpen = !pageMenu.classList.contains('open');
      if (!nextOpen) {
        closePageMenu();
        return;
      }
      pageMenu.classList.add('open');
      pageButton.setAttribute('aria-expanded', 'true');
    });

    document.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      if (e.target.closest('.pill-page-menu')) return;
      closePageMenu();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closePageMenu();
    });
  }
})();
</script>

<style>
  .pill-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 2px;
    background: var(--floating-nav-bg);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--floating-nav-border);
    border-radius: 99px;
    padding: 3px;
    max-width: 90vw;
    overflow: visible;
    overflow-y: visible;
    scrollbar-width: none;
    box-shadow: var(--floating-nav-shadow);
  }
  body.drawer-open .pill-nav {
    z-index: 100 !important;
    opacity: .08;
    pointer-events: none;
  }
  .pill-nav::-webkit-scrollbar { display: none; }
  .pill-strip {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    min-width: 0;
    overflow-x: auto;
    overflow-y: visible;
    scrollbar-width: none;
  }
  .pill-strip::-webkit-scrollbar { display: none; }
  .pill-page-menu {
    flex-shrink: 0;
    position: relative;
  }
  .pill-page-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: .35rem;
    border-radius: 99px;
    background: var(--floating-nav-page-bg);
    border: 1px solid var(--floating-nav-page-border);
    color: var(--floating-nav-page-color);
    border-radius: 99px;
    cursor: pointer;
    min-height: 2rem;
    min-width: 4.75rem;
    padding: .45rem .8rem;
    font-size: .65rem;
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    transition: background .18s, border-color .18s, color .18s;
  }
  .pill-page-button:hover {
    background: var(--floating-nav-page-hover-bg);
  }
  .pill-page-caret {
    font-size: .5rem;
    opacity: .7;
  }
  .pill-page-popover {
    position: absolute;
    left: 0;
    bottom: calc(100% + .5rem);
    min-width: 9rem;
    display: none;
    flex-direction: column;
    gap: 2px;
    padding: .3rem;
    border-radius: 14px;
    background: var(--floating-nav-menu-bg);
    border: 1px solid var(--floating-nav-menu-border);
    box-shadow: var(--floating-nav-menu-shadow);
    backdrop-filter: blur(16px) saturate(180%);
  }
  .pill-page-menu.open .pill-page-popover {
    display: flex;
  }
  .pill-page-option {
    text-decoration: none;
    color: var(--floating-nav-menu-option-color);
    font-size: .65rem;
    font-weight: 600;
    line-height: 1;
    padding: .55rem .7rem;
    border-radius: 10px;
    white-space: nowrap;
    transition: background .18s, color .18s;
  }
  .pill-page-option:hover {
    background: var(--floating-nav-menu-option-hover-bg);
    color: var(--floating-nav-menu-option-hover-color);
  }
  .pill-page-option-active {
    background: var(--floating-nav-menu-option-active-bg);
    color: var(--floating-nav-menu-option-active-color);
  }
  .pill {
    padding: .3rem .6rem;
    border-radius: 99px;
    font-size: .65rem;
    font-weight: 500;
    color: var(--floating-nav-pill-color);
    text-decoration: none;
    transition: all .2s;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1;
  }
  .pill:hover {
    color: var(--floating-nav-pill-hover-color);
    background: var(--floating-nav-pill-hover-bg);
  }
  .pill-active {
    color: var(--floating-nav-pill-active-color);
    background: var(--floating-nav-pill-active-bg);
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
