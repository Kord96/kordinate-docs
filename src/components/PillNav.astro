---
/**
 * Floating content navigator — jump between sections within a page.
 * Fixed at bottom center. Highlights the section currently in view.
 * Uses IntersectionObserver to track scroll position.
 */
interface Props {
  sections: { id: string; label: string }[];
  pageLinks?: { label: string; href: string }[];
  activePage?: string;
}
const { sections, pageLinks = [], activePage = '' } = Astro.props;
const activePageLink = pageLinks.find((link) => link.label.toLowerCase() === activePage) || pageLinks[0] || null;
---

<nav class="pill-nav" aria-label="Section navigation" id="pill-nav">
  {activePageLink && (
    <div class="pill-page-row" aria-label="Page navigation">
      <div class="pill-page-group">
        {pageLinks.map((link) => (
          <a class:list={['pill-page-link', activePage === link.label.toLowerCase() && 'pill-page-link-active']} href={link.href}>
            {link.label}
          </a>
        ))}
      </div>
    </div>
  )}
  <div class="pill-section-row">
    {sections.map((s, i) => (
      <a class:list={['pill', i === 0 && 'pill-active']} href={`#${s.id}`} data-section={s.id}>
        <span class="pill-label">{s.label}</span>
      </a>
    ))}
  </div>
</nav>

<script is:inline>
(function() {
  const nav = document.getElementById('pill-nav');
  if (!nav) return;
  const pills = nav.querySelectorAll('.pill[data-section]');
  const ids = Array.from(pills).map(p => p.dataset.section);
  const targets = ids.map(id => document.getElementById(id)).filter(Boolean);
  if (!targets.length) return;

  let current = ids[0];

  const obs = new IntersectionObserver(entries => {
    for (const e of entries) {
      if (e.isIntersecting) {
        current = e.target.id;
        pills.forEach(p => {
          p.classList.toggle('pill-active', p.dataset.section === current);
        });
      }
    }
  }, { rootMargin: '-20% 0px -70% 0px' });

  targets.forEach(t => obs.observe(t));

  // Smooth scroll on click
  pills.forEach(p => {
    p.addEventListener('click', e => {
      e.preventDefault();
      const target = document.getElementById(p.dataset.section);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
})();
</script>

<style>
  .pill-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 4px;
    background: rgba(9,9,11,0.92);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--border-hover);
    border-radius: 18px;
    padding: 6px;
    max-width: 90vw;
    overflow-x: visible;
    overflow-y: visible;
    scrollbar-width: none;
    box-shadow: 0 10px 28px rgba(0,0,0,0.28);
  }
  .pill-nav::-webkit-scrollbar { display: none; }
  .pill-page-row,
  .pill-section-row {
    display: flex;
    align-items: center;
    gap: 2px;
    min-width: 0;
  }
  .pill-page-row {
    justify-content: center;
    padding: 0 .15rem .15rem;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }
  .pill-section-row {
    overflow-x: auto;
    scrollbar-width: none;
    padding-top: .05rem;
  }
  .pill-section-row::-webkit-scrollbar { display: none; }
  .pill-page-group {
    display: inline-flex;
    align-items: center;
    gap: .15rem;
    flex-shrink: 0;
  }
  .pill-page-group::before {
    content: '';
  }
  .pill-page-link {
    display: inline-flex;
    align-items: center;
    padding: .1rem .35rem;
    border-radius: 6px;
    font-size: .6rem;
    font-weight: 600;
    color: var(--text-3);
    background: transparent;
    line-height: 1;
    text-decoration: none;
    transition: all .18s ease;
  }
  .pill-page-link + .pill-page-link::before {
    content: '/';
    margin-right: .3rem;
    color: var(--text-4);
  }
  .pill-page-link:hover {
    color: var(--text-2);
    background: transparent;
  }
  .pill-page-link-active {
    color: var(--accent);
    background: transparent;
    font-weight: 600;
  }
  .pill {
    padding: .3rem .6rem;
    border-radius: 99px;
    font-size: .65rem;
    font-weight: 500;
    color: var(--text-4);
    text-decoration: none;
    transition: all .2s;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1;
  }
  .pill:hover {
    color: var(--text-2);
    background: rgba(39,39,42,0.6);
  }
  .pill-active {
    color: var(--text);
    background: var(--border-hover);
  }
  [data-theme='light'] .pill-nav {
    background: rgba(255,255,255,0.96);
    border-color: #cbd5e1;
    box-shadow: 0 8px 28px rgba(24,24,27,0.08);
  }
  [data-theme='light'] .pill {
    color: #71717a;
  }
  [data-theme='light'] .pill-page-link {
    color: #71717a;
  }
  [data-theme='light'] .pill-page-link + .pill-page-link::before {
    color: #a1a1aa;
  }
  [data-theme='light'] .pill-page-link:hover {
    color: #27272a;
    background: transparent;
  }
  [data-theme='light'] .pill-page-link-active {
    color: #3730a3;
    background: transparent;
  }
  [data-theme='light'] .pill-page-row {
    border-bottom-color: rgba(24,24,27,0.08);
  }
  [data-theme='light'] .pill:hover {
    color: #18181b;
    background: rgba(24,24,27,0.05);
  }
  [data-theme='light'] .pill-active {
    color: #18181b;
    background: #e4e4e7;
  }
</style>
