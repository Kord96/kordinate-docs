---
/**
 * Floating content navigator — jump between sections within a page.
 * Fixed at bottom center. Highlights the section currently in view.
 * Uses IntersectionObserver to track scroll position.
 */
interface Props {
  sections: { id: string; label: string }[];
}
const { sections } = Astro.props;
---

<nav class="pill-nav" aria-label="Section navigation" id="pill-nav">
  {sections.map((s, i) => (
    <a class:list={['pill', i === 0 && 'pill-active']} href={`#${s.id}`} data-section={s.id}>
      <span class="pill-label">{s.label}</span>
    </a>
  ))}
</nav>

<script is:inline>
(function() {
  const nav = document.getElementById('pill-nav');
  if (!nav) return;
  const pills = nav.querySelectorAll('.pill[data-section]');
  const ids = Array.from(pills).map(p => p.dataset.section);
  const targets = ids.map(id => document.getElementById(id)).filter(Boolean);
  if (!targets.length) return;

  let current = ids[0];

  const obs = new IntersectionObserver(entries => {
    for (const e of entries) {
      if (e.isIntersecting) {
        current = e.target.id;
        pills.forEach(p => {
          p.classList.toggle('pill-active', p.dataset.section === current);
        });
      }
    }
  }, { rootMargin: '-20% 0px -70% 0px' });

  targets.forEach(t => obs.observe(t));

  // Smooth scroll on click
  pills.forEach(p => {
    p.addEventListener('click', e => {
      e.preventDefault();
      const target = document.getElementById(p.dataset.section);
      if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
})();
</script>

<style>
  .pill-nav {
    position: fixed;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 200;
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(9,9,11,0.92);
    backdrop-filter: blur(16px) saturate(180%);
    border: 1px solid var(--border-hover);
    border-radius: 99px;
    padding: 3px;
    max-width: 90vw;
    overflow-x: auto;
    scrollbar-width: none;
    box-shadow: 0 10px 28px rgba(0,0,0,0.28);
  }
  .pill-nav::-webkit-scrollbar { display: none; }
  .pill {
    padding: .3rem .6rem;
    border-radius: 99px;
    font-size: .65rem;
    font-weight: 500;
    color: var(--text-4);
    text-decoration: none;
    transition: all .2s;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1;
  }
  .pill:hover {
    color: var(--text-2);
    background: rgba(39,39,42,0.6);
  }
  .pill-active {
    color: var(--text);
    background: var(--border-hover);
  }
  [data-theme='light'] .pill-nav {
    background: rgba(255,255,255,0.96);
    border-color: #cbd5e1;
    box-shadow: 0 8px 28px rgba(24,24,27,0.08);
  }
  [data-theme='light'] .pill {
    color: #71717a;
  }
  [data-theme='light'] .pill:hover {
    color: #18181b;
    background: rgba(24,24,27,0.05);
  }
  [data-theme='light'] .pill-active {
    color: #18181b;
    background: #e4e4e7;
  }
</style>
