---
import { basisFileRefs, entityRefs } from '../../lib/docs-data';

interface Props {
  project: string;
  snapshotId: string;
  snapshot: any;
  allSnapshots?: any[];
}

const { project, snapshotId, snapshot, allSnapshots = [] } = Astro.props;
const components = Array.isArray(snapshot.components) ? snapshot.components : [];
const flows = Array.isArray(snapshot.flows) ? snapshot.flows : [];
const stack = Array.isArray(snapshot.stack) ? snapshot.stack : [];
const patterns = Array.isArray(snapshot.patterns) ? snapshot.patterns : [];
const concerns = Array.isArray(snapshot.concerns) ? snapshot.concerns : [];
const stories = Array.isArray(snapshot.stories) ? snapshot.stories : [];
const observability = snapshot.observability || {};
const scenarios = Array.isArray(observability.scenarios) ? observability.scenarios : [];

const componentNames = new Map(components.filter((item: any) => item?.id).map((item: any) => [item.id, item.name || item.id]));
const flowNames = new Map(flows.filter((item: any) => item?.id).map((item: any) => [item.id, item.name || item.id]));

function entityLinks(basis: any) {
  return [
    ...entityRefs(basis, ['component_ids']).map((id) => ({ id, label: componentNames.get(id) || id, href: `#component-${id}` })),
    ...entityRefs(basis, ['flow_ids']).map((id) => ({ id, label: flowNames.get(id) || id, href: `#flow-${id}` })),
    ...entityRefs(basis, ['concern_ids']).map((id) => ({ id, label: id, href: `#concern-${id}` })),
    ...entityRefs(basis, ['observability_ids']).map((id) => ({ id, label: id, href: `#observability-${id}` })),
  ];
}
---

<main class="snapshot-shell">
  <section class="snapshot-hero">
    <div>
      <div class="eyebrow">Snapshot · <span>{snapshot.sha || snapshotId}</span></div>
      <h1>{snapshot.project || project}</h1>
      <p>{snapshot.summary || snapshot.purpose}</p>
    </div>
    <div class="snapshot-switcher">
      <label for="snapshot-select">Snapshot</label>
      <select id="snapshot-select" data-snapshot-switcher>
        {allSnapshots.map((entry: any) => (
          <option value={entry.snapshotId} selected={entry.snapshotId === snapshotId}>
            {(entry.sha || entry.snapshotId).slice(0, 12)}
          </option>
        ))}
      </select>
    </div>
  </section>

  <section class="metrics-grid">
    <a href="#components" class="metric-card"><span>{components.length}</span><div>Components</div></a>
    <a href="#flows" class="metric-card"><span>{flows.length}</span><div>Flows</div></a>
    <a href="#observability" class="metric-card"><span>{scenarios.length}</span><div>Failure Scenarios</div></a>
    <a href="#concerns" class="metric-card"><span>{concerns.length}</span><div>Concerns</div></a>
  </section>

  <section class="section-grid">
    <article class="section-panel" id="identity">
      <h2>System Identity</h2>
      <p>{snapshot.purpose}</p>
      <div class="pill-list">
        {(snapshot.system_kinds || []).map((entry: any) => <span>{entry.label || entry.id}</span>)}
      </div>
    </article>

    <article class="section-panel" id="stack">
      <h2>Stack</h2>
      <div class="item-list compact">
        {stack.map((entry: any) => (
          <div class="item-row">
            <strong>{entry.label || entry.id}</strong>
            {entry.role && <span>{entry.role}</span>}
          </div>
        ))}
      </div>
    </article>
  </section>

  <section class="snapshot-section" id="components">
    <div class="section-heading">
      <h2>Components</h2>
      <p>Current responsibilities, boundaries, and direct relationships.</p>
    </div>
    <div class="card-grid">
      {components.map((component: any) => (
        <article class="snapshot-card" id={`component-${component.id}`}>
          <div class="card-head">
            <h3>{component.name || component.id}</h3>
            <span>{component.behavioral_role}</span>
          </div>
          <p>{component.description}</p>
          {Array.isArray(component.relationships) && component.relationships.length > 0 && (
            <div class="sublist">
              <div class="subhead">Relationships</div>
              {component.relationships.map((relationship: any) => (
                <div class="relation">
                  <span>{relationship.type}</span>
                  <a href={`#component-${relationship.to}`}>{componentNames.get(relationship.to) || relationship.to}</a>
                  <p>{relationship.description}</p>
                </div>
              ))}
            </div>
          )}
          {basisFileRefs(component.basis).length > 0 && (
            <div class="basis">{basisFileRefs(component.basis).map((ref) => <code>{ref}</code>)}</div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="snapshot-section" id="flows">
    <div class="section-heading">
      <h2>Flows</h2>
      <p>How work and state move through the repo.</p>
    </div>
    <div class="flow-list">
      {flows.map((flow: any) => (
        <article class="snapshot-card" id={`flow-${flow.id}`}>
          <div class="card-head">
            <h3>{flow.name || flow.id}</h3>
            <span>{flow.trigger}</span>
          </div>
          <p>{flow.description}</p>
          <div class="flow-frame">
            <div><strong>Trigger</strong><span>{flow.trigger}</span></div>
            <div><strong>Outcome</strong><span>{flow.outcome}</span></div>
          </div>
          <ol class="steps">
            {(flow.steps || []).map((step: any) => (
              <li>
                <a href={`#component-${step.component_id}`}>{componentNames.get(step.component_id) || step.component_id}</a>
                <span>{step.action}</span>
                {step.target_id && <a href={`#component-${step.target_id}`}>{componentNames.get(step.target_id) || step.target_id}</a>}
                <em>{step.effect}</em>
              </li>
            ))}
          </ol>
        </article>
      ))}
    </div>
  </section>

  <section class="snapshot-section" id="patterns">
    <div class="section-heading">
      <h2>Patterns</h2>
      <p>Reusable architecture and code concepts that explain the current shape.</p>
    </div>
    <div class="card-grid small">
      {patterns.map((pattern: any) => (
        <article class="snapshot-card">
          <div class="card-head">
            <h3>{pattern.name || pattern.pattern_id || pattern.id}</h3>
            <span>{pattern.pattern_id}</span>
          </div>
          <p>{pattern.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="snapshot-section" id="observability">
    <div class="section-heading">
      <h2>Observability</h2>
      <p>{observability.summary || 'What could go wrong and what should be watched.'}</p>
    </div>
    <div class="flow-list">
      {scenarios.map((scenario: any) => (
        <article class="snapshot-card" id={`observability-${scenario.id}`}>
          <div class="card-head">
            <h3>{scenario.title || scenario.id}</h3>
            <span>{scenario.path?.outcome}</span>
          </div>
          <p>{scenario.description}</p>
          <div class="item-list compact">
            {(scenario.measurements || []).map((measurement: any) => (
              <div class="item-row"><strong>{measurement.label || measurement.name || measurement.id}</strong><span>{measurement.description}</span></div>
            ))}
            {(scenario.states || []).map((state: any) => (
              <div class="item-row"><strong>{state.label || state.name || state.id}</strong><span>{state.description}</span></div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="snapshot-section" id="concerns">
    <div class="section-heading">
      <h2>Concerns</h2>
      <p>Current issues that matter to Augur’s understanding and future updates.</p>
    </div>
    <div class="card-grid small">
      {concerns.map((concern: any) => (
        <article class="snapshot-card" id={`concern-${concern.id}`}>
          <div class="card-head">
            <h3>{concern.title || concern.id}</h3>
            <span>{concern.kind}</span>
          </div>
          <p>{concern.summary}</p>
          {entityLinks(concern.basis).length > 0 && (
            <div class="link-list">{entityLinks(concern.basis).map((link) => <a href={link.href}>{link.label}</a>)}</div>
          )}
        </article>
      ))}
    </div>
  </section>

  <section class="snapshot-section" id="stories">
    <div class="section-heading">
      <h2>Reading Paths</h2>
      <p>Current-state paths through the snapshot for humans reading the repo.</p>
    </div>
    <div class="flow-list">
      {stories.map((story: any) => (
        <article class="snapshot-card">
          <h3>{story.title || story.id}</h3>
          <div class="item-list compact">
            {(story.objectives || []).map((objective: any) => (
              <div class="item-row"><strong>{objective.id}</strong><span>{objective.text}</span></div>
            ))}
          </div>
          {(story.chapters || []).map((chapter: any) => (
            <div class="chapter">
              <h4>{chapter.title || chapter.id}</h4>
              <ul>
                {(chapter.teaches || []).map((point: any) => <li>{point.point}</li>)}
              </ul>
            </div>
          ))}
        </article>
      ))}
    </div>
  </section>
</main>

<script define:vars={{ project }}>
  document.querySelector('[data-snapshot-switcher]')?.addEventListener('change', (event) => {
    const next = event.target.value;
    window.location.href = `/${project.replace('--', '/')}/snapshots/${next}/`;
  });
</script>

<style>
  .snapshot-shell { max-width: 1180px; margin: 0 auto; padding: 2rem 1.25rem 4rem; }
  .snapshot-hero {
    min-height: 260px;
    display: grid;
    grid-template-columns: 1fr minmax(220px, 280px);
    gap: 2rem;
    align-items: end;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.5rem;
  }
  .eyebrow { color: var(--text-4); font-family: var(--mono); font-size: .78rem; margin-bottom: .8rem; }
  .snapshot-hero h1 { font-size: clamp(2rem, 5vw, 4.5rem); line-height: .95; letter-spacing: 0; max-width: 840px; }
  .snapshot-hero p { margin-top: 1rem; color: var(--text-2); font-size: 1.05rem; line-height: 1.65; max-width: 760px; }
  .snapshot-switcher {
    border: 1px solid var(--border);
    background: var(--bg-raised);
    border-radius: 8px;
    padding: .9rem;
  }
  .snapshot-switcher label { display: block; color: var(--text-4); font-size: .72rem; font-weight: 700; text-transform: uppercase; margin-bottom: .45rem; }
  .snapshot-switcher select {
    width: 100%;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .6rem;
    font-family: var(--mono);
  }
  .metrics-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; margin: 1rem 0 2rem; }
  .metric-card, .section-panel, .snapshot-card {
    border: 1px solid var(--border);
    background: var(--bg-card);
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
  }
  .metric-card { padding: 1rem; }
  .metric-card span { display: block; font-size: 2rem; font-weight: 800; color: var(--accent); }
  .metric-card div { color: var(--text-3); font-size: .82rem; }
  .section-grid { display: grid; grid-template-columns: 1.2fr .8fr; gap: 1rem; margin-bottom: 2.5rem; }
  .section-panel, .snapshot-card { padding: 1rem; }
  .section-panel h2, .section-heading h2 { font-size: 1.4rem; margin-bottom: .45rem; }
  .section-panel p, .section-heading p, .snapshot-card p { color: var(--text-2); line-height: 1.55; }
  .pill-list, .basis, .link-list { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .8rem; }
  .pill-list span, .card-head span, .basis code, .link-list a {
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--text-3);
    border-radius: 999px;
    padding: .25rem .5rem;
    font-size: .74rem;
    text-decoration: none;
  }
  .snapshot-section { margin-top: 3rem; scroll-margin-top: 5rem; }
  .section-heading { margin-bottom: 1rem; }
  .card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
  .card-grid.small { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .flow-list { display: grid; gap: 1rem; }
  .card-head { display: flex; justify-content: space-between; align-items: start; gap: 1rem; margin-bottom: .7rem; }
  .card-head h3, .snapshot-card h3 { font-size: 1.05rem; line-height: 1.25; }
  .sublist, .item-list, .chapter { margin-top: .9rem; }
  .subhead { color: var(--text-4); font-size: .72rem; font-weight: 700; text-transform: uppercase; margin-bottom: .4rem; }
  .relation, .item-row {
    border-top: 1px solid var(--border);
    padding: .65rem 0;
    display: grid;
    gap: .25rem;
  }
  .relation span, .item-row span { color: var(--text-3); font-size: .82rem; line-height: 1.45; }
  .relation a { color: var(--accent); text-decoration: none; font-weight: 650; }
  .flow-frame { display: grid; grid-template-columns: repeat(2, 1fr); gap: .65rem; margin: .9rem 0; }
  .flow-frame div { border: 1px solid var(--border); border-radius: 8px; padding: .75rem; background: var(--bg-raised); }
  .flow-frame strong { display: block; font-size: .72rem; color: var(--text-4); text-transform: uppercase; margin-bottom: .25rem; }
  .flow-frame span { color: var(--text-2); }
  .steps { display: grid; gap: .65rem; margin-left: 0; list-style: none; }
  .steps li { display: grid; grid-template-columns: minmax(120px, .8fr) 1fr minmax(120px, .8fr); gap: .5rem; align-items: start; border-top: 1px solid var(--border); padding-top: .65rem; }
  .steps a { color: var(--accent); text-decoration: none; }
  .steps em { grid-column: 1 / -1; color: var(--text-3); font-style: normal; }
  .chapter h4 { margin-bottom: .45rem; }
  .chapter ul { color: var(--text-2); margin-left: 1rem; line-height: 1.55; }
  @media (max-width: 860px) {
    .snapshot-hero, .section-grid, .metrics-grid, .card-grid, .card-grid.small, .flow-frame { grid-template-columns: 1fr; }
    .steps li { grid-template-columns: 1fr; }
  }
</style>
