---
/**
 * Shared header — translucent bar with logo, badge, nav links, theme toggle.
 * Used by all custom project pages (homepage, journey, atlas, etc.).
 */
import { displayProjectTitle, getProjectIndex, projectAnalysesRoutePath, projectAtlasRoutePath, projectRoutePath } from '../lib/docs-data';

interface Props {
  project: string;
  currentProject?: string;
  projects?: { slug: string; title: string; purpose?: string; componentCount?: number }[];
  badge?: string;
  links?: { label: string; href: string }[];
  position?: 'fixed' | 'sticky';
  active?: string;
}
const { project, currentProject, projects: explicitProjects = [], badge, links = [], position = 'fixed', active } = Astro.props;
const projects = explicitProjects.length > 0 || !currentProject ? explicitProjects : await getProjectIndex();
const hasProjectSwitcher = projects.length > 0;
const displayProject = displayProjectTitle(project);
---

<header class:list={['site-header', position === 'sticky' && 'sticky']}>
  <div class="h-left">
    {hasProjectSwitcher ? (
      <button
        class:list={['h-brand', 'h-brand-button']}
        type="button"
        title="Open project switcher"
        aria-label="Open project switcher"
        data-project-switcher-trigger="true"
      >
        <img src="/logo_dark.png?v=2" alt="Kordinate" class="logo-dark" />
        <img src="/logo_light.png?v=2" alt="Kordinate" class="logo-light" />
        <span class="h-sep"></span>
        <span class="h-logo">{displayProject}</span>
      </button>
    ) : (
      <a class="h-brand" href="/" title="Home">
        <img src="/logo_dark.png?v=2" alt="Kordinate" class="logo-dark" />
        <img src="/logo_light.png?v=2" alt="Kordinate" class="logo-light" />
        <span class="h-sep"></span>
        <span class="h-logo">{displayProject}</span>
      </a>
    )}
    {badge && <span class="h-env">{badge}</span>}
  </div>
  <div class="h-right">
    {links.map(link => (
      <a class:list={['h-link', active === link.label.toLowerCase() && 'h-link-active']} href={link.href}>{link.label}</a>
    ))}
    <button class="h-theme-toggle" title="Toggle theme" aria-label="Toggle dark/light theme">
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <a class="h-gh" href="https://github.com/Kord96" title="GitHub" aria-label="GitHub">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
    </a>
  </div>
</header>

{hasProjectSwitcher && (
  <>
    <div class="project-switcher-backdrop" id="project-switcher-backdrop"></div>
    <aside class="project-switcher" id="project-switcher" aria-hidden="true">
      <div class="project-switcher-head">
        <div>
          <div class="project-switcher-kicker">Projects</div>
          <div class="project-switcher-title">Switch project</div>
        </div>
        <button class="project-switcher-close" id="project-switcher-close" type="button" aria-label="Close project switcher">✕</button>
      </div>
      <div class="project-switcher-list">
        {projects.map((entry) => {
          const displayTitle = displayProjectTitle(entry.slug, entry.title);
          const isCurrent = currentProject === entry.slug;
          if (isCurrent) {
            return (
              <details class:list={['project-switcher-item', 'project-switcher-item-active']} open>
                <summary class="project-switcher-summary">
                  <div class="project-switcher-row">
                    <span class="project-switcher-name">{displayTitle}</span>
                    <div class="project-switcher-summary-right">
                      {typeof entry.componentCount === 'number' && entry.componentCount > 0 && <span class="project-switcher-count">{entry.componentCount}</span>}
                      <span class="project-switcher-chevron">▾</span>
                    </div>
                  </div>
                  {entry.purpose && <div class="project-switcher-purpose">{entry.purpose}</div>}
                </summary>
                <div class="project-switcher-links">
                  <a class="project-switcher-link" href={projectRoutePath(entry.slug)}>Journey</a>
                  <a class="project-switcher-link" href={projectAtlasRoutePath(entry.slug)}>Atlas</a>
                  <a class="project-switcher-link" href={projectAnalysesRoutePath(entry.slug)}>History</a>
                </div>
              </details>
            );
          }

          return (
            <a class="project-switcher-card" href={projectRoutePath(entry.slug)}>
              <div class="project-switcher-row">
                <span class="project-switcher-name">{displayTitle}</span>
                {typeof entry.componentCount === 'number' && entry.componentCount > 0 && <span class="project-switcher-count">{entry.componentCount}</span>}
              </div>
              {entry.purpose && <div class="project-switcher-purpose">{entry.purpose}</div>}
            </a>
          );
        })}
      </div>
    </aside>
  </>
)}

<script>
  // Theme toggle — persist in localStorage
  (function() {
    const stored = localStorage.getItem('theme');
    if (stored) {
      document.documentElement.dataset.theme = stored;
    }
  })();

  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.h-theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme;
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  });

  document.addEventListener('DOMContentLoaded', () => {
    const trigger = document.querySelector('[data-project-switcher-trigger="true"]');
    const drawer = document.getElementById('project-switcher');
    const backdrop = document.getElementById('project-switcher-backdrop');
    const close = document.getElementById('project-switcher-close');
    if (!trigger || !drawer || !backdrop) return;

    const setOpen = (open) => {
      drawer.classList.toggle('project-switcher-open', open);
      backdrop.classList.toggle('project-switcher-backdrop-open', open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.body.classList.toggle('project-switcher-active', open);
    };

    trigger.addEventListener('click', () => setOpen(true));
    backdrop.addEventListener('click', () => setOpen(false));
    close?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  });
</script>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 0 1.5rem; height: 40px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(9,9,11,0.85); backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid var(--border);
  }
  .site-header.sticky {
    position: sticky;
    height: 48px;
  }
  .h-left { display: flex; align-items: center; gap: .6rem; }
  .h-logo { font-weight: 700; font-size: .85rem; letter-spacing: -.02em; }
  .h-sep {
    width: 1px; height: 1.2rem;
    background: var(--border-hover);
  }
  .h-env {
    font-size: .5rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em;
    padding: .1rem .35rem; border-radius: 3px;
    background: rgba(251,191,36,.12); color: #fbbf24; border: 1px solid rgba(251,191,36,.2);
  }
  .h-right { display: flex; gap: .4rem; align-items: center; }
  .h-link {
    font-size: .7rem; color: var(--text-4); text-decoration: none;
    padding: .2rem .5rem; border: 1px solid var(--border); border-radius: 4px;
    transition: all .2s;
  }
  .h-link:hover { color: var(--text-2); }
  .h-link-active { color: var(--text-2); }
  .h-brand {
    display: flex; align-items: center; gap: .6rem;
    color: inherit; text-decoration: none;
  }
  .h-brand-button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .h-brand img {
    height: 32px; width: auto; max-height: 32px; opacity: 0.8;
    transition: opacity .2s;
  }
  .h-brand:hover img,
  .h-brand:hover .h-logo { opacity: 1; }
  .logo-light { display: none; }
  :global([data-theme='light']) .logo-dark { display: none; }
  :global([data-theme='light']) .logo-light { display: block; }

  /* Theme toggle button */
  .h-theme-toggle {
    display: flex; align-items: center; justify-content: center;
    width: 28px; height: 28px;
    background: none; border: none;
    color: var(--text-3); cursor: pointer;
    transition: all .2s;
  }
  .h-theme-toggle:hover {
    color: var(--text-2);
  }
  /* In dark mode (default): show sun, hide moon */
  .icon-moon { display: none; }
  .icon-sun { display: block; }
  :global([data-theme='light']) .icon-sun { display: none; }
  :global([data-theme='light']) .icon-moon { display: block; }

  /* GitHub icon link */
  .h-gh {
    display: flex; align-items: center; justify-content: center;
    color: var(--text-3);
    transition: color .2s;
  }
  .h-gh:hover { color: var(--text-2); }

  /* Light mode header */
  :global([data-theme='light']) .site-header {
    background: rgba(255,255,255,0.9);
    border-bottom-color: #e4e4e7;
  }
  :global([data-theme='light']) .h-logo { color: #18181b; }
  :global([data-theme='light']) .h-env {
    background: rgba(251,191,36,0.15);
    color: #92400e;
    border-color: rgba(251,191,36,0.3);
  }
  :global([data-theme='light']) .h-sep { background: #d4d4d8; }
  :global([data-theme='light']) .h-link {
    color: #3f3f46;
    border-color: #d4d4d8;
  }
  :global([data-theme='light']) .h-link:hover,
  :global([data-theme='light']) .h-link-active {
    color: #18181b;
    border-color: #a1a1aa;
  }
  :global([data-theme='light']) .h-theme-toggle {
    color: #52525b;
    border-color: #d4d4d8;
  }
  :global([data-theme='light']) .h-theme-toggle:hover {
    color: #18181b;
    border-color: #a1a1aa;
  }
  :global([data-theme='light']) .h-gh {
    color: #52525b;
  }
  :global([data-theme='light']) .h-gh:hover { color: #18181b; }

  .project-switcher-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,.45);
    opacity: 0;
    pointer-events: none;
    transition: opacity .2s;
    z-index: 109;
  }
  .project-switcher-backdrop-open {
    opacity: 1;
    pointer-events: auto;
  }
  .project-switcher {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: min(30rem, 90vw);
    transform: translateX(-100%);
    transition: transform .22s ease;
    background: rgba(9,9,11,.98);
    border-right: 1px solid var(--border);
    z-index: 110;
    display: flex;
    flex-direction: column;
  }
  .project-switcher-open {
    transform: translateX(0);
  }
  .project-switcher-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.1rem 1rem .9rem;
    border-bottom: 1px solid var(--border);
  }
  .project-switcher-kicker {
    color: var(--text-4);
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .08em;
  }
  .project-switcher-title {
    font-size: 1rem;
    font-weight: 700;
    margin-top: .2rem;
  }
  .project-switcher-close {
    background: none;
    border: none;
    color: var(--text-3);
    cursor: pointer;
    font-size: 1rem;
  }
  .project-switcher-list {
    padding: .75rem;
    display: grid;
    gap: .6rem;
    overflow: auto;
  }
  .project-switcher-card,
  .project-switcher-item {
    display: block;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: rgba(255,255,255,.02);
    overflow: hidden;
  }
  .project-switcher-card {
    padding: .85rem .9rem;
    text-decoration: none;
    color: inherit;
    transition: border-color .18s ease, background .18s ease;
  }
  .project-switcher-card:hover,
  .project-switcher-item:hover,
  .project-switcher-item-active {
    border-color: var(--border-hover);
    background: rgba(255,255,255,.04);
  }
  .project-switcher-summary {
    list-style: none;
    cursor: pointer;
    padding: .85rem .9rem;
    display: grid;
    gap: .35rem;
  }
  .project-switcher-summary::-webkit-details-marker {
    display: none;
  }
  .project-switcher-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
  }
  .project-switcher-summary-right {
    display: flex;
    align-items: center;
    gap: .55rem;
    flex-shrink: 0;
  }
  .project-switcher-name {
    font-weight: 700;
  }
  .project-switcher-count {
    font-family: var(--mono);
    font-size: .72rem;
    color: var(--text-3);
  }
  .project-switcher-purpose {
    color: var(--text-3);
    font-size: .78rem;
    line-height: 1.45;
  }
  .project-switcher-chevron {
    color: var(--text-4);
    font-size: .8rem;
    transition: transform .18s ease;
  }
  .project-switcher-item[open] .project-switcher-chevron {
    transform: rotate(180deg);
  }
  .project-switcher-links {
    display: flex;
    gap: .5rem;
    flex-wrap: wrap;
    padding: 0 .9rem .9rem;
    border-top: 1px solid var(--border);
    margin-top: .1rem;
    padding-top: .8rem;
  }
  .project-switcher-link {
    text-decoration: none;
    font-size: .74rem;
    font-weight: 600;
    color: var(--accent);
    background: var(--accent-dim);
    border: 1px solid var(--accent-border);
    border-radius: 999px;
    padding: .25rem .65rem;
    transition: all .18s;
  }
  .project-switcher-link:hover {
    background: var(--accent);
    color: #fff;
  }
  :global(body.project-switcher-active) {
    overflow: hidden;
  }
  :global([data-theme='light']) .project-switcher {
    background: rgba(255,255,255,.98);
    border-right-color: #e4e4e7;
  }
  :global([data-theme='light']) .project-switcher-card,
  :global([data-theme='light']) .project-switcher-item {
    background: #fff;
    border-color: #e4e4e7;
  }
  :global([data-theme='light']) .project-switcher-card:hover,
  :global([data-theme='light']) .project-switcher-item:hover,
  :global([data-theme='light']) .project-switcher-item-active {
    border-color: #a1a1aa;
    background: #fafafa;
  }
  :global([data-theme='light']) .project-switcher-links {
    border-top-color: #e4e4e7;
  }
  :global([data-theme='light']) .project-switcher-link {
    color: #3730a3;
    background: rgba(79,70,229,0.08);
    border-color: rgba(79,70,229,0.18);
  }
  :global([data-theme='light']) .project-switcher-link:hover {
    color: #fff;
    background: #4f46e5;
  }
</style>
