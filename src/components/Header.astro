---
import { displayProjectTitle, getProjectIndex, projectRoutePath, projectSnapshotsRoutePath, splitDisplayProjectTitle } from '../lib/docs-data';

interface Props {
  project?: string;
  currentProject?: string;
  projects?: { slug: string; title: string; purpose?: string; componentCount?: number; currentSha?: string }[];
  active?: 'snapshot' | 'snapshots' | 'repos';
}

const { project = 'Repositories', currentProject = '', projects: explicitProjects = [], active = 'snapshot' } = Astro.props;
const projects = explicitProjects.length > 0 ? explicitProjects : await getProjectIndex();
const hasProjectSwitcher = projects.length > 0;
const currentProjectParts = splitDisplayProjectTitle(currentProject || project, project);
---

<header class="site-header">
  <div class="h-top">
    <div class="h-left">
      <a class="h-brand" href="/" title="Repositories">
        <img src="/logo_dark.png?v=2" alt="Kordinate" class="logo-dark" />
        <img src="/logo_light.png?v=2" alt="Kordinate" class="logo-light" />
        <span class="h-sep" aria-hidden="true"></span>
        <span class="h-project-id">
          {currentProjectParts.owner && <span class="h-project-owner">{currentProjectParts.owner}</span>}
          {currentProjectParts.owner && <span class="h-project-slash">/</span>}
          <span class="h-project-repo">{currentProjectParts.repo}</span>
        </span>
      </a>
      {hasProjectSwitcher && (
        <button class="h-switch" type="button" data-project-switcher-trigger="true">Switch repo</button>
      )}
    </div>
    <nav class="h-nav" aria-label="Primary">
      {currentProject && <a class:list={[active === 'snapshot' && 'active']} href={projectRoutePath(currentProject)}>Snapshot</a>}
      {currentProject && <a class:list={[active === 'snapshots' && 'active']} href={projectSnapshotsRoutePath(currentProject)}>Snapshots</a>}
      <a class:list={[active === 'repos' && 'active']} href="/">Repos</a>
      <a href="/login/">Sign in</a>
      <button class="h-theme-toggle" title="Toggle theme" aria-label="Toggle dark/light theme">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      </button>
    </nav>
  </div>
</header>

{hasProjectSwitcher && (
  <>
    <div class="project-switcher-backdrop" id="project-switcher-backdrop"></div>
    <aside class="project-switcher" id="project-switcher" aria-hidden="true">
      <div class="project-switcher-head">
        <div>
          <div class="project-switcher-kicker">Accessible repositories</div>
          <div class="project-switcher-title">Switch snapshot source</div>
        </div>
        <button class="project-switcher-close" id="project-switcher-close" type="button" aria-label="Close project switcher">x</button>
      </div>
      <div class="project-switcher-list">
        {projects.map((entry) => {
          const displayParts = splitDisplayProjectTitle(entry.slug, entry.title);
          return (
            <a class:list={['project-switcher-card', currentProject === entry.slug && 'project-switcher-item-active']} href={projectRoutePath(entry.slug)}>
              <div class="project-switcher-row">
                <span class="project-switcher-name">
                  {displayParts.owner && <span class="project-switcher-owner">{displayParts.owner}</span>}
                  {displayParts.owner && <span class="project-switcher-slash">/</span>}
                  <span class="project-switcher-repo">{displayParts.repo}</span>
                </span>
                {entry.currentSha && <span class="project-switcher-count">{entry.currentSha.slice(0, 7)}</span>}
              </div>
              {entry.purpose && <div class="project-switcher-purpose">{entry.purpose}</div>}
            </a>
          );
        })}
      </div>
    </aside>
  </>
)}

<script>
  (function() {
    const stored = localStorage.getItem('theme');
    if (stored) document.documentElement.dataset.theme = stored;
  })();

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelector('.h-theme-toggle')?.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });

    const trigger = document.querySelector('[data-project-switcher-trigger="true"]');
    const drawer = document.getElementById('project-switcher');
    const backdrop = document.getElementById('project-switcher-backdrop');
    const close = document.getElementById('project-switcher-close');
    if (!trigger || !drawer || !backdrop) return;
    const setOpen = (open) => {
      drawer.classList.toggle('project-switcher-open', open);
      backdrop.classList.toggle('project-switcher-backdrop-open', open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
    };
    trigger.addEventListener('click', () => setOpen(true));
    backdrop.addEventListener('click', () => setOpen(false));
    close?.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setOpen(false);
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(9,9,11,0.9);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
  }
  .h-top {
    min-height: 52px;
    padding: .45rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .h-left, .h-nav, .h-brand, .h-project-id {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .h-left { gap: .75rem; }
  .h-brand {
    gap: .6rem;
    color: inherit;
    text-decoration: none;
  }
  .h-brand img { height: 30px; width: auto; opacity: .85; }
  .logo-light { display: none; }
  :global([data-theme='light']) .logo-dark { display: none; }
  :global([data-theme='light']) .logo-light { display: block; }
  .h-sep { width: 1px; height: 1.15rem; background: var(--border); }
  .h-project-id { gap: .12rem; line-height: 1; }
  .h-project-owner, .h-project-slash { color: var(--text-4); font-size: .75rem; font-weight: 600; }
  .h-project-repo { color: var(--text-2); font-size: .82rem; font-weight: 750; }
  .h-switch, .h-nav a, .h-theme-toggle {
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--text-2);
    border-radius: 8px;
    padding: .42rem .62rem;
    text-decoration: none;
    font: inherit;
    font-size: .78rem;
    cursor: pointer;
  }
  .h-nav { gap: .45rem; }
  .h-nav a.active { color: var(--text); border-color: var(--accent-border); background: var(--accent-dim); }
  .h-theme-toggle { width: 32px; height: 32px; display: grid; place-items: center; padding: 0; }
  .icon-moon { display: none; }
  :global([data-theme='light']) .icon-sun { display: none; }
  :global([data-theme='light']) .icon-moon { display: block; }

  .project-switcher-backdrop {
    position: fixed;
    inset: 0;
    z-index: 199;
    background: rgba(0,0,0,.35);
    opacity: 0;
    pointer-events: none;
    transition: opacity .18s ease;
  }
  .project-switcher-backdrop-open { opacity: 1; pointer-events: auto; }
  .project-switcher {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(420px, 100vw);
    z-index: 200;
    transform: translateX(100%);
    transition: transform .2s ease;
    background: var(--bg);
    border-left: 1px solid var(--border);
    padding: 1rem;
    overflow: auto;
  }
  .project-switcher-open { transform: translateX(0); }
  .project-switcher-head, .project-switcher-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }
  .project-switcher-kicker { color: var(--text-4); font-size: .72rem; text-transform: uppercase; font-weight: 700; }
  .project-switcher-title { font-size: 1.1rem; font-weight: 800; }
  .project-switcher-close {
    border: 1px solid var(--border);
    background: var(--bg-raised);
    color: var(--text);
    border-radius: 8px;
    width: 32px;
    height: 32px;
  }
  .project-switcher-list { display: grid; gap: .65rem; margin-top: 1rem; }
  .project-switcher-card {
    display: block;
    color: inherit;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .85rem;
    background: var(--bg-raised);
  }
  .project-switcher-card:hover, .project-switcher-item-active { border-color: var(--accent-border); background: var(--accent-dim); }
  .project-switcher-name { font-weight: 750; }
  .project-switcher-owner, .project-switcher-slash { color: var(--text-4); }
  .project-switcher-count {
    color: var(--text-3);
    font-family: var(--mono);
    font-size: .72rem;
  }
  .project-switcher-purpose { color: var(--text-3); font-size: .8rem; margin-top: .4rem; line-height: 1.45; }
  @media (max-width: 760px) {
    .h-top { align-items: flex-start; flex-direction: column; }
    .h-nav { flex-wrap: wrap; }
  }
</style>
