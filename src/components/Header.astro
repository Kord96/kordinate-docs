---
/**
 * Shared header — translucent bar with logo, badge, nav links, theme toggle.
 * Used by all custom project pages (homepage, journey, atlas, etc.).
 */
interface Props {
  project: string;
  badge?: string;
  links?: { label: string; href: string }[];
  position?: 'fixed' | 'sticky';
  active?: string;
}
const { project, badge, links = [], position = 'fixed', active } = Astro.props;
---

<header class:list={['site-header', position === 'sticky' && 'sticky']}>
  <div class="h-left">
    <a class="h-brand" href="/" title="Home">
      <img src="/logo_dark.png?v=2" alt="Kordinate" class="logo-dark" />
      <img src="/logo_light.png?v=2" alt="Kordinate" class="logo-light" />
      <span class="h-sep"></span>
      <span class="h-logo">{project}</span>
    </a>
    {badge && <span class="h-env">{badge}</span>}
  </div>
  <div class="h-right">
    {links.map(link => (
      <a class:list={['h-link', active === link.label.toLowerCase() && 'h-link-active']} href={link.href}>{link.label}</a>
    ))}
    <button class="h-theme-toggle" title="Toggle theme" aria-label="Toggle dark/light theme">
      <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
    </button>
    <a class="h-gh" href="https://github.com/Kord96" title="GitHub" aria-label="GitHub">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
    </a>
  </div>
</header>

<script>
  // Theme toggle — persist in localStorage
  (function() {
    const stored = localStorage.getItem('theme');
    if (stored) {
      document.documentElement.dataset.theme = stored;
    }
  })();

  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.querySelector('.h-theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme;
      const next = current === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      localStorage.setItem('theme', next);
    });
  });
</script>

<style>
  .site-header {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 0 1.5rem; height: 40px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(9,9,11,0.85); backdrop-filter: blur(16px) saturate(180%);
    border-bottom: 1px solid var(--border);
  }
  .site-header.sticky {
    position: sticky;
    height: 48px;
  }
  .h-left { display: flex; align-items: center; gap: .6rem; }
  .h-logo { font-weight: 700; font-size: .85rem; letter-spacing: -.02em; }
  .h-sep {
    width: 1px; height: 1.2rem;
    background: var(--border-hover);
  }
  .h-env {
    font-size: .5rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em;
    padding: .1rem .35rem; border-radius: 3px;
    background: rgba(251,191,36,.12); color: #fbbf24; border: 1px solid rgba(251,191,36,.2);
  }
  .h-right { display: flex; gap: .4rem; align-items: center; }
  .h-link {
    font-size: .7rem; color: var(--text-4); text-decoration: none;
    padding: .2rem .5rem; border: 1px solid var(--border); border-radius: 4px;
    transition: all .2s;
  }
  .h-link:hover { color: var(--text-2); }
  .h-link-active { color: var(--text-2); }
  .h-brand {
    display: flex; align-items: center; gap: .6rem;
    color: inherit; text-decoration: none;
  }
  .h-brand img {
    height: 32px; width: auto; max-height: 32px; opacity: 0.8;
    transition: opacity .2s;
  }
  .h-brand:hover img,
  .h-brand:hover .h-logo { opacity: 1; }
  .logo-light { display: none; }
  :global([data-theme='light']) .logo-dark { display: none; }
  :global([data-theme='light']) .logo-light { display: block; }

  /* Theme toggle button */
  .h-theme-toggle {
    display: flex; align-items: center; justify-content: center;
    width: 28px; height: 28px;
    background: none; border: none;
    color: var(--text-3); cursor: pointer;
    transition: all .2s;
  }
  .h-theme-toggle:hover {
    color: var(--text-2);
  }
  /* In dark mode (default): show sun, hide moon */
  .icon-moon { display: none; }
  .icon-sun { display: block; }
  :global([data-theme='light']) .icon-sun { display: none; }
  :global([data-theme='light']) .icon-moon { display: block; }

  /* GitHub icon link */
  .h-gh {
    display: flex; align-items: center; justify-content: center;
    color: var(--text-3);
    transition: color .2s;
  }
  .h-gh:hover { color: var(--text-2); }

  /* Light mode header */
  :global([data-theme='light']) .site-header {
    background: rgba(255,255,255,0.9);
    border-bottom-color: #e4e4e7;
  }
  :global([data-theme='light']) .h-logo { color: #18181b; }
  :global([data-theme='light']) .h-env {
    background: rgba(251,191,36,0.15);
    color: #92400e;
    border-color: rgba(251,191,36,0.3);
  }
  :global([data-theme='light']) .h-sep { background: #d4d4d8; }
  :global([data-theme='light']) .h-link {
    color: #3f3f46;
    border-color: #d4d4d8;
  }
  :global([data-theme='light']) .h-link:hover,
  :global([data-theme='light']) .h-link-active {
    color: #18181b;
    border-color: #a1a1aa;
  }
  :global([data-theme='light']) .h-theme-toggle {
    color: #52525b;
    border-color: #d4d4d8;
  }
  :global([data-theme='light']) .h-theme-toggle:hover {
    color: #18181b;
    border-color: #a1a1aa;
  }
  :global([data-theme='light']) .h-gh {
    color: #52525b;
  }
  :global([data-theme='light']) .h-gh:hover { color: #18181b; }
</style>
