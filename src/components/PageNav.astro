---
interface Props {
  tabs: { label: string; href: string; active?: boolean }[];
}
const { tabs } = Astro.props;
---

<nav class="page-nav">
  <div class="page-nav-inner">
    {tabs.map(tab => (
      <a class:list={['page-tab', tab.active && 'page-tab-active']} href={tab.href}>
        {tab.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .page-nav {
    padding: 0.75rem 1.5rem 0;
  }
  .page-nav-inner {
    max-width: 60rem;
    margin: 0 auto;
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.25rem;
    border: 1px solid var(--border, rgba(255,255,255,0.06));
    border-radius: 999px;
    background: var(--bg-raised, rgba(24,24,27,0.75));
    backdrop-filter: blur(12px);
  }
  .page-tab {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-3, #71717a);
    text-decoration: none;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    transition: all 0.2s;
  }
  .page-tab:hover {
    color: var(--text-2, #d4d4d8);
    background: rgba(255,255,255,0.04);
  }
  .page-tab-active {
    color: var(--text, #fafafa);
    background: rgba(129,140,248,0.14);
    border: 1px solid rgba(129,140,248,0.2);
    box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset;
  }

  :global([data-theme='light']) .page-nav {
    background: transparent;
  }
  :global([data-theme='light']) .page-nav-inner {
    background: rgba(255,255,255,0.9);
    border-color: #d4d4d8;
    box-shadow: 0 1px 0 rgba(24,24,27,0.03);
  }
  :global([data-theme='light']) .page-tab { color: #52525b; }
  :global([data-theme='light']) .page-tab:hover { color: #18181b; background: rgba(0,0,0,0.04); }
  :global([data-theme='light']) .page-tab-active { color: #18181b; background: rgba(79,70,229,0.1); border-color: rgba(79,70,229,0.2); }
</style>
