---
interface Props {
  tabs: { label: string; href: string; active?: boolean }[];
}
const { tabs } = Astro.props;
---

<nav class="page-nav">
  <div class="page-nav-inner">
    {tabs.map(tab => (
      <a class:list={['page-tab', tab.active && 'page-tab-active']} href={tab.href}>
        {tab.label}
      </a>
    ))}
  </div>
</nav>

<style>
  .page-nav {
    padding: 0.75rem 1.5rem 0;
  }
  .page-nav-inner {
    max-width: 60rem;
    margin: 0 auto;
    display: inline-flex;
    gap: 0.3rem;
    padding: 0.3rem;
    border: 1px solid var(--border-hover, rgba(255,255,255,0.08));
    border-radius: 999px;
    background: rgba(9,9,11,0.92);
    backdrop-filter: blur(16px) saturate(180%);
  }
  .page-tab {
    font-size: 0.68rem;
    font-weight: 600;
    color: var(--text-4, #a1a1aa);
    text-decoration: none;
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    transition: all 0.2s;
  }
  .page-tab:hover {
    color: var(--text-2, #e4e4e7);
    background: rgba(39,39,42,0.6);
  }
  .page-tab-active {
    color: var(--text, #fafafa);
    background: rgba(129,140,248,0.14);
    border: 1px solid rgba(129,140,248,0.2);
    box-shadow: 0 1px 0 rgba(255,255,255,0.04) inset;
  }

  :global([data-theme='light']) .page-nav {
    background: transparent;
  }
  :global([data-theme='light']) .page-nav-inner {
    background: rgba(255,255,255,0.96);
    border-color: #cbd5e1;
    box-shadow: 0 8px 28px rgba(24,24,27,0.08);
  }
  :global([data-theme='light']) .page-tab { color: #52525b; }
  :global([data-theme='light']) .page-tab:hover { color: #18181b; background: rgba(24,24,27,0.06); }
  :global([data-theme='light']) .page-tab-active { color: #18181b; background: rgba(79,70,229,0.1); border-color: rgba(79,70,229,0.2); }
</style>
