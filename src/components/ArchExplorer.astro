  function parseNarrativeToHtml(text) {
    if (!text) return '';
    // Split into blocks on double newlines
    var blocks = text.split(/\n\n+/);
    return blocks.map(function(block) {
      var trimmed = block.trim();
      if (!trimmed) return '';
      // Check for markdown headings
      var headingMatch = trimmed.match(/^(#{1,3})\s+(.*)$/);
      if (headingMatch) {
        var level = headingMatch[1].length + 1; // ## → h3, ### → h4 (shift by 1 since h2 is the title)
        var hText = headingMatch[2].replace(/\*\*([^*]+)\*\*/g, function(m, name) {
          var nid = resolveNodeId(name);
          if (nid) return '<span class="bp-node-ref" data-node-id="' + escapeHtml(nid) + '">' + escapeHtml(name) + '</span>';
          return '<strong>' + escapeHtml(name) + '</strong>';
        });
        return '<h' + level + '>' + hText + '</h' + level + '>';
      }
      // Regular paragraph
      var html = trimmed.replace(/\*\*([^*]+)\*\*/g, function(m, name) {
        var nid = resolveNodeId(name);
        if (nid) return '<span class="bp-node-ref" data-node-id="' + escapeHtml(nid) + '">' + escapeHtml(name) + '</span>';
        return '<strong>' + escapeHtml(name) + '</strong>';
      });
      html = html.replace(/ -- /g, ' — ');
      // Handle single newlines as line breaks within a paragraph
      html = html.replace(/\n/g, '<br>');
      return '<p>' + html + '</p>';
    }).join('');
  }

