---
import logoDark from '../assets/logo_dark.webp';

interface Props {
  title: string;
  subtitle: string;
  data: any;
  repoUrl: string;
  narratives?: {
    structure?: string;
    flows?: string;
    data?: string;
    resilience?: string;
  };
}

const { title, subtitle, data, repoUrl, narratives } = Astro.props;
---

<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} -- Architecture Explorer</title>

  <script src="https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js" is:inline></script>
  <script src="https://unpkg.com/layout-base@2.0.1/layout-base.js" is:inline></script>
  <script src="https://unpkg.com/cose-base@2.2.0/cose-base.js" is:inline></script>
  <script src="https://unpkg.com/cytoscape-cose-bilkent@4.1.0/cytoscape-cose-bilkent.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js" is:inline></script>
</head>
<body>

<!-- Embedded architecture data -->
<script id="arch-data" type="application/json" set:html={JSON.stringify(data)} />
<script id="repo-url" type="application/json" set:html={JSON.stringify(repoUrl)} />
<script id="narratives-data" type="application/json" set:html={JSON.stringify(narratives || {})} />

<!-- ===== NAV BAR ===== -->
<nav id="site-nav">
  <div class="nav-left">
    <a href="/" class="nav-logo-link">
      <img src={logoDark.src} alt="Docs" class="nav-logo" />
      <span class="nav-title">Docs</span>
    </a>
    <span class="nav-sep">/</span>
    <span class="nav-project">{title}</span>
  </div>
  <div class="nav-right">
    <div class="env-toggle" title="Environment">
      <button class="env-btn active" data-env="prod">prod</button>
      <button class="env-btn" data-env="dev">dev</button>
    </div>
    <a href="/" class="nav-link back-link">&larr; Back to docs</a>
    <a href={repoUrl} class="nav-link gh-link" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      GitHub
    </a>
  </div>
</nav>

<!-- ===== TAB BAR ===== -->
<div id="tab-bar">
  <button class="tab-btn active" data-tab="structure">
    <span class="tab-icon">&#9638;</span>Structure
  </button>
  <button class="tab-btn" data-tab="flows">
    <span class="tab-icon">&#8594;</span>Flows
  </button>
  <button class="tab-btn" data-tab="data">
    <span class="tab-icon">&#9707;</span>Data
  </button>
  <button class="tab-btn" data-tab="failure">
    <span class="tab-icon">&#9829;</span>Resilience
  </button>
  <div class="tab-description" id="tab-desc">Component hierarchy &mdash; expand and collapse to explore</div>
</div>

<!-- ===== TOOLTIP (shared) ===== -->
<div id="tooltip">
  <div class="tt-label"></div>
  <div class="tt-type"></div>
  <div class="tt-file"></div>
  <div class="tt-desc"></div>
  <div class="tt-exports"></div>
  <div class="tt-children-hint"></div>
</div>

<!-- ===== CONTEXT PANEL (bottom drawer) ===== -->
<div id="bottom-panel">
  <div id="bottom-panel-tabs">
    <button class="bp-tab active" data-bp-tab="details">Details</button>
    <button class="bp-tab" data-bp-tab="terminal">Terminal</button>
    <button id="bottom-panel-close" aria-label="Close">&times;</button>
  </div>
  <div class="bp-content active" id="bp-details">
    <div id="ctx-header">
      <span id="ctx-name"></span>
      <span id="ctx-type-badge"></span>
    </div>
    <a id="ctx-file" href="#" target="_blank" rel="noopener"></a>
    <p id="ctx-desc"></p>
    <div id="ctx-exports"></div>
  </div>
  <div class="bp-content" id="bp-terminal">
    <div class="terminal-body">
      <p class="terminal-welcome">Talk to this project's architecture. Ask questions, request changes, explore flows — Claude works in the background while you see the results live on the graph.</p>
      <div class="terminal-input-area">
        <span class="terminal-prompt">$</span>
        <input type="text" id="terminal-input" placeholder="Coming soon — ask anything about this architecture..." disabled />
      </div>
    </div>
  </div>
</div>

<!-- ===== SIDEBAR ===== -->
<div id="arch-sidebar">
  <div id="sidebar-header">
    <span id="sidebar-title">Structure</span>
    <button id="sidebar-collapse" title="Collapse sidebar">&#x276E;</button>
  </div>
  <div id="sidebar-content"></div>
</div>
<button id="sidebar-expand" title="Expand sidebar" style="display:none;">&#x276F;</button>

<!-- ===== TAB 1: STRUCTURE ===== -->
<div class="tab-panel active" id="structure-panel">
  <div id="cy-structure"></div>

  <div id="breadcrumb-bar">
    <div id="breadcrumb"></div>
    <div id="flow-dots"></div>
  </div>

  <button id="controls-toggle" title="Controls">&#9881;</button>
  <div id="controls-panel" class="controls-hidden">
    <div class="controls-section">
      <div class="controls-label">View</div>
      <button class="btn" id="btn-expand-all">Expand All</button>
      <button class="btn" id="btn-collapse-all">Collapse All</button>
      <button class="btn" id="btn-fit">Fit View</button>
      <button class="btn" id="btn-reset">Reset</button>
    </div>
  </div>

  <div id="info-badge"><span id="node-counter">Showing <strong>3</strong> of <strong>35</strong> nodes</span></div>

  <div id="bottom-left">
    <button id="terminal-toggle" title="Talk to this architecture">
      <svg width="20" height="18" viewBox="0 0 20 18" fill="none">
        <rect x="0.5" y="0.5" width="19" height="17" rx="3" stroke="currentColor" stroke-width="1"/>
        <path d="M4 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M4 5l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  <div id="flow-filters" style="display:none"></div>

  <button id="help-toggle" title="Help">?</button>
  <div id="help-panel" class="help-hidden">
    <div class="help-section">
      <div class="help-label">Interactions</div>
      <div class="help-tip">
        Click to expand &middot; Right-click to collapse<br>
        Scroll to zoom &middot; Drag to pan
      </div>
    </div>
    <div class="help-section">
      <div class="help-label">Node Types</div>
      <div class="legend-compact">
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="none" stroke="rgba(255,255,255,0.3)" stroke-dasharray="2 1"/></svg> Group</span>
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="#4a90d9"/></svg> Component</span>
        <span class="lc-item"><svg width="10" height="10"><polygon points="5,0 10,5 5,10 0,5" fill="#e67e22"/></svg> External</span>
        <span class="lc-item"><svg width="10" height="10"><polygon points="2,0 8,0 10,3 10,7 8,10 2,10 0,7 0,3" fill="#1abc9c"/></svg> Route</span>
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="#9b59b6"/></svg> Library</span>
        <span class="lc-item"><svg width="10" height="10"><circle cx="5" cy="5" r="4" fill="#e74c3c"/></svg> Config</span>
      </div>
    </div>
  </div>
</div>

<!-- ===== TAB 2: FLOWS ===== -->
<div class="tab-panel" id="flows-panel">
  <div class="flows-container" id="flows-container"></div>
</div>

<!-- ===== TAB 3: DATA ===== -->
<div class="tab-panel" id="data-panel">
  <div id="cy-data"></div>
  <div class="graph-legend" id="data-legend" style="display:none;">
    <h3>State Model</h3>
    <div class="legend-item">
      <div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="2" width="14" height="12" rx="3" fill="#e67e22"/></svg></div>
      Source of Truth
    </div>
    <div class="legend-item">
      <div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="2" width="14" height="12" rx="3" fill="#3498db"/></svg></div>
      Cache
    </div>
    <div class="legend-item">
      <div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="2" fill="#4a90d9"/></svg></div>
      Component (reader)
    </div>
    <div class="legend-item">
      <div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="2" fill="#9b59b6"/></svg></div>
      Store (writer)
    </div>
    <div class="legend-item" style="margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06);">
      <div class="legend-shape" style="opacity: 0.6;"><svg viewBox="0 0 16 16"><line x1="2" y1="8" x2="14" y2="8" stroke="#2ecc71" stroke-width="2"/></svg></div>
      <span style="color: #888;">Reads/writes state</span>
    </div>
  </div>
</div>

<!-- ===== TAB 4: RESILIENCE ===== -->
<div class="tab-panel" id="failure-panel">
  <div class="resilience-container" id="resilience-container"></div>
</div>

<script is:inline>
(function() {
  'use strict';

  // ==========================================================================
  // ARCHITECTURE DATA (loaded from embedded JSON element)
  // ==========================================================================
  var dataEl = document.getElementById('arch-data');
  var RAW = JSON.parse(dataEl.textContent);
  var REPO_URL = JSON.parse(document.getElementById('repo-url').textContent);
  var NARRATIVES = JSON.parse(document.getElementById('narratives-data').textContent || '{}');

  // ==========================================================================
  // DATA FLOWS (for Flows tab -- mermaid sequence diagrams)
  // ==========================================================================
  var DATA_FLOWS = [];

  // Build DATA_FLOWS from architecture.json data_flows field
  if (RAW.data_flows && RAW.data_flows.length > 0) {
    RAW.data_flows.forEach(function(df, idx) {
      var mermaidStr = df.mermaid || '';
      if (!mermaidStr && df.steps) {
        // Auto-generate a basic mermaid from steps
        var lines = ['sequenceDiagram', '    autonumber'];
        df.steps.forEach(function(step) {
          if (step.to) {
            lines.push('    ' + step.component + '->>' + step.to + ': ' + (step.action || '').substring(0, 60));
          }
        });
        mermaidStr = lines.join('\n');
      }
      DATA_FLOWS.push({
        id: df.id,
        name: df.name,
        number: idx + 1,
        description: df.description || '',
        path: df.steps ? df.steps.map(function(s) { return s.component; }).filter(Boolean) : [],
        steps: df.steps || [],
        mermaid: mermaidStr
      });
    });
  }

  // Fallback: build from edges if no data_flows
  if (DATA_FLOWS.length === 0) {
    var seenFlows = {};
    RAW.edges.forEach(function(e) {
      if (e.flowId && e.flowId !== 'dependency' && !seenFlows[e.flowId]) {
        seenFlows[e.flowId] = true;
        DATA_FLOWS.push({
          id: e.flowId,
          name: e.flowId.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }),
          number: DATA_FLOWS.length + 1,
          description: '',
          path: [],
          steps: [],
          mermaid: ''
        });
      }
    });
  }

  // ==========================================================================
  // STATE STORES (from architecture.json state field)
  // ==========================================================================
  var STATE_DATA = {
    stores: (RAW.state || []).map(function(s) {
      return {
        id: s.id,
        name: s.name || s.technology || s.id,
        purpose: s.purpose || 'unknown',
        description: s.description || '',
        scope: s.persistence || '',
        readers: s.readers || [],
        writers: s.writers || [s.component].filter(Boolean)
      };
    })
  };

  // ==========================================================================
  // FAILURE MODES (from architecture.json failure_modes field)
  // ==========================================================================
  var FAILURE_MODES = (RAW.failure_modes || []).map(function(f) {
    return {
      id: f.id,
      name: f.trigger,
      trigger: f.trigger,
      cascade: (f.cascade || []),
      impact: f.impact || '',
      detection: f.detection || [],
      recovery: f.recovery || [],
      severity: f.severity || 'medium'
    };
  });

  // ==========================================================================
  // SHARED: DATA INDEX
  // ==========================================================================
  var nodeMap = {};
  var childrenOf = {};
  var rootIds = [];
  var totalNodes = RAW.nodes.length;

  RAW.nodes.forEach(function(n) {
    nodeMap[n.id] = n;
    if (n.parent) {
      if (!childrenOf[n.parent]) childrenOf[n.parent] = [];
      childrenOf[n.parent].push(n.id);
    } else {
      rootIds.push(n.id);
    }
  });

  function countDescendants(id) {
    var kids = childrenOf[id] || [];
    var count = kids.length;
    kids.forEach(function(kid) { count += countDescendants(kid); });
    return count;
  }

  function getAncestors(id) {
    var path = [];
    var current = id;
    while (current) {
      path.unshift(current);
      current = nodeMap[current] ? nodeMap[current].parent : null;
    }
    return path;
  }

  function getAllDescendants(id) {
    var result = [];
    var kids = childrenOf[id] || [];
    kids.forEach(function(kid) {
      result.push(kid);
      result = result.concat(getAllDescendants(kid));
    });
    return result;
  }

  // ==========================================================================
  // SHARED: TYPE CONFIG
  // ==========================================================================
  var typeConfig = {
    'group':            { bg: '#2a2a4e', border: '#4a4a6e', text: '#aaa', shape: 'roundrectangle' },
    'component':        { bg: '#4a90d9', border: '#3a78c0', text: '#fff', shape: 'roundrectangle' },
    'frontend':         { bg: '#4a90d9', border: '#3a78c0', text: '#fff', shape: 'roundrectangle' },
    'service':          { bg: '#3498db', border: '#2980b9', text: '#fff', shape: 'roundrectangle' },
    'external-service': { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'diamond' },
    'endpoint':         { bg: '#d4740e', border: '#b8640c', text: '#fff', shape: 'diamond' },
    'route':            { bg: '#1abc9c', border: '#14a085', text: '#fff', shape: 'hexagon' },
    'library':          { bg: '#9b59b6', border: '#8244a0', text: '#fff', shape: 'roundrectangle' },
    'config':           { bg: '#c0392b', border: '#a93226', text: '#fff', shape: 'ellipse' },
    'stylesheet':       { bg: '#e74c3c', border: '#c0392b', text: '#fff', shape: 'ellipse' },
    'test-suite':       { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'roundrectangle' },
    'test':             { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'ellipse' },
    'gateway':          { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'diamond' },
    'store':            { bg: '#1abc9c', border: '#14a085', text: '#fff', shape: 'barrel' },
    'worker':           { bg: '#2ecc71', border: '#27ae60', text: '#fff', shape: 'roundrectangle' },
    'api':              { bg: '#3498db', border: '#2980b9', text: '#fff', shape: 'roundrectangle' }
  };

  function getTypeConfig(type) {
    return typeConfig[type] || typeConfig.component;
  }

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // Debt severity colors
  var debtColors = {
    critical: '#e74c3c',
    high: '#e67e22',
    medium: '#f1c40f',
    low: '#2ecc71',
    none: '#555'
  };

  function getDebtColor(severity) {
    return debtColors[severity] || debtColors.none;
  }

  // ==========================================================================
  // SHARED: TOOLTIP
  // ==========================================================================
  var tooltip = document.getElementById('tooltip');
  var ttLabel = tooltip.querySelector('.tt-label');
  var ttType = tooltip.querySelector('.tt-type');
  var ttFile = tooltip.querySelector('.tt-file');
  var ttDesc = tooltip.querySelector('.tt-desc');
  var ttExports = tooltip.querySelector('.tt-exports');
  var ttChildrenHint = tooltip.querySelector('.tt-children-hint');

  function showTooltip(data, cfg) {
    ttLabel.textContent = data.name || data.label || '';
    ttType.textContent = (data.type || data.nodeType || '').replace(/-/g, ' ');
    ttType.style.color = cfg ? (cfg.bg === '#2a2a4e' ? '#7b68ee' : cfg.bg) : '#7b68ee';
    ttFile.textContent = data.file || '';
    ttFile.style.display = data.file ? 'block' : 'none';
    ttDesc.textContent = data.description || '';

    if (data.exports && data.exports.length > 0) {
      var html = '<div class="tt-exports-title">Exports (' + data.exports.length + ')</div>';
      data.exports.forEach(function(exp) {
        var expName = typeof exp === 'string' ? exp : exp.name;
        var expKind = typeof exp === 'string' ? '' : (exp.kind || '');
        html += '<div class="tt-export-item">';
        html += '<span class="export-name">' + escapeHtml(expName) + '</span>';
        if (expKind) html += '<span class="export-kind"> (' + expKind + ')</span>';
        html += '</div>';
      });
      ttExports.innerHTML = html;
      ttExports.style.display = 'block';
    } else {
      ttExports.style.display = 'none';
    }

    ttChildrenHint.style.display = 'none';
    tooltip.classList.add('visible');
  }

  function showStructureTooltip(cyNode) {
    var id = cyNode.data('id');
    var n = nodeMap[id];
    if (!n) return;
    var cfg = getTypeConfig(n.type);
    showTooltip(n, cfg);

    var kids = childrenOf[id] || [];
    if (kids.length > 0 && !structureState.expandedNodes[id]) {
      ttChildrenHint.textContent = 'Click to expand ' + countDescendants(id) + ' child nodes';
      ttChildrenHint.style.display = 'block';
    } else if (kids.length > 0 && structureState.expandedNodes[id]) {
      ttChildrenHint.textContent = 'Right-click to collapse';
      ttChildrenHint.style.display = 'block';
    }
  }

  function hideTooltip() {
    tooltip.classList.remove('visible');
  }

  function positionTooltip(evt) {
    if (!tooltip.classList.contains('visible') || !evt) return;
    var x = evt.clientX || 0;
    var y = evt.clientY || 0;
    var pad = 16;
    var tw = tooltip.offsetWidth;
    var th = tooltip.offsetHeight;
    var left = x + pad;
    var top = y + pad;
    if (left + tw > window.innerWidth - 20) left = x - tw - pad;
    if (top + th > window.innerHeight - 20) top = y - th - pad;
    tooltip.style.left = left + 'px';
    tooltip.style.top = top + 'px';
  }

  // ==========================================================================
  // BOTTOM PANEL (unified: Details + Terminal)
  // ==========================================================================
  var bottomPanel = document.getElementById('bottom-panel');
  var ctxName = document.getElementById('ctx-name');
  var ctxTypeBadge = document.getElementById('ctx-type-badge');
  var ctxFile = document.getElementById('ctx-file');
  var ctxDesc = document.getElementById('ctx-desc');
  var ctxExports = document.getElementById('ctx-exports');

  // Tab switching
  document.querySelectorAll('.bp-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      document.querySelectorAll('.bp-tab').forEach(function(t) { t.classList.remove('active'); });
      document.querySelectorAll('.bp-content').forEach(function(c) { c.classList.remove('active'); });
      tab.classList.add('active');
      document.getElementById('bp-' + tab.dataset.bpTab).classList.add('active');
    });
  });

  document.getElementById('bottom-panel-close').addEventListener('click', function() {
    bottomPanel.classList.remove('open');
  });

  function showContextPanel(nodeData) {
    // Switch to Details tab
    document.querySelectorAll('.bp-tab').forEach(function(t) { t.classList.remove('active'); });
    document.querySelectorAll('.bp-content').forEach(function(c) { c.classList.remove('active'); });
    document.querySelector('[data-bp-tab="details"]').classList.add('active');
    document.getElementById('bp-details').classList.add('active');
    var cfg = getTypeConfig(nodeData.type || nodeData.nodeType);
    ctxName.textContent = nodeData.name || nodeData.label || '';

    var typeLabel = (nodeData.type || nodeData.nodeType || '').replace(/-/g, ' ');
    ctxTypeBadge.textContent = typeLabel;
    ctxTypeBadge.style.background = cfg.bg + '33';
    ctxTypeBadge.style.color = cfg.bg === '#2a2a4e' ? '#7b68ee' : cfg.bg;
    ctxTypeBadge.style.borderColor = cfg.bg === '#2a2a4e' ? 'rgba(123,104,238,0.3)' : cfg.bg + '55';

    if (nodeData.file) {
      ctxFile.textContent = nodeData.file;
      ctxFile.href = REPO_URL + '/blob/main/' + nodeData.file;
      ctxFile.style.display = 'inline-block';
    } else {
      ctxFile.style.display = 'none';
    }

    ctxDesc.textContent = nodeData.description || '';
    ctxDesc.style.display = nodeData.description ? 'block' : 'none';

    var exports = nodeData.exports;
    if (exports && exports.length > 0) {
      var html = '<div class="ctx-exports-title">Exports (' + exports.length + ')</div><ul class="ctx-exports-list">';
      exports.forEach(function(exp) {
        var expName = typeof exp === 'string' ? exp : exp.name;
        var expKind = typeof exp === 'string' ? '' : (exp.kind || '');
        var expDesc = typeof exp === 'string' ? '' : (exp.description || '');
        html += '<li><span class="ctx-export-name">' + escapeHtml(expName) + '</span>';
        if (expKind) html += ' <span class="ctx-export-kind">(' + expKind + ')</span>';
        if (expDesc) html += '<div class="ctx-export-desc">' + escapeHtml(expDesc) + '</div>';
        html += '</li>';
      });
      html += '</ul>';
      ctxExports.innerHTML = html;
      ctxExports.style.display = 'block';
    } else {
      ctxExports.style.display = 'none';
    }

    bottomPanel.classList.add('open');
  }

  function hideContextPanel() {
    bottomPanel.classList.remove('open');
  }

  // ==========================================================================
  // TAB SWITCHING
  // ==========================================================================
  var tabDescriptions = {
    structure: 'Component hierarchy &mdash; expand and collapse to explore',
    flows: 'Sequence diagrams for each data flow through the system',
    data: 'State stores and which components read or write them',
    failure: 'Resilience runbook &mdash; trigger, cascade, detection, recovery'
  };

  var currentTab = 'structure';
  var tabInitialized = { structure: false, flows: false, data: false, failure: false };

  var tabBtns = document.querySelectorAll('.tab-btn');
  var tabDesc = document.getElementById('tab-desc');

  tabBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var tab = btn.dataset.tab;
      if (tab === currentTab) return;

      // Hide old panel elements
      hideTabSpecificElements(currentTab);

      // Update tab state
      tabBtns.forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');

      document.querySelectorAll('.tab-panel').forEach(function(p) { p.classList.remove('active'); });
      document.getElementById(tab + '-panel').classList.add('active');

      tabDesc.innerHTML = tabDescriptions[tab];
      currentTab = tab;

      // Show new panel elements
      showTabSpecificElements(tab);

      // Initialize on first view
      if (!tabInitialized[tab]) {
        tabInitialized[tab] = true;
        if (tab === 'flows') initFlows();
        if (tab === 'data') initDataTab();
        if (tab === 'failure') initFailureTab();
      } else {
        // Re-fit graphs that need it
        if (tab === 'data' && cyData) {
          setTimeout(function() { cyData.fit(undefined, 80); }, 100);
        }
      }

      if (tab === 'structure' && cyStructure) {
        setTimeout(function() { cyStructure.resize(); cyStructure.fit(undefined, 100); }, 100);
      }

      // Rebuild sidebar for the new tab
      buildSidebarForTab(tab);
    });
  });

  function hideTabSpecificElements(tab) {
    if (tab === 'structure') {
      document.getElementById('breadcrumb-bar').style.display = 'none';
      document.getElementById('controls-toggle').style.display = 'none';
      document.getElementById('controls-panel').style.display = 'none';
      document.getElementById('flow-filters').style.display = 'none';
      document.getElementById('info-badge').style.display = 'none';
    }
    if (tab === 'data') {
      document.getElementById('data-legend').style.display = 'none';
    }
  }

  function showTabSpecificElements(tab) {
    if (tab === 'structure') {
      document.getElementById('breadcrumb-bar').style.display = '';
      document.getElementById('controls-toggle').style.display = '';
      document.getElementById('controls-panel').style.display = '';
      document.getElementById('flow-filters').style.display = '';
      document.getElementById('info-badge').style.display = '';
    }
    if (tab === 'data') {
      document.getElementById('data-legend').style.display = '';
    }
  }

  // ==========================================================================
  // ENV TOGGLE
  // ==========================================================================
  document.querySelectorAll('.env-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.env-btn').forEach(function(b) { b.classList.remove('active'); });
      btn.classList.add('active');
      var env = btn.dataset.env;
      document.body.dataset.env = env;
      console.log('Environment:', env);
    });
