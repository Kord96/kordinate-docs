  // PANEL TOGGLES (gear + help)
  // ==========================================================================
  (function() {
    var ctrlToggle = document.getElementById('controls-toggle');
    var ctrlPanel = document.getElementById('controls-panel');
    var helpToggle = document.getElementById('help-toggle');
    var helpPanel = document.getElementById('help-panel');
    var termToggle = document.getElementById('terminal-toggle');
    var bPanel = document.getElementById('bottom-panel');

    ctrlToggle.addEventListener('click', function(e) {
      e.stopPropagation();
      ctrlPanel.classList.toggle('controls-hidden');
      helpPanel.classList.add('help-hidden');
    });

    helpToggle.addEventListener('click', function(e) {
      e.stopPropagation();
      helpPanel.classList.toggle('help-hidden');
      ctrlPanel.classList.add('controls-hidden');
    });

    termToggle.addEventListener('click', function(e) {
      e.stopPropagation();
      document.querySelectorAll('.bp-tab').forEach(function(t) { t.classList.remove('active'); });
      document.querySelectorAll('.bp-content').forEach(function(c) { c.classList.remove('active'); });
      document.querySelector('[data-bp-tab="terminal"]').classList.add('active');
      document.getElementById('bp-terminal').classList.add('active');
      bPanel.classList.toggle('open');
      ctrlPanel.classList.add('controls-hidden');
      helpPanel.classList.add('help-hidden');
    });

    document.addEventListener('click', function(e) {
      if (!ctrlPanel.contains(e.target) && e.target !== ctrlToggle) {
        ctrlPanel.classList.add('controls-hidden');
      }
      if (!helpPanel.contains(e.target) && e.target !== helpToggle) {
        helpPanel.classList.add('help-hidden');
      }
    });
  })();

  // ==========================================================================
  // SIDEBAR: STATE & SCROLL POSITIONS
  // ==========================================================================
  var sidebarScrollPositions = { structure: 0, flows: 0, data: 0, failure: 0 };
  var sidebarCollapsed = false;
  var sidebarObserver = null;
  var activeSidebarSection = null;

  // ==========================================================================
  // SIDEBAR: COLLAPSE / EXPAND
  // ==========================================================================
  var sidebar = document.getElementById('arch-sidebar');
  var sidebarContent = document.getElementById('sidebar-content');
  var sidebarCollapseBtn = document.getElementById('sidebar-collapse');
  var sidebarExpandBtn = document.getElementById('sidebar-expand');
  var sidebarTitle = document.getElementById('sidebar-title');

  sidebarCollapseBtn.addEventListener('click', function() {
    sidebarCollapsed = true;
    sidebar.classList.add('collapsed');
    sidebarExpandBtn.style.display = 'flex';
    document.body.classList.add('sidebar-collapsed');
    if (cyStructure) setTimeout(function() { cyStructure.resize(); }, 300);
    if (cyData) setTimeout(function() { cyData.resize(); }, 300);
  });

  sidebarExpandBtn.addEventListener('click', function() {
    sidebarCollapsed = false;
    sidebar.classList.remove('collapsed');
    sidebarExpandBtn.style.display = 'none';
    document.body.classList.remove('sidebar-collapsed');
    if (cyStructure) setTimeout(function() { cyStructure.resize(); }, 300);
    if (cyData) setTimeout(function() { cyData.resize(); }, 300);
  });

  // ==========================================================================
  // SIDEBAR: BUILD SECTIONS
  // ==========================================================================
  function buildSidebarForTab(tab) {
    // Save scroll position of current tab
    if (sidebarContent.scrollTop > 0) {
      sidebarScrollPositions[currentTab] = sidebarContent.scrollTop;
    }

    // Update title
    var tabNames = { structure: 'Structure', flows: 'Flows', data: 'Data', failure: 'Resilience' };
    sidebarTitle.textContent = tabNames[tab] || tab;

    // Disconnect old observer
    if (sidebarObserver) {
      sidebarObserver.disconnect();
      sidebarObserver = null;
    }

    var html = '';

    // Merge narrative if available
    var narrativeKey = tab === 'failure' ? 'resilience' : tab;
    var narrative = NARRATIVES[narrativeKey] || '';

    if (tab === 'structure') {
      html = buildStructureSections(narrative);
    } else if (tab === 'flows') {
      html = buildFlowsSections(narrative);
    } else if (tab === 'data') {
      html = buildDataSections(narrative);
    } else if (tab === 'failure') {
      html = buildResilienceSections(narrative);
    }

    sidebarContent.innerHTML = html;

    // Restore scroll position
    sidebarContent.scrollTop = sidebarScrollPositions[tab] || 0;

    // Set up IntersectionObserver for scroll-spy
    setupScrollSpy();

    // Bind click handlers on sidebar sections
    bindSidebarClicks();
  }

  // ----- Structure tab: one section per top-level group -----
  function buildStructureSections(narrative) {
    var html = '';

    if (narrative) {
      html += '<div class="sb-narrative">' + narrative + '</div>';
    }

    rootIds.forEach(function(rid) {
      var n = nodeMap[rid];
      if (!n) return;
      var kids = childrenOf[rid] || [];
      var allIds = [rid].concat(getAllDescendants(rid));
      var cfg = getTypeConfig(n.type);

      html += '<div class="sb-section" data-node-ids="' + allIds.join(',') + '">';
      html += '<div class="sb-section-heading" data-section-id="' + rid + '">';
      html += '<span class="sb-type-dot" style="background:' + (cfg.bg === '#2a2a4e' ? '#7b68ee' : cfg.bg) + '"></span>';
      html += '<span class="sb-section-title">' + escapeHtml(n.name) + '</span>';
      html += '<span class="sb-node-count">' + (kids.length + 1) + ' nodes</span>';

      // Pattern badges
      if (n.patterns && n.patterns.length > 0) {
        n.patterns.forEach(function(p) {
          html += '<span class="sb-pattern-badge">' + escapeHtml(typeof p === 'string' ? p : p.name) + '</span>';
        });
      }

      // Debt dot
      if (n.debt) {
        var debtSev = typeof n.debt === 'string' ? n.debt : (n.debt.severity || 'none');
        html += '<span class="sb-debt-dot" style="background:' + getDebtColor(debtSev) + '" title="Debt: ' + debtSev + '"></span>';
      }

      html += '</div>';

      if (n.description) {
        html += '<div class="sb-section-desc">' + escapeHtml(n.description) + '</div>';
      }

      // Children list
      if (kids.length > 0) {
        html += '<div class="sb-children">';
        kids.forEach(function(kid) {
          var kn = nodeMap[kid];
          if (!kn) return;
          var kcfg = getTypeConfig(kn.type);
          var grandKids = childrenOf[kid] || [];
          var kidAllIds = [kid].concat(getAllDescendants(kid));

          html += '<div class="sb-child" data-node-ids="' + kidAllIds.join(',') + '">';
          html += '<span class="sb-type-dot small" style="background:' + (kcfg.bg === '#2a2a4e' ? '#7b68ee' : kcfg.bg) + '"></span>';
          html += '<span class="sb-child-name">' + escapeHtml(kn.name) + '</span>';

          // Pattern badges
          if (kn.patterns && kn.patterns.length > 0) {
            kn.patterns.forEach(function(p) {
              html += '<span class="sb-pattern-badge small">' + escapeHtml(typeof p === 'string' ? p : p.name) + '</span>';
            });
          }

          // Debt dot
          if (kn.debt) {
            var kDebtSev = typeof kn.debt === 'string' ? kn.debt : (kn.debt.severity || 'none');
            html += '<span class="sb-debt-dot small" style="background:' + getDebtColor(kDebtSev) + '" title="Debt: ' + kDebtSev + '"></span>';
          }

          if (grandKids.length > 0) {
            html += '<span class="sb-child-count">' + grandKids.length + '</span>';
          }
          html += '</div>';

          // Grandchildren (depth 2)
          if (grandKids.length > 0) {
            html += '<div class="sb-grandchildren">';
            grandKids.forEach(function(gk) {
              var gn = nodeMap[gk];
              if (!gn) return;
              var gcfg = getTypeConfig(gn.type);

              html += '<div class="sb-grandchild" data-node-ids="' + gk + '">';
              html += '<span class="sb-type-dot tiny" style="background:' + (gcfg.bg === '#2a2a4e' ? '#7b68ee' : gcfg.bg) + '"></span>';
              html += '<span class="sb-grandchild-name">' + escapeHtml(gn.name) + '</span>';

              if (gn.patterns && gn.patterns.length > 0) {
                gn.patterns.forEach(function(p) {
                  html += '<span class="sb-pattern-badge tiny">' + escapeHtml(typeof p === 'string' ? p : p.name) + '</span>';
                });
              }

              if (gn.debt) {
                var gDebtSev = typeof gn.debt === 'string' ? gn.debt : (gn.debt.severity || 'none');
                html += '<span class="sb-debt-dot tiny" style="background:' + getDebtColor(gDebtSev) + '" title="Debt: ' + gDebtSev + '"></span>';
              }

              html += '</div>';
            });
            html += '</div>';
          }
        });
        html += '</div>';
      }

      html += '</div>'; // close sb-section
    });

    return html;
  }

  // ----- Flows tab: one section per data flow -----
  function buildFlowsSections(narrative) {
    var html = '';

    if (narrative) {
      html += '<div class="sb-narrative">' + narrative + '</div>';
    }

    DATA_FLOWS.forEach(function(flow) {
      var pathIds = flow.path || [];
      html += '<div class="sb-section" data-node-ids="' + pathIds.join(',') + '" data-flow-id="' + flow.id + '">';
      html += '<div class="sb-section-heading" data-section-id="flow-' + flow.id + '">';
      html += '<span class="sb-flow-number">' + flow.number + '</span>';
      html += '<span class="sb-section-title">' + escapeHtml(flow.name) + '</span>';
      html += '</div>';

      if (flow.description) {
        html += '<div class="sb-section-desc">' + escapeHtml(flow.description) + '</div>';
      }

      // Step summary
      if (flow.steps && flow.steps.length > 0) {
        html += '<div class="sb-flow-steps">';
        flow.steps.forEach(function(step, i) {
          html += '<div class="sb-flow-step">';
          html += '<span class="sb-step-num">' + (i + 1) + '</span>';
          html += '<span class="sb-step-component">' + escapeHtml(step.component) + '</span>';
          if (step.action) {
            var shortAction = step.action.length > 80 ? step.action.substring(0, 77) + '...' : step.action;
            html += '<span class="sb-step-action">' + escapeHtml(shortAction) + '</span>';
          }
          html += '</div>';
        });
        html += '</div>';
      } else if (pathIds.length > 0) {
        html += '<div class="sb-flow-path">';
        html += pathIds.map(function(p) {
          var pn = nodeMap[p];
          return '<span class="sb-path-node">' + escapeHtml(pn ? pn.name : p) + '</span>';
        }).join('<span class="sb-path-arrow">&rarr;</span>');
        html += '</div>';
      }

      html += '</div>';
    });

    return html;
  }

  // ----- Data tab: one section per state store -----
  function buildDataSections(narrative) {
    var html = '';

    if (narrative) {
      html += '<div class="sb-narrative">' + narrative + '</div>';
    }

    STATE_DATA.stores.forEach(function(store) {
      var allIds = [store.id].concat(store.readers || []).concat(store.writers || []);
      var purposeLabel = store.purpose === 'source-of-truth' ? 'Source of Truth' :
                         store.purpose === 'cache' ? 'Cache' :
                         store.purpose === 'staging' ? 'Staging' : store.purpose;

      html += '<div class="sb-section" data-node-ids="' + allIds.join(',') + '">';
      html += '<div class="sb-section-heading" data-section-id="store-' + store.id + '">';
      html += '<span class="sb-purpose-badge ' + store.purpose + '">' + purposeLabel + '</span>';
      html += '<span class="sb-section-title">' + escapeHtml(store.name) + '</span>';
      html += '</div>';

      if (store.description) {
        html += '<div class="sb-section-desc">' + escapeHtml(store.description) + '</div>';
      }

      // Readers
      if (store.readers && store.readers.length > 0) {
        html += '<div class="sb-store-group">';
        html += '<div class="sb-store-label">Readers</div>';
        store.readers.forEach(function(r) {
          var rn = nodeMap[r];
          html += '<span class="sb-store-component reader">' + escapeHtml(rn ? rn.name : r) + '</span>';
        });
        html += '</div>';
      }

      // Writers
      if (store.writers && store.writers.length > 0) {
        html += '<div class="sb-store-group">';
        html += '<div class="sb-store-label">Writers</div>';
        store.writers.forEach(function(w) {
          var wn = nodeMap[w];
          html += '<span class="sb-store-component writer">' + escapeHtml(wn ? wn.name : w) + '</span>';
        });
        html += '</div>';
      }

      html += '</div>';
    });

    return html;
  }

  // ----- Resilience tab: one section per failure mode -----
  function buildResilienceSections(narrative) {
    var html = '';

    if (narrative) {
      html += '<div class="sb-narrative">' + narrative + '</div>';
    }

    FAILURE_MODES.forEach(function(fm) {
      var cascadeIds = (fm.cascade || []).map(function(c) { return c.component; }).filter(Boolean);
      html += '<div class="sb-section" data-node-ids="' + cascadeIds.join(',') + '" data-failure-id="' + fm.id + '">';
      html += '<div class="sb-section-heading" data-section-id="failure-' + fm.id + '">';
      html += '<span class="sb-severity-badge ' + fm.severity + '">' + fm.severity + '</span>';
      html += '<span class="sb-section-title">' + escapeHtml(fm.name) + '</span>';
      html += '</div>';

      // Trigger
      html += '<div class="sb-section-desc">' + escapeHtml(fm.trigger) + '</div>';

      // Cascade summary
      if (fm.cascade && fm.cascade.length > 0) {
        html += '<div class="sb-cascade-summary">';
        html += '<div class="sb-store-label">Cascade (' + fm.cascade.length + ')</div>';
        fm.cascade.forEach(function(c) {
          html += '<div class="sb-cascade-item">';
          html += '<span class="sb-cascade-component">' + escapeHtml(c.component) + '</span>';
          html += '</div>';
        });
        html += '</div>';
      }

      // Impact
      if (fm.impact) {
        html += '<div class="sb-impact">';
        html += '<div class="sb-store-label">Impact</div>';
        html += '<div class="sb-impact-text">' + escapeHtml(fm.impact) + '</div>';
        html += '</div>';
      }

      html += '</div>';
    });

    return html;
  }

  // ==========================================================================
  // SIDEBAR: SCROLL-SPY (IntersectionObserver)
  // ==========================================================================
  function setupScrollSpy() {
    if (sidebarObserver) sidebarObserver.disconnect();

    var headings = sidebarContent.querySelectorAll('.sb-section-heading');
    if (headings.length === 0) return;

    sidebarObserver = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          var section = entry.target.closest('.sb-section');
          if (section && section !== activeSidebarSection) {
            // Remove active from previous
            if (activeSidebarSection) {
              activeSidebarSection.classList.remove('active');
            }
            activeSidebarSection = section;
            section.classList.add('active');

            // Passive highlight: gently glow corresponding nodes in graph (NO camera pan)
            var nodeIds = (section.dataset.nodeIds || '').split(',').filter(Boolean);
            if (nodeIds.length > 0 && currentTab === 'structure' && cyStructure) {
              applyPassiveHighlight(nodeIds);
            }
          }
        }
      });
    }, {
      root: sidebarContent,
      rootMargin: '-10% 0px -70% 0px',
      threshold: 0
    });

    headings.forEach(function(h) {
      sidebarObserver.observe(h);
    });
  }

  // Passive highlight: subtle glow on graph nodes, no camera pan
  function applyPassiveHighlight(nodeIds) {
    if (!cyStructure || currentTab !== 'structure') return;

    // Clear previous passive highlights
    cyStructure.nodes('.passive-glow').removeClass('passive-glow');

    nodeIds.forEach(function(nid) {
      var cyNode = cyStructure.getElementById(nid);
      if (cyNode.length > 0 && cyNode.visible()) {
        cyNode.addClass('passive-glow');
      } else {
        // Walk up to find visible ancestor
        var current = nid;
        while (current) {
          var rawNode = nodeMap[current];
          if (!rawNode || !rawNode.parent) break;
          current = rawNode.parent;
          var cyParent = cyStructure.getElementById(current);
          if (cyParent.length > 0 && cyParent.visible()) {
            cyParent.addClass('passive-glow');
            break;
          }
        }
      }
    });
  }

  // ==========================================================================
  // SIDEBAR: CLICK HANDLERS (sidebar -> graph)
  // ==========================================================================
  function bindSidebarClicks() {
    var sections = sidebarContent.querySelectorAll('.sb-section, .sb-child, .sb-grandchild');
    sections.forEach(function(section) {
      section.addEventListener('click', function(e) {
        e.stopPropagation();
        var nodeIds = (section.dataset.nodeIds || '').split(',').filter(Boolean);
        if (nodeIds.length === 0) return;

        // Mark active in sidebar
        sidebarContent.querySelectorAll('.sb-section.clicked, .sb-child.clicked, .sb-grandchild.clicked').forEach(function(el) {
          el.classList.remove('clicked');
        });
        section.classList.add('clicked');

        if (currentTab === 'structure' && cyStructure) {
          highlightAndPanToNodes(nodeIds);
        } else if (currentTab === 'data' && cyData) {
          highlightDataNodes(nodeIds);
        }
      });
    });
  }

  // Highlight nodes in structure graph and pan camera
  function highlightAndPanToNodes(nodeIds) {
    if (!cyStructure) return;

    // Clear previous sidebar-driven highlights
    cyStructure.elements().removeClass('sidebar-highlight sidebar-dimmed passive-glow');

    var targets = cyStructure.collection();
    nodeIds.forEach(function(nid) {
      var cyNode = cyStructure.getElementById(nid);
      if (cyNode.length > 0 && cyNode.visible()) {
        targets = targets.union(cyNode);
      } else {
        // Walk up to visible ancestor
        var current = nid;
        while (current) {
          var rawNode = nodeMap[current];
          if (!rawNode || !rawNode.parent) break;
          current = rawNode.parent;
          var cyParent = cyStructure.getElementById(current);
          if (cyParent.length > 0 && cyParent.visible()) {
            targets = targets.union(cyParent);
            break;
          }
        }
      }
    });

    if (targets.length === 0) return;

    // Include ancestors so they aren't dimmed
    var relevant = targets.clone();
    targets.forEach(function(n) {
      relevant = relevant.union(n.ancestors());
    });

    // Dim everything else
    cyStructure.elements().not(relevant).addClass('sidebar-dimmed');
    targets.addClass('sidebar-highlight');

    // Pan camera to center on highlighted nodes
    cyStructure.animate({
      fit: { eles: targets, padding: 120 },
      duration: 400,
      easing: 'ease-in-out-cubic'
    });

    // Auto-clear after 3 seconds
    setTimeout(function() {
      cyStructure.elements().removeClass('sidebar-highlight sidebar-dimmed');
    }, 3000);
  }

  // Highlight nodes in data graph
  function highlightDataNodes(nodeIds) {
    if (!cyData) return;

    cyData.elements().removeClass('sidebar-highlight sidebar-dimmed');

    var targets = cyData.collection();
    nodeIds.forEach(function(nid) {
      // Data tab uses prefixed IDs
      var storeNode = cyData.getElementById('store-' + nid);
      var compNode = cyData.getElementById('comp-' + nid);
      if (storeNode.length > 0) targets = targets.union(storeNode);
      if (compNode.length > 0) targets = targets.union(compNode);
    });

    if (targets.length === 0) return;

    var relevant = targets.clone();
    targets.forEach(function(n) {
      relevant = relevant.union(n.ancestors());
      relevant = relevant.union(n.connectedEdges());
    });

    cyData.elements().not(relevant).addClass('sidebar-dimmed');
    targets.addClass('sidebar-highlight');

    cyData.animate({
      fit: { eles: targets, padding: 100 },
      duration: 400,
      easing: 'ease-in-out-cubic'
    });

    setTimeout(function() {
      cyData.elements().removeClass('sidebar-highlight sidebar-dimmed');
    }, 3000);
  }

  // ==========================================================================
  // SIDEBAR: GRAPH -> SIDEBAR (bidirectional: clicking graph scrolls sidebar)
  // ==========================================================================
  function scrollSidebarToNode(nodeId) {
    // Find sidebar section that contains this node
    var sections = sidebarContent.querySelectorAll('[data-node-ids]');
    var bestMatch = null;
    var bestSpecificity = Infinity;

    sections.forEach(function(section) {
      var ids = (section.dataset.nodeIds || '').split(',');
      if (ids.indexOf(nodeId) !== -1) {
        // Prefer the most specific section (fewest total IDs)
        if (ids.length < bestSpecificity) {
          bestSpecificity = ids.length;
          bestMatch = section;
        }
      }
    });

    if (bestMatch) {
      // Remove previous active
      sidebarContent.querySelectorAll('.sb-section.clicked, .sb-child.clicked, .sb-grandchild.clicked').forEach(function(el) {
        el.classList.remove('clicked');
      });
      bestMatch.classList.add('clicked');

      // Scroll into view
      bestMatch.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  }

  // ==========================================================================
  // TAB 1: STRUCTURE (the original cytoscape expand/collapse viewer)
  // ==========================================================================
  var structureState = {
    expandedNodes: {},
    activeFlow: null
  };

  var cyStructure = cytoscape({
    container: document.getElementById('cy-structure'),
    elements: [],
    minZoom: 0.2,
    maxZoom: 4,
    wheelSensitivity: 0.3,
    style: [
      {
        selector: 'node[nodeType="group"][?collapsed]',
        style: {
          'shape': 'roundrectangle',
          'width': function(ele) { return Math.max(180, 140 + ele.data('label').length * 3); },
          'height': 56,
          'background-color': 'rgba(123,104,238,0.08)',
          'border-width': 2,
          'border-style': 'dashed',
          'border-color': 'rgba(123,104,238,0.35)',
          'label': 'data(label)',
          'color': '#ccc',
          'font-size': '13px',
          'font-weight': '600',
          'text-halign': 'center',
          'text-valign': 'center',
          'text-wrap': 'wrap',
          'text-max-width': '220px',
          'font-family': 'Inter, sans-serif',
          'overlay-opacity': 0
        }
      },
      {
        selector: 'node[nodeType="group"][!collapsed]',
