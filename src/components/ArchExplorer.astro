  function updateGraphForSelection() {
    // Reset structure graph
    cyStructure.elements().removeClass('dimmed flow-highlight flow-halo highlighted');
    structureState.activeFlow = null;
    // Reset data graph
    if (cyData) cyData.elements().removeClass('dimmed highlighted hover-glow');

    if (!selectionState.type) {
      // Clear visual highlights on all tabs
      document.querySelectorAll('.flow-section.active-flow').forEach(function(el) { el.classList.remove('active-flow'); });
      document.querySelectorAll('.resilience-card.active-failure').forEach(function(el) { el.classList.remove('active-failure'); });
      return;
    }

    // === STRUCTURE TAB highlights ===
    if (selectionState.type === 'flow') {
      structureState.activeFlow = selectionState.id;
      highlightFlow(selectionState.id);
    } else if (selectionState.type === 'node') {
      var cyNode = cyStructure.getElementById(selectionState.id);
      if (cyNode.length > 0) {
        cyStructure.elements().addClass('dimmed');
        cyNode.neighborhood().union(cyNode).removeClass('dimmed').addClass('flow-halo');
      }
    } else if (selectionState.type === 'failure') {
      var fm = FAILURE_MODES.find(function(f) { return f.id === selectionState.id; });
      if (fm) {
        var ids = new Set(); (fm.cascade || []).forEach(function(c) { ids.add(c.component); });
        if (ids.size > 0) { cyStructure.elements().addClass('dimmed'); ids.forEach(function(nid) { var n = cyStructure.getElementById(nid); if (n.length > 0) n.removeClass('dimmed').addClass('flow-halo'); }); }
      }
    } else if (selectionState.type === 'state') {
      var st = STATE_DATA.stores.find(function(s) { return s.id === selectionState.id; });
      if (st) {
        var ids = new Set(); ids.add(st.id); (st.readers || []).forEach(function(r) { ids.add(r); }); (st.writers || []).forEach(function(w) { ids.add(w); });
        cyStructure.elements().addClass('dimmed'); ids.forEach(function(nid) { var n = cyStructure.getElementById(nid); if (n.length > 0) n.removeClass('dimmed').addClass('flow-halo'); });
      }
    }

    // === FLOWS TAB: highlight the selected flow section ===
    document.querySelectorAll('.flow-section.active-flow').forEach(function(el) { el.classList.remove('active-flow'); });
    if (selectionState.type === 'flow') {
      var flowSection = document.querySelector('.flow-section[data-flow-id="' + selectionState.id + '"]');
      if (flowSection) {
        flowSection.classList.add('active-flow');
        if (currentTab === 'flows') flowSection.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    // === DATA TAB: highlight store and its readers/writers in the data graph ===
    if (selectionState.type === 'state' && cyData) {
      cyData.elements().addClass('dimmed');
      var storeNode = cyData.getElementById('store-' + selectionState.id);
      if (storeNode.length > 0) {
        var neighborhood = storeNode.neighborhood().union(storeNode).union(storeNode.ancestors());
        neighborhood.removeClass('dimmed').addClass('highlighted');
      }
    }

    // === RESILIENCE TAB: scroll to and highlight the selected failure card ===
    document.querySelectorAll('.resilience-card.active-failure').forEach(function(el) { el.classList.remove('active-failure'); });
    if (selectionState.type === 'failure') {
      var failCard = document.querySelector('.resilience-card[data-failure-id="' + selectionState.id + '"]');
      if (failCard) {
        failCard.classList.add('active-failure');
        if (currentTab === 'failure') failCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }
  }

