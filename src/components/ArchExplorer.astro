---
import logoDark from '../assets/logo_dark.webp';

interface Props {
  title: string;
  subtitle: string;
  data: any;
  repoUrl: string;
  narratives?: {
    structure?: string;
    flows?: string;
    data?: string;
    resilience?: string;
  };
}

const { title, subtitle, data, repoUrl, narratives } = Astro.props;
---

<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} -- Architecture Explorer</title>
  <script src="https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js" is:inline></script>
  <script src="https://unpkg.com/layout-base@2.0.1/layout-base.js" is:inline></script>
  <script src="https://unpkg.com/cose-base@2.2.0/cose-base.js" is:inline></script>
  <script src="https://unpkg.com/cytoscape-cose-bilkent@4.1.0/cytoscape-cose-bilkent.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js" is:inline></script>
</head>
<body>
<!-- Embedded architecture data -->
<script id="arch-data" type="application/json" set:html={JSON.stringify(data)} />
<script id="repo-url" type="application/json" set:html={JSON.stringify(repoUrl)} />
<script id="narratives-data" type="application/json" set:html={JSON.stringify(narratives || {})} />

<!-- ===== NAV BAR ===== -->
<nav id="site-nav">
  <div class="nav-left">
    <a href="/" class="nav-logo-link">
      <img src={logoDark.src} alt="Docs" class="nav-logo" />
      <span class="nav-title">Docs</span>
    </a>
    <span class="nav-sep">/</span>
    <div class="nav-project-switcher">
      <button class="nav-project-current" id="project-switcher-btn">{title} <span class="nav-chevron">&#9662;</span></button>
      <div class="nav-project-dropdown" id="project-dropdown">
        <a href="/sous-storefront/" class={title === 'sous-storefront' ? 'active' : ''}>sous-storefront</a>
        <a href="/logbd/" class={title === 'logbd' ? 'active' : ''}>logbd</a>
        <a href="/kordinate/" class={title === 'kordinate' ? 'active' : ''}>kordinate</a>
      </div>
    </div>
  </div>
  <div class="nav-right">
    <div class="env-toggle" title="Environment">
      <a class="env-btn" href={'/' + title + '/'}>prod</a>
      <a class="env-btn" href={'/dev/' + title + '/'}>dev</a>
    </div>
    <a href="/" class="nav-link back-link">&larr; Back to docs</a>
    <a href={repoUrl} class="nav-link gh-link" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      GitHub
    </a>
  </div>
</nav>

<!-- ===== TAB BAR ===== -->
<div id="tab-bar">
  <button class="tab-btn active" data-tab="structure"><span class="tab-icon">&#9638;</span>Structure</button>
  <button class="tab-btn" data-tab="flows"><span class="tab-icon">&#8594;</span>Flows</button>
  <button class="tab-btn" data-tab="data"><span class="tab-icon">&#9707;</span>Data</button>
  <button class="tab-btn" data-tab="failure"><span class="tab-icon">&#9829;</span>Resilience</button>
  <div class="tab-description" id="tab-desc">Component hierarchy &mdash; expand and collapse to explore</div>
</div>

<!-- ===== TOOLTIP ===== -->
<div id="tooltip">
  <div class="tt-label"></div>
  <div class="tt-type"></div>
  <div class="tt-file"></div>
  <div class="tt-desc"></div>
  <div class="tt-exports"></div>
  <div class="tt-children-hint"></div>
</div>

<!-- ===== HIGHLIGHT PICKER (left drawer, slides in) ===== -->
<!-- expand button moves to breadcrumb via JS -->
<div id="highlight-bar">
  <div id="highlight-header">
    <span>Highlights</span>
    <button id="highlight-collapse" title="Close highlights">&#x276E;</button>
  </div>
  <div id="highlight-list"></div>
</div>

<!-- ===== BOTTOM DRAWER (narrative + details, slides up) ===== -->
<div id="bottom-panel">
  <div id="bottom-panel-header">
    <span id="bp-title"></span>
    <span id="bp-type-badge"></span>
    <button id="bottom-panel-close" aria-label="Close">&times;</button>
  </div>
  <div id="bottom-panel-body">
    <div id="bp-narrative"></div>
    <div id="bp-details">
      <div id="ctx-header"><span id="ctx-name"></span><span id="ctx-type-badge" style="display:none"></span></div>
      <a id="ctx-file" href="#" target="_blank" rel="noopener"></a>
      <p id="ctx-desc"></p>
      <div id="ctx-exports"></div>
    </div>
  </div>
  <div id="bp-terminal" style="display:none">
    <div class="terminal-body">
      <p class="terminal-welcome">Talk to this project's architecture. Ask questions, explore flows, understand decisions.</p>
      <div class="terminal-input-area">
        <span class="terminal-prompt">$</span>
        <input type="text" id="terminal-input" placeholder="Coming soon..." disabled />
      </div>
    </div>
  </div>
</div>

<!-- ===== TAB 1: STRUCTURE ===== -->
<div class="tab-panel active" id="structure-panel">
  <div id="cy-structure"></div>
  <div id="breadcrumb-bar">
    <button id="highlight-expand" title="Open highlights">&#x276F;</button>
    <div id="breadcrumb"></div>
    <div id="flow-dots"></div>
  </div>
  <button id="controls-toggle" title="Controls">&#9881;</button>
  <div id="controls-panel" class="controls-hidden">
    <div class="controls-section">
      <div class="controls-label">View</div>
      <button class="btn" id="btn-expand-all">Expand All</button>
      <button class="btn" id="btn-collapse-all">Collapse All</button>
      <button class="btn" id="btn-fit">Fit View</button>
      <button class="btn" id="btn-reset">Reset</button>
    </div>
  </div>
  <div id="info-badge"><span id="node-counter">Showing <strong>3</strong> of <strong>35</strong> nodes</span></div>
  <div id="bottom-left">
    <button id="terminal-toggle" title="Talk to this architecture">
      <svg width="20" height="18" viewBox="0 0 20 18" fill="none">
        <rect x="0.5" y="0.5" width="19" height="17" rx="3" stroke="currentColor" stroke-width="1"/>
        <path d="M4 12h5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        <path d="M4 5l3 3-3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </button>
  </div>
  <div id="flow-filters" style="display:none"></div>
  <button id="help-toggle" title="Help">?</button>
  <div id="help-panel" class="help-hidden">
    <div class="help-section">
      <div class="help-label">Interactions</div>
      <div class="help-tip">Click to expand &middot; Right-click to collapse<br>Scroll to zoom &middot; Drag to pan</div>
    </div>
    <div class="help-section">
      <div class="help-label">Node Types</div>
      <div class="legend-compact">
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="none" stroke="rgba(255,255,255,0.3)" stroke-dasharray="2 1"/></svg> Group</span>
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="#4a90d9"/></svg> Component</span>
        <span class="lc-item"><svg width="10" height="10"><polygon points="5,0 10,5 5,10 0,5" fill="#e67e22"/></svg> External</span>
        <span class="lc-item"><svg width="10" height="10"><polygon points="2,0 8,0 10,3 10,7 8,10 2,10 0,7 0,3" fill="#1abc9c"/></svg> Route</span>
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="#9b59b6"/></svg> Library</span>
        <span class="lc-item"><svg width="10" height="10"><circle cx="5" cy="5" r="4" fill="#e74c3c"/></svg> Config</span>
      </div>
    </div>
  </div>
</div>

<!-- ===== TAB 2: FLOWS ===== -->
<div class="tab-panel" id="flows-panel"><div class="flows-container" id="flows-container"></div></div>

<!-- ===== TAB 3: DATA ===== -->
<div class="tab-panel" id="data-panel">
  <div id="cy-data"></div>
  <div class="graph-legend" id="data-legend" style="display:none;">
    <h3>State Model</h3>
    <div class="legend-item"><div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="2" width="14" height="12" rx="3" fill="#e67e22"/></svg></div>Source of Truth</div>
    <div class="legend-item"><div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="2" width="14" height="12" rx="3" fill="#3498db"/></svg></div>Cache</div>
    <div class="legend-item"><div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="2" fill="#4a90d9"/></svg></div>Component (reader)</div>
    <div class="legend-item"><div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="2" fill="#9b59b6"/></svg></div>Store (writer)</div>
    <div class="legend-item" style="margin-top:8px;padding-top:8px;border-top:1px solid rgba(255,255,255,0.06);"><div class="legend-shape" style="opacity:0.6;"><svg viewBox="0 0 16 16"><line x1="2" y1="8" x2="14" y2="8" stroke="#2ecc71" stroke-width="2"/></svg></div><span style="color:#888;">Reads/writes state</span></div>
  </div>
</div>

<!-- ===== TAB 4: RESILIENCE ===== -->
<div class="tab-panel" id="failure-panel"><div class="resilience-container" id="resilience-container"></div></div>

<script is:inline>
(function() {
  'use strict';
  var dataEl = document.getElementById('arch-data');
  var RAW = JSON.parse(dataEl.textContent);
  var REPO_URL = JSON.parse(document.getElementById('repo-url').textContent);
  var NARRATIVES = JSON.parse(document.getElementById('narratives-data').textContent || '{}');
  var HAS_INLINE_NARRATIVES = !!RAW.overview;

  // DATA FLOWS
  var DATA_FLOWS = [];
  if (RAW.data_flows && RAW.data_flows.length > 0) {
    RAW.data_flows.forEach(function(df, idx) {
      var mermaidStr = df.mermaid || '';
      if (!mermaidStr && df.steps) {
        var lines = ['sequenceDiagram', '    autonumber'];
        df.steps.forEach(function(step) {
          if (step.to) lines.push('    ' + step.component + '->>' + step.to + ': ' + (step.action || '').substring(0, 60));
        });
        mermaidStr = lines.join('\n');
      }
      DATA_FLOWS.push({ id: df.id, name: df.name, number: idx + 1, description: df.description || '', narrative: df.narrative || '', path: df.steps ? df.steps.map(function(s) { return s.component; }).filter(Boolean) : [], steps: df.steps || [], mermaid: mermaidStr });
    });
  }
  if (DATA_FLOWS.length === 0) {
    var seenFlows = {};
    RAW.edges.forEach(function(e) {
      if (e.flowId && e.flowId !== 'dependency' && !seenFlows[e.flowId]) {
        seenFlows[e.flowId] = true;
        DATA_FLOWS.push({ id: e.flowId, name: e.flowId.replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }), number: DATA_FLOWS.length + 1, description: '', narrative: '', path: [], steps: [], mermaid: '' });
      }
    });
  }

  // STATE STORES
  var STATE_DATA = { stores: (RAW.state || []).map(function(s) { return { id: s.id, name: s.name || s.technology || s.id, purpose: s.purpose || 'unknown', description: s.description || '', narrative: s.narrative || '', scope: s.persistence || '', readers: s.readers || [], writers: s.writers || [s.component].filter(Boolean) }; }) };

  // FAILURE MODES
  var FAILURE_MODES = (RAW.failure_modes || []).map(function(f) { var name = f.name || f.trigger || f.id.replace(/^failure-/, '').replace(/-/g, ' ').replace(/\b\w/g, function(c) { return c.toUpperCase(); }); return { id: f.id, name: name, trigger: f.trigger || name, narrative: f.narrative || '', cascade: f.cascade || [], impact: f.impact || '', detection: f.detection || [], recovery: f.recovery || [], severity: f.severity || 'medium' }; });

  // DERIVED FLOW EDGES from steps
  DATA_FLOWS.forEach(function(flow) {
    if (!flow.steps || flow.steps.length === 0) return;
    flow.steps.forEach(function(step, i) {
      var src = step.component;
      var tgt = step.to || (flow.steps[i + 1] ? flow.steps[i + 1].component : null);
      if (src && tgt && src !== tgt) {
        var exists = RAW.edges.some(function(e) { return e.source === src && e.target === tgt && e.flowId === flow.id; });
        if (!exists) RAW.edges.push({ source: src, target: tgt, flowId: flow.id, label: step.action ? step.action.substring(0, 40) : '' });
      }
    });
  });

  // DATA INDEX
  var nodeMap = {}, childrenOf = {}, rootIds = [], totalNodes = RAW.nodes.length, nameToId = {};
  RAW.nodes.forEach(function(n) {
    nodeMap[n.id] = n;
    nameToId[n.id.toLowerCase()] = n.id;
    nameToId[n.name.toLowerCase()] = n.id;
    if (n.parent) { if (!childrenOf[n.parent]) childrenOf[n.parent] = []; childrenOf[n.parent].push(n.id); }
    else rootIds.push(n.id);
  });
  function countDescendants(id) { var kids = childrenOf[id] || []; var c = kids.length; kids.forEach(function(k) { c += countDescendants(k); }); return c; }
  function getAncestors(id) { var p = [], cur = id; while (cur) { p.unshift(cur); cur = nodeMap[cur] ? nodeMap[cur].parent : null; } return p; }
  function getAllDescendants(id) { var r = []; (childrenOf[id] || []).forEach(function(k) { r.push(k); r = r.concat(getAllDescendants(k)); }); return r; }

  // TYPE CONFIG
  var typeConfig = { 'group': { bg: '#2a2a4e', border: '#4a4a6e', text: '#aaa', shape: 'roundrectangle' }, 'component': { bg: '#4a90d9', border: '#3a78c0', text: '#fff', shape: 'roundrectangle' }, 'frontend': { bg: '#4a90d9', border: '#3a78c0', text: '#fff', shape: 'roundrectangle' }, 'service': { bg: '#3498db', border: '#2980b9', text: '#fff', shape: 'roundrectangle' }, 'external-service': { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'diamond' }, 'endpoint': { bg: '#d4740e', border: '#b8640c', text: '#fff', shape: 'diamond' }, 'route': { bg: '#1abc9c', border: '#14a085', text: '#fff', shape: 'hexagon' }, 'library': { bg: '#9b59b6', border: '#8244a0', text: '#fff', shape: 'roundrectangle' }, 'config': { bg: '#c0392b', border: '#a93226', text: '#fff', shape: 'ellipse' }, 'stylesheet': { bg: '#e74c3c', border: '#c0392b', text: '#fff', shape: 'ellipse' }, 'test-suite': { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'roundrectangle' }, 'test': { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'ellipse' }, 'gateway': { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'diamond' }, 'store': { bg: '#1abc9c', border: '#14a085', text: '#fff', shape: 'barrel' }, 'worker': { bg: '#2ecc71', border: '#27ae60', text: '#fff', shape: 'roundrectangle' }, 'api': { bg: '#3498db', border: '#2980b9', text: '#fff', shape: 'roundrectangle' } };
  function getTypeConfig(type) { return typeConfig[type] || typeConfig.component; }
  function escapeHtml(s) { return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;'); }
  var debtColors = { critical: '#e74c3c', high: '#e67e22', medium: '#f1c40f', low: '#2ecc71', none: '#555' };
  function getDebtColor(s) { return debtColors[s] || debtColors.none; }

  // NARRATIVE PARSER
  function resolveNodeId(text) { return nameToId[text.toLowerCase()] || null; }
  function parseNarrative(text) {
    if (!text) return '';
    var escaped = escapeHtml(text);
    return escaped.replace(/\*\*([^*]+)\*\*/g, function(m, inner) {
      var nid = resolveNodeId(inner);
      if (nid) return '<span class="sb-node-ref" data-node-id="' + escapeHtml(nid) + '">' + inner + '</span>';
      return '<strong>' + inner + '</strong>';
    });
  }

  // TOOLTIP
  var tooltip = document.getElementById('tooltip');
  var ttLabel = tooltip.querySelector('.tt-label'), ttType = tooltip.querySelector('.tt-type'), ttFile = tooltip.querySelector('.tt-file'), ttDesc = tooltip.querySelector('.tt-desc'), ttExports = tooltip.querySelector('.tt-exports'), ttChildrenHint = tooltip.querySelector('.tt-children-hint');
  function showTooltip(data, cfg) { ttLabel.textContent = data.name || data.label || ''; ttType.textContent = (data.type || data.nodeType || '').replace(/-/g, ' '); ttType.style.color = cfg ? (cfg.bg === '#2a2a4e' ? '#7b68ee' : cfg.bg) : '#7b68ee'; ttFile.textContent = data.file || ''; ttFile.style.display = data.file ? 'block' : 'none'; ttDesc.textContent = data.description || ''; if (data.exports && data.exports.length > 0) { var h = '<div class="tt-exports-title">Exports (' + data.exports.length + ')</div>'; data.exports.forEach(function(exp) { var en = typeof exp === 'string' ? exp : exp.name; var ek = typeof exp === 'string' ? '' : (exp.kind || ''); h += '<div class="tt-export-item"><span class="export-name">' + escapeHtml(en) + '</span>'; if (ek) h += '<span class="export-kind"> (' + ek + ')</span>'; h += '</div>'; }); ttExports.innerHTML = h; ttExports.style.display = 'block'; } else { ttExports.style.display = 'none'; } ttChildrenHint.style.display = 'none'; tooltip.classList.add('visible'); }
  function showStructureTooltip(cyNode) { var id = cyNode.data('id'); var n = nodeMap[id]; if (!n) return; showTooltip(n, getTypeConfig(n.type)); var kids = childrenOf[id] || []; if (kids.length > 0 && !structureState.expandedNodes[id]) { ttChildrenHint.textContent = 'Click to expand ' + countDescendants(id) + ' child nodes'; ttChildrenHint.style.display = 'block'; } else if (kids.length > 0 && structureState.expandedNodes[id]) { ttChildrenHint.textContent = 'Right-click to collapse'; ttChildrenHint.style.display = 'block'; } }
  function hideTooltip() { tooltip.classList.remove('visible'); }
  function positionTooltip(evt) { if (!tooltip.classList.contains('visible') || !evt) return; var x = evt.clientX || 0, y = evt.clientY || 0, pad = 16, tw = tooltip.offsetWidth, th = tooltip.offsetHeight; var left = x + pad, top = y + pad; if (left + tw > window.innerWidth - 20) left = x - tw - pad; if (top + th > window.innerHeight - 20) top = y - th - pad; tooltip.style.left = left + 'px'; tooltip.style.top = top + 'px'; }

  // BOTTOM PANEL + HIGHLIGHT BAR — unified selection state
  var bottomPanel = document.getElementById('bottom-panel'), bpTitle = document.getElementById('bp-title'), bpTypeBadge = document.getElementById('bp-type-badge'), bpNarrative = document.getElementById('bp-narrative'), bpDetails = document.getElementById('bp-details');
  var ctxName = document.getElementById('ctx-name'), ctxTypeBadge = document.getElementById('ctx-type-badge'), ctxFile = document.getElementById('ctx-file'), ctxDesc = document.getElementById('ctx-desc'), ctxExports = document.getElementById('ctx-exports');
  var highlightList = document.getElementById('highlight-list');
  var selectionState = { type: null, id: null };

  document.getElementById('bottom-panel-close').addEventListener('click', function() { setSelection(null, null); });

  function setSelection(type, id) {
    if (selectionState.type === type && selectionState.id === id) { type = null; id = null; }
    selectionState = { type: type, id: id };
    updateHighlightBar();
    updateDrawer();
    updateGraphForSelection();
  }

  function updateHighlightBar() {
    highlightList.querySelectorAll('.hl-item').forEach(function(el) {
      el.classList.toggle('active', el.dataset.selType === selectionState.type && el.dataset.selId === selectionState.id);
    });
  }

  function buildHighlightBar(tab) {
    var html = '';
    tab = tab || currentTab;
    // Primary highlights for this tab
    if (tab === 'structure' || tab === 'flows') {
      if (DATA_FLOWS.length > 0) {
        html += '<div class="hl-group-label">Flows</div>';
        DATA_FLOWS.forEach(function(f, i) {
          var color = flowColors[i % flowColors.length];
          html += '<button class="hl-item hl-flow" data-sel-type="flow" data-sel-id="' + f.id + '" style="--hl-color:' + color + '"><span class="hl-dot" style="background:' + color + '"></span>' + escapeHtml(f.name) + '</button>';
        });
      }
    }
    if (tab === 'data') {
      if (STATE_DATA.stores && STATE_DATA.stores.length > 0) {
        html += '<div class="hl-group-label">State Stores</div>';
        STATE_DATA.stores.forEach(function(st) {
          html += '<button class="hl-item hl-state" data-sel-type="state" data-sel-id="' + st.id + '" style="--hl-color:#f59e0b"><span class="hl-diamond" style="background:#f59e0b"></span>' + escapeHtml(st.name || st.id) + '</button>';
        });
      }
    }
    if (tab === 'failure') {
      if (FAILURE_MODES.length > 0) {
        html += '<div class="hl-group-label">Failure Scenarios</div>';
        FAILURE_MODES.forEach(function(fm) {
          var color = fm.severity === 'critical' ? '#e74c3c' : fm.severity === 'high' ? '#e67e22' : '#f39c12';
          html += '<button class="hl-item hl-failure" data-sel-type="failure" data-sel-id="' + fm.id + '" style="--hl-color:' + color + '"><span class="hl-square" style="background:' + color + '"></span>' + escapeHtml(fm.name || fm.trigger || fm.id) + '</button>';
        });
      }
    }
    // Secondary highlights (collapsed, other tabs)
    var secondary = [];
    if (tab !== 'structure' && tab !== 'flows' && DATA_FLOWS.length > 0) secondary.push({ label: 'Flows', items: DATA_FLOWS, type: 'flow', shape: 'dot' });
    if (tab !== 'data' && STATE_DATA.stores && STATE_DATA.stores.length > 0) secondary.push({ label: 'State', items: STATE_DATA.stores, type: 'state', shape: 'diamond' });
    if (tab !== 'failure' && FAILURE_MODES.length > 0) secondary.push({ label: 'Failures', items: FAILURE_MODES, type: 'failure', shape: 'square' });
    secondary.forEach(function(group) {
      html += '<div class="hl-group-label secondary">' + group.label + '</div>';
      group.items.forEach(function(item, i) {
        var color = group.type === 'flow' ? flowColors[i % flowColors.length] : group.type === 'failure' ? (item.severity === 'critical' ? '#e74c3c' : item.severity === 'high' ? '#e67e22' : '#f39c12') : '#f59e0b';
        var shape = group.shape === 'dot' ? 'hl-dot' : group.shape === 'square' ? 'hl-square' : 'hl-diamond';
