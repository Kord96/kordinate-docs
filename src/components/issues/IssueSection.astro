---
import IssueCard from './IssueCard.astro';

interface Props {
  id: string;
  title: string;
  titleColor: string;
  issues: any[];
  sevColor: (s: string) => string;
  showSeverity?: boolean;
}
const { id, title, titleColor, issues, sevColor, showSeverity = true } = Astro.props;
---

{issues.length > 0 && (
  <div class="section" id={id}>
    <div class="section-header">
      <span class="section-title" style={`color: ${titleColor}`}>{title}</span>
      <span class="section-count">{issues.length}</span>
    </div>
    {issues.map((issue: any) => (
      <IssueCard issue={issue} sevColor={sevColor} showSeverity={showSeverity} />
    ))}
  </div>
)}
