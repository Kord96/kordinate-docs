  function findVisibleNodeForEdge(nodeId, visibleIds) {
    var current = nodeId;
    while (current) {
      if (visibleIds.has(current)) return current;
      current = nodeMap[current] ? nodeMap[current].parent : null;
    }
    return null;
  }

  function getTopLevel(id) {
    var current = id;
    while (nodeMap[current] && nodeMap[current].parent) {
      current = nodeMap[current].parent;
    }
    return current;
  }

  function rebuildStructureGraph(animateLayout) {
    var elements = [];
    var visibleIds = new Set();

    function addNode(id, parentIdInGraph) {
      var n = nodeMap[id];
      if (!n) return;
      visibleIds.add(id);

      var isExpanded = structureState.expandedNodes[id];
      var kids = childrenOf[id] || [];
      var hasKids = kids.length > 0;
      var desc = countDescendants(id);

      var label = n.name;
      if (hasKids && !isExpanded) {
        label = n.name + '  [' + desc + ']';
      }

      var nodeData = {
        id: id,
        label: label,
        nodeType: n.type,
        description: n.description || '',
        hasChildren: hasKids,
        collapsed: hasKids && !isExpanded,
        file: n.file || '',
        origName: n.name
      };
      if (parentIdInGraph) {
        nodeData.parent = parentIdInGraph;
      }

      elements.push({ group: 'nodes', data: nodeData });

      if (isExpanded && hasKids) {
        kids.forEach(function(kid) { addNode(kid, id); });
      }
    }

    rootIds.forEach(function(rid) { addNode(rid, null); });

    var edgeElements = [];
    RAW.edges.forEach(function(e, i) {
      var src = findVisibleNodeForEdge(e.source, visibleIds);
      var tgt = findVisibleNodeForEdge(e.target, visibleIds);
      if (src && tgt && src !== tgt) {
        var exists = edgeElements.some(function(ee) {
          return ee.data.source === src && ee.data.target === tgt;
        });
        if (!exists) {
          var srcTop = getTopLevel(src);
          var tgtTop = getTopLevel(tgt);
          var edgeStyle = srcTop !== tgtTop ? 'dashed' : 'solid';
          edgeElements.push({
            group: 'edges',
            data: {
              id: 'edge-' + i + '-' + src + '-' + tgt,
              source: src,
              target: tgt,
              label: e.label || '',
              edgeStyle: edgeStyle,
              flowId: e.flowId || ''
            }
          });
        }
      }
    });

    elements = elements.concat(edgeElements);

    cyStructure.elements().remove();
    cyStructure.add(elements);

    updateNodeCounter(visibleIds.size);

    var layoutOpts = {
      name: 'cose-bilkent',
      quality: 'proof',
      nodeDimensionsIncludeLabels: true,
      idealEdgeLength: visibleIds.size > 30 ? 80 : 120,
      nodeRepulsion: visibleIds.size > 30 ? 6000 : 8000,
      edgeElasticity: 0.45,
      nestingFactor: 0.1,
      gravity: 0.25,
      gravityRange: 3.8,
      numIter: 2500,
      tile: true,
      tilingPaddingVertical: 16,
      tilingPaddingHorizontal: 16,
      animate: animateLayout ? 'end' : false,
      animationDuration: animateLayout ? 400 : 0,
      fit: true,
      padding: 100
    };

    cyStructure.layout(layoutOpts).run();
    cyStructure.nodes('[?collapsed]').ungrabify();
  }

  function expandNode(id) {
    if (!childrenOf[id] || childrenOf[id].length === 0) return;
    structureState.expandedNodes[id] = true;
    rebuildStructureGraph(true);
    updateBreadcrumb(id);
  }

  function collapseNode(id) {
    delete structureState.expandedNodes[id];
    function collapseDescendants(nid) {
      (childrenOf[nid] || []).forEach(function(kid) {
        delete structureState.expandedNodes[kid];
        collapseDescendants(kid);
      });
    }
    collapseDescendants(id);
    rebuildStructureGraph(true);
    updateBreadcrumb(nodeMap[id] ? nodeMap[id].parent : null);
  }

  function expandAll() {
    RAW.nodes.forEach(function(n) {
      if (n.hasChildren) structureState.expandedNodes[n.id] = true;
    });
    rebuildStructureGraph(false);
    updateBreadcrumb(null);
  }

  function collapseAll() {
    structureState.expandedNodes = {};
    rebuildStructureGraph(true);
    updateBreadcrumb(null);
  }

  function resetView() {
    structureState.expandedNodes = {};
    rebuildStructureGraph(false);
    updateBreadcrumb(null);
    setTimeout(function() { cyStructure.fit(undefined, 100); }, 300);
  }

  function updateBreadcrumb(activeNodeId) {
    var bc = document.getElementById('breadcrumb');
    bc.innerHTML = '';

    var rootCrumb = document.createElement('span');
    rootCrumb.className = 'bc-crumb' + (!activeNodeId ? ' current' : '');
    rootCrumb.textContent = 'System';
    rootCrumb.onclick = function() { collapseAll(); };
    bc.appendChild(rootCrumb);

    if (!activeNodeId) return;

    var ancestors = getAncestors(activeNodeId);
    ancestors.forEach(function(id, idx) {
      var sep = document.createElement('span');
      sep.className = 'bc-sep';
      sep.textContent = '\u203A';
      bc.appendChild(sep);

      var crumb = document.createElement('span');
      var isLast = idx === ancestors.length - 1;
      crumb.className = 'bc-crumb' + (isLast ? ' current' : '');
      crumb.textContent = nodeMap[id].name;
      if (!isLast) {
        crumb.onclick = (function(nid) {
          return function() {
            (childrenOf[nid] || []).forEach(function(kid) {
              delete structureState.expandedNodes[kid];
              (function collapseBelow(cid) {
                (childrenOf[cid] || []).forEach(function(c) {
                  delete structureState.expandedNodes[c];
                  collapseBelow(c);
                });
              })(kid);
            });
            rebuildStructureGraph(true);
            updateBreadcrumb(nid);
          };
        })(id);
      }
      bc.appendChild(crumb);
    });
  }

  function updateNodeCounter(visible) {
    document.getElementById('node-counter').innerHTML =
      'Showing <strong>' + visible + '</strong> of <strong>' + totalNodes + '</strong> nodes';
  }

  // Flow filters
  var flows = [
    { id: 'ssr-prefetch-flow', name: 'SSR Prefetch', color: '#4a90d9' },
    { id: 'infinite-scroll-flow', name: 'Infinite Scroll', color: '#1abc9c' },
    { id: 'load-more-flow', name: 'Load More', color: '#e67e22' },
    { id: 'cart-flow', name: 'Cart Flow', color: '#9b59b6' },
    { id: 'theme-flow', name: 'Theme Toggle', color: '#e74c3c' }
  ];

  function buildFlowFilters() {
    var container = document.getElementById('flow-filters');
    flows.forEach(function(flow) {
      var pill = document.createElement('button');
      pill.className = 'flow-pill';
      pill.textContent = flow.name;
      pill.dataset.flowId = flow.id;
      pill.onclick = function() {
        if (structureState.activeFlow === flow.id) {
          structureState.activeFlow = null;
          pill.classList.remove('active');
          cyStructure.elements().removeClass('dimmed flow-highlight highlighted');
        } else {
          structureState.activeFlow = flow.id;
          document.querySelectorAll('.flow-pill').forEach(function(p) { p.classList.remove('active'); });
          pill.classList.add('active');
          highlightFlow(flow.id);
        }
      };
      container.appendChild(pill);
    });
  }

  function highlightFlow(flowId) {
    cyStructure.elements().removeClass('dimmed flow-highlight highlighted');
    var flowEdges = cyStructure.edges().filter(function(e) { return e.data('flowId') === flowId; });
    if (flowEdges.length === 0) return;
    var connectedNodes = flowEdges.connectedNodes();
    var allRelevant = connectedNodes.union(flowEdges);
    connectedNodes.forEach(function(n) { allRelevant = allRelevant.union(n.ancestors()); });
    cyStructure.elements().not(allRelevant).addClass('dimmed');
    flowEdges.addClass('flow-highlight');
  }

  // Structure event handlers
  cyStructure.on('tap', 'node', function(e) {
    var id = e.target.data('id');
    var n = nodeMap[id];
    if (n) showContextPanel(n);
    if ((childrenOf[id] || []).length > 0 && !structureState.expandedNodes[id]) {
      expandNode(id);
    }
  });

  cyStructure.on('cxttap', 'node', function(e) {
    e.preventDefault();
    var id = e.target.data('id');
    if (structureState.expandedNodes[id]) collapseNode(id);
  });

  cyStructure.on('tap', function(e) {
    if (e.target === cyStructure) hideContextPanel();
  });

  document.getElementById('cy-structure').addEventListener('contextmenu', function(e) { e.preventDefault(); });

  cyStructure.on('mouseover', 'node', function(e) {
    showStructureTooltip(e.target);
    e.target.addClass('hover-glow');
    if (!structureState.activeFlow) {
      var connected = e.target.connectedEdges();
      var neighbors = e.target.neighborhood().add(e.target);
      connected.addClass('highlighted');
      cyStructure.elements().not(neighbors).not(connected).addClass('dimmed');
    }
  });

  cyStructure.on('mouseout', 'node', function(e) {
    hideTooltip();
    e.target.removeClass('hover-glow');
    if (!structureState.activeFlow) {
      cyStructure.elements().removeClass('highlighted dimmed');
    }
  });

  cyStructure.on('mousemove', function(e) {
    if (e.originalEvent) positionTooltip(e.originalEvent);
  });

  cyStructure.on('mouseover', 'node[?collapsed][?hasChildren]', function() {
    document.getElementById('cy-structure').style.cursor = 'pointer';
  });
  cyStructure.on('mouseout', 'node[?collapsed][?hasChildren]', function() {
    document.getElementById('cy-structure').style.cursor = 'default';
  });
  cyStructure.on('mouseover', 'node[!collapsed][?hasChildren]', function() {
    document.getElementById('cy-structure').style.cursor = 'pointer';
  });
  cyStructure.on('mouseout', 'node[!collapsed][?hasChildren]', function() {
    document.getElementById('cy-structure').style.cursor = 'default';
  });

  document.getElementById('btn-expand-all').addEventListener('click', expandAll);
  document.getElementById('btn-collapse-all').addEventListener('click', collapseAll);
  document.getElementById('btn-reset').addEventListener('click', resetView);
  document.getElementById('btn-fit').addEventListener('click', function() {
    cyStructure.animate({ fit: { padding: 100 }, duration: 400, easing: 'ease-in-out-cubic' });
  });

  // Initialize structure
  buildFlowFilters();
  rebuildStructureGraph(false);
  updateBreadcrumb(null);
  tabInitialized.structure = true;

  cyStructure.ready(function() {
    setTimeout(function() {
      cyStructure.fit(undefined, 100);
      cyStructure.panBy({ x: 0, y: 50 });
    }, 300);
  });

  // ==========================================================================
  // TAB 2: FLOWS (Mermaid sequence diagrams)
  // ==========================================================================
  function initFlows() {
    mermaid.initialize({
      startOnLoad: false,
      theme: 'dark',
      themeVariables: {
        primaryColor: '#2a2a5e',
        primaryBorderColor: '#7b68ee',
        primaryTextColor: '#ddd',
        lineColor: '#7b68ee',
        secondaryColor: 'rgba(123,104,238,0.08)',
        tertiaryColor: 'rgba(123,104,238,0.05)',
        noteBkgColor: 'rgba(123,104,238,0.12)',
        noteBorderColor: 'rgba(123,104,238,0.3)',
        noteTextColor: '#bbb',
        actorBkg: '#2a2a5e',
        actorBorder: '#7b68ee',
        actorTextColor: '#ddd',
        actorLineColor: 'rgba(123,104,238,0.3)',
        signalColor: '#ccc',
        signalTextColor: '#ccc',
        sequenceNumberColor: '#1a1a2e',
        fontFamily: 'Inter, sans-serif'
      },
      sequence: {
        actorMargin: 60,
        width: 180,
        height: 50,
        boxMargin: 10,
        boxTextMargin: 5,
        noteMargin: 10,
        messageMargin: 40,
        mirrorActors: false,
        useMaxWidth: true,
        showSequenceNumbers: true
      }
    });

    var container = document.getElementById('flows-container');
    container.innerHTML = '';

    DATA_FLOWS.forEach(function(flow, idx) {
      var section = document.createElement('div');
      section.className = 'flow-section';
      section.innerHTML =
        '<div class="flow-header" data-flow-idx="' + idx + '">' +
          '<h3><span class="flow-number">' + flow.number + '</span>' + escapeHtml(flow.name) + '</h3>' +
          '<span class="flow-toggle open">&#9660;</span>' +
        '</div>' +
        '<div class="flow-desc">' + escapeHtml(flow.description) + '</div>' +
        '<div class="flow-path">Path: ' + flow.path.map(function(p) { return '<span>' + p + '</span>'; }).join(' &rarr; ') + '</div>' +
        '<div class="flow-diagram"><div class="mermaid" id="mermaid-' + idx + '">' + flow.mermaid + '</div></div>';
      container.appendChild(section);
    });

    // Render mermaid diagrams
    DATA_FLOWS.forEach(function(flow, idx) {
      var el = document.getElementById('mermaid-' + idx);
      var id = 'mermaid-svg-' + idx;
      mermaid.render(id, flow.mermaid).then(function(result) {
        el.innerHTML = result.svg;
      }).catch(function(err) {
        el.innerHTML = '<pre style="color:#e74c3c;font-size:12px;">Diagram render error: ' + escapeHtml(err.message || String(err)) + '</pre>';
      });
    });

    // Accordion toggle
    container.addEventListener('click', function(e) {
      var header = e.target.closest('.flow-header');
      if (!header) return;
      var section = header.parentElement;
      var desc = section.querySelector('.flow-desc');
      var path = section.querySelector('.flow-path');
      var diagram = section.querySelector('.flow-diagram');
      var toggle = header.querySelector('.flow-toggle');

      var isOpen = toggle.classList.contains('open');
      if (isOpen) {
        desc.style.display = 'none';
        path.style.display = 'none';
        diagram.style.display = 'none';
        toggle.classList.remove('open');
      } else {
        desc.style.display = '';
        path.style.display = '';
        diagram.style.display = '';
        toggle.classList.add('open');
      }
    });
  }

  // ==========================================================================
  // TAB 3: DATA (State stores graph)
  // ==========================================================================
  var cyData = null;

  function initDataTab() {
    var elements = [];

    // Purpose group nodes
    var purposes = {};
    STATE_DATA.stores.forEach(function(store) {
      if (!purposes[store.purpose]) {
        purposes[store.purpose] = true;
        var pLabel = store.purpose === 'source-of-truth' ? 'Source of Truth' :
                     store.purpose === 'cache' ? 'Cache' : store.purpose;
        elements.push({
          group: 'nodes',
          data: {
            id: 'purpose-' + store.purpose,
            label: pLabel,
            nodeType: 'purpose-group'
          }
        });
      }
    });

    // Store nodes
    STATE_DATA.stores.forEach(function(store) {
      elements.push({
        group: 'nodes',
        data: {
          id: 'store-' + store.id,
          label: store.name,
          nodeType: 'store',
          description: store.description,
          scope: store.scope,
          parent: 'purpose-' + store.purpose
        }
      });
    });

    // Collect all component IDs referenced
    var componentIds = new Set();
    STATE_DATA.stores.forEach(function(store) {
      store.readers.forEach(function(r) { componentIds.add(r); });
      store.writers.forEach(function(w) { componentIds.add(w); });
    });

    // Component nodes
    componentIds.forEach(function(cid) {
      var n = nodeMap[cid];
      if (!n) return;
      elements.push({
        group: 'nodes',
        data: {
          id: 'comp-' + cid,
          label: n.name,
          nodeType: n.type,
          description: n.description,
          file: n.file
        }
      });
    });

    // Edges: read/write
    var edgeIdx = 0;
    STATE_DATA.stores.forEach(function(store) {
      var readers = new Set(store.readers);
      var writers = new Set(store.writers);

      // Both read and write
      writers.forEach(function(w) {
        if (readers.has(w)) {
          elements.push({
            group: 'edges',
            data: {
              id: 'data-edge-' + (edgeIdx++),
              source: 'comp-' + w,
              target: 'store-' + store.id,
              label: 'read-write',
              edgeType: 'read-write'
            }
          });
          readers.delete(w);
        } else {
          elements.push({
            group: 'edges',
            data: {
              id: 'data-edge-' + (edgeIdx++),
              source: 'comp-' + w,
              target: 'store-' + store.id,
              label: 'write',
              edgeType: 'write'
            }
          });
        }
      });

      readers.forEach(function(r) {
        elements.push({
          group: 'edges',
          data: {
            id: 'data-edge-' + (edgeIdx++),
            source: 'store-' + store.id,
            target: 'comp-' + r,
            label: 'read',
            edgeType: 'read'
          }
        });
      });
    });

    cyData = cytoscape({
      container: document.getElementById('cy-data'),
      elements: elements,
      minZoom: 0.3,
      maxZoom: 3,
      wheelSensitivity: 0.3,
      style: [
        // Purpose groups
        {
          selector: 'node[nodeType="purpose-group"]',
          style: {
            'shape': 'roundrectangle',
            'background-color': 'rgba(42,42,78,0.5)',
            'border-width': 1.5,
            'border-style': 'dashed',
            'border-color': 'rgba(255,255,255,0.08)',
            'label': 'data(label)',
            'color': '#777',
            'font-size': '12px',
            'font-weight': '600',
            'text-halign': 'center',
            'text-valign': 'top',
            'text-margin-y': -6,
            'padding': '30px',
            'font-family': 'Inter, sans-serif',
            'text-transform': 'uppercase'
          }
        },
        // Store nodes
        {
          selector: 'node[nodeType="store"]',
          style: {
            'shape': 'barrel',
            'width': function(ele) { return Math.max(180, 130 + ele.data('label').length * 4); },
            'height': 60,
            'background-color': function(ele) {
              var p = ele.parent();
              if (p && p.length > 0) {
                var pid = p.data('id');
                if (pid === 'purpose-source-of-truth') return '#e67e22';
                if (pid === 'purpose-cache') return '#3498db';
              }
              return '#9b59b6';
            },
            'border-width': 2,
            'border-color': function(ele) {
              var p = ele.parent();
              if (p && p.length > 0) {
                var pid = p.data('id');
                if (pid === 'purpose-source-of-truth') return '#cf6d14';
                if (pid === 'purpose-cache') return '#2980b9';
              }
              return '#8244a0';
            },
            'label': 'data(label)',
            'color': '#fff',
            'font-size': '12px',
            'font-weight': '600',
            'text-halign': 'center',
            'text-valign': 'center',
            'text-wrap': 'wrap',
            'text-max-width': '160px',
            'font-family': 'Inter, sans-serif'
          }
        },
        // Component nodes (non-store)
        {
          selector: 'node[nodeType!="store"][nodeType!="purpose-group"]',
          style: {
            'shape': 'roundrectangle',
            'width': function(ele) { return Math.max(150, 110 + ele.data('label').length * 3.5); },
            'height': 44,
            'background-color': function(ele) { return getTypeConfig(ele.data('nodeType')).bg; },
            'border-width': 0,
            'label': 'data(label)',
            'color': '#fff',
            'font-size': '11px',
            'font-weight': '500',
            'text-halign': 'center',
            'text-valign': 'center',
            'text-wrap': 'wrap',
            'text-max-width': '140px',
            'font-family': 'Inter, sans-serif'
          }
        },
        // Read edges
        {
          selector: 'edge[edgeType="read"]',
          style: {
            'width': 2,
            'line-color': '#2ecc71',
            'target-arrow-color': '#2ecc71',
            'target-arrow-shape': 'triangle',
            'arrow-scale': 0.8,
            'curve-style': 'bezier',
            'label': 'data(label)',
            'font-size': '9px',
            'font-family': 'Inter, sans-serif',
            'color': '#2ecc71',
            'text-rotation': 'autorotate',
            'text-margin-y': -10,
            'text-background-color': '#1a1a2e',
            'text-background-opacity': 0.85,
            'text-background-padding': '3px',
            'text-background-shape': 'roundrectangle'
          }
        },
        // Write edges
        {
          selector: 'edge[edgeType="write"]',
          style: {
            'width': 2,
            'line-color': '#e74c3c',
            'target-arrow-color': '#e74c3c',
            'target-arrow-shape': 'triangle',
            'arrow-scale': 0.8,
            'curve-style': 'bezier',
            'label': 'data(label)',
            'font-size': '9px',
            'font-family': 'Inter, sans-serif',
            'color': '#e74c3c',
            'text-rotation': 'autorotate',
            'text-margin-y': -10,
            'text-background-color': '#1a1a2e',
            'text-background-opacity': 0.85,
            'text-background-padding': '3px',
            'text-background-shape': 'roundrectangle'
          }
        },
        // Read-write edges
        {
          selector: 'edge[edgeType="read-write"]',
          style: {
            'width': 2.5,
            'line-color': '#f39c12',
            'target-arrow-color': '#f39c12',
            'target-arrow-shape': 'triangle',
            'source-arrow-color': '#f39c12',
            'source-arrow-shape': 'triangle',
            'arrow-scale': 0.7,
            'curve-style': 'bezier',
            'label': 'data(label)',
            'font-size': '9px',
            'font-family': 'Inter, sans-serif',
            'color': '#f39c12',
            'text-rotation': 'autorotate',
            'text-margin-y': -10,
            'text-background-color': '#1a1a2e',
            'text-background-opacity': 0.85,
            'text-background-padding': '3px',
            'text-background-shape': 'roundrectangle'
          }
        },
        // Hover
        { selector: 'node.hover-glow', style: { 'overlay-color': '#7b68ee', 'overlay-opacity': 0.15, 'overlay-padding': 8 } },
        { selector: 'node.dimmed', style: { 'opacity': 0.2 } },
        { selector: 'edge.dimmed', style: { 'opacity': 0.08 } },
        { selector: 'edge.highlighted', style: { 'width': 3, 'z-index': 999 } }
      ]
    });

    cyData.layout({
      name: 'cose-bilkent',
      quality: 'proof',
      nodeDimensionsIncludeLabels: true,
      idealEdgeLength: 150,
      nodeRepulsion: 10000,
      edgeElasticity: 0.3,
      nestingFactor: 0.15,
      gravity: 0.2,
      numIter: 2500,
      fit: true,
      padding: 80
    }).run();

    // Tooltip for data tab
    cyData.on('mouseover', 'node', function(e) {
      var node = e.target;
      var data = node.data();
      if (data.nodeType === 'purpose-group') return;
      var cfg = data.nodeType === 'store' ? { bg: '#e67e22' } : getTypeConfig(data.nodeType);
      var tooltipData = {
        name: data.label,
        type: data.nodeType,
        description: data.description || data.scope || '',
        file: data.file
      };
      showTooltip(tooltipData, cfg);
      node.addClass('hover-glow');
      var connected = node.connectedEdges();
      var neighbors = node.neighborhood().add(node);
      connected.addClass('highlighted');
      cyData.elements().not(neighbors).not(connected).not(node.ancestors()).addClass('dimmed');
    });

    cyData.on('mouseout', 'node', function(e) {
      hideTooltip();
      e.target.removeClass('hover-glow');
      cyData.elements().removeClass('highlighted dimmed');
    });

    cyData.on('mousemove', function(e) {
      if (e.originalEvent) positionTooltip(e.originalEvent);
    });

    // Context panel on click for data tab
    cyData.on('tap', 'node', function(e) {
      var d = e.target.data();
      if (d.nodeType === 'purpose-group') return;
      var n = nodeMap[d.id.replace(/^comp-/, '')] || nodeMap[d.id.replace(/^store-/, '')];
      if (n) {
        showContextPanel(n);
      } else {
        showContextPanel({ name: d.label, type: d.nodeType, description: d.description || d.scope || '', file: d.file });
      }
    });

    cyData.on('tap', function(e) {
      if (e.target === cyData) hideContextPanel();
    });
  }

  // ==========================================================================
  // TAB 4: RESILIENCE (vertical timeline runbook)
  // ==========================================================================
  function initFailureTab() {
    var container = document.getElementById('resilience-container');

    // Build controls
    var controlsDiv = document.createElement('div');
    controlsDiv.className = 'resilience-controls';
    controlsDiv.innerHTML = '<label for="failure-select">Scenario:</label><select id="failure-select"></select>';
    container.appendChild(controlsDiv);

    // Build timeline container
    var timelineDiv = document.createElement('div');
    timelineDiv.id = 'resilience-timeline';
    container.appendChild(timelineDiv);

    // Populate dropdown
    var select = document.getElementById('failure-select');
    FAILURE_MODES.forEach(function(fm) {
      var opt = document.createElement('option');
      opt.value = fm.id;
      opt.textContent = fm.name + ' (' + fm.severity + ')';
      select.appendChild(opt);
    });

    select.addEventListener('change', function() {
      renderResilienceTimeline(select.value);
    });

    renderResilienceTimeline(FAILURE_MODES[0].id);
  }

  function renderResilienceTimeline(failureId) {
    var fm = FAILURE_MODES.find(function(f) { return f.id === failureId; });
    if (!fm) return;

    var container = document.getElementById('resilience-timeline');
    var html = '';

    // Severity badge
    html += '<div style="display:flex;align-items:center;gap:12px;margin-bottom:20px;">';
    html += '<span class="resilience-severity ' + fm.severity + '">' + fm.severity + '</span>';
    html += '<span style="font-size:14px;color:#ccc;font-weight:500;">' + escapeHtml(fm.name) + '</span>';
    html += '</div>';

    html += '<div class="resilience-timeline">';

    // 1. TRIGGER
    html += '<div class="timeline-section trigger">';
    html += '<div class="timeline-dot"></div>';
    html += '<div class="timeline-header">Trigger</div>';
    html += '<div class="timeline-content"><div class="timeline-text">' + escapeHtml(fm.trigger) + '</div></div>';
    html += '</div>';

    // 2. CASCADE
    if (fm.cascade && fm.cascade.length > 0) {
      html += '<div class="timeline-section cascade">';
      html += '<div class="timeline-dot"></div>';
      html += '<div class="timeline-header">Cascade <span style="font-weight:400;font-size:10px;letter-spacing:0;text-transform:none;color:#888;">(' + fm.cascade.length + ' component' + (fm.cascade.length > 1 ? 's' : '') + ')</span></div>';
      html += '<div class="timeline-content">';
      fm.cascade.forEach(function(step, i) {
        html += '<div class="cascade-step">';
        html += '<span class="step-number">' + (i + 1) + '</span>';
        html += '<span class="step-component">' + escapeHtml(step.component) + '</span>';
        html += '<span class="step-arrow">\u2192</span>';
        html += '<span class="step-effect">' + escapeHtml(step.effect) + '</span>';
        html += '</div>';
      });
      html += '</div></div>';
    }

    // 3. IMPACT
    html += '<div class="timeline-section impact">';
    html += '<div class="timeline-dot"></div>';
    html += '<div class="timeline-header">Impact</div>';
    html += '<div class="timeline-content"><div class="timeline-text">' + escapeHtml(fm.impact) + '</div></div>';
    html += '</div>';

    // 4. DETECTION
    if (fm.detection && fm.detection.length > 0) {
      html += '<div class="timeline-section detection">';
      html += '<div class="timeline-dot"></div>';
      html += '<div class="timeline-header">Detection <span style="font-weight:400;font-size:10px;letter-spacing:0;text-transform:none;color:#888;">(' + fm.detection.length + ' signal' + (fm.detection.length > 1 ? 's' : '') + ')</span></div>';
      html += '<div class="timeline-content">';
      fm.detection.forEach(function(signal, i) {
        html += '<div class="signal-item">';
        html += '<span class="step-number">' + (i + 1) + '</span>';
        html += '<span>' + escapeHtml(signal) + '</span>';
        html += '</div>';
      });
      html += '</div></div>';
    }

    // 5. RECOVERY
    if (fm.recovery && fm.recovery.length > 0) {
      html += '<div class="timeline-section recovery">';
      html += '<div class="timeline-dot"></div>';
      html += '<div class="timeline-header">Recovery <span style="font-weight:400;font-size:10px;letter-spacing:0;text-transform:none;color:#888;">(' + fm.recovery.length + ' step' + (fm.recovery.length > 1 ? 's' : '') + ')</span></div>';
      html += '<div class="timeline-content">';
      fm.recovery.forEach(function(step, i) {
        html += '<div class="signal-item">';
        html += '<span class="step-number">' + (i + 1) + '</span>';
        html += '<span>' + escapeHtml(step) + '</span>';
        html += '</div>';
      });
      html += '</div></div>';
    }

    html += '</div>'; // close resilience-timeline

    container.innerHTML = html;
  }

  // ==========================================================================
  // DEBUG EXPORTS
  // ==========================================================================
  window.cyStructure = cyStructure;
  window.archData = RAW;

})();
</script>

</body>
</html>

<style is:global>
