  function showStructureTooltip(cyNode) {
    var id = cyNode.data('id');
    var n = nodeMap[id];
    if (!n) return;
    var cfg = getTypeConfig(n.type);
    showTooltip(n, cfg);

    var kids = childrenOf[id] || [];
    if (kids.length > 0 && !structureState.expandedNodes[id]) {
      ttChildrenHint.textContent = 'Click to expand ' + countDescendants(id) + ' child nodes';
      ttChildrenHint.style.display = 'block';
    } else if (kids.length > 0 && structureState.expandedNodes[id]) {
      ttChildrenHint.textContent = 'Right-click to collapse';
      ttChildrenHint.style.display = 'block';
    }
  }

  function hideTooltip() {
    tooltip.classList.remove('visible');
  }

  function positionTooltip(evt) {
    if (!tooltip.classList.contains('visible') || !evt) return;
    var x = evt.clientX || 0;
    var y = evt.clientY || 0;
    var pad = 16;
    var tw = tooltip.offsetWidth;
    var th = tooltip.offsetHeight;
    var left = x + pad;
    var top = y + pad;
    if (left + tw > window.innerWidth - 20) left = x - tw - pad;
    if (top + th > window.innerHeight - 20) top = y - th - pad;
    tooltip.style.left = left + 'px';
    tooltip.style.top = top + 'px';
  }

