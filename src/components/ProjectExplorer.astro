---
import logoDark from '../assets/logo_dark.webp';

interface Props {
  title: string;
  subtitle: string;
  data: any;
  repoUrl: string;
}

const { title, subtitle, data, repoUrl } = Astro.props;
---

<html lang="en" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} -- Project Explorer</title>

  <script src="https://unpkg.com/cytoscape@3.30.4/dist/cytoscape.min.js" is:inline></script>
  <script src="https://unpkg.com/layout-base@2.0.1/layout-base.js" is:inline></script>
  <script src="https://unpkg.com/cose-base@2.2.0/cose-base.js" is:inline></script>
  <script src="https://unpkg.com/cytoscape-cose-bilkent@4.1.0/cytoscape-cose-bilkent.js" is:inline></script>
  <script src="https://cdn.jsdelivr.net/npm/mermaid/dist/mermaid.min.js" is:inline></script>
</head>
<body>

<!-- Embedded architecture data -->
<script id="arch-data" type="application/json" set:html={JSON.stringify(data)} />
<script id="repo-url" type="application/json" set:html={JSON.stringify(repoUrl)} />

<!-- ===== NAV BAR ===== -->
<nav id="site-nav">
  <div class="nav-left">
    <a href="/" class="nav-logo-link">
      <img src={logoDark.src} alt="Docs" class="nav-logo" />
      <span class="nav-title">Docs</span>
    </a>
    <span class="nav-sep">/</span>
    <span class="nav-project">{title}</span>
  </div>
  <div class="nav-right">
    <a href="/" class="nav-link back-link">&larr; Back to docs</a>
    <a href={repoUrl} class="nav-link gh-link" target="_blank" rel="noopener">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
      GitHub
    </a>
  </div>
</nav>

<!-- ===== TAB BAR ===== -->
<div id="tab-bar">
  <button class="tab-btn active" data-tab="structure">
    <span class="tab-icon">&#9638;</span>Structure
  </button>
  <button class="tab-btn" data-tab="flows">
    <span class="tab-icon">&#8594;</span>Flows
  </button>
  <button class="tab-btn" data-tab="data">
    <span class="tab-icon">&#9707;</span>Data
  </button>
  <button class="tab-btn" data-tab="failure">
    <span class="tab-icon">&#x1F6E1;</span>Resilience
  </button>
  <div class="tab-description" id="tab-desc">Component hierarchy &mdash; expand and collapse to explore</div>
</div>

<!-- ===== TOOLTIP (shared) ===== -->
<div id="tooltip">
  <div class="tt-label"></div>
  <div class="tt-type"></div>
  <div class="tt-file"></div>
  <div class="tt-desc"></div>
  <div class="tt-exports"></div>
  <div class="tt-children-hint"></div>
</div>

<!-- ===== CONTEXT PANEL ===== -->
<div id="context-panel">
  <button id="context-close" aria-label="Close panel">&times;</button>
  <div id="context-inner">
    <div id="ctx-header">
      <span id="ctx-name"></span>
      <span id="ctx-type-badge"></span>
    </div>
    <a id="ctx-file" href="#" target="_blank" rel="noopener"></a>
    <p id="ctx-desc"></p>
    <div id="ctx-exports"></div>
  </div>
</div>

<!-- ===== TAB 1: STRUCTURE ===== -->
<div class="tab-panel active" id="structure-panel">
  <div id="cy-structure"></div>

  <div id="breadcrumb-bar">
    <div id="breadcrumb"></div>
  </div>

  <button id="controls-toggle" title="Controls">&#9881;</button>
  <div id="controls-panel" class="controls-hidden">
    <div class="controls-section">
      <div class="controls-label">View</div>
      <button class="btn" id="btn-expand-all">Expand All</button>
      <button class="btn" id="btn-collapse-all">Collapse All</button>
      <button class="btn" id="btn-fit">Fit View</button>
      <button class="btn" id="btn-reset">Reset</button>
    </div>
  </div>

  <div id="flow-legend">
    <h3>Flows</h3>
    <div id="flow-filters"></div>
  </div>

  <div id="info-badge"><span id="node-counter">Showing <strong>3</strong> of <strong>35</strong> nodes</span></div>
  <button id="help-toggle" title="Help">?</button>
  <div id="help-panel" class="help-hidden">
    <div class="help-section">
      <div class="help-label">Interactions</div>
      <div class="help-tip">
        Click to expand &middot; Right-click to collapse<br>
        Scroll to zoom &middot; Drag to pan
      </div>
    </div>
    <div class="help-section">
      <div class="help-label">Node Types</div>
      <div class="legend-compact">
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="none" stroke="rgba(255,255,255,0.3)" stroke-dasharray="2 1"/></svg> Group</span>
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="#4a90d9"/></svg> Component</span>
        <span class="lc-item"><svg width="10" height="10"><polygon points="5,0 10,5 5,10 0,5" fill="#e67e22"/></svg> External</span>
        <span class="lc-item"><svg width="10" height="10"><polygon points="2,0 8,0 10,3 10,7 8,10 2,10 0,7 0,3" fill="#1abc9c"/></svg> Route</span>
        <span class="lc-item"><svg width="10" height="10"><rect width="10" height="8" y="1" rx="2" fill="#9b59b6"/></svg> Library</span>
        <span class="lc-item"><svg width="10" height="10"><circle cx="5" cy="5" r="4" fill="#e74c3c"/></svg> Config</span>
      </div>
    </div>
  </div>
</div>

<!-- ===== TAB 2: FLOWS ===== -->
<div class="tab-panel" id="flows-panel">
  <div class="flows-container" id="flows-container"></div>
</div>

<!-- ===== TAB 3: DATA ===== -->
<div class="tab-panel" id="data-panel">
  <div id="cy-data"></div>
  <div class="graph-legend" id="data-legend" style="display:none;">
    <h3>State Model</h3>
    <div class="legend-item">
      <div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="2" width="14" height="12" rx="3" fill="#e67e22"/></svg></div>
      Source of Truth
    </div>
    <div class="legend-item">
      <div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="2" width="14" height="12" rx="3" fill="#3498db"/></svg></div>
      Cache
    </div>
    <div class="legend-item">
      <div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="2" fill="#4a90d9"/></svg></div>
      Component (reader)
    </div>
    <div class="legend-item">
      <div class="legend-shape"><svg viewBox="0 0 16 16"><rect x="1" y="3" width="14" height="10" rx="2" fill="#9b59b6"/></svg></div>
      Store (writer)
    </div>
    <div class="legend-item" style="margin-top: 8px; padding-top: 8px; border-top: 1px solid rgba(255,255,255,0.06);">
      <div class="legend-shape" style="opacity: 0.6;"><svg viewBox="0 0 16 16"><line x1="2" y1="8" x2="14" y2="8" stroke="#2ecc71" stroke-width="2"/></svg></div>
      <span style="color: #888;">Reads/writes state</span>
    </div>
  </div>
</div>

<!-- ===== TAB 4: RESILIENCE ===== -->
<div class="tab-panel" id="failure-panel">
  <div class="resilience-container" id="resilience-container"></div>
</div>

<script is:inline>
(function() {
  'use strict';

  // ==========================================================================
  // ARCHITECTURE DATA (loaded from embedded JSON element)
  // ==========================================================================
  var dataEl = document.getElementById('arch-data');
  var RAW = JSON.parse(dataEl.textContent);
  var REPO_URL = JSON.parse(document.getElementById('repo-url').textContent);

  // ==========================================================================
  // DATA FLOWS (for Flows tab -- mermaid sequence diagrams)
  // ==========================================================================
  var DATA_FLOWS = [
    {
      id: 'ssr-prefetch-flow',
      name: 'SSR Prefetch & Hydration',
      number: 1,
      description: 'Server-side rendering flow: root-layout.loader and home.loader prefetch data with TanStack Query, dehydrate it, and pass to the client via HydrationBoundary for zero-waterfall rendering.',
      path: ['root-layout', 'home-route', 'products-route', 'categories-query', 'api-client', 'dummyjson-api'],
      mermaid: [
        'sequenceDiagram',
        '    autonumber',
        '    participant B as Browser',
        '    participant SSR as SSR Server',
        '    participant RL as Root Layout Loader',
        '    participant HL as Home Loader',
        '    participant TQ as TanStack Query',
        '    participant API as DummyJSON API',
        '',
        '    B->>SSR: GET / (initial page load)',
        '    SSR->>RL: Execute root-layout loader',
        '    RL->>TQ: prefetchQuery(categoriesQueryOptions)',
        '    TQ->>API: GET /products/categories',
        '    API-->>TQ: Category[]',
        '    RL->>SSR: Return dehydrated QueryClient',
        '    SSR->>HL: Execute home loader',
        '    HL->>TQ: prefetchInfiniteQuery(categorySectionsOptions)',
        '    TQ->>API: GET /products/category/:slug (x4)',
        '    API-->>TQ: Products for first 4 categories',
        '    HL->>SSR: Return dehydrated state + title',
        '    SSR->>B: HTML with embedded dehydrated state',
        '    Note over B: HydrationBoundary rehydrates<br/>QueryClient on mount — no refetch needed'
      ].join('\n')
    },
    {
      id: 'infinite-scroll-flow',
      name: 'Infinite Scroll (Home)',
      number: 2,
      description: 'Home page loads categories in pages of 4. IntersectionObserver on a sentinel element triggers fetchNextPage when the user scrolls near the bottom. Each page fetches 4 products per category with an 800ms artificial delay.',
      path: ['home-route', 'home-infinite-query', 'api-client', 'dummyjson-products-by-category'],
      mermaid: [
        'sequenceDiagram',
        '    autonumber',
        '    participant S as Shopper',
        '    participant HR as Home Route',
        '    participant IO as IntersectionObserver',
        '    participant IQ as categorySectionsInfiniteQuery',
        '    participant API as DummyJSON API',
        '',
        '    Note over HR: Page 0 already loaded via SSR',
        '    S->>HR: Scrolls down',
        '    HR->>IO: Sentinel enters viewport',
        '    IO->>IQ: fetchNextPage()',
        '    IQ->>API: GET /products/category/:slug (next 4 categories)',
        '    Note over IQ: 800ms artificial delay per category',
        '    API-->>IQ: Products for categories 5-8',
        '    IQ-->>HR: New CategorySection data available',
        '    HR->>S: Renders new CategorySections with ProductCards',
        '    Note over IO: Repeats until all categories loaded<br/>(hasNextPage becomes false)'
      ].join('\n')
    },
    {
      id: 'load-more-flow',
      name: 'Load More (Products)',
      number: 3,
      description: 'Products page uses offset-based pagination via productsInfiniteQuery. User clicks "Load more" button, fetchNextPage fires, appends next 8 products. Button hides when skip + products.length >= total.',
      path: ['products-route', 'products-infinite-query', 'api-client', 'dummyjson-products'],
      mermaid: [
        'sequenceDiagram',
        '    autonumber',
        '    participant S as Shopper',
        '    participant PR as Products Route',
        '    participant IQ as productsInfiniteQuery',
        '    participant API as DummyJSON API',
        '',
        '    Note over PR: First page (8 products) loaded via SSR',
        '    S->>PR: Clicks "Load more" button',
        '    PR->>IQ: fetchNextPage()',
        '    IQ->>API: GET /products?limit=8&skip=8&select=...',
        '    Note over IQ: Or GET /products/category/:slug<br/>with same pagination params',
        '    API-->>IQ: Next 8 products + total count',
        '    IQ-->>PR: Appended page data',
        '    PR->>S: Renders new ProductCards in grid',
        '    Note over PR: Button hidden when<br/>skip + products.length >= total'
      ].join('\n')
    },
    {
      id: 'cart-flow',
      name: 'Cart Add-to-Checkout',
      number: 4,
      description: 'ProductCard.onAddToCart -> useCartStore.addItem -> toast.success. Cart drawer reads useCartStore for items/total. Checkout button navigates to /checkout. clientLoader guards empty cart. clientAction simulates processing, clears cart, sets successfulOrder, redirects to /success.',
      path: ['product-card', 'cart-store', 'cart-drawer', 'checkout-route', 'success-route'],
      mermaid: [
        'sequenceDiagram',
        '    autonumber',
        '    participant S as Shopper',
        '    participant PC as ProductCard',
        '    participant CS as Cart Store (Zustand)',
        '    participant CD as Cart Drawer',
        '    participant CK as Checkout Page',
        '    participant SP as Success Page',
        '',
        '    S->>PC: Clicks "Add to cart"',
        '    PC->>CS: useCartStore.addItem(product)',
        '    CS-->>CD: State updates (items, total)',
        '    Note over CS: Persisted to localStorage',
        '    PC->>S: toast.success("Product added to cart")',
        '    S->>CD: Opens cart drawer',
        '    CD->>S: Shows items, total, Checkout link',
        '    S->>CK: Navigates to /checkout',
        '    CK->>CS: clientLoader guards empty cart',
        '    S->>CK: Fills shipping + payment forms',
        '    S->>CK: Submits order',
        '    CK->>CS: clientAction: clear cart, set successfulOrder',
        '    CK->>SP: Redirect to /success',
        '    SP->>S: Confetti + confirmation message'
      ].join('\n')
    },
    {
      id: 'theme-flow',
      name: 'Theme Toggle',
      number: 5,
      description: 'ThemeToggle calls useThemeStore.setTheme which toggles dark/light class on document.documentElement. On app mount, root.tsx reads store state and applies initial class. Sonner Toaster reads theme for toast styling.',
      path: ['theme-toggle', 'theme-store', 'root-module', 'ui-sonner'],
      mermaid: [
        'sequenceDiagram',
        '    autonumber',
        '    participant S as Shopper',
        '    participant TT as ThemeToggle',
        '    participant TS as Theme Store (Zustand)',
        '    participant DOM as document.documentElement',
        '    participant RM as Root Module',
        '    participant T as Toaster (Sonner)',
        '',
        '    S->>TT: Clicks theme toggle button',
        '    TT->>TS: useThemeStore.setTheme(dark/light)',
        '    TS->>DOM: Toggle .dark class on <html>',
        '    Note over TS: Persisted to localStorage<br/>as "theme-storage"',
        '    TS-->>TT: Re-render with Sun/Moon icon',
        '    TS-->>T: Theme value updates toast styling',
        '    Note over RM: On app mount, reads store state<br/>and applies initial theme class'
      ].join('\n')
    }
  ];

  // ==========================================================================
  // STATE STORES (from architecture.json state field)
  // ==========================================================================
  var STATE_DATA = {
    stores: (RAW.state || []).map(function(s) {
      return {
        id: s.id,
        name: s.name || s.technology || s.id,
        purpose: s.purpose || 'unknown',
        description: s.description || '',
        scope: s.persistence || '',
        readers: [],
        writers: [s.component].filter(Boolean)
      };
    })
  };

  // ==========================================================================
  // FAILURE MODES (from architecture.json failure_modes field)
  // ==========================================================================
  var FAILURE_MODES = (RAW.failure_modes || []).map(function(f) {
    return {
      id: f.id,
      name: f.trigger,
      trigger: f.trigger,
      cascade: (f.cascade || []),
      impact: f.impact || '',
      detection: f.detection || [],
      recovery: f.recovery || [],
      severity: f.severity || 'medium'
    };
  });
  // Legacy block removed — FAILURE_MODES now reads from architecture.json above
  var _LEGACY_REMOVED = [
    {
      id: '_removed',
      name: '_removed',
      trigger: '_removed',
      cascade: [
        { component: 'api-client', effect: 'ky requests fail or hang (no timeout configured)' },
        { component: 'categories-query', effect: 'Category prefetch fails' },
        { component: 'home-infinite-query', effect: 'Product sections fail to load' },
        { component: 'products-infinite-query', effect: 'Product list fails to load' },
        { component: 'root-layout', effect: 'SSR loader blocks indefinitely waiting for categories' },
        { component: 'home-route', effect: 'SSR loader blocks, returns error' },
        { component: 'products-route', effect: 'SSR loader blocks, returns error' }
      ],
      impact: 'Product pages show infinite loading spinners or root ErrorBoundary. Cart and checkout continue working from local state.',
      detection: [
        'Root ErrorBoundary renders error (dev mode shows stack trace)',
        'TanStack Query retries 3x with exponential backoff',
        'No server-side logging \u2014 failures are silent on the server',
        'No health check endpoint to probe'
      ],
      recovery: [
        'TanStack Query retries 3x automatically',
        'After retry exhaustion, query enters error state',
        'Root ErrorBoundary catches and renders generic error',
        'Cart/checkout/theme continue from localStorage (unaffected)',
        'Manual: restart SSR server if loaders are stuck'
      ],
      severity: 'critical'
    },
    {
      id: 'localstorage-unavailable',
      name: 'localStorage Unavailable',
      trigger: 'Browser localStorage is full, disabled, or blocked by policy',
      cascade: [
        { component: 'cart-store', effect: 'Zustand persist middleware fails to read/write' },
        { component: 'theme-store', effect: 'Theme preference not persisted' }
      ],
      impact: 'Cart and theme work within session but lose state on page refresh. No error shown to user.',
      detection: [
        'none \u2014 Zustand persist silently falls back to in-memory'
      ],
      recovery: [
        'Zustand stores continue in-memory automatically',
        'State is lost on refresh \u2014 no recovery for lost data'
      ],
      severity: 'medium'
    },
    {
      id: 'empty-cart-checkout',
      name: 'Empty Cart Checkout',
      trigger: 'User navigates directly to /checkout with empty cart',
      cascade: [
        { component: 'checkout-route', effect: 'clientLoader reads cart state, finds 0 items' }
      ],
      impact: 'User never sees empty checkout page.',
      detection: [
        'clientLoader guard check: items.length === 0'
      ],
      recovery: [
        'Automatic redirect to /products'
      ],
      severity: 'low'
    },
    {
      id: 'direct-success-access',
      name: 'Direct Success Access',
      trigger: 'User navigates directly to /success without completing checkout',
      cascade: [
        { component: 'success-route', effect: 'clientLoader reads successfulOrder flag, finds false' }
      ],
      impact: 'User never sees success page without placing order.',
      detection: [
        'clientLoader guard check: successfulOrder === false'
      ],
      recovery: [
        'Automatic redirect to /products',
        'successfulOrder flag cleared after read to prevent stale state'
      ],
      severity: 'low'
    },
    {
      id: 'ssr-hydration-mismatch',
      name: 'SSR Hydration Mismatch',
      trigger: 'Server renders without dark class, client applies it in useEffect',
      cascade: [
        { component: 'root-module', effect: 'SSR HTML has light theme, client applies dark class post-hydration' },
        { component: 'ui-sonner', effect: 'Toaster theme prop may mismatch briefly' }
      ],
      impact: 'Brief flash of light theme on page load if user has dark mode. React logs console warnings.',
      detection: [
        'React hydration mismatch warning in browser console',
        'Visual flash visible to user'
      ],
      recovery: [
        'useEffect applies correct theme class within milliseconds',
        'Subsequent renders are correct'
      ],
      severity: 'low'
    }
  ];

  // ==========================================================================
  // SHARED: DATA INDEX
  // ==========================================================================
  var nodeMap = {};
  var childrenOf = {};
  var rootIds = [];
  var totalNodes = RAW.nodes.length;

  RAW.nodes.forEach(function(n) {
    nodeMap[n.id] = n;
    if (n.parent) {
      if (!childrenOf[n.parent]) childrenOf[n.parent] = [];
      childrenOf[n.parent].push(n.id);
    } else {
      rootIds.push(n.id);
    }
  });

  function countDescendants(id) {
    var kids = childrenOf[id] || [];
    var count = kids.length;
    kids.forEach(function(kid) { count += countDescendants(kid); });
    return count;
  }

  function getAncestors(id) {
    var path = [];
    var current = id;
    while (current) {
      path.unshift(current);
      current = nodeMap[current] ? nodeMap[current].parent : null;
    }
    return path;
  }

  // ==========================================================================
  // SHARED: TYPE CONFIG
  // ==========================================================================
  var typeConfig = {
    'group':            { bg: '#2a2a4e', border: '#4a4a6e', text: '#aaa', shape: 'roundrectangle' },
    'component':        { bg: '#4a90d9', border: '#3a78c0', text: '#fff', shape: 'roundrectangle' },
    'frontend':         { bg: '#4a90d9', border: '#3a78c0', text: '#fff', shape: 'roundrectangle' },
    'service':          { bg: '#3498db', border: '#2980b9', text: '#fff', shape: 'roundrectangle' },
    'external-service': { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'diamond' },
    'endpoint':         { bg: '#d4740e', border: '#b8640c', text: '#fff', shape: 'diamond' },
    'route':            { bg: '#1abc9c', border: '#14a085', text: '#fff', shape: 'hexagon' },
    'library':          { bg: '#9b59b6', border: '#8244a0', text: '#fff', shape: 'roundrectangle' },
    'config':           { bg: '#c0392b', border: '#a93226', text: '#fff', shape: 'ellipse' },
    'stylesheet':       { bg: '#e74c3c', border: '#c0392b', text: '#fff', shape: 'ellipse' },
    'test-suite':       { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'roundrectangle' },
    'test':             { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'ellipse' },
    'gateway':          { bg: '#e67e22', border: '#cf6d14', text: '#fff', shape: 'diamond' },
    'store':            { bg: '#1abc9c', border: '#14a085', text: '#fff', shape: 'barrel' },
    'worker':           { bg: '#2ecc71', border: '#27ae60', text: '#fff', shape: 'roundrectangle' },
    'api':              { bg: '#3498db', border: '#2980b9', text: '#fff', shape: 'roundrectangle' }
  };

  function getTypeConfig(type) {
    return typeConfig[type] || typeConfig.component;
  }

  function escapeHtml(str) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }

  // ==========================================================================
  // SHARED: TOOLTIP
  // ==========================================================================
  var tooltip = document.getElementById('tooltip');
  var ttLabel = tooltip.querySelector('.tt-label');
  var ttType = tooltip.querySelector('.tt-type');
  var ttFile = tooltip.querySelector('.tt-file');
  var ttDesc = tooltip.querySelector('.tt-desc');
  var ttExports = tooltip.querySelector('.tt-exports');
  var ttChildrenHint = tooltip.querySelector('.tt-children-hint');

  function showTooltip(data, cfg) {
    ttLabel.textContent = data.name || data.label || '';
    ttType.textContent = (data.type || data.nodeType || '').replace(/-/g, ' ');
    ttType.style.color = cfg ? (cfg.bg === '#2a2a4e' ? '#7b68ee' : cfg.bg) : '#7b68ee';
    ttFile.textContent = data.file || '';
    ttFile.style.display = data.file ? 'block' : 'none';
    ttDesc.textContent = data.description || '';

    if (data.exports && data.exports.length > 0) {
      var html = '<div class="tt-exports-title">Exports (' + data.exports.length + ')</div>';
      data.exports.forEach(function(exp) {
        var expName = typeof exp === 'string' ? exp : exp.name;
        var expKind = typeof exp === 'string' ? '' : (exp.kind || '');
        html += '<div class="tt-export-item">';
        html += '<span class="export-name">' + escapeHtml(expName) + '</span>';
        if (expKind) html += '<span class="export-kind"> (' + expKind + ')</span>';
        html += '</div>';
      });
      ttExports.innerHTML = html;
      ttExports.style.display = 'block';
    } else {
      ttExports.style.display = 'none';
    }

    ttChildrenHint.style.display = 'none';
    tooltip.classList.add('visible');
