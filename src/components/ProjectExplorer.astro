  /* ========= RESILIENCE TAB ========= */
  #failure-panel {
    overflow-y: auto;
    overflow-x: hidden;
  }

  .resilience-container {
    padding: 20px 32px 60px;
    padding-top: 20px;
    max-width: 900px;
