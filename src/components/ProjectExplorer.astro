  .resilience-severity.critical { background: rgba(231,76,60,0.2); color: #ff6b6b; border: 1px solid rgba(231,76,60,0.4); }
  .resilience-severity.high { background: rgba(230,126,34,0.2); color: #f0a050; border: 1px solid rgba(230,126,34,0.4); }
  .resilience-severity.medium { background: rgba(241,196,15,0.2); color: #f1c40f; border: 1px solid rgba(241,196,15,0.4); }
  .resilience-severity.low { background: rgba(46,204,113,0.2); color: #6dffab; border: 1px solid rgba(46,204,113,0.4); }

  /* Timeline */
  .resilience-timeline {
    position: relative;
    padding-left: 32px;
  }

  .resilience-timeline::before {
    content: '';
    position: absolute;
    left: 15px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: rgba(255,255,255,0.06);
  }

  .timeline-section {
    position: relative;
    margin-bottom: 24px;
  }

  .timeline-section:last-child {
    margin-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -24px;
    top: 14px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid;
    z-index: 1;
  }

  .timeline-section.trigger .timeline-dot { background: #e74c3c; border-color: #e74c3c; }
  .timeline-section.cascade .timeline-dot { background: #e67e22; border-color: #e67e22; }
  .timeline-section.impact .timeline-dot { background: #f39c12; border-color: #f39c12; }
  .timeline-section.detection .timeline-dot { background: #3498db; border-color: #3498db; }
  .timeline-section.recovery .timeline-dot { background: #2ecc71; border-color: #2ecc71; }

  .timeline-header {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .timeline-section.trigger .timeline-header { color: #e74c3c; }
  .timeline-section.cascade .timeline-header { color: #e67e22; }
  .timeline-section.impact .timeline-header { color: #f39c12; }
  .timeline-section.detection .timeline-header { color: #3498db; }
  .timeline-section.recovery .timeline-header { color: #2ecc71; }

  .timeline-content {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
    padding: 14px 18px;
  }

  .timeline-section.trigger .timeline-content { border-left: 3px solid #e74c3c; }
  .timeline-section.cascade .timeline-content { border-left: 3px solid #e67e22; }
  .timeline-section.impact .timeline-content { border-left: 3px solid #f39c12; }
  .timeline-section.detection .timeline-content { border-left: 3px solid #3498db; }
  .timeline-section.recovery .timeline-content { border-left: 3px solid #2ecc71; }

  .timeline-text {
    font-size: 13px;
    color: #ccc;
    line-height: 1.6;
  }

  .cascade-step {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin-bottom: 8px;
    font-size: 13px;
  }

  .cascade-step:last-child { margin-bottom: 0; }

  .cascade-step .step-number {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 700;
    margin-top: 1px;
  }

  .timeline-section.cascade .step-number { background: rgba(230,126,34,0.2); color: #e67e22; border: 1px solid rgba(230,126,34,0.3); }
  .timeline-section.detection .step-number { background: rgba(52,152,219,0.2); color: #3498db; border: 1px solid rgba(52,152,219,0.3); }
  .timeline-section.recovery .step-number { background: rgba(46,204,113,0.2); color: #2ecc71; border: 1px solid rgba(46,204,113,0.3); }

