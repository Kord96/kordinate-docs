---
/**
 * Shared floating-nav theme tokens for atlas and journey navigators.
 */
---

<style is:global>
  :root {
    --floating-nav-bg: rgba(9, 9, 11, 0.92);
    --floating-nav-border: var(--border-hover);
    --floating-nav-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
    --floating-nav-pill-color: var(--text-4);
    --floating-nav-pill-hover-color: var(--text-2);
    --floating-nav-pill-hover-bg: rgba(255, 255, 255, 0.08);
    --floating-nav-pill-active-color: var(--text);
    --floating-nav-pill-active-bg: rgba(255, 255, 255, 0.14);
    --floating-nav-page-bg: var(--accent-dim);
    --floating-nav-page-border: var(--accent-border);
    --floating-nav-page-color: var(--accent);
    --floating-nav-page-hover-bg: rgba(129, 140, 248, 0.14);
    --floating-nav-menu-bg: rgba(9, 9, 11, 0.96);
    --floating-nav-menu-border: var(--border-hover);
    --floating-nav-menu-shadow: 0 12px 28px rgba(0, 0, 0, 0.28);
    --floating-nav-menu-option-color: var(--accent);
    --floating-nav-menu-option-hover-bg: rgba(129, 140, 248, 0.12);
    --floating-nav-menu-option-hover-color: var(--text);
    --floating-nav-menu-option-active-bg: rgba(129, 140, 248, 0.14);
    --floating-nav-menu-option-active-color: var(--text);
  }

  [data-theme='light'] {
    --floating-nav-bg: rgba(255, 255, 255, 0.96);
    --floating-nav-border: #cbd5e1;
    --floating-nav-shadow: 0 8px 28px rgba(24, 24, 27, 0.08);
    --floating-nav-pill-color: #71717a;
    --floating-nav-pill-hover-color: #18181b;
    --floating-nav-pill-hover-bg: rgba(24, 24, 27, 0.05);
    --floating-nav-pill-active-color: #18181b;
    --floating-nav-pill-active-bg: rgba(24, 24, 27, 0.1);
    --floating-nav-page-bg: rgba(79, 70, 229, 0.08);
    --floating-nav-page-border: rgba(79, 70, 229, 0.18);
    --floating-nav-page-color: #3730a3;
    --floating-nav-page-hover-bg: rgba(79, 70, 229, 0.14);
    --floating-nav-menu-bg: rgba(255, 255, 255, 0.98);
    --floating-nav-menu-border: #d4d4d8;
    --floating-nav-menu-shadow: 0 12px 32px rgba(24, 24, 27, 0.12);
    --floating-nav-menu-option-color: #3730a3;
    --floating-nav-menu-option-hover-bg: rgba(79, 70, 229, 0.1);
    --floating-nav-menu-option-hover-color: #18181b;
    --floating-nav-menu-option-active-bg: rgba(79, 70, 229, 0.1);
    --floating-nav-menu-option-active-color: #18181b;
  }
</style>
