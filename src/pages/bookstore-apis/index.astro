---
import ArchExplorer from '../../components/ArchExplorer.astro';
import data from '../../content/docs/bookstore-apis/architecture.json';
import { readFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';

const __dirname = dirname(fileURLToPath(import.meta.url));
const narrativeDir = join(__dirname, '../../data/narratives/bookstore-apis');

function mdToHtml(filename: string): string {
  try {
    const md = readFileSync(join(narrativeDir, filename), 'utf-8');
    // Strip {#id} anchors and convert to simple HTML
    return md
      .replace(/^### (.*?)\s*\{#([^}]+)\}/gm, '<h3 id="$2">$1</h3>')
      .replace(/^## (.*?)\s*\{#([^}]+)\}/gm, '<h2 id="$2">$1</h2>')
      .replace(/^# (.*?)\s*\{#([^}]+)\}/gm, '<h1 id="$2">$1</h1>')
      .replace(/^### (.*)/gm, '<h3>$1</h3>')
      .replace(/^## (.*)/gm, '<h2>$1</h2>')
      .replace(/^# (.*)/gm, '<h1>$1</h1>')
      .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
      .replace(/\*([^*]+)\*/g, '<em>$1</em>')
      .replace(/\n\n/g, '</p><p>')
      .replace(/^/, '<p>')
      .replace(/$/, '</p>');
  } catch {
    return '';
  }
}

const narratives = {
  structure: mdToHtml('structure.md'),
  flows: mdToHtml('flows.md'),
  data: mdToHtml('data.md'),
  resilience: mdToHtml('resilience.md'),
};
---
<ArchExplorer
  title="bookstore-apis"
  subtitle={`${data.nodes.length} nodes · ${data.edges.length} edges · ${(data as any).data_flows?.length || 0} flows`}
  data={data}
  repoUrl="https://github.com/n0krashy/Bookstore-APIs"
  narratives={narratives}
/>
