---
import Base from '../../../../layouts/Base.astro';
import Header from '../../../../components/Header.astro';
import { getProjectAnalyses, getProjectAtlas, getProjectIndex, projectAnalysesRoutePath, projectAnalysisAtlasRoutePath, projectAnalysisRoutePath, projectAtlasRoutePath, projectRoutePath, slugFromRouteParts } from '../../../../lib/docs-data';

export async function getStaticPaths() {
  const projects = await getProjectIndex();
  return projects.map(({ slug }) => {
    const [owner, repo] = slug.split('--');
    return { params: { owner, repo } };
  });
}

const { owner, repo } = Astro.params;
const project = slugFromRouteParts(owner, repo);
const [atlas, analyses] = await Promise.all([
  getProjectAtlas(project),
  getProjectAnalyses(project),
]);

function formatNumber(value?: number | null, digits = 0) {
  if (typeof value !== 'number' || Number.isNaN(value)) return '';
  return value.toLocaleString(undefined, {
    minimumFractionDigits: digits,
    maximumFractionDigits: digits,
  });
}

function formatSeconds(value?: number | null) {
  if (typeof value !== 'number' || Number.isNaN(value)) return '';
  if (value < 1) return `${formatNumber(value, 2)}s`;
  if (value < 60) return `${formatNumber(value, 1)}s`;
  return `${formatNumber(value / 60, 1)}m`;
}

function formatUsd(value?: number | null) {
  if (typeof value !== 'number' || Number.isNaN(value)) return '';
  return `$${value.toFixed(4)}`;
}
---

<Base title={`${atlas.project || project} — Analyses`}>
  <Header
    project={project}
    currentProject={project}
    position="sticky"
    links={[
      { label: 'Narrative', href: projectRoutePath(project) },
      { label: 'Atlas', href: projectAtlasRoutePath(project) },
      { label: 'History', href: projectAnalysesRoutePath(project) },
    ]}
    active="history"
  />

  <main class="history">
    <section class="history-hero">
      <h1>Analysis History</h1>
      <p>{atlas.purpose || 'Browse immutable Augur snapshots for this project.'}</p>
    </section>

    <section class="history-list">
      {analyses.map((analysis) => (
        <article class="analysis-card">
          <div class="analysis-meta">
            <div class="analysis-id">{analysis.analysisId}</div>
            {analysis.commitSha && <div class="analysis-sha">{analysis.commitSha}</div>}
          </div>
          <div class="analysis-times">
            {analysis.commitTime && <span>Commit: {analysis.commitTime}</span>}
            {analysis.analyzedAt && <span>Analyzed: {analysis.analyzedAt}</span>}
            {analysis.status && <span>Status: {analysis.status}</span>}
            {typeof analysis.validation?.attempts === 'number' && analysis.validation.attempts > 0 && <span>Validation attempts: {analysis.validation.attempts}</span>}
          </div>
          <div class="analysis-runtime">
            {analysis.agent?.name && <span>Agent: {analysis.agent.name}</span>}
            {analysis.agent?.specialization && <span>Specialization: {analysis.agent.specialization}</span>}
            {analysis.agent?.bundleMode && <span>Bundle: {analysis.agent.bundleMode}</span>}
          </div>
          <div class="analysis-telemetry">
            {analysis.requestId && <span>Request: {analysis.requestId}</span>}
            {analysis.repository?.fileCount != null && <span>Files: {formatNumber(analysis.repository.fileCount, 0)}</span>}
            {analysis.repository?.filesReadCount != null && <span>Read: {formatNumber(analysis.repository.filesReadCount, 0)}</span>}
            {analysis.repository?.repoTokensEst != null && <span>Repo est: {formatNumber(analysis.repository.repoTokensEst, 0)} tok</span>}
          </div>
          <div class="analysis-links">
            <a href={projectAnalysisRoutePath(project, analysis.analysisId)}>Narrative Snapshot</a>
            <a href={projectAnalysisAtlasRoutePath(project, analysis.analysisId)}>Atlas Snapshot</a>
          </div>
        </article>
      ))}
    </section>
  </main>
</Base>

<style>
  .history {
    padding-top: 40px;
    min-height: 100vh;
    background: var(--bg);
  }
  .history-hero {
    max-width: 60rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 1.5rem;
  }
  .history-hero h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
    letter-spacing: -0.03em;
  }
  .history-hero p {
    color: var(--text-2);
    max-width: 42rem;
  }
  .history-list {
    max-width: 60rem;
    margin: 0 auto;
    padding: 0 1.5rem 4rem;
    display: grid;
    gap: 1rem;
  }
  .analysis-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    padding: 1.15rem 1.2rem;
    display: grid;
    gap: 0.75rem;
  }
  .analysis-meta {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .analysis-id {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .analysis-sha {
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-3);
  }
  .analysis-times {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    color: var(--text-2);
    font-size: 0.82rem;
  }
  .analysis-runtime,
  .analysis-telemetry {
    display: flex;
    gap: .85rem;
    flex-wrap: wrap;
    color: var(--text-3);
    font-size: 0.78rem;
  }
  .analysis-links {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .analysis-links a {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.82rem;
  }
</style>
