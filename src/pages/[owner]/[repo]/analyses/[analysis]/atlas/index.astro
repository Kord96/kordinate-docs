---
import Base from '../../../../../../layouts/Base.astro';
import Header from '../../../../../../components/Header.astro';
import PillNav from '../../../../../../components/PillNav.astro';
import AtlasStyles from '../../../../../../components/atlas/AtlasStyles.astro';
import AtlasSubnav from '../../../../../../components/atlas/AtlasSubnav.astro';
import MetadataSection from '../../../../../../components/atlas/MetadataSection.astro';
import ArchGraphSection from '../../../../../../components/atlas/ArchGraphSection.astro';
import PatternsSection from '../../../../../../components/atlas/PatternsSection.astro';
import TensionsSection from '../../../../../../components/atlas/TensionsSection.astro';
import { displayProjectTitle, getProjectAnalyses, getProjectAnalysisBundle, getProjectIndex, projectAnalysesRoutePath, projectAnalysisAtlasRoutePath, projectAnalysisAtlasSubpageRoutePath, projectAnalysisRoutePath, projectApiPath, slugFromRouteParts } from '../../../../../../lib/docs-data';

export async function getStaticPaths() {
  const projects = await getProjectIndex();
  const paths = await Promise.all(projects.map(async ({ slug }) => {
    const analyses = await getProjectAnalyses(slug);
    const [owner, repo] = slug.split('--');
    return analyses.map((analysis) => ({ params: { owner, repo, analysis: analysis.analysisId } }));
  }));
  return paths.flat();
}

const { owner, repo, analysis } = Astro.params;
const project = slugFromRouteParts(owner, repo);
const { atlas, analysisId } = await getProjectAnalysisBundle(project, analysis);

const metadata = atlas.metadata || {};
const components = atlas.components || [];
const flows = atlas.flows || [];
const stateEntries = atlas.state || [];
const extDeps = atlas.external_dependencies || [];
const failureScenarios = atlas.failure_scenarios || [];
const monitoring = atlas.monitoring || [];
const gaps = atlas.gaps || [];
const concepts = atlas.concepts || {};
const tensions = atlas.tensions || [];

const atlasViewLinks = [
  { label: 'Overview', href: projectAnalysisAtlasRoutePath(project, analysis), active: true },
  { label: 'Architecture', href: projectAnalysisAtlasSubpageRoutePath(project, analysis, 'architecture') },
  { label: 'Runtime', href: projectAnalysisAtlasSubpageRoutePath(project, analysis, 'runtime') },
  { label: 'Health', href: projectAnalysisAtlasSubpageRoutePath(project, analysis, 'health') },
];

const atlasSections = [
  { id: 'sec-atlas-overview', label: 'Overview' },
  { id: 'sec-graph', label: 'Map' },
  { id: 'sec-patterns', label: 'Concepts' },
  { id: 'sec-tensions', label: 'Trade-offs' },
];

function severity(s: string) {
  const colors: Record<string, string> = { critical: '#ef4444', high: '#f97316', medium: '#f59e0b', low: '#22c55e' };
  return colors[s] || '#64748b';
}
---

<Base title={`${displayProjectTitle(project, atlas.project)} — Atlas Snapshot`}>
  <AtlasStyles />
  <Header
    project={project}
    currentProject={project}
    position="sticky"
    links={[
      { label: 'Narrative', href: projectAnalysisRoutePath(project, analysis) },
      { label: 'Atlas', href: projectAnalysisAtlasRoutePath(project, analysis) },
      { label: 'History', href: projectAnalysesRoutePath(project) },
    ]}
    active="atlas"
  />

  <AtlasSubnav links={atlasViewLinks} />

  <div class="container">
    <div class="section">
      <h1 class="section-title">{displayProjectTitle(project, atlas.project)}</h1>
      <p class="section-sub">{atlas.purpose}</p>
      <div class="group-kicker">Snapshot · {analysisId}</div>
    </div>
    <MetadataSection
      metadata={metadata}
      components={components}
      flows={flows}
      state={stateEntries}
      extDeps={extDeps}
      failures={failureScenarios}
      monitoring={monitoring}
      gaps={gaps}
      concepts={concepts}
      tensions={tensions}
    />
    <ArchGraphSection components={components} extDeps={extDeps} patterns={atlas.concepts?.detected_patterns || []} projectApiPath={projectApiPath(project)} />
    <PatternsSection concepts={concepts} debt={{}} severity={severity} components={components} flows={flows} />
    <TensionsSection tensions={tensions} components={components} />
  </div>

  <PillNav
    sections={atlasSections}
    pageLinks={[
      { label: 'Narrative', href: projectAnalysisRoutePath(project, analysis) },
      { label: 'Atlas', href: projectAnalysisAtlasRoutePath(project, analysis) },
      { label: 'History', href: projectAnalysesRoutePath(project) },
    ]}
    activePage="atlas"
  />
</Base>
