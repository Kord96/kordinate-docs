---
import Base from '../../../../layouts/Base.astro';
import Header from '../../../../components/Header.astro';
import PillNav from '../../../../components/PillNav.astro';
import AtlasStyles from '../../../../components/atlas/AtlasStyles.astro';
import MetadataSection from '../../../../components/atlas/MetadataSection.astro';
import ContextSection from '../../../../components/atlas/ContextSection.astro';
import ArchGraphSection from '../../../../components/atlas/ArchGraphSection.astro';
import ComponentsSection from '../../../../components/atlas/ComponentsSection.astro';
import FlowsSection from '../../../../components/atlas/FlowsSection.astro';
import StateSection from '../../../../components/atlas/StateSection.astro';
import ExternalDepsSection from '../../../../components/atlas/ExternalDepsSection.astro';
import FailuresSection from '../../../../components/atlas/FailuresSection.astro';
import MonitoringSection from '../../../../components/atlas/MonitoringSection.astro';
import GapsSection from '../../../../components/atlas/GapsSection.astro';
import PatternsSection from '../../../../components/atlas/PatternsSection.astro';
import TensionsSection from '../../../../components/atlas/TensionsSection.astro';
import { displayProjectTitle, getProjectAtlas, getProjectIndex, projectAnalysesRoutePath, projectApiPath, projectAtlasRoutePath, projectRoutePath, slugFromRouteParts } from '../../../../lib/docs-data';

export async function getStaticPaths() {
  const projects = await getProjectIndex();
  return projects.map(({ slug }) => {
    const [owner, repo] = slug.split('--');
    return { params: { owner, repo } };
  });
}

const { owner, repo } = Astro.params;
const project = slugFromRouteParts(owner, repo);
const atlas = await getProjectAtlas(project);

const metadata = atlas.metadata || {};
const components = atlas.components || [];
const flows = atlas.flows || [];
const stateEntries = atlas.state || [];
const extDeps = atlas.external_dependencies || [];
const failureScenarios = atlas.failure_scenarios || [];
const monitoring = atlas.monitoring || [];
const gaps = atlas.gaps || [];
const dm = atlas.domain_model || {};
const actors = atlas.actors || [];
const events = atlas.events || [];
const concepts = atlas.concepts || {};
const tensions = atlas.tensions || [];
const atlasSections = [
  { id: 'sec-atlas-overview', label: 'Atlas Overview' },
  { id: 'sec-context', label: 'Domain & Interfaces' },
  { id: 'components-section', label: 'Components' },
  { id: 'sec-flows', label: 'Flows' },
  { id: 'sec-state', label: 'State & Storage' },
  { id: 'sec-external', label: 'External Dependencies' },
  ...(failureScenarios.length > 0 ? [{ id: 'sec-failures', label: 'Failure Scenarios' }] : []),
  ...(monitoring.length > 0 ? [{ id: 'sec-monitoring', label: 'Monitoring' }] : []),
  ...(gaps.length > 0 ? [{ id: 'sec-gaps', label: 'Gaps' }] : []),
  { id: 'sec-patterns', label: 'Concepts' },
  { id: 'sec-tensions', label: 'Architecture Tensions' },
];

function severity(s: string) {
  const colors: Record<string, string> = { critical: '#ef4444', high: '#f97316', medium: '#f59e0b', low: '#22c55e' };
  return colors[s] || '#64748b';
}
---

<Base title={`${displayProjectTitle(project, atlas.project)} — Atlas`}>
  <AtlasStyles />

  <Header
    project={project}
    currentProject={project}
    position="sticky"
    links={[
      {label: "Journey", href: projectRoutePath(project)},
      {label: "Atlas", href: projectAtlasRoutePath(project)},
      {label: "History", href: projectAnalysesRoutePath(project)},
    ]}
    active="atlas"
  />

  <div class="container">
    <MetadataSection metadata={metadata} components={components} flows={flows} state={stateEntries} extDeps={extDeps} />
    <ContextSection domainModel={dm} actors={actors} events={events} components={components} />
    <div class="section" id="components-section">
      <h2 class="section-title">Components</h2>
      <p class="section-sub">{components.length} components arranged by top-level architecture slice, with a dependency view to show runtime relationships.</p>
      <ArchGraphSection components={components} extDeps={extDeps} patterns={atlas.concepts?.detected_patterns || []} embedded={true} projectApiPath={projectApiPath(project)} />
      <ComponentsSection components={components} embedded={true} />
    </div>
    <FlowsSection flows={flows} components={components} />
    <StateSection stateEntries={stateEntries} components={components} />
    <ExternalDepsSection extDeps={extDeps} severity={severity} components={components} />
    {failureScenarios.length > 0 && <FailuresSection failures={failureScenarios} severity={severity} components={components} flows={flows} stateEntries={stateEntries} extDeps={extDeps} />}
    {monitoring.length > 0 && <MonitoringSection monitoring={monitoring} components={components} flows={flows} extDeps={extDeps} failures={failureScenarios} />}
    {gaps.length > 0 && <GapsSection gaps={gaps} components={components} flows={flows} extDeps={extDeps} failures={failureScenarios} />}
    <PatternsSection concepts={concepts} debt={{}} severity={severity} components={components} flows={flows} />
    <TensionsSection tensions={tensions} components={components} />
  </div>

  <PillNav
    sections={atlasSections}
    pageLinks={[
      { label: 'Journey', href: projectRoutePath(project) },
      { label: 'Atlas', href: projectAtlasRoutePath(project) },
      { label: 'History', href: projectAnalysesRoutePath(project) },
    ]}
    activePage="atlas"
  />
  <button class="atlas-focus-btn atlas-focus-global" id="atlas-focus-global" type="button">Focus ⛶</button>

  <div class="atlas-focus-overlay" id="atlas-focus-overlay">
    <div class="atlas-focus-header">
      <div class="atlas-focus-nav">
        <button class="atlas-focus-btn atlas-focus-nav-btn" id="atlas-focus-prev" type="button">← Prev</button>
        <span class="atlas-focus-pos" id="atlas-focus-pos"></span>
        <button class="atlas-focus-btn atlas-focus-nav-btn" id="atlas-focus-next" type="button">Next →</button>
      </div>
      <button class="atlas-focus-btn atlas-focus-close" id="atlas-focus-close" type="button">✕ Close</button>
    </div>
  </div>

  <script is:inline define:vars={{ atlasSections }}>
    (function() {
      const body = document.body;
      const overlay = document.getElementById('atlas-focus-overlay');
      const prevBtn = document.getElementById('atlas-focus-prev');
      const nextBtn = document.getElementById('atlas-focus-next');
      const closeBtn = document.getElementById('atlas-focus-close');
      const pos = document.getElementById('atlas-focus-pos');
      const sectionIds = atlasSections.map((section) => section.id);
      const labelById = Object.fromEntries(atlasSections.map((section) => [section.id, section.label]));
      let focusIndex = -1;

      function currentSection() {
        if (focusIndex < 0) return null;
        return document.getElementById(sectionIds[focusIndex]);
      }

      function refreshFocusedSection() {
        const section = currentSection();
        if (!section) return;
        pos.textContent = `${labelById[section.id]} · ${focusIndex + 1} / ${sectionIds.length}`;
        prevBtn.disabled = focusIndex === 0;
        nextBtn.disabled = focusIndex === sectionIds.length - 1;
        setTimeout(() => {
          window.dispatchEvent(new Event('resize'));
          section.querySelector('#btn-fit')?.click();
        }, 120);
      }

      function findActiveSectionId() {
        const activePill = document.querySelector('#pill-nav .pill-active');
        return activePill?.dataset.section || sectionIds[0];
      }

      function openFocus(sectionId) {
        const section = document.getElementById(sectionId);
        const nextIndex = sectionIds.indexOf(sectionId);
        if (!section || nextIndex < 0) return;
        body.classList.remove('atlas-focus-active');
        document.querySelectorAll('.atlas-focus-target').forEach((node) => node.classList.remove('atlas-focus-target'));
        focusIndex = nextIndex;
        section.classList.add('atlas-focus-target');
        body.classList.add('atlas-focus-active');
        overlay.classList.add('open');
        body.style.overflow = 'hidden';
        refreshFocusedSection();
      }

      function closeFocus() {
        body.classList.remove('atlas-focus-active');
        overlay.classList.remove('open');
        body.style.overflow = '';
        document.querySelectorAll('.atlas-focus-target').forEach((node) => node.classList.remove('atlas-focus-target'));
        focusIndex = -1;
        window.dispatchEvent(new Event('resize'));
      }

      document.getElementById('atlas-focus-global')?.addEventListener('click', () => {
        openFocus(findActiveSectionId());
      });

      prevBtn?.addEventListener('click', () => {
        if (focusIndex <= 0) return;
        openFocus(sectionIds[focusIndex - 1]);
      });
      nextBtn?.addEventListener('click', () => {
        if (focusIndex >= sectionIds.length - 1) return;
        openFocus(sectionIds[focusIndex + 1]);
      });
      closeBtn?.addEventListener('click', closeFocus);

      document.addEventListener('keydown', (event) => {
        if (!overlay.classList.contains('open')) return;
        if (event.key === 'Escape') closeFocus();
        if (event.key === 'ArrowLeft' || event.key === 'h') prevBtn?.click();
        if (event.key === 'ArrowRight' || event.key === 'l') nextBtn?.click();
      });
    })();
  </script>
</Base>
