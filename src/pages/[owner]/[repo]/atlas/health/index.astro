---
import Base from '../../../../../layouts/Base.astro';
import Header from '../../../../../components/Header.astro';
import PillNav from '../../../../../components/PillNav.astro';
import AtlasStyles from '../../../../../components/atlas/AtlasStyles.astro';
import AtlasSubnav from '../../../../../components/atlas/AtlasSubnav.astro';
import FailuresSection from '../../../../../components/atlas/FailuresSection.astro';
import MonitoringSection from '../../../../../components/atlas/MonitoringSection.astro';
import GapsSection from '../../../../../components/atlas/GapsSection.astro';
import { displayProjectTitle, getProjectAtlas, getProjectIndex, projectAnalysesRoutePath, projectAtlasRoutePath, projectAtlasSubpageRoutePath, projectRoutePath, slugFromRouteParts } from '../../../../../lib/docs-data';

export async function getStaticPaths() {
  const projects = await getProjectIndex();
  return projects.map(({ slug }) => {
    const [owner, repo] = slug.split('--');
    return { params: { owner, repo } };
  });
}

const { owner, repo } = Astro.params;
const project = slugFromRouteParts(owner, repo);
const atlas = await getProjectAtlas(project);

const components = atlas.components || [];
const flows = atlas.flows || [];
const stateEntries = atlas.state || [];
const extDeps = atlas.external_dependencies || [];
const failureScenarios = atlas.failure_scenarios || [];
const monitoring = atlas.monitoring || [];
const gaps = atlas.gaps || [];

const atlasViewLinks = [
  { label: 'Overview', href: projectAtlasRoutePath(project) },
  { label: 'Architecture', href: projectAtlasSubpageRoutePath(project, 'architecture') },
  { label: 'Runtime', href: projectAtlasSubpageRoutePath(project, 'runtime') },
  { label: 'Health', href: projectAtlasSubpageRoutePath(project, 'health'), active: true },
];

const atlasSections = [
  ...(failureScenarios.length > 0 ? [{ id: 'sec-failures', label: 'Failures' }] : []),
  ...(monitoring.length > 0 ? [{ id: 'sec-monitoring', label: 'Monitoring' }] : []),
  ...(gaps.length > 0 ? [{ id: 'sec-gaps', label: 'Gaps' }] : []),
];

function severity(s: string) {
  const colors: Record<string, string> = { critical: '#ef4444', high: '#f97316', medium: '#f59e0b', low: '#22c55e' };
  return colors[s] || '#64748b';
}
---

<Base title={`${displayProjectTitle(project, atlas.project)} — Atlas Health`}>
  <AtlasStyles />
  <Header
    project={project}
    currentProject={project}
    position="sticky"
    links={[
      {label: "Narrative", href: projectRoutePath(project)},
      {label: "Atlas", href: projectAtlasRoutePath(project)},
      {label: "History", href: projectAnalysesRoutePath(project)},
    ]}
    active="atlas"
  />

  <AtlasSubnav links={atlasViewLinks} />

  <div class="container">
    {failureScenarios.length > 0 && <FailuresSection failures={failureScenarios} severity={severity} components={components} flows={flows} stateEntries={stateEntries} extDeps={extDeps} />}
    {monitoring.length > 0 && <MonitoringSection monitoring={monitoring} components={components} flows={flows} extDeps={extDeps} failures={failureScenarios} />}
    {gaps.length > 0 && <GapsSection gaps={gaps} components={components} flows={flows} extDeps={extDeps} failures={failureScenarios} />}
  </div>

  {atlasSections.length > 0 && (
    <PillNav
      sections={atlasSections}
      pageLinks={[
        { label: 'Narrative', href: projectRoutePath(project) },
        { label: 'Atlas', href: projectAtlasRoutePath(project) },
        { label: 'History', href: projectAnalysesRoutePath(project) },
      ]}
      activePage="atlas"
    />
  )}
</Base>
