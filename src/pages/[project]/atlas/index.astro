---
import { getProjectIndex, projectAtlasRoutePath } from '../../../lib/docs-data';

export async function getStaticPaths() {
  const projects = await getProjectIndex();
  return projects.map(({ slug }) => ({ params: { project: slug } }));
}

const { project } = Astro.params;
return Astro.redirect(projectAtlasRoutePath(project));
---
