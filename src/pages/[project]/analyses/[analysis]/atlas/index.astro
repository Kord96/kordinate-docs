---
import { getProjectAnalyses, getProjectIndex, projectAnalysisAtlasRoutePath } from '../../../../../lib/docs-data';

export async function getStaticPaths() {
  const projects = await getProjectIndex();
  const paths = await Promise.all(projects.map(async ({ slug }) => {
    const analyses = await getProjectAnalyses(slug);
    return analyses.map((analysis) => ({ params: { project: slug, analysis: analysis.analysisId } }));
  }));
  return paths.flat();
}

const { project, analysis } = Astro.params;
return Astro.redirect(projectAnalysisAtlasRoutePath(project, analysis));
---
