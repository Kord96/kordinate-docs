---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import PillNav from '../../../components/PillNav.astro';
import IssuesStyles from '../../../components/issues/IssuesStyles.astro';
import IssueSection from '../../../components/issues/IssueSection.astro';
import fs from 'node:fs';
import yaml from 'js-yaml';

export async function getStaticPaths() {
  const entries = await import.meta.glob('../../../content/docs/*/atlas.json');
  const projects = Object.keys(entries).map(path => {
    const match = path.match(/\/docs\/([^/]+)\//);
    return match ? { params: { project: match[1] } } : null;
  }).filter(Boolean);
  return projects;
}

const { project } = Astro.params;
const dir = `src/content/docs/${project}`;

let atlas = {};
try {
  atlas = JSON.parse(fs.readFileSync(`${dir}/atlas.json`, 'utf-8'));
} catch (e) {
  console.error(`Failed to load atlas for ${project}:`, e);
}

let storyObs: any[] = [];
try {
  const storyDir = `${dir}/stories`;
  if (fs.existsSync(storyDir)) {
    for (const f of fs.readdirSync(storyDir).filter((s: string) => s.endsWith('.yaml'))) {
      const s = yaml.load(fs.readFileSync(`${storyDir}/${f}`, 'utf-8')) as any;
      for (const obs of (s.observations || [])) {
        if (obs.recommendation && obs.confidence !== 'low') {
          storyObs.push({ ...obs, story: s.id });
        }
      }
    }
  }
} catch (e) {
  console.error(`Failed to load stories for ${project}:`, e);
}

interface Issue { id: string; type: 'bug' | 'enhancement' | 'suggestion'; severity: string; title: string; description: string; category: string; components: string[]; files: string[]; recommendation: string; source: string; }

const issues: Issue[] = [];

for (const v of (atlas.debt?.violations || [])) {
  const sev = (v.severity || '').toUpperCase();
  issues.push({ id: `violation:${v.anti_pattern?.toLowerCase().replace(/\s+/g, '-').substring(0, 40)}`, type: sev === 'CRITICAL' || sev === 'HIGH' ? 'bug' : 'enhancement', severity: v.severity?.toLowerCase() || 'medium', title: v.anti_pattern, description: v.detail, category: v.category || 'General', components: v.components || [], files: v.files || [], recommendation: '', source: 'Debt / Violations' });
}
for (const r of (atlas.debt?.recommendations || [])) {
  const sev = (r.severity || '').toUpperCase();
  issues.push({ id: `rec:${r.title?.toLowerCase().replace(/\s+/g, '-').substring(0, 40)}`, type: sev === 'CRITICAL' || sev === 'HIGH' ? 'bug' : 'enhancement', severity: r.severity?.toLowerCase() || 'medium', title: r.title || 'Recommendation', description: r.description || '', category: r.category || 'General', components: [], files: r.files || [], recommendation: r.description || '', source: 'Debt / Recommendations' });
}
for (const fm of (atlas.failure_modes || [])) {
  const sev = (fm.severity || '').toLowerCase();
  issues.push({ id: `failure:${fm.id}`, type: sev === 'critical' || sev === 'high' ? 'bug' : 'enhancement', severity: sev || 'medium', title: `Failure mode: ${fm.id.replace(/-/g, ' ')}`, description: fm.impact, category: 'Reliability', components: fm.cascade?.map((c: any) => c.component) || [], files: fm.grounded_in || [], recommendation: (fm.recovery || []).join('. '), source: 'Failure Modes' });
}
for (const g of (atlas.concepts?.gaps || [])) {
  const gap = typeof g === 'string' ? { id: g, relevance: '', recommendation: '' } : g;
  issues.push({ id: `gap:${gap.id}`, type: 'suggestion', severity: 'low', title: gap.id.replace(/-/g, ' '), description: gap.relevance || '', category: 'Architecture Gap', components: [], files: [], recommendation: gap.recommendation || '', source: 'Concept Gaps' });
}
for (const obs of storyObs) {
  const tags = obs.tags || [];
  const isCritical = tags.includes('critical') || tags.includes('security');
  issues.push({ id: obs.id, type: isCritical ? 'bug' : 'enhancement', severity: isCritical ? 'high' : 'medium', title: obs.finding?.replace(/\*\*/g, '') || obs.id, description: obs.finding?.replace(/\*\*/g, '') || '', category: tags[0] || 'Observation', components: obs.component ? [obs.component] : [], files: obs.evidence?.file ? [`${obs.evidence.file}:${obs.evidence.lines?.[0] || ''}`] : [], recommendation: obs.recommendation || '', source: `Story: ${obs.story}` });
}

const sevOrder: Record<string, number> = { critical: 0, high: 1, medium: 2, low: 3 };
const typeOrder: Record<string, number> = { bug: 0, enhancement: 1, suggestion: 2 };
issues.sort((a, b) => (typeOrder[a.type] ?? 9) - (typeOrder[b.type] ?? 9) || (sevOrder[a.severity] ?? 9) - (sevOrder[b.severity] ?? 9));

const bugs = issues.filter(i => i.type === 'bug');
const enhancements = issues.filter(i => i.type === 'enhancement');
const suggestions = issues.filter(i => i.type === 'suggestion');

function sevColor(s: string) { return ({ critical: '#ef4444', high: '#f97316', medium: '#f59e0b', low: '#22c55e' } as Record<string, string>)[s] || '#64748b'; }
function typeColor(t: string) { return ({ bug: '#ef4444', enhancement: '#60a5fa', suggestion: '#a78bfa' } as Record<string, string>)[t] || '#64748b'; }
---

<Base title={`${atlas.project} — Issues`}>
  <IssuesStyles />

  <Header project={atlas.project} badge="dev" links={[{ label: 'Journey', href: `/dev/${project}/` }, { label: 'Atlas', href: `/dev/${project}/atlas/` }]} position="sticky" active="issues" />

  <div class="container">
    <h1 class="page-title">Issues</h1>
    <p class="page-sub">Architectural findings from automated analysis — violations, failure modes, gaps, and observations.</p>

    <div class="summary">
      {atlas.debt?.grade && (
        <div class="summary-stat">
          <div class="debt-badge" style={`background: ${sevColor(atlas.debt.grade === 'A' ? 'low' : atlas.debt.grade === 'B' ? 'medium' : 'high')}`}>{atlas.debt.grade}</div>
          <div>
            <div style="font-weight: 600; font-size: .85rem;">Debt Score: {atlas.debt.score}</div>
            <div style="font-size: .65rem; color: var(--text-3);">{atlas.debt.interpretation || ''}</div>
          </div>
        </div>
      )}
      <div class="summary-stat">
        <div class="stat-count" style={`color: ${typeColor('bug')}`}>{bugs.length}</div>
        <div class="stat-label">Bugs</div>
      </div>
      <div class="summary-stat">
        <div class="stat-count" style={`color: ${typeColor('enhancement')}`}>{enhancements.length}</div>
        <div class="stat-label">Enhancements</div>
      </div>
      <div class="summary-stat">
        <div class="stat-count" style={`color: ${typeColor('suggestion')}`}>{suggestions.length}</div>
        <div class="stat-label">Suggestions</div>
      </div>
      <div class="summary-stat">
        <div class="stat-count" style="color: var(--text-3)">{issues.length}</div>
        <div class="stat-label">Total</div>
      </div>
    </div>

    <IssueSection id="sec-bugs" title="Bugs" titleColor={typeColor('bug')} issues={bugs} sevColor={sevColor} />
    <IssueSection id="sec-enhancements" title="Enhancements" titleColor={typeColor('enhancement')} issues={enhancements} sevColor={sevColor} />
    <IssueSection id="sec-suggestions" title="Suggestions" titleColor={typeColor('suggestion')} issues={suggestions} sevColor={sevColor} showSeverity={false} />
  </div>

  <PillNav sections={[
    { id: 'sec-bugs', label: `Bugs (${bugs.length})` },
    { id: 'sec-enhancements', label: `Enhancements (${enhancements.length})` },
    { id: 'sec-suggestions', label: `Suggestions (${suggestions.length})` },
  ]} />
</Base>
