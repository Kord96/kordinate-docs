---
/**
 * Generic Project Journey — Dynamic routing for any project
 * Uses shared journey components from src/components/journey/
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import JourneyStyles from '../../components/journey/JourneyStyles.astro';
import JourneyNav from '../../components/journey/JourneyNav.astro';
import LandingSection from '../../components/journey/LandingSection.astro';
import OverviewSection from '../../components/journey/OverviewSection.astro';
import StorySection from '../../components/journey/StorySection.astro';
import FocusOverlay from '../../components/journey/FocusOverlay.astro';
import Drawer from '../../components/journey/Drawer.astro';
import JourneyData from '../../components/journey/JourneyData.astro';
import JourneyScript from '../../components/journey/JourneyScript.astro';
import fs from 'node:fs';
import yaml from 'js-yaml';

export async function getStaticPaths() {
  const docsDir = 'src/content/docs';
  const entries = await import.meta.glob('../../content/docs/*/atlas.json');
  const projects = Object.keys(entries).map(path => {
    const match = path.match(/\/docs\/([^/]+)\//);
    return match ? { params: { project: match[1] } } : null;
  }).filter(Boolean);
  return projects;
}

const { project } = Astro.params;
const dir = `src/content/docs/${project}`;

let atlas = {};
let manifest = {};
let storyByNode = {};
let journeys = [];
let storyMap: Record<string, any> = {};

try {
  atlas = JSON.parse(fs.readFileSync(`${dir}/atlas.json`, 'utf-8'));
} catch (e) {
  console.error(`Failed to load atlas for ${project}:`, e);
}

try {
  manifest = JSON.parse(fs.readFileSync(`${dir}/manifest.json`, 'utf-8'));
} catch (e) {
  console.error(`Failed to load manifest for ${project}:`, e);
}

try {
  storyByNode = JSON.parse(fs.readFileSync(`${dir}/storyByNode.json`, 'utf-8'));
} catch (e) {
  // storyByNode is optional
}

// Load journeys
try {
  const journeyDir = `${dir}/journeys`;
  if (fs.existsSync(journeyDir)) {
    const journeyFiles = fs.readdirSync(journeyDir).filter((f: string) => f.endsWith('.yaml'));
    journeys = journeyFiles.map((f: string) => yaml.load(fs.readFileSync(`${journeyDir}/${f}`, 'utf-8'))) as any[];
  }
} catch (e) {
  console.error(`Failed to load journeys for ${project}:`, e);
}

const defaultJourney = journeys.find((j: any) => j.id === 'getting-started') || journeys[0] || { id: 'default', title: 'Journey', stories: [] };

// Load all stories into a map
try {
  const storyDir = `${dir}/stories`;
  if (fs.existsSync(storyDir)) {
    for (const f of fs.readdirSync(storyDir).filter((s: string) => s.endsWith('.yaml'))) {
      const s = yaml.load(fs.readFileSync(`${storyDir}/${f}`, 'utf-8')) as any;
      storyMap[s.id] = s;
    }
  }
} catch (e) {
  console.error(`Failed to load stories for ${project}:`, e);
}

// Build stories + bridges per journey
const journeyData: Record<string, { stories: any[]; bridgeMap: Record<string, any>; total: number }> = {};
for (const j of journeys) {
  const jStories = (j.stories || []).map((sid: string) => storyMap[sid]).filter(Boolean);
  const jBridges: Record<string, any> = {};
  for (const b of (j.bridges || [])) {
    if (b && typeof b === 'object') jBridges[b.to] = b;
  }
  journeyData[j.id] = { stories: jStories, bridgeMap: jBridges, total: jStories.length };
}

const stories = journeyData[defaultJourney.id]?.stories || [];
const compMap: Record<string, any> = {};
for (const c of (atlas.components || [])) compMap[c.id] = c;
for (const e of (atlas.external_dependencies || [])) compMap[e.id] = e;

const purpose = atlas.purpose || '';

// Helper: parse bold refs in summary
function parseSummary(text: string): string {
  return text
    .replace(/\*\*([^*]+?)\*\*/gs, (_: string, name: string) =>
      `<span class="ref" data-id="${name.toLowerCase().replace(/\s+/g, '-')}">${name}</span>`)
    .replace(/\n\n/g, '<br><br>')
    .replace(/\n/g, ' ');
}
---

<Base title={defaultJourney.title}>
  <JourneyStyles />

  <Header project={atlas.project || project} badge="dev" links={[{ label: 'Atlas', href: `/dev/${project}/atlas/` }, { label: 'Issues', href: `/dev/${project}/issues/` }]} active="journey" />

  <JourneyNav journeys={journeys} defaultJourney={defaultJourney} stories={stories} />

  <LandingSection
    project={atlas.project || project}
    purpose={purpose}
    journeys={journeys}
    defaultJourney={defaultJourney}
    totalStories={stories.length}
    domainModel={atlas.domain_model}
    componentCount={atlas.components?.length}
    flowCount={atlas.flows?.length}
  />

  <OverviewSection atlas={atlas} journeys={journeys} defaultJourney={defaultJourney} storyByNode={storyByNode} />

  {journeys.map((journey: any) => {
    const jd = journeyData[journey.id];
    const isDefault = journey.id === defaultJourney.id;
    return jd.stories.map((story: any, i: number) => (
      <StorySection
        story={story}
        index={i}
        total={jd.total}
        journeyId={journey.id}
        isDefault={isDefault}
        bridge={jd.bridgeMap[story.id]}
        compMap={compMap}
        storyByNode={storyByNode}
        parseSummary={parseSummary}
      />
    ));
  })}

  <FocusOverlay />
  <JourneyData atlas={atlas} storyByNode={storyByNode} />
  <Drawer project={atlas.project || project} />
  <JourneyScript />
</Base>
