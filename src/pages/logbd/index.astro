---
/**
 * logBD Journey — Guided architecture walkthrough
 *
 * Auto-loads augur + scribe data from content directory.
 * CSS scroll-snap for section focus, progressive reveal.
 */
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import PillNav from '../../components/PillNav.astro';
import fs from 'node:fs';
import yaml from 'js-yaml';

const dir = 'src/content/docs/logbd';
const atlas = JSON.parse(fs.readFileSync(`${dir}/atlas.json`, 'utf-8'));
const manifest = JSON.parse(fs.readFileSync(`${dir}/manifest.json`, 'utf-8'));
const storyByNode = JSON.parse(fs.readFileSync(`${dir}/storyByNode.json`, 'utf-8'));

// Load journeys
const journeyFiles = fs.readdirSync(`${dir}/journeys`).filter((f: string) => f.endsWith('.yaml'));
const journeys = journeyFiles.map((f: string) => yaml.load(fs.readFileSync(`${dir}/journeys/${f}`, 'utf-8')));
const defaultJourney = journeys.find((j: any) => j.id === 'getting-started') || journeys[0];

// Load all stories into a map
const storyMap: Record<string, any> = {};
for (const f of fs.readdirSync(`${dir}/stories`).filter((s: string) => s.endsWith('.yaml'))) {
  const s = yaml.load(fs.readFileSync(`${dir}/stories/${f}`, 'utf-8')) as any;
  storyMap[s.id] = s;
}

// Build stories + bridges per journey
const journeyData: Record<string, { stories: any[]; bridgeMap: Record<string, any>; total: number }> = {};
for (const j of journeys) {
  const jStories = (j.stories || []).map((sid: string) => storyMap[sid]).filter(Boolean);
  const jBridges: Record<string, any> = {};
  for (const b of (j.bridges || [])) {
    if (b && typeof b === 'object') jBridges[b.to] = b;
  }
  journeyData[j.id] = { stories: jStories, bridgeMap: jBridges, total: jStories.length };
}

// Default journey stories (for dots count)
const stories = journeyData[defaultJourney.id]?.stories || [];
const bridgeMap = journeyData[defaultJourney.id]?.bridgeMap || {};

// Component lookup
const compMap: Record<string, any> = {};
for (const c of (atlas.components || [])) compMap[c.id] = c;
for (const e of (atlas.external_dependencies || [])) compMap[e.id] = e;

const purpose = atlas.purpose || '';
const dm = atlas.domain_model || {};
const totalStories = stories.length;

// Load overview (chapter 0) from scribe
let overview: any = {};
try { overview = JSON.parse(fs.readFileSync(`${dir}/overview.json`, 'utf-8')); } catch {};

// Manifest lookup
const manifestMap: Record<string, any> = {};
for (const s of (manifest.stories || [])) manifestMap[s.storyId] = s;

// Helper: parse bold refs in summary
function parseSummary(text: string): string {
  return text
    .replace(/\*\*([^*]+?)\*\*/gs, (_: string, name: string) =>
      `<span class="ref" data-id="${name.toLowerCase().replace(/\s+/g, '-')}">${name}</span>`)
    .replace(/\n\n/g, '<br><br>')
    .replace(/\n/g, ' ');
}

// Type colors for nodes
const typeColors: Record<string, { bg: string; border: string; text: string }> = {
  worker: { bg: 'rgba(99,102,241,0.08)', border: 'rgba(99,102,241,0.25)', text: '#818cf8' },
  service: { bg: 'rgba(59,130,246,0.08)', border: 'rgba(59,130,246,0.25)', text: '#60a5fa' },
  api: { bg: 'rgba(34,197,94,0.08)', border: 'rgba(34,197,94,0.25)', text: '#4ade80' },
  store: { bg: 'rgba(245,158,11,0.08)', border: 'rgba(245,158,11,0.25)', text: '#fbbf24' },
  cli: { bg: 'rgba(100,116,139,0.08)', border: 'rgba(100,116,139,0.25)', text: '#94a3b8' },
  scheduler: { bg: 'rgba(168,85,247,0.08)', border: 'rgba(168,85,247,0.25)', text: '#c084fc' },
  external: { bg: 'rgba(239,68,68,0.08)', border: 'rgba(239,68,68,0.25)', text: '#f87171' },
  broker: { bg: 'rgba(249,115,22,0.08)', border: 'rgba(249,115,22,0.25)', text: '#fb923c' },
};
function getTypeStyle(type: string) {
  return typeColors[type] || typeColors.worker;
}
---

<Base title={defaultJourney.title}>
  <style slot="head">
    html { scroll-snap-type: y mandatory; scroll-behavior: smooth; }

    /* ─── Journey bar (below header, sticky) ─── */
    .journey-bar {
      position: fixed; top: 40px; left: 0; right: 0; z-index: 99;
      background: rgba(9,9,11,0.8); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
      padding: 0 1.5rem;
      opacity: 0; transform: translateY(-100%);
      transition: all .3s ease;
    }
    .journey-bar.visible { opacity: 1; transform: translateY(0); }
    .jb-top {
      display: flex; align-items: center; justify-content: space-between;
      height: 32px;
    }
    .jb-left { display: flex; align-items: center; gap: .75rem; }
    .jb-select {
      font-size: .75rem; font-weight: 500; color: var(--accent);
      background: var(--accent-dim); border: 1px solid var(--accent-border);
      padding: .2rem .6rem; border-radius: 5px; cursor: pointer;
      outline: none; -webkit-appearance: none; appearance: none;
    }
    .jb-select option { background: var(--bg); color: var(--text); }
    .jb-dots {
      display: flex; align-items: center; gap: 3px;
      overflow-x: auto; scrollbar-width: none;
      max-width: 70%;
      background: rgba(9,9,11,0.6);
      border: 1px solid var(--border);
      border-radius: 99px;
      padding: 2px;
    }
    .jb-dots::-webkit-scrollbar { display: none; }
    .jb-dot {
      padding: .2rem .55rem; border-radius: 99px;
      font-size: .6rem; font-weight: 500; color: var(--text-4);
      cursor: pointer; transition: all .2s; text-decoration: none;
      white-space: nowrap;
    }
    .jb-dot:hover { color: var(--text-2); background: rgba(39,39,42,0.6); }
    .jb-dot-active { color: var(--text); background: var(--border); }
    .jb-dot-visited { color: var(--text-3); }

    /* ─── Sections ─── */
    .snap { min-height: 100vh; scroll-snap-align: start; scroll-snap-stop: always; position: relative; }
    .snap-inner {
      max-width: 680px; margin: 0 auto; padding: 90px 1.5rem 120px;
      min-height: 100vh; display: flex; flex-direction: column; justify-content: center;
    }

    /* ─── Landing ─── */
    .landing { text-align: center; }
    .landing h1 {
      font-size: 3.5rem; font-weight: 800; letter-spacing: -.04em;
      background: linear-gradient(135deg, #fff 20%, var(--accent) 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
      margin-bottom: .75rem;
    }
    .landing-sub { font-size: 1.05rem; color: var(--text-2); line-height: 1.65; max-width: 520px; margin: 0 auto 1.5rem; }
    .landing-badge {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .3rem .8rem; border-radius: 99px; font-size: .75rem;
      background: var(--accent-dim); border: 1px solid var(--accent-border); color: var(--accent);
      margin-bottom: 2.5rem;
    }
    .landing-cta {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .7rem 1.8rem; border-radius: 8px; font-size: .9rem; font-weight: 500;
      background: var(--accent); color: #fff; border: none; cursor: pointer;
      transition: all .2s; text-decoration: none;
    }
    .landing-cta:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(129,140,248,.2); }
    /* ─── Chapter 0 ─── */
    .ch0 { justify-content: flex-start; padding-top: 80px; }
    .ch0-header { margin-bottom: 1rem; }
    .ch0-text { margin-top: 1rem; }
    .ch0-journey-overview.hidden { display: none; }
    .ch0-journey-title { font-size: .8rem; font-weight: 600; color: var(--accent); margin-bottom: .5rem; }
    .ch0-point {
      display: flex; gap: .6rem; align-items: flex-start;
      padding: .4rem 0; font-size: .85rem; color: var(--text-2); line-height: 1.6;
    }
    .ch0-dot {
      width: 20px; height: 20px; border-radius: 50%; flex-shrink: 0;
      background: var(--accent-dim); color: var(--accent);
      font-size: .65rem; font-weight: 600;
      display: flex; align-items: center; justify-content: center; margin-top: .15rem;
    }
    .ch0-decisions {
      margin-top: 1rem; padding: .75rem 1rem;
      background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius);
    }
    .ch0-decisions-label {
      font-size: .6rem; font-weight: 600; text-transform: uppercase;
      letter-spacing: .1em; color: var(--text-4); margin-bottom: .4rem;
    }
    .ch0-decision {
      font-size: .8rem; color: var(--text-3); line-height: 1.5;
      padding: .2rem 0;
    }

    .landing-overview {
      font-size: .9rem; color: var(--text-2); line-height: 1.65;
      max-width: 560px; margin: 0 auto 1rem; text-align: left;
    }
    .landing-how {
      font-size: .85rem; color: var(--text-3); line-height: 1.6;
      max-width: 560px; margin: 0 auto 2rem; text-align: left;
      padding: .75rem 1rem; background: var(--bg-raised);
      border: 1px solid var(--border); border-radius: var(--radius);
    }
    .landing-journeys {
      display: flex; gap: .6rem; justify-content: center; flex-wrap: wrap;
      margin-bottom: 1.5rem;
    }
    .landing-journey-btn {
      padding: .6rem 1.4rem; border-radius: 8px; font-size: .85rem; font-weight: 500;
      text-decoration: none; transition: all .2s; cursor: pointer;
      border: 1px solid var(--border); color: var(--text-3);
    }
    .landing-journey-btn:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-dim); }
    .landing-journey-btn.primary {
      background: var(--accent); color: #fff; border-color: var(--accent);
    }
    .landing-journey-btn.primary:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(129,140,248,.2); }
    .landing-stats {
      margin-top: 1.5rem; display: flex; gap: 1.5rem; justify-content: center;
      font-size: .75rem; color: var(--text-4);
    }
    .landing-switch {
      margin-top: 1.5rem;
    }
    .landing-switch-link {
      font-size: .75rem; color: var(--text-4); text-decoration: none;
      padding: .3rem .8rem; border: 1px solid var(--border); border-radius: 6px;
      transition: all .2s;
    }
    .landing-switch-link:hover {
      color: var(--text-2); border-color: var(--border-hover);
    }

    /* ─── Bridge ─── */
    .bridge {
      text-align: center; max-width: 440px; margin: 0 auto 2.5rem;
      font-size: .9rem; color: var(--text-3); font-style: italic; line-height: 1.6;
      padding: 1rem 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    }

    /* ─── Story chrome ─── */
    .story-num { font-size: .65rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--accent); margin-bottom: .4rem; }
    .story-title { font-size: 1.6rem; font-weight: 700; letter-spacing: -.025em; margin-bottom: .4rem; line-height: 1.2; }
    .story-group { display: inline-block; font-size: .65rem; color: var(--text-4); padding: .15rem .5rem; border: 1px solid var(--border); border-radius: 4px; margin-bottom: 1.25rem; }

    /* ─── Anchor ─── */
    .anchor {
      display: flex; gap: .6rem; padding: .6rem .8rem; margin-bottom: 1.25rem;
      background: var(--accent-dim); border: 1px solid var(--accent-border); border-radius: var(--radius);
    }
    .anchor-pin { flex-shrink: 0; font-size: .85rem; }
    .anchor-file { font-family: var(--mono); font-size: .75rem; color: var(--accent); }
    .anchor-desc { font-size: .75rem; color: var(--text-3); margin-top: .15rem; }

    /* ─── Summary ─── */
    .summary { font-size: .9rem; line-height: 1.75; color: var(--text-2); margin-bottom: 1.25rem; }

    /* ─── Structure ─── */
    .struct { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); margin-bottom: 1rem; overflow: hidden; }
    .struct-graph { width: 100%; height: 280px; cursor: grab; }
    .struct-legend {
      display: flex; flex-wrap: wrap; gap: .4rem; padding: .3rem .6rem;
      border-top: 1px solid var(--border); font-size: .6rem; color: var(--text-4);
    }
    .legend-item { display: flex; align-items: center; gap: .25rem; }
    .legend-dot { width: 8px; height: 8px; border-radius: 2px; }
    .struct-graph:active { cursor: grabbing; }
    .struct-hint { text-align: center; font-size: .6rem; color: var(--text-4); padding: .35rem; }

    /* ─── Floating terminal button ─── */
    .fab {
      position: fixed; bottom: 1.25rem; right: 1.25rem; z-index: 200;
      width: 44px; height: 44px; border-radius: 12px; border: none;
      background: rgba(249,115,22,.15); color: #fb923c;
      font-size: 1rem; font-weight: 700; cursor: pointer;
      box-shadow: 0 0 16px rgba(249,115,22,.2), 0 4px 12px rgba(0,0,0,.3);
      transition: all .2s; display: flex; align-items: center; justify-content: center;
      font-family: var(--mono);
    }
    .fab:hover { transform: scale(1.05); box-shadow: 0 0 24px rgba(249,115,22,.3), 0 6px 16px rgba(0,0,0,.4); }
    .fab.hidden { display: none; }

    /* ─── Bottom Drawer ─── */
    #drawer {
      position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
      background: var(--bg); border-top: 1px solid var(--border);
      transform: translateY(100%); transition: transform .3s ease;
      height: 280px; display: flex; flex-direction: column;
    }
    #drawer.open { transform: translateY(0); }
    .drawer-tabs {
      display: flex; border-bottom: 1px solid var(--border); padding: 0 1rem;
      align-items: center;
    }
    .drawer-tab {
      padding: .5rem .75rem; font-size: .7rem; font-weight: 500;
      color: var(--text-4); cursor: pointer; border: none; background: none;
      border-bottom: 2px solid transparent; transition: all .2s;
    }
    .drawer-tab:hover { color: var(--text-2); }
    .drawer-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
    .drawer-close {
      margin-left: auto; padding: .3rem .5rem; font-size: .65rem;
      color: var(--text-4); cursor: pointer; border: none; background: none;
      border-radius: 4px;
    }
    .drawer-close:hover { color: var(--text-2); background: var(--bg-raised); }
    .drawer-body { flex: 1; overflow-y: auto; padding: 1rem 1.25rem; }
    .drawer-panel { display: none; }
    .drawer-panel.active { display: block; }

    /* ─── Detail panel ─── */
    .detail-header { margin-bottom: .6rem; }
    .detail-name { font-weight: 700; font-size: 1.05rem; margin-bottom: .25rem; letter-spacing: -.01em; }
    .detail-type {
      font-size: .65rem; color: var(--text-4); text-transform: uppercase;
      letter-spacing: .08em;
      display: flex; gap: .4rem; flex-wrap: wrap; align-items: center;
    }
    .detail-type-badge {
      padding: .15rem .5rem; border-radius: 4px;
      background: var(--accent-dim); color: var(--accent); font-size: .6rem;
    }
    .detail-desc {
      font-size: .85rem; color: var(--text-2); line-height: 1.6; margin-bottom: .75rem;
      padding-bottom: .75rem; border-bottom: 1px solid var(--border);
    }
    .detail-section { margin-bottom: .6rem; }
    .detail-label { font-size: .6rem; font-weight: 600; color: var(--text-4); text-transform: uppercase; letter-spacing: .1em; margin-bottom: .3rem; }
    .detail-links { display: flex; flex-wrap: wrap; gap: .3rem; }
    .detail-link {
      font-size: .72rem; color: var(--accent); cursor: pointer;
      padding: .15rem .5rem; border-radius: 5px; background: var(--accent-dim);
      border: 1px solid transparent; transition: all .15s;
    }
    .detail-link:hover { background: rgba(129,140,248,.15); border-color: var(--accent-border); }

    /* ─── Terminal panel ─── */
    .term-input-row { display: flex; align-items: center; gap: .5rem; margin-bottom: .75rem; }
    .term-prompt { color: #fb923c; font-family: var(--mono); font-size: .8rem; font-weight: 600; }
    .term-field {
      flex: 1; background: none; border: none; color: var(--text);
      font-family: var(--font); font-size: .85rem; outline: none;
    }
    .term-field::placeholder { color: var(--text-4); }
    .term-output {
      font-size: .8rem; color: var(--text-3); line-height: 1.6;
      font-style: italic;
    }

    /* ─── Flow ─── */
    .flow { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 1rem; margin-bottom: 1rem; }
    .flow-head { font-size: .75rem; font-weight: 600; color: var(--text-3); margin-bottom: .75rem; }
    .flow-step { display: flex; gap: .6rem; padding: .35rem 0; font-size: .8rem; }
    .flow-n {
      width: 18px; height: 18px; border-radius: 50%; flex-shrink: 0;
      background: var(--accent-dim); color: var(--accent);
      font-size: .6rem; font-weight: 600;
      display: flex; align-items: center; justify-content: center; margin-top: .1rem;
    }
    .flow-from { font-weight: 500; color: var(--accent); font-size: .78rem; }
    .flow-arrow { color: var(--text-4); font-size: .7rem; }
    .flow-action { color: var(--text-3); font-size: .78rem; }

    /* ─── Observation ─── */
    .obs {
      padding: .6rem .8rem; border: 1px solid var(--border); border-radius: var(--radius);
      margin-bottom: .6rem; font-size: .8rem;
    }
    .obs.gap { border-left: 2px solid var(--warn); background: var(--warn-dim); }
    .obs.finding { border-left: 2px solid var(--info); background: var(--info-dim); }
    .obs-text { color: var(--text); line-height: 1.5; }
    .obs-meta { display: flex; gap: .6rem; flex-wrap: wrap; margin-top: .3rem; font-size: .7rem; color: var(--text-4); }
    .obs-file { font-family: var(--mono); font-size: .65rem; color: var(--accent); }
    .obs-badge {
      padding: .05rem .35rem; border-radius: 99px; font-size: .6rem;
      font-weight: 600; text-transform: uppercase;
    }
    .obs-badge.high { background: var(--success-dim); color: var(--success); }
    .obs-badge.medium { color: var(--warn); border: 1px solid var(--warn-border); }
    .obs-badge.low { color: var(--text-4); border: 1px solid var(--border); }
    .obs-rec { margin-top: .3rem; color: var(--warn); font-size: .75rem; }

    /* ─── Rationale ─── */
    .rat {
      padding: .6rem .8rem; border: 1px solid var(--border); border-left: 2px solid var(--info);
      border-radius: var(--radius); margin-bottom: .6rem; font-size: .8rem;
    }
    .rat-dec { font-weight: 500; margin-bottom: .2rem; }
    .rat-ctx { color: var(--text-3); font-size: .75rem; }
    .rat-trade { color: var(--text-4); font-size: .75rem; margin-top: .2rem; }

    /* ─── Next ─── */
    .next { margin-top: 2rem; text-align: center; }
    .next a {
      display: inline-flex; align-items: center; gap: .4rem;
      padding: .5rem 1.2rem; border: 1px solid var(--border); border-radius: 8px;
      color: var(--text-3); font-size: .8rem; text-decoration: none; transition: all .2s;
    }
    .next a:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-dim); }

    /* ─── Journey switching ─── */
    .journey-section.hidden { display: none; }

    /* ─── Focus mode (fullscreen story) ─── */
    .focus-btn {
      position: absolute; top: 80px; right: 1.5rem;
      padding: .25rem .6rem; border-radius: 5px; font-size: .65rem;
      color: var(--text-4); border: 1px solid var(--border); background: transparent;
      cursor: pointer; transition: all .2s; z-index: 10;
    }
    .focus-btn:hover { color: var(--accent); border-color: var(--accent-border); background: var(--accent-dim); }

    .focus-overlay {
      display: none; position: fixed; inset: 0; z-index: 500;
      background: var(--bg); overflow-y: auto;
    }
    .focus-overlay.open { display: block; }

    /* Focus header — nav + close */
    .focus-header {
      position: sticky; top: 0; z-index: 501;
      display: flex; align-items: center; justify-content: space-between;
      padding: .5rem 1.5rem; height: 44px;
      background: rgba(9,9,11,.9); backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }
    .focus-nav { display: flex; gap: .4rem; align-items: center; }
    .focus-nav-btn {
      padding: .25rem .6rem; border-radius: 5px; font-size: .7rem;
      color: var(--text-3); border: 1px solid var(--border); background: transparent;
      cursor: pointer; transition: all .2s; text-decoration: none;
    }
    .focus-nav-btn:hover { color: var(--accent); border-color: var(--accent-border); }
    .focus-nav-btn:disabled { opacity: .3; cursor: default; }
    .focus-pos { font-size: .75rem; color: var(--text-4); margin: 0 .5rem; }
    .focus-close {
      padding: .25rem .6rem; border-radius: 5px; font-size: .7rem;
      color: var(--text-3); border: 1px solid var(--border); background: transparent;
      cursor: pointer; transition: all .2s;
    }
    .focus-close:hover { color: var(--text); border-color: var(--text-3); }

    /* Focus content — wider, two-column for graphs */
    .focus-content {
      max-width: 1000px; margin: 0 auto; padding: 2.5rem 2.5rem 4rem;
    }
    .focus-content .story-num { font-size: .7rem; }
    .focus-content .story-title { font-size: 1.8rem; margin-bottom: .75rem; }
    .focus-content .anchor { margin-bottom: 1.5rem; font-size: .9rem; }
    .focus-content .anchor-file { font-size: .85rem; }
    .focus-content .anchor-desc { font-size: .82rem; }
    .focus-content .summary { font-size: .95rem; line-height: 1.8; margin-bottom: 1.5rem; }
    .focus-content .struct { margin-bottom: 1.5rem; }
    .focus-content .struct-graph { height: 420px; }
    .focus-content .flow { padding: 1.25rem; margin-bottom: 1.5rem; }
    .focus-content .flow-head { font-size: .85rem; }
    .focus-content .flow-step { font-size: .88rem; padding: .5rem 0; }
    .focus-content .obs { padding: .85rem 1rem; font-size: .85rem; margin-bottom: .75rem; }
    .focus-content .obs-text { line-height: 1.6; }
    .focus-content .rat { padding: .85rem 1rem; font-size: .85rem; margin-bottom: .75rem; }

    /* Bridge in focus mode */
    .focus-bridge {
      text-align: center; padding: 1.5rem 0; margin: 1rem 0;
      font-size: .9rem; color: var(--text-3); font-style: italic;
      border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
      max-width: 500px; margin-left: auto; margin-right: auto;
    }

    /* terminal styles are above with detail drawer */

    /* ─── Responsive ─── */
    @media (max-width: 640px) {
      .snap-inner { padding: 64px 1rem 100px; }
      .landing h1 { font-size: 2.2rem; }
      .story-title { font-size: 1.3rem; }
      header { padding: 0 1rem; }
      .landing-stats { flex-wrap: wrap; gap: .75rem; }
    }
  </style>
<style is:global>
  /* Refs injected via set:html — not scoped by Astro */
  .ref {
    color: #818cf8 !important;
    font-weight: 600 !important;
    cursor: pointer !important;
    border-bottom: 1px dotted rgba(129,140,248,0.3) !important;
    transition: all .15s;
  }
  .ref:hover {
    color: #a5b4fc !important;
