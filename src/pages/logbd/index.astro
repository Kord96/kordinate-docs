<!-- Bottom drawer (detail + terminal tabs) -->
<div id="drawer">
  <div class="drawer-tabs">
    <button class="drawer-tab active" data-panel="detail">Detail</button>
    <button class="drawer-tab" data-panel="terminal">Terminal</button>
