---
/**
 * logBD Atlas — Full reference view of the architecture.
 * Shows all components, flows, failure modes, debt, observations.
 */
import fs from 'node:fs';
import yaml from 'js-yaml';

const dir = 'src/content/docs/logbd';
const atlas = JSON.parse(fs.readFileSync(`${dir}/atlas.json`, 'utf-8'));
let storyByNode: Record<string, string[]> = {};
try { storyByNode = JSON.parse(fs.readFileSync(`${dir}/storyByNode.json`, 'utf-8')); } catch {}

const groups = atlas.groups || [];
const components = atlas.components || [];
const flows = atlas.flows || [];
const failures = atlas.failure_modes || [];
const extDeps = atlas.external_dependencies || [];
const debt = atlas.debt || {};
const dm = atlas.domain_model || {};
const concepts = atlas.concepts || {};

function severity(s: string) {
  const colors: Record<string, string> = { critical: '#ef4444', high: '#f97316', medium: '#f59e0b', low: '#22c55e' };
  return colors[s] || '#64748b';
}
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{atlas.project} — Atlas</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #09090b; --bg-card: #18181b; --border: #27272a; --border-hover: #3f3f46;
      --text: #fafafa; --text-2: #a1a1aa; --text-3: #71717a; --text-4: #52525b;
      --accent: #818cf8; --accent-dim: rgba(129,140,248,.12); --accent-border: rgba(129,140,248,.2);
      --radius: 10px; --font: 'Inter', system-ui, sans-serif; --mono: 'JetBrains Mono', monospace;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: var(--font); background: var(--bg); color: var(--text); -webkit-font-smoothing: antialiased; }

    header {
      position: sticky; top: 0; z-index: 100; padding: 0 1.5rem; height: 48px;
      display: flex; align-items: center; justify-content: space-between;
      background: rgba(9,9,11,.85); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border);
    }
    .h-left { display: flex; align-items: center; gap: .75rem; }
    .h-logo { font-weight: 700; font-size: .9rem; }
    .h-badge { font-size: .6rem; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; padding: .1rem .4rem; border-radius: 3px; background: rgba(251,191,36,.12); color: #fbbf24; }
    .h-title { font-size: .8rem; color: var(--text-3); }
    .h-links { display: flex; gap: .5rem; }
    .h-link { font-size: .7rem; color: var(--text-4); text-decoration: none; padding: .2rem .5rem; border: 1px solid var(--border); border-radius: 4px; transition: all .2s; }
    .h-link:hover { color: var(--text-2); border-color: var(--border-hover); }

    .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

    .section { margin-bottom: 3rem; }
    .section-title { font-size: 1.2rem; font-weight: 700; margin-bottom: .25rem; letter-spacing: -.02em; }
    .section-sub { font-size: .8rem; color: var(--text-3); margin-bottom: 1.25rem; }

    /* ─── Cards ─── */
    .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .75rem; }
    .card {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: .75rem 1rem; transition: border-color .2s;
    }
    .card:hover { border-color: var(--border-hover); }
    .card-name { font-weight: 600; font-size: .85rem; margin-bottom: .2rem; }
    .card-type { font-size: .6rem; text-transform: uppercase; letter-spacing: .08em; color: var(--text-4); margin-bottom: .35rem; }
    .card-desc { font-size: .78rem; color: var(--text-2); line-height: 1.5; }
    .card-meta { display: flex; gap: .4rem; flex-wrap: wrap; margin-top: .4rem; }
    .card-tag { font-size: .6rem; padding: .1rem .35rem; border-radius: 4px; background: var(--accent-dim); color: var(--accent); }

    /* ─── Group header ─── */
    .group-header { margin-top: 2rem; margin-bottom: .75rem; padding-bottom: .35rem; border-bottom: 1px solid var(--border); }
    .group-name { font-size: .9rem; font-weight: 600; }
    .group-desc { font-size: .75rem; color: var(--text-3); }

    /* ─── Failure modes ─── */
    .failure {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: .75rem 1rem; margin-bottom: .6rem;
    }
    .failure-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: .3rem; }
    .failure-name { font-weight: 600; font-size: .85rem; }
    .failure-sev { font-size: .6rem; font-weight: 600; text-transform: uppercase; padding: .1rem .4rem; border-radius: 99px; color: white; }
    .failure-trigger { font-size: .78rem; color: var(--text-2); margin-bottom: .3rem; }
    .failure-cascade { font-size: .75rem; color: var(--text-3); }

    /* ─── Debt ─── */
    .debt-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
    .debt-grade { font-size: 2rem; font-weight: 800; width: 56px; height: 56px; border-radius: 12px; display: flex; align-items: center; justify-content: center; }
    .debt-score { font-size: .8rem; color: var(--text-3); }
    .violation {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: .6rem .8rem; margin-bottom: .5rem; font-size: .8rem;
    }
    .violation-sev { font-size: .6rem; font-weight: 600; text-transform: uppercase; margin-right: .4rem; }

    /* ─── External deps ─── */
    .dep { display: flex; justify-content: space-between; align-items: center; padding: .5rem 0; border-bottom: 1px solid var(--border); font-size: .82rem; }
    .dep:last-child { border-bottom: none; }
    .dep-name { font-weight: 500; }
    .dep-crit { font-size: .6rem; text-transform: uppercase; letter-spacing: .05em; }

    /* ─── Flows ─── */
    .flow-card {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius);
      padding: .75rem 1rem; margin-bottom: .6rem;
    }
    .flow-name { font-weight: 600; font-size: .85rem; margin-bottom: .15rem; }
    .flow-type { font-size: .6rem; text-transform: uppercase; letter-spacing: .08em; color: var(--accent); margin-bottom: .3rem; }
    .flow-desc { font-size: .78rem; color: var(--text-2); line-height: 1.5; }

    /* ─── Domain model ─── */
    .dm-badge { display: inline-flex; padding: .3rem .8rem; border-radius: 99px; font-size: .75rem; background: var(--accent-dim); border: 1px solid var(--accent-border); color: var(--accent); margin-bottom: 1rem; }
    .dm-entities { display: flex; flex-wrap: wrap; gap: .3rem; margin-top: .5rem; }
    .dm-entity { font-size: .7rem; padding: .15rem .4rem; border-radius: 4px; background: var(--bg-card); border: 1px solid var(--border); color: var(--text-2); }
  </style>
</head>
<body>

<header>
  <div class="h-left">
    <span class="h-logo">{atlas.project}</span>
    <span class="h-badge">atlas</span>
    <span class="h-title">Architecture Reference</span>
  </div>
  <div class="h-links">
    <a class="h-link" href="/dev/logbd/">Journey</a>
    <a class="h-link" href="/dev/">Home</a>
  </div>
</header>

<div class="container">

  <!-- Purpose + Domain Model -->
  <div class="section">
    <h1 class="section-title">{atlas.project}</h1>
    <p class="section-sub">{atlas.purpose}</p>
    {dm.primary && (
      <div>
        <div class="dm-badge">◆ {dm.primary}</div>
        {dm.description && <p style="font-size: .82rem; color: var(--text-2); margin-bottom: .5rem;">{dm.description}</p>}
        {dm.entities && (
          <div class="dm-entities">
            {dm.entities.map((e: string) => <span class="dm-entity">{e}</span>)}
          </div>
        )}
      </div>
    )}
  </div>

  <!-- Components by group -->
  <div class="section">
    <h2 class="section-title">Components</h2>
    <p class="section-sub">{components.length} components across {groups.length} groups</p>

    {groups.map((g: any) => {
      const groupComps = components.filter((c: any) => c.group === g.id);
      return (
        <div>
          <div class="group-header">
            <div class="group-name">{g.name}</div>
            <div class="group-desc">{g.description}</div>
          </div>
          <div class="card-grid">
            {groupComps.map((c: any) => (
              <div class="card">
                <div class="card-name">{c.name}</div>
                <div class="card-type">{c.type}</div>
                <div class="card-desc">{c.description}</div>
                {c.patterns && c.patterns.length > 0 && (
                  <div class="card-meta">
                    {c.patterns.map((p: string) => <span class="card-tag">{p}</span>)}
                  </div>
                )}
              </div>
            ))}
          </div>
        </div>
      );
    })}
  </div>

  <!-- Flows -->
  <div class="section">
    <h2 class="section-title">Flows</h2>
    <p class="section-sub">{flows.length} typed flows</p>
    {flows.map((f: any) => (
      <div class="flow-card">
        <div class="flow-name">{f.name}</div>
        <div class="flow-type">{f.type} flow</div>
        <div class="flow-desc">{f.description}</div>
      </div>
    ))}
  </div>

  <!-- External Dependencies -->
  <div class="section">
    <h2 class="section-title">External Dependencies</h2>
    <p class="section-sub">{extDeps.length} external dependencies</p>
    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: .5rem 1rem;">
      {extDeps.map((e: any) => (
        <div class="dep">
          <span class="dep-name">{e.name || e.id}</span>
          <span class="dep-crit" style={`color: ${severity(e.criticality)}`}>{e.criticality}</span>
        </div>
      ))}
    </div>
  </div>

  <!-- Failure Modes -->
  <div class="section">
    <h2 class="section-title">Failure Modes</h2>
    <p class="section-sub">{failures.length} failure scenarios analyzed</p>
    {failures.map((fm: any) => (
      <div class="failure">
        <div class="failure-header">
          <span class="failure-name">{fm.id.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}</span>
          <span class="failure-sev" style={`background: ${severity(fm.severity)}`}>{fm.severity}</span>
        </div>
        <div class="failure-trigger">▸ {fm.trigger}</div>
        {fm.cascade && fm.cascade.length > 0 && (
          <div class="failure-cascade">
            Cascade: {fm.cascade.map((c: any) => c.component || c.effect).join(' → ')}
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- Debt -->
  <div class="section">
    <h2 class="section-title">Technical Debt</h2>
    <div class="debt-header">
      <div class="debt-grade" style={`background: ${severity(debt.grade === 'A' ? 'low' : debt.grade === 'B' ? 'medium' : 'high')}; color: white;`}>
        {debt.grade || '?'}
      </div>
      <div>
        <div style="font-weight: 600;">Score: {debt.score}</div>
        <div class="debt-score">{debt.interpretation || ''}</div>
      </div>
    </div>
    {(debt.violations || []).map((v: any) => (
      <div class="violation">
        <span class="violation-sev" style={`color: ${severity(v.severity)}`}>{v.severity}</span>
        {v.description || v.title}
      </div>
    ))}
    {(debt.recommendations || []).map((r: any) => (
      <div class="violation" style="border-left: 2px solid var(--accent);">
        → {r.title || r.description || r}
      </div>
    ))}
  </div>

  <!-- Detected Patterns -->
  <div class="section">
    <h2 class="section-title">Detected Patterns</h2>
    <p class="section-sub">{(concepts.detected_patterns || []).length} patterns, {(concepts.detected_anti_patterns || []).length} anti-patterns, {(concepts.gaps || []).length} gaps</p>
    <div style="display: flex; flex-wrap: wrap; gap: .3rem;">
      {(concepts.detected_patterns || []).map((p: any) => (
        <span class="card-tag">{p.id || p.name || p}</span>
      ))}
    </div>
    {(concepts.gaps || []).length > 0 && (
      <div style="margin-top: 1rem;">
        <div style="font-size: .7rem; font-weight: 600; color: var(--text-4); text-transform: uppercase; margin-bottom: .3rem;">Gaps</div>
        {(concepts.gaps || []).map((g: any) => (
          <div style="font-size: .78rem; color: #f59e0b; padding: .2rem 0;">⚠ {g.name || g.id || g}</div>
        ))}
      </div>
    )}
  </div>

</div>
</body>
</html>
