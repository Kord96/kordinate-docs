---
/**
 * logBD Issues — Architectural findings from augur analysis.
 * Shows violations, failure modes, gaps, and story observations
 * classified by severity and type.
 */
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import fs from 'node:fs';
import yaml from 'js-yaml';

const dir = 'src/content/docs/logbd';
const atlas = JSON.parse(fs.readFileSync(`${dir}/atlas.json`, 'utf-8'));

// Load story observations
const storyDir = `${dir}/stories`;
const storyObs: any[] = [];
for (const f of fs.readdirSync(storyDir).filter((s: string) => s.endsWith('.yaml'))) {
  const s = yaml.load(fs.readFileSync(`${storyDir}/${f}`, 'utf-8')) as any;
  for (const obs of (s.observations || [])) {
    if (obs.recommendation && obs.confidence !== 'low') {
      storyObs.push({ ...obs, story: s.id });
    }
  }
}

// Build unified issues list
interface Issue {
  id: string;
  type: 'bug' | 'enhancement' | 'suggestion';
  severity: string;
  title: string;
  description: string;
  category: string;
  components: string[];
  files: string[];
  recommendation: string;
  source: string;
}

const issues: Issue[] = [];

// Violations
for (const v of (atlas.debt?.violations || [])) {
  const sev = (v.severity || '').toUpperCase();
  issues.push({
    id: `violation:${v.anti_pattern?.toLowerCase().replace(/\s+/g, '-').substring(0, 40)}`,
    type: sev === 'CRITICAL' || sev === 'HIGH' ? 'bug' : 'enhancement',
    severity: v.severity?.toLowerCase() || 'medium',
    title: v.anti_pattern,
    description: v.detail,
    category: v.category || 'General',
    components: v.components || [],
    files: v.files || [],
    recommendation: '',
    source: 'Debt / Violations',
  });
}

// Recommendations
for (const r of (atlas.debt?.recommendations || [])) {
  const sev = (r.severity || '').toUpperCase();
  issues.push({
    id: `rec:${r.title?.toLowerCase().replace(/\s+/g, '-').substring(0, 40)}`,
    type: sev === 'CRITICAL' || sev === 'HIGH' ? 'bug' : 'enhancement',
    severity: r.severity?.toLowerCase() || 'medium',
    title: r.title || 'Recommendation',
    description: r.description || '',
    category: r.category || 'General',
    components: [],
    files: r.files || [],
    recommendation: r.description || '',
    source: 'Debt / Recommendations',
  });
}

// Failure modes
for (const fm of (atlas.failure_modes || [])) {
  const sev = (fm.severity || '').toLowerCase();
  issues.push({
    id: `failure:${fm.id}`,
    type: sev === 'critical' || sev === 'high' ? 'bug' : 'enhancement',
    severity: sev || 'medium',
    title: `Failure mode: ${fm.id.replace(/-/g, ' ')}`,
    description: fm.impact,
    category: 'Reliability',
    components: fm.cascade?.map((c: any) => c.component) || [],
    files: fm.grounded_in || [],
    recommendation: (fm.recovery || []).join('. '),
    source: 'Failure Modes',
  });
}

// Concept gaps
for (const g of (atlas.concepts?.gaps || [])) {
  const gap = typeof g === 'string' ? { id: g, relevance: '', recommendation: '' } : g;
  issues.push({
    id: `gap:${gap.id}`,
    type: 'suggestion',
    severity: 'low',
    title: gap.id.replace(/-/g, ' '),
    description: gap.relevance || '',
    category: 'Architecture Gap',
    components: [],
    files: [],
    recommendation: gap.recommendation || '',
    source: 'Concept Gaps',
  });
}

// Story observations with recommendations
for (const obs of storyObs) {
  const tags = obs.tags || [];
  const isCritical = tags.includes('critical') || tags.includes('security');
  issues.push({
    id: obs.id,
    type: isCritical ? 'bug' : 'enhancement',
    severity: isCritical ? 'high' : 'medium',
    title: obs.finding?.replace(/\*\*/g, '') || obs.id,
    description: obs.finding?.replace(/\*\*/g, '') || '',
    category: tags[0] || 'Observation',
    components: obs.component ? [obs.component] : [],
    files: obs.evidence?.file ? [`${obs.evidence.file}:${obs.evidence.lines?.[0] || ''}`] : [],
    recommendation: obs.recommendation || '',
    source: `Story: ${obs.story}`,
  });
}

// Sort: bugs first, then by severity
const sevOrder: Record<string, number> = { critical: 0, high: 1, medium: 2, low: 3 };
const typeOrder: Record<string, number> = { bug: 0, enhancement: 1, suggestion: 2 };
issues.sort((a, b) => (typeOrder[a.type] ?? 9) - (typeOrder[b.type] ?? 9) || (sevOrder[a.severity] ?? 9) - (sevOrder[b.severity] ?? 9));

const bugs = issues.filter(i => i.type === 'bug');
const enhancements = issues.filter(i => i.type === 'enhancement');
const suggestions = issues.filter(i => i.type === 'suggestion');

function sevColor(s: string) {
  const colors: Record<string, string> = { critical: '#ef4444', high: '#f97316', medium: '#f59e0b', low: '#22c55e' };
  return colors[s] || '#64748b';
}

function typeColor(t: string) {
  const colors: Record<string, string> = { bug: '#ef4444', enhancement: '#60a5fa', suggestion: '#a78bfa' };
  return colors[t] || '#64748b';
}
---

<Base title={`${atlas.project} — Issues`}>
  <style slot="head">
    .container { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
    .page-title { font-size: 1.5rem; font-weight: 800; margin-bottom: .25rem; letter-spacing: -.03em; }
    .page-sub { font-size: .85rem; color: var(--text-3); margin-bottom: 2rem; }

    .stats { display: flex; gap: 1.5rem; margin-bottom: 2rem; }
    .stat { text-align: center; }
    .stat-num { font-size: 1.5rem; font-weight: 800; }
    .stat-label { font-size: .7rem; color: var(--text-3); text-transform: uppercase; letter-spacing: .08em; }

    .section { margin-bottom: 2.5rem; }
    .section-header { display: flex; align-items: center; gap: .5rem; margin-bottom: 1rem; padding-bottom: .5rem; border-bottom: 1px solid var(--border); }
    .section-title { font-size: 1rem; font-weight: 700; }
    .section-count { font-size: .7rem; color: var(--text-3); background: var(--border); padding: .1rem .4rem; border-radius: 99px; }

    .issue { background: var(--bg-raised); border: 1px solid var(--border); border-radius: var(--radius); padding: .75rem 1rem; margin-bottom: .5rem; transition: border-color .2s; }
    .issue:hover { border-color: var(--border-hover); }
    .issue-top { display: flex; align-items: center; gap: .5rem; margin-bottom: .35rem; flex-wrap: wrap; }
    .issue-title { font-weight: 600; font-size: .85rem; flex: 1; min-width: 200px; }
    .badge { font-size: .55rem; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; padding: .1rem .35rem; border-radius: 3px; white-space: nowrap; }
    .issue-desc { font-size: .78rem; color: var(--text-2); line-height: 1.5; margin-bottom: .35rem; }
    .issue-meta { display: flex; gap: .5rem; flex-wrap: wrap; align-items: center; }
    .issue-source { font-size: .65rem; color: var(--text-4); }
    .issue-files { font-size: .65rem; color: var(--text-3); font-family: var(--mono); }
    .issue-rec { font-size: .75rem; color: var(--accent); margin-top: .35rem; padding: .4rem .6rem; background: var(--accent-dim); border-radius: 6px; border-left: 2px solid var(--accent); }
    .components { display: flex; gap: .3rem; flex-wrap: wrap; }
    .comp { font-size: .6rem; padding: .1rem .3rem; border-radius: 3px; background: rgba(99,102,241,0.08); color: var(--accent); border: 1px solid rgba(99,102,241,0.15); }
  </style>

<Header project={atlas.project} badge="issues" links={[{ label: 'Journey', href: '/dev/logbd/' }, { label: 'Atlas', href: '/dev/logbd/atlas/' }]} position="sticky" />

<div class="container">
  <h1 class="page-title">Issues</h1>
  <p class="page-sub">Architectural findings from automated analysis — violations, failure modes, gaps, and observations.</p>

  <div class="stats">
    <div class="stat">
      <div class="stat-num" style={`color: ${typeColor('bug')}`}>{bugs.length}</div>
      <div class="stat-label">Bugs</div>
    </div>
    <div class="stat">
      <div class="stat-num" style={`color: ${typeColor('enhancement')}`}>{enhancements.length}</div>
      <div class="stat-label">Enhancements</div>
    </div>
    <div class="stat">
      <div class="stat-num" style={`color: ${typeColor('suggestion')}`}>{suggestions.length}</div>
      <div class="stat-label">Suggestions</div>
    </div>
    <div class="stat">
      <div class="stat-num" style="color: var(--text)">{issues.length}</div>
      <div class="stat-label">Total</div>
    </div>
  </div>

  {bugs.length > 0 && (
    <div class="section">
      <div class="section-header">
        <span class="section-title" style={`color: ${typeColor('bug')}`}>Bugs</span>
        <span class="section-count">{bugs.length}</span>
      </div>
      {bugs.map(issue => (
        <div class="issue">
          <div class="issue-top">
            <span class="issue-title">{issue.title}</span>
            <span class="badge" style={`background: ${sevColor(issue.severity)}22; color: ${sevColor(issue.severity)}`}>{issue.severity}</span>
            <span class="badge" style={`background: var(--border); color: var(--text-3)`}>{issue.category}</span>
          </div>
          {issue.description && <div class="issue-desc">{issue.description}</div>}
          {issue.recommendation && <div class="issue-rec">{issue.recommendation}</div>}
          <div class="issue-meta">
            {issue.components.length > 0 && (
              <div class="components">
                {issue.components.map(c => <span class="comp">{c}</span>)}
              </div>
            )}
            {issue.files.length > 0 && <span class="issue-files">{issue.files.join(', ')}</span>}
            <span class="issue-source">{issue.source}</span>
          </div>
        </div>
      ))}
    </div>
  )}

  {enhancements.length > 0 && (
    <div class="section">
      <div class="section-header">
        <span class="section-title" style={`color: ${typeColor('enhancement')}`}>Enhancements</span>
        <span class="section-count">{enhancements.length}</span>
      </div>
      {enhancements.map(issue => (
        <div class="issue">
          <div class="issue-top">
            <span class="issue-title">{issue.title}</span>
            <span class="badge" style={`background: ${sevColor(issue.severity)}22; color: ${sevColor(issue.severity)}`}>{issue.severity}</span>
            <span class="badge" style={`background: var(--border); color: var(--text-3)`}>{issue.category}</span>
          </div>
          {issue.description && <div class="issue-desc">{issue.description}</div>}
          {issue.recommendation && <div class="issue-rec">{issue.recommendation}</div>}
          <div class="issue-meta">
            {issue.components.length > 0 && (
              <div class="components">
                {issue.components.map(c => <span class="comp">{c}</span>)}
              </div>
            )}
            {issue.files.length > 0 && <span class="issue-files">{issue.files.join(', ')}</span>}
            <span class="issue-source">{issue.source}</span>
          </div>
        </div>
      ))}
    </div>
  )}

  {suggestions.length > 0 && (
    <div class="section">
      <div class="section-header">
        <span class="section-title" style={`color: ${typeColor('suggestion')}`}>Suggestions</span>
        <span class="section-count">{suggestions.length}</span>
      </div>
      {suggestions.map(issue => (
        <div class="issue">
          <div class="issue-top">
            <span class="issue-title">{issue.title}</span>
            <span class="badge" style={`background: var(--border); color: var(--text-3)`}>{issue.category}</span>
          </div>
          {issue.description && <div class="issue-desc">{issue.description}</div>}
        </div>
      ))}
    </div>
  )}
</div>
</Base>
